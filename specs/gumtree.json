    "/gumtree/v1/seller": {
      "get": {
        "operationId": "gumtreeSeller",
        "summary": "Gumtree trade seller",
        "description": "A trade seller's profile on Gumtree UK: name (when shown), years on Gumtree, rating with its 1-5 breakdown, feedback tags, recent reviews (rating, date, category, tags; reviewers' names are left out), all-time ad counts per category and the live ads with price, location, date, description, photos and attributes. Pass the seller's public id or one of its ad ids. Private sellers' profiles are not returned. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/gumtree-seller",
        "tags": [
          "Gumtree"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Public seller id (the hex id in gumtree.com/profile/account/<id>). Either id or ad is required.",
            "schema": {
              "type": "string"
            },
            "example": "58d009c0fe7a21f25cddf553559f2ae4"
          },
          {
            "name": "ad",
            "in": "query",
            "required": false,
            "description": "One of the seller's ad ids or ad links, instead of id.",
            "schema": {
              "type": "string"
            }
          },
