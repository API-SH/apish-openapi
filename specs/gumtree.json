{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Gumtree",
    "version": "1.0.0",
    "description": "The Gumtree API from API.SH: public Gumtree data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Gumtree",
      "description": "4 endpoints (e-commerce)",
      "x-slug": "gumtree",
      "x-domains": [
        "gumtree.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/gumtree/v1/categories": {
      "get": {
        "operationId": "gumtreeCategories",
        "summary": "Gumtree categories",
        "description": "Gumtree UK categories with their live ad counts: the top level by default, or a category's sub-categories (with its parent path), optionally within a location. Use a slug as category with /gumtree/v1/search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/gumtree-categories",
        "tags": [
          "Gumtree"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug (default all: the top level).",
            "schema": {
              "type": "string"
            },
            "example": "for-sale"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Location slug (default uk), e.g. london.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "category": "for-sale",
                  "location": "uk",
                  "parents": [],
                  "count": 23,
                  "categories": [
                    {
                      "slug": "home-garden",
                      "name": "Home & Garden",
                      "ads": 421636,
                      "url": "https://www.gumtree.com/search?search_category=home-garden&search_location=uk&sort=relevance"
                    },
                    {
                      "slug": "clothing",
                      "name": "Clothes, Footwear & Accessories",
                      "ads": 172826,
                      "url": "https://www.gumtree.com/search?search_category=clothing&search_location=uk&sort=relevance"
                    },
                    "… 21 more"
                  ],
                  "note": "Leaf categories have no sub-categories; use a slug as category with /gumtree/v1/search",
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/gumtree/v1/listing": {
      "get": {
        "operationId": "gumtreeListing",
        "summary": "Gumtree UK ad details",
        "description": "One Gumtree UK ad: price, description, condition, photos, location, created, published and expiry dates, category and breadcrumbs, seller type and, for trade sellers, the seller name and ads link, plus `attributes`: the ad's Details list as key, name, value, unit and group (cars: make, model, year, mileage, fuel, body type, transmission, engine, emissions, performance; property: bedrooms, property type, availability; other categories as the site lists them). Pass `id`, `url`, or `latest=1` with search params. Private sellers' names, phone numbers and email addresses are never returned (masked in ad text).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/gumtree-listing",
        "tags": [
          "Gumtree"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Gumtree ad id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Gumtree ad url.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`1`: open the first current result of a search made with this route's search params (q, location and filters) instead of an id. Ads expire, so this keeps a link working.",
            "schema": {
              "type": "string"
            },
            "example": "1"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search keywords (with latest=1).",
            "schema": {
              "type": "string"
            },
            "example": "bike"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Location (with latest=1).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug (with latest=1).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "1804472256",
                  "url": "https://www.gumtree.com/p/road-bikes/merida-scultura-6000-2025-road-bike-as-good-as-new/1804472256",
                  "title": "Merida Scultura 6000 2025 Road Bike - As Good As New",
                  "description": "Merida Scultura 6000 road bike, 2025 model, in black. It's in as good as new condition, barely ridden, and well-maintained. Features disc br…",
                  "price": 1400,
                  "currency": "GBP",
                  "condition": "new",
                  "availability": "InStock",
                  "location": "Hebburn, Tyne and Wear",
                  "posted": "2026-11-01T08:30:25.332Z",
                  "published": "2026-11-03T15:22:46.946Z",
                  "expires": "2027-02-01T00:00:00.000Z",
                  "posted_ago": "14 hours ago",
                  "images": [
                    "https://img.gumtree.com/ePR8PyKf84wPHx7_RYmEag/390be175ea9d46e599_33d21f3069ea/86",
                    "https://img.gumtree.com/ePR8PyKf84wPHx7_RYmEag/c902d09d1f7a4d1384_533a89e61c90/86",
                    "… 1 more"
                  ],
                  "category": "Sporting Goods > Outdoor Recreation > Cycling > Bicycles",
                  "breadcrumbs": [
                    {
                      "name": "Home",
                      "url": "https://www.gumtree.com/"
                    },
                    {
                      "name": "For Sale",
                      "url": "https://www.gumtree.com/for-sale/uk/hebburn"
                    },
                    "… 4 more"
                  ],
                  "seller_type": "private",
                  "seller": null,
                  "attributes": [],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/gumtree/v1/search": {
      "get": {
        "operationId": "gumtreeSearch",
        "summary": "Search Gumtree UK ads",
        "description": "Gumtree UK classified ads for a keyword, category and location with distance, price, seller type, condition and sort, plus category filters (cars: year, mileage, make, model, fuel, transmission, body type; property: bedrooms and property type; any other filter the site offers through `attributes`). Each result has price, location, age, photo, photo count, seller type, delivery option, promotions and `attributes` (the ad's key/value details such as make, model, year, mileage, fuel, bedrooms, property type); `applied` shows the category, location and radius the site resolved, `applied_filters` every filter the site applied, and `filters` the filter groups the page offers (key, label, type, values with ad counts; range filters list their `min_key`/`max_key` for `attributes`). Featured ads come first, as on the site. Private sellers' names, phone numbers and email addresses are never returned (masked in ad text).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/gumtree-search",
        "tags": [
          "Gumtree"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords.",
            "schema": {
              "type": "string"
            },
            "example": "bike"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Gumtree category slug (all, for-sale, bicycles, mobile-phones, cars, motorbikes-scooters, flats-houses, property-to-rent, home-garden, jobs).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Town, city, area or postcode (default uk).",
            "schema": {
              "type": "string"
            },
            "example": "london"
          },
          {
            "name": "distance",
            "in": "query",
            "required": false,
            "description": "Radius in miles around the location.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (GBP).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price (GBP).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "seller_type",
            "in": "query",
            "required": false,
            "description": "private or trade.",
            "schema": {
              "type": "string",
              "enum": [
                "private",
                "trade"
              ]
            }
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "description": "Item condition.",
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "used",
                "refurbished",
                "for_parts"
              ]
            }
          },
          {
            "name": "min_year",
            "in": "query",
            "required": false,
            "description": "Cars: earliest registration year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_year",
            "in": "query",
            "required": false,
            "description": "Cars: latest registration year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_mileage",
            "in": "query",
            "required": false,
            "description": "Cars: minimum mileage (miles).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_mileage",
            "in": "query",
            "required": false,
            "description": "Cars: maximum mileage (miles).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "vehicle_make",
            "in": "query",
            "required": false,
            "description": "Cars: make, e.g. bmw, ford, volkswagen (see the vehicle_make values in `filters`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "vehicle_model",
            "in": "query",
            "required": false,
            "description": "Cars: model as the site lists it, e.g. `3 SERIES` (with vehicle_make; see `filters`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fuel_type",
            "in": "query",
            "required": false,
            "description": "Cars: fuel type, e.g. petrol, diesel, electric, hybrid.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transmission",
            "in": "query",
            "required": false,
            "description": "Cars: automatic or manual.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "body_type",
            "in": "query",
            "required": false,
            "description": "Cars: body type, e.g. hatchback, saloon, estate, convertible, coupe, mpv.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_beds",
            "in": "query",
            "required": false,
            "description": "Property: minimum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_beds",
            "in": "query",
            "required": false,
            "description": "Property: maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Property: flat, house or other.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "attributes",
            "in": "query",
            "required": false,
            "description": "Any other site filter as comma-separated key:value pairs using the keys in `filters`, e.g. `vehicle_colour:black,min_vehicle_engine_size:999,pets_allowed:true`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "price_asc",
                "price_desc",
                "distance"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Results page, 1 for the first. Pass back `next_page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
