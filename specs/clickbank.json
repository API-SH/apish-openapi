          "ClickBank"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "vendor",
            "in": "query",
            "required": true,
            "description": "Vendor id as in search results (e.g. PRODENTIM), or a hop link.",
            "schema": {
              "type": "string"
            },
            "example": "PRODENTIM"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
