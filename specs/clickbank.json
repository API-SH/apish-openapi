    "/clickbank/v1/search": {
      "get": {
        "operationId": "clickbankSearch",
        "summary": "ClickBank Marketplace search",
        "description": "Affiliate offers on the ClickBank Marketplace with every marketplace filter: keywords, category and subcategory, gravity, earnings per sale (initial, average, future rebill), EPC (initial, average, future, net), conversion rate, activation date, product type, language, attributes and seller flags, sorted by rank, gravity, EPC, conversion rate or relevance. Each offer has the vendor id, title, description, category, activation date, gravity, rank, earnings per sale, EPC and conversion figures, languages, product types, sales page, affiliate page and support contact, and the hop link; plus facet counts for the whole result. Pass `next_offset` back as `offset`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/clickbank-search",
        "tags": [
          "ClickBank"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords.",
            "schema": {
              "type": "string"
            },
            "example": "weight loss"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category name as in /clickbank/v1/categories (e.g. Health & Fitness).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subcategory",
            "in": "query",
            "required": false,
            "description": "Subcategory name (needs category).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "gravity_min",
            "in": "query",
            "required": false,
            "description": "Lowest gravity.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "gravity_max",
            "in": "query",
            "required": false,
            "description": "Highest gravity.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "average_earnings_per_sale_min",
            "in": "query",
            "required": false,
            "description": "Lowest average $/conversion.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "average_earnings_per_sale_max",
            "in": "query",
            "required": false,
            "description": "Highest average $/conversion.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "initial_earnings_per_sale_min",
            "in": "query",
            "required": false,
            "description": "Lowest initial $/conversion.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "initial_earnings_per_sale_max",
            "in": "query",
            "required": false,
            "description": "Highest initial $/conversion.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "future_earnings_min",
            "in": "query",
            "required": false,
            "description": "Lowest future $/rebill.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "future_earnings_max",
            "in": "query",
            "required": false,
            "description": "Highest future $/rebill.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "average_epc_min",
            "in": "query",
            "required": false,
            "description": "Lowest average EPC.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "average_epc_max",
            "in": "query",
            "required": false,
            "description": "Highest average EPC.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "initial_epc_min",
            "in": "query",
            "required": false,
            "description": "Lowest initial EPC.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "initial_epc_max",
            "in": "query",
            "required": false,
            "description": "Highest initial EPC.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "future_epc_min",
            "in": "query",
            "required": false,
            "description": "Lowest future EPC.",
