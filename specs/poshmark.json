    "/poshmark/v1/listing": {
      "get": {
        "operationId": "poshmarkListing",
        "summary": "One Poshmark listing",
        "description": "One listing by id or URL: title, description, price and original price, brand, size, condition, department and category, colors, quantity, likes, comments, shares, active offers, seller, all images and videos and its dates.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/poshmark-listing",
        "tags": [
          "Poshmark"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Listing id (24 hex characters) or a poshmark.com/listing URL.",
            "schema": {
              "type": "string"
            },
            "example": "6ab1f0e518db020854d0b39d"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
