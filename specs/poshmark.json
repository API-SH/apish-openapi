    "/poshmark/v1/search": {
      "get": {
        "operationId": "poshmarkSearch",
        "summary": "Poshmark listing search",
        "description": "Search Poshmark listings: id, title, price and original price, brand, size, condition, department, category, colors, status, likes, comments, shares, seller, images and publish time. Filter by brand, size, condition, sold listings, department, category and subcategory, color and a price range; `applied_filters` echoes the filters used. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/poshmark-search",
        "tags": [
          "Poshmark"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search text; leave it out and pass brand (or department/category) to browse a brand or category.",
            "schema": {
              "type": "string"
            },
            "example": "lululemon"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), added_desc, price_asc, price_desc or like_count.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "added_desc",
                "price_asc",
                "price_desc",
                "like_count"
              ]
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand name(s), comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Size(s), comma-separated, e.g. M or 9.5.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "description": "nwt, ret, uln, ug, gd, fr or not_nwt (comma-separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sold",
            "in": "query",
            "required": false,
            "description": "true for sold listings.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Department: Women, Men, Kids, Home, Pets or Electronics.",
            "schema": {
              "type": "string",
              "enum": [
                "Women",
                "Men",
                "Kids",
                "Home",
                "Pets",
                "Electronics"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category within the department, as the site names it (e.g. Shoes, Bags, Jeans, Jackets & Coats). Needs `department`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subcategory",
            "in": "query",
            "required": false,
            "description": "Subcategory within the category (e.g. Sneakers, Athletic Shoes). Needs `category`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "color",
            "in": "query",
            "required": false,
            "description": "Color(s), comma-separated: Red, Pink, Orange, Yellow, Green, Blue, Purple, Gold, Silver, Black, Gray, White, Cream, Brown or Tan.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Listings per page, 1-100 (default 48).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pass `next_cursor` from the previous response.",
            "schema": {
              "type": "string"
            }
          },
          {
