    "/argenprop/v1/search": {
      "get": {
        "operationId": "argenpropSearch",
        "summary": "Argenprop property search",
        "description": "Apartments, houses, PH, land, premises, offices, garages, country houses, farms, warehouses and businesses for sale, rent or temporary rent on Argenprop (Argentina), with the site's filters (place, bedrooms, rooms, price range in pesos or dollars, covered and total area in m², building features, furnished, pets, professional use, pool, new) and sorts. Each result has id, link, title, address, price and currency, expenses, main features, bedrooms, rooms, bathrooms, area, description, photos, photo count and the agency; private owners are flagged without name or phone. 20 per page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/argenprop-search",
        "tags": [
          "Argenprop"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Place slug as in argenprop.com links: capital-federal, palermo, belgrano, cordoba, rosario, la-plata ... Omit for the whole country.",
            "schema": {
              "type": "string"
            },
            "example": "capital-federal"
          },
          {
            "name": "transaction",
            "in": "query",
            "required": false,
            "description": "Transaction.",
            "schema": {
