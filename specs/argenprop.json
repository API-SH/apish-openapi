    "/argenprop/v1/locations": {
      "get": {
        "operationId": "argenpropLocations",
        "summary": "Argenprop location autocomplete",
        "description": "The Argentine places Argenprop suggests for what was typed: provinces, districts, localities, neighborhoods and sub-neighborhoods, each with its level, id, name, the slug the search endpoint takes as location, its parent places, bounding box and a search link.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/argenprop-locations",
        "tags": [
          "Argenprop"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "A place name.",
            "schema": {
              "type": "string"
            },
            "example": "palermo"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "palermo",
                  "count": 18,
                  "results": [
                    {
