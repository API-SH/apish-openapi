    "/argenprop/v1/listing": {
      "get": {
        "operationId": "argenpropListing",
        "summary": "Argenprop listing",
        "description": "One Argenprop listing: listing code, title, headline, address, price and currency, expenses, main features, rooms, bedrooms, bathrooms, covered/total/land area, every feature grouped as on the page, full description, coordinates, locality and neighbourhood, photos, videos, and the agency (name, logo, agency page). A private owner's name and phone are never returned. Pass `url`, `id` or `latest=true` with search params.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/argenprop-listing",
        "tags": [
          "Argenprop"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "An argenprop.com listing link (ending in --<id>).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Listing id (the number at the end of the link).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "true: return the newest current listing of a search with the search params given alongside (keeps examples valid). Then id/url are not needed.",
            "schema": {
              "type": "boolean"
            },
            "example": "true"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "With latest=true: place slug for the search.",
            "schema": {
              "type": "string"
            },
            "example": "rosario"
          },
          {
            "name": "transaction",
            "in": "query",
            "required": false,
            "description": "With latest=true: transaction.",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent",
                "temporary_rent"
              ]
            }
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "With latest=true: property type.",
            "schema": {
              "type": "string",
              "enum": [
                "apartments",
                "houses",
                "ph",
                "land",
                "premises",
                "offices",
                "garages",
                "country_houses",
                "farms",
                "warehouses",
                "businesses"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
