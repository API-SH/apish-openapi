    "/pypi/v1/releases": {
      "get": {
        "operationId": "pypiReleases",
        "summary": "PyPI release history",
        "description": "Every release of a package, newest first: version, upload time, requires-python, yanked flag and reason, and each file with type (sdist or wheel), python and platform tags, size, upload time, hash and download link. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/pypi-releases",
        "tags": [
          "PyPI"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "Package name, or a pypi.org project URL.",
            "schema": {
              "type": "string"
            },
            "example": "requests"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Releases per page, 1-200 (default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Pass `next_page` from the previous response.",
            "schema": {
