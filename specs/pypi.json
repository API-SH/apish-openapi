    "/pypi/v1/stats": {
      "get": {
        "operationId": "pypiStats",
        "summary": "PyPI download statistics",
        "description": "Download counts for a package: last day, week and month, plus the daily series (up to 180 days) overall or broken down by Python version or operating system.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/pypi-stats",
        "tags": [
          "PyPI"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "Package name, or a pypi.org project URL.",
            "schema": {
              "type": "string"
            },
            "example": "requests"
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "Daily series: overall (default), python_major, python_minor or system.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Days of daily data to return, 1-180 (default 180).",
            "schema": {
              "type": "integer"
            },
            "example": "30"
          },
          {
            "name": "mirrors",
            "in": "query",
            "required": false,
            "description": "true or false: include or exclude mirror downloads in the overall series (default both).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
