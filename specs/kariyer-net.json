    "/kariyer/v1/search": {
      "get": {
        "operationId": "kariyerSearch",
        "summary": "Kariyer.net job search (Turkey)",
        "description": "Jobs on Kariyer.net (kariyer.net, Turkey) for a keyword, with the site's filters: city, district and country, work type, work model (on-site, remote, hybrid), position level, education level and position; sort by relevance, newest or oldest. `filters` lists every filter's ids and names. Each job: `id`, `title`, `url`, `code`, `company`, `company_id`, `company_url`, `company_logo`, `location`, `locations` (with districts), `work_type`, `work_model`, `position`, `sectors`, `easy_apply`, `sponsored`, `posted_at` and `raw`. 50 jobs a page; `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kariyer-search",
        "tags": [
          "Kariyer.net"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `yazılım`, `muhasebe`.",
            "schema": {
              "type": "string"
            },
            "example": "muhasebe"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City ids from `filters.city`, comma separated (e.g. `34` İstanbul (Avr.), `82` İstanbul (Asya), `6` Ankara, `35` İzmir).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "district",
            "in": "query",
            "required": false,
            "description": "District ids, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country ids from `filters.country`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "work_type",
            "in": "query",
            "required": false,
            "description": "Work type ids from `filters.work_type` (e.g. `1` full time, `4` part time).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "work_model",
            "in": "query",
            "required": false,
            "description": "`0` on-site, `1` remote, `2` hybrid (comma separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position_level",
            "in": "query",
            "required": false,
            "description": "Position level ids from `filters.position_level`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "education",
            "in": "query",
            "required": false,
            "description": "Education level codes from `filters.education` (e.g. `UM` university graduate).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position",
            "in": "query",
            "required": false,
            "description": "Position ids from `filters.position`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "oldest"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
