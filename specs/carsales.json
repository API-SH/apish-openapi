    "/carsales/v1/search": {
      "get": {
        "operationId": "carsalesSearch",
        "summary": "Search carsales cars",
        "description": "carsales (Australia) car search with every filter the site offers: listing id and link, title, variant, make, model, year, price, price type (drive away, excl. government charges), price rating (good / great / fair price), odometer, key details (body, engine, transmission), condition, ad type, state, seller type, dealer name and id (not for private sellers), promoted flag, badges and photos; `total` is the number of matching cars. About 20 cars a page (promoted ones included) with `page` and `pages`; pass `next_cursor` back as `cursor` (with the same filters) for the next page; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/carsales-search",
        "tags": [
          "carsales"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "make",
            "in": "query",
            "required": false,
            "description": "Make, e.g. Mazda.",
            "schema": {
              "type": "string"
            },
            "example": "Mazda"
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Model, e.g. CX-5 (with make).",
            "schema": {
              "type": "string"
            },
            "example": "CX-5"
          },
          {
            "name": "badge",
            "in": "query",
            "required": false,
            "description": "Badge / trim, e.g. Maxx.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "NSW, VIC, QLD, WA, SA, TAS, ACT or NT.",
            "schema": {
              "type": "string",
              "enum": [
                "NSW",
                "VIC",
                "QLD",
                "WA",
                "SA",
                "TAS",
                "ACT",
                "NT"
              ]
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "A region, e.g. Melbourne.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "body",
            "in": "query",
            "required": false,
            "description": "Body type, e.g. SUV, Sedan, Ute.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fuel",
            "in": "query",
            "required": false,
            "description": "Fuel type, e.g. Diesel, Hybrid.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transmission",
            "in": "query",
            "required": false,
            "description": "automatic or manual.",
            "schema": {
              "type": "string",
              "enum": [
                "automatic",
                "manual"
              ]
            }
          },
          {
            "name": "seller_type",
            "in": "query",
            "required": false,
            "description": "dealer or private.",
            "schema": {
              "type": "string",
              "enum": [
                "dealer",
                "private"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in AUD.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in AUD.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_min",
            "in": "query",
            "required": false,
            "description": "Earliest year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_max",
            "in": "query",
            "required": false,
            "description": "Latest year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "km_min",
            "in": "query",
            "required": false,
            "description": "Lowest odometer reading in km.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "km_max",
            "in": "query",
            "required": false,
            "description": "Highest odometer reading in km.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "A keyword in the listing (e.g. turbo).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "description": "A raw carsales search expression such as (And.Service.carsales._.Make.Mazda.), instead of the filters.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: featured (default), price_asc, price_desc, year_desc, year_asc, km_asc, km_desc, newest.",
            "schema": {
              "type": "string",
              "enum": [
                "featured",
                "price_asc",
                "price_desc",
                "year_desc",
                "year_asc",
                "km_asc",
                "km_desc",
                "newest"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "The `next_cursor` of the previous page (pages follow on from it; start again without it).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "(And.Service.carsales._.Make.Mazda._.Model.CX-5.)",
                  "applied_filters": {
