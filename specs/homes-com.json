    "/homes-com/v1/search": {
      "get": {
        "operationId": "homesComSearch",
        "summary": "Homes.com home search",
        "description": "Homes for sale, for rent or recently sold on Homes.com in a US city, ZIP, neighborhood, county or state, with the site's filters: property type, minimum and maximum bedrooms, price range, open houses and newest first. Each result has the property id, listing key, link, status, price, property type, beds, baths, size, address, photo and photo count, brokerage, the listing agents (name, title, phone, company, profile link), a summary line and description. `total` is the site's match count. 40 per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/homes-com-search",
        "tags": [
          "Homes.com"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "description": "Place: a Homes.com path such as austin-tx, austin-tx/78729, austin-tx/pemberton-heights-neighborhood, travis-county-tx or texas, a homes.com search link, or \"Austin, TX\".",
            "schema": {
              "type": "string"
            },
            "example": "austin-tx"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Listing status.",
            "schema": {
              "type": "string",
              "enum": [
                "for_sale",
                "rent",
                "sold"
              ]
            },
            "example": "for_sale"
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Property type (for sale: house, townhouse, condo, land, mobile_home; for rent: house, apartment, townhouse, condo).",
            "schema": {
              "type": "string",
              "enum": [
                "house",
                "townhouse",
                "condo",
                "land",
                "mobile_home",
                "apartment"
              ]
            }
          },
          {
            "name": "beds_min",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms (0 to 6).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "beds_max",
            "in": "query",
            "required": false,
            "description": "Maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price or monthly rent (USD).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price or monthly rent (USD).",
            "schema": {
              "type": "number"
            },
            "example": "600000"
          },
          {
            "name": "open_house",
            "in": "query",
            "required": false,
            "description": "Only homes with an upcoming open house (for sale).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest"
              ]
            },
            "example": "relevance"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Result page (1 = first).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
