    "/mytheresa/v1/search": {
      "get": {
        "operationId": "mytheresaSearch",
        "summary": "Mytheresa product search and listings",
        "description": "Search Mytheresa products by keywords, or list a category or designer page (e.g. /clothing/dresses, /bags, /designers/gucci), with every filter the store offers (designers, colors, materials, patterns, sizesGrouped, sleeve, saleStatus and the page's other facets; comma list = any of) and four sort orders, in any country store and section. Each product: code, name, designer, colour, price, original price, discount, currency, VAT and duties notes, stock, labels, promotions, every size with its harmonized size, price and stock hint, images and link, plus `raw`; also the facets with counts. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/mytheresa-search",
        "tags": [
          "Mytheresa"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords. Either q or category is required.",
            "schema": {
              "type": "string"
            },
            "example": "gucci bag"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A listing path such as /clothing/dresses or /designers/gucci, or its link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Store country (prices, currency and duties follow it). Default US.",
            "schema": {
              "type": "string",
              "enum": [
                "US",
                "GB",
                "DE",
                "FR",
                "IT",
                "CH",
                "NL",
                "AT",
                "ES",
                "BE",
                "IE",
                "JP",
                "HK",
                "AU",
                "SG",
                "AE",
                "CN",
                "CA",
                "KR"
              ]
            }
          },
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "Shop section.",
            "schema": {
              "type": "string",
              "enum": [
                "women",
                "men",
                "kids",
                "life"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "recommendation",
                "new_item",
                "price_asc",
                "price_desc"
              ]
            }
          },
          {
            "name": "designers",
            "in": "query",
            "required": false,
            "description": "Designer name(s) as listed in filters, e.g. Gucci.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "colors",
            "in": "query",
            "required": false,
            "description": "Colour(s), e.g. black,blue.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "materials",
            "in": "query",
            "required": false,
            "description": "Material(s).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "patterns",
            "in": "query",
            "required": false,
            "description": "Pattern(s).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sizesGrouped",
            "in": "query",
            "required": false,
            "description": "Size id(s) from filters, e.g. Clothing|US 4.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sleeve",
            "in": "query",
            "required": false,
            "description": "Sleeve type(s).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "saleStatus",
            "in": "query",
            "required": false,
            "description": "sale to show reduced items.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Products per page (default 60, max 120).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": null,
                  "category": "/clothing/dresses",
                  "name": "Dresses",
                  "country": "US",
                  "store": "us",
                  "section": "women",
                  "sort": "recommendation",
                  "page": 1,
                  "applied_filters": {},
                  "total": 7207,
                  "pages": 121,
                  "count": 60,
                  "next_page": 2,
                  "breadcrumb": [
                    {
                      "name": "Women",
                      "slug": "/women"
                    },
                    {
                      "name": "Clothing",
                      "slug": "/women/clothing"
                    },
                    "… 1 more"
                  ],
                  "products": [
                    {
                      "id": "P01246581",
                      "name": "Ruched corset dress",
                      "designer": "Magda Butrym",
                      "colour": "brown",
                      "price": 2675,
                      "original_price": 2675,
                      "discount_percent": "0%",
                      "currency": "USD",
                      "includes_vat": false,
                      "price_note": "",
                      "in_stock": true,
                      "coming_soon": false,
                      "labels": [
                        "new",
                        "new season"
                      ],
                      "promotions": [],
                      "sizes": [
