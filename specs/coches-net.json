                "relevance",
                "price_asc",
                "price_desc",
                "km_asc",
                "km_desc",
                "year_desc",
                "year_asc",
                "hp_desc",
                "hp_asc",
                "title"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
