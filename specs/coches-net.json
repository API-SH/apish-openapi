    "/cochesnet/v1/search": {
      "get": {
        "operationId": "cochesnetSearch",
        "summary": "coches.net car search",
        "description": "Used and km 0 cars on coches.net, Spain's largest car marketplace, with every filter the site offers: keywords, make and model ids, price, monthly payment, kilometres, year, power, doors, seats, engine size, electric range and battery, fuel, gearbox, body type, colour, driven wheels, environmental label, equipment, province, seller type, warranty, certified, with photos, price drops, reservation, stock, and sort. Any other filter of the site's search links is accepted under its own name (e.g. `ArrBodyType`, `Fueltype2List`, `locationLat`/`locationLong`/`locationDistance`). Each car has make, model, version, year, km, hp, fuel, gearbox, colour, label, price, price drop, the site's price rating and average price, location, seller type (business phone for dealers), flags and photos, plus `raw`. `facets` gives live counts per make, model, fuel, body type and province. About 30 cars a page; pass `next_page` back as `page` (null on the last page).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cochesnet-search",
        "tags": [
          "coches.net"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "`used` (default) or `km0`.",
            "schema": {
              "type": "string",
              "enum": [
                "used",
                "km0"
              ]
            }
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `golf gti`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "make_id",
            "in": "query",
            "required": false,
            "description": "Make ids, comma separated (from /cochesnet/v1/makes), e.g. `7` for BMW.",
            "schema": {
              "type": "string"
            },
            "example": "7"
          },
          {
            "name": "model_id",
            "in": "query",
            "required": false,
            "description": "Model ids, comma separated (from /cochesnet/v1/makes).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price in EUR.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price in EUR.",
            "schema": {
              "type": "integer"
            },
            "example": "15000"
          },
          {
            "name": "monthly_payment_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly payment in EUR.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "monthly_payment_max",
            "in": "query",
            "required": false,
            "description": "Maximum monthly payment in EUR.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "km_min",
            "in": "query",
            "required": false,
            "description": "Kilometres from.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "km_max",
            "in": "query",
            "required": false,
            "description": "Kilometres to.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_min",
            "in": "query",
            "required": false,
            "description": "Year from.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_max",
            "in": "query",
            "required": false,
            "description": "Year to.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hp_min",
            "in": "query",
            "required": false,
            "description": "Power (hp) from.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hp_max",
            "in": "query",
            "required": false,
            "description": "Power (hp) to.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "doors_min",
            "in": "query",
            "required": false,
            "description": "Doors from.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "doors_max",
            "in": "query",
            "required": false,
            "description": "Doors to.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "seats_min",
            "in": "query",
            "required": false,
            "description": "Seats from.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "seats_max",
            "in": "query",
            "required": false,
            "description": "Seats to.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "electric_range_min",
            "in": "query",
            "required": false,
            "description": "Electric range (km) from.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fuel_id",
            "in": "query",
            "required": false,
            "description": "Fuel ids, comma separated: 1 diesel, 2 petrol, 3 electric, 4 hybrid, 5 plug-in hybrid, 6 LPG, 7 CNG, 8 other.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transmission_id",
            "in": "query",
            "required": false,
            "description": "Gearbox: 1 automatic, 2 manual.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "body_type_id",
            "in": "query",
            "required": false,
            "description": "Body type ids, comma separated: 1 saloon, 2 coupe, 3 convertible, 4 estate, 5 people carrier, 6 SUV/4x4, 7 pick-up, 8 van.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "color_id",
            "in": "query",
            "required": false,
            "description": "Colour id: 1 yellow, 2 blue, 3 beige, 4 white, 5 maroon, 6 grey/silver, 7 brown, 8 orange, 9 black, 10 red, 11 pink, 12 green, 13 purple.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "province_id",
            "in": "query",
            "required": false,
            "description": "Province ids, comma separated (Spanish INE codes, e.g. 28 Madrid, 8 Barcelona).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "environmental_label",
            "in": "query",
            "required": false,
            "description": "Environmental labels, comma separated: `0`, `ECO`, `C`, `B`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "seller_type",
            "in": "query",
            "required": false,
            "description": "Only private sellers or dealers.",
            "schema": {
              "type": "string",
              "enum": [
                "private",
                "professional"
              ]
            }
          },
          {
            "name": "with_warranty",
            "in": "query",
            "required": false,
            "description": "`true`: only cars with a warranty.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "certified",
            "in": "query",
            "required": false,
            "description": "`true`: only certified cars.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "price_drop",
            "in": "query",
            "required": false,
            "description": "`true`: only cars whose price dropped.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "with_photo",
            "in": "query",
            "required": false,
            "description": "`true`: only ads with photos.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
