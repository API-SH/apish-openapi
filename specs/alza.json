    "/alza/v1/reviews": {
      "get": {
        "operationId": "alzaReviews",
        "summary": "Alza product reviews",
        "description": "Customer reviews of one Alza product, newest first: rating, reviewer name and town, date, variant, text, pros and cons, likes, verified-purchase note, translated flag, photos and the shop's reply. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/alza-reviews",
