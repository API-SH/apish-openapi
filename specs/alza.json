    "/alza/v1/product": {
      "get": {
        "operationId": "alzaProduct",
        "summary": "Alza product",
        "description": "One Alza product: name, order code, manufacturer and supplier codes, price with and without VAT, original price, discount and price label, lowest-price note, instalment price, stock, availability and delivery, maximum quantity, units sold, warranty, category and breadcrumb, every parameter group (display, memory, camera...), labels and promotions, rating with the 5-to-1 star distribution, recommendation and complaint rates, purchase count, all images, documents (product fiche, manuals) and accessories.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/alza-product",
        "tags": [
          "Alza"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The number after -d in an alza.cz/<name>-d<id>.htm link (e.g. 13078770), or that link.",
            "schema": {
              "type": "string"
            },
            "example": "13078770"
          },
