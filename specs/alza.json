          "Alza"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "A category number (e.g. 18843445 for mobile phones) or an alza.cz category link ending in <number>.htm.",
            "schema": {
              "type": "string"
            },
            "example": "18843445"
          },
          {
            "name": "page",
