    "/hemnet/v1/search": {
      "get": {
        "operationId": "hemnetSearch",
        "summary": "Hemnet homes for sale",
        "description": "Search homes for sale (and upcoming) in Sweden on Hemnet with the site's filters: locations, housing form (houses, row houses, apartments, vacation homes, plots, homesteads, others), price, rooms, living area, land area, monthly fee, construction year, price per m², distance to water or sea, balcony, elevator, new construction, foreclosure, bidding started, hide removed before showing, ownership only, published within, status, keywords and sort order. Each home: id, slug, address, area, housing form, asking price, rooms, living area, land area, fee, price per m², published date, showings, labels, coordinates, broker and agency, images, description, link and `raw`. 50 per page; pass `next_page` back as `page` (the site serves up to 50 pages).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/hemnet-search",
        "tags": [
          "Hemnet"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location_ids",
            "in": "query",
            "required": false,
            "description": "Comma-separated location ids from /hemnet/v1/locations (e.g. 17744 = Stockholms län). Empty: all of Sweden.",
            "schema": {
              "type": "string"
            },
            "example": "17744"
          },
          {
            "name": "housing_form",
            "in": "query",
            "required": false,
            "description": "Comma-separated: houses, row_houses, apartments, vacation_homes, plots, homesteads, others.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum asking price (SEK).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum asking price (SEK).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "rooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum rooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "rooms_max",
            "in": "query",
            "required": false,
            "description": "Maximum rooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "living_area_min",
            "in": "query",
            "required": false,
            "description": "Minimum living area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "living_area_max",
            "in": "query",
            "required": false,
            "description": "Maximum living area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "land_area_min",
            "in": "query",
            "required": false,
            "description": "Minimum land area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fee_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly fee (SEK).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "fee_max",
            "in": "query",
            "required": false,
            "description": "Maximum monthly fee (SEK).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "construction_year_min",
            "in": "query",
            "required": false,
            "description": "Built in or after.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "construction_year_max",
            "in": "query",
            "required": false,
            "description": "Built in or before.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "m2_price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price per m².",
            "schema": {
              "type": "integer"
            }
          },
