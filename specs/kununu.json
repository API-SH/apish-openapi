    "/kununu/v1/search": {
      "get": {
        "operationId": "kununuSearch",
        "summary": "kununu company search",
        "description": "Companies on kununu (the employer review site of Germany, Austria and Switzerland) matching a name: name, `slug`, country, id, city, logo and link. Pass `slug` and `country` to the other kununu endpoints. `country` puts that country's companies first.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kununu-search",
        "tags": [
          "kununu"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Company name or part of it, e.g. `siemens`.",
            "schema": {
              "type": "string"
            },
            "example": "siemens"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Put companies of this country first.",
            "schema": {
              "type": "string",
              "enum": [
                "de",
                "at",
                "ch"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of companies (1-50, default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
