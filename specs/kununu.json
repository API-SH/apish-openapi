    "/kununu/v1/reviews": {
      "get": {
        "operationId": "kununuReviews",
        "summary": "kununu employee reviews",
        "description": "Employee, applicant or apprentice reviews of a company on kununu: title, score, recommended, former employee, position, department, published and updated dates, ratings and texts by category, location, employer responses and reactions; plus the company's score, recommendation rate, review counts and score ranges. Logged out, kununu shows the first page (10 reviews) of each review type and sort, so `next_page` is null: use `type` and `sort` (newest, oldest, best, worst, helpful) to read different reviews.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kununu-reviews",
        "tags": [
          "kununu"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "description": "The company's kununu name (e.g. `sap`, `siemens`, `deutsche-bahn`; `slug` in /kununu/v1/search) or a kununu.com/<country>/<company> link.",
            "schema": {
              "type": "string"
            },
            "example": "sap"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "The kununu site the company is on.",
            "schema": {
              "type": "string",
              "enum": [
                "de",
                "at",
                "ch"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Whose reviews.",
            "schema": {
              "type": "string",
              "enum": [
                "employees",
                "candidates",
                "apprentices"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
