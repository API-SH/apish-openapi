    "/zonaprop/v1/search": {
      "get": {
        "operationId": "zonapropSearch",
        "summary": "Zonaprop property search",
        "description": "Argentine property listings (sale, rent, temporary rent) with every filter the site offers: property type and apartment subtype, location id or a free-text place or keyword, price range in USD or ARS, monthly expenses, rooms, bedrooms, bathrooms, parking, covered or total area, age, publication date, publisher type (agency or owner), amenities, property features, room types, services, disposition, media, agency, and sort. Each listing has prices per operation, expenses, areas, rooms, bedrooms, bathrooms, parking, features, description, address, location path with ids, coordinates, publisher, media flags and photos, plus `raw`. 30 a page; pass `next_page` back as `page` (null on the last page). Listings return `location_id` and `location_path` ids to reuse as `location_id`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/zonaprop-search",
        "tags": [
          "Zonaprop"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "operation",
            "in": "query",
            "required": false,
            "description": "sale, rent or temporary (default sale).",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent",
                "temporary"
              ]
            },
            "example": "sale"
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Property type (default apartment).",
            "schema": {
              "type": "string",
              "enum": [
                "apartment",
                "house",
                "ph",
                "land",
                "retail",
                "farm",
                "country_house",
                "office",
                "garage",
                "warehouse",
                "business",
                "hotel",
                "storage",
                "burial_plot",
                "boat_slip",
                "consulting_room",
                "building",
                "horizontal_development",
                "vertical_development"
              ]
            },
            "example": "apartment"
          },
          {
            "name": "property_subtype",
            "in": "query",
            "required": false,
            "description": "Apartment subtype.",
            "schema": {
              "type": "string",
              "enum": [
                "standard",
                "semi_floor",
                "full_floor",
                "duplex",
                "studio",
                "apartaestudio",
                "loft",
                "penthouse",
                "triplex"
              ]
            }
          },
          {
            "name": "location_id",
            "in": "query",
            "required": false,
            "description": "A Zonaprop location id: V1-B-<n> province or city, V1-C-<n> neighbourhood, V1-D-<n> zone (from a listing's `location_path`).",
            "schema": {
              "type": "string"
            },
            "example": "V1-C-1003652"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Free text: a place (e.g. palermo) or a keyword (e.g. pileta).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price.",
            "schema": {
              "type": "integer"
            },
            "example": "100000"
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price.",
            "schema": {
              "type": "integer"
            },
            "example": "300000"
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Price currency (default USD).",
            "schema": {
              "type": "string",
              "enum": [
                "USD",
                "ARS"
              ]
            }
          },
          {
            "name": "expenses_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly expenses (ARS).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "expenses_max",
            "in": "query",
            "required": false,
            "description": "Maximum monthly expenses (ARS).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "rooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum rooms (ambientes).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "rooms_max",
            "in": "query",
            "required": false,
            "description": "Maximum rooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bedrooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms.",
            "schema": {
              "type": "integer"
            },
            "example": "2"
          },
          {
            "name": "bedrooms_max",
            "in": "query",
            "required": false,
            "description": "Maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bathrooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum bathrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "parking_min",
            "in": "query",
            "required": false,
            "description": "Parking: none, 1, 2, 3 or 4 (or more).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "area_min",
            "in": "query",
            "required": false,
            "description": "Minimum area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "area_max",
            "in": "query",
            "required": false,
            "description": "Maximum area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "area_type",
            "in": "query",
            "required": false,
            "description": "Which area the range applies to (default covered).",
            "schema": {
              "type": "string",
              "enum": [
                "covered",
                "total"
              ]
            }
          },
          {
            "name": "age",
            "in": "query",
            "required": false,
            "description": "Building age.",
            "schema": {
              "type": "string",
              "enum": [
                "under_construction",
                "new",
                "up_to_5",
                "up_to_10",
                "up_to_20",
                "up_to_50",
                "over_50"
              ]
            }
          },
          {
            "name": "published_within",
            "in": "query",
            "required": false,
            "description": "Published within.",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "1d",
                "7d",
                "15d",
                "30d",
                "45d"
              ]
            }
          },
          {
            "name": "publisher_type",
            "in": "query",
            "required": false,
            "description": "Publisher (default all).",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "agency",
                "owner"
              ]
            }
          },
          {
            "name": "amenities",
            "in": "query",
            "required": false,
            "description": "Comma separated: pool, grill, doorman, security, elevator, sports_court, gym, laundry, quincho, solarium, sum.",
            "schema": {
              "type": "string"
            },
            "example": "pool"
          },
          {
            "name": "features",
            "in": "query",
            "required": false,
            "description": "Comma separated: mortgage_eligible, professional_use, accessible, bright, financing, pets_allowed.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "room_types",
            "in": "query",
            "required": false,
            "description": "Comma separated: kitchen, living_dining, balcony, laundry_room, guest_toilet, service_room, ensuite, garden, patio, terrace, walk_in_closet.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "services",
            "in": "query",
            "required": false,
            "description": "Comma separated: electricity, water, natural_gas, heating.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "disposition",
            "in": "query",
            "required": false,
            "description": "Unit position.",
            "schema": {
              "type": "string",
              "enum": [
                "back",
                "front",
                "interior",
                "side"
              ]
            }
          },
          {
            "name": "media",
            "in": "query",
            "required": false,
            "description": "Comma separated: tour_360, video, floor_plans.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agency_id",
            "in": "query",
            "required": false,
            "description": "Only this agency's listings (publisher id, or a zonaprop.com.ar/inmobiliarias/ link).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default relevance).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_low",
                "price_high",
                "newest",
                "most_viewed",
                "price_lowered"
              ]
            },
            "example": "price_low"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page (30 a page).",
            "schema": {
              "type": "integer",
              "default": "1"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
