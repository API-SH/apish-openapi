    "/bezrealitky/v1/search": {
      "get": {
        "operationId": "bezrealitkySearch",
        "summary": "Bezrealitky property search",
        "description": "Flats, houses, land, garages, offices, commercial and recreational property for sale or rent on Bezrealitky, the Czech owners-only portal, with the site's filters: place, layout (2+kk, 3+1 ...), price, area, land area, land type, ownership, building type, condition, furnishing, balcony, terrace, loggia, cellar, front garden, parking, garage, lift, pets, barrier-free, low-energy, discounted and roommate listings, sorted newest first (default), by price or by area (`sort`). Each result has id, link, title, offer and property type, layout, price and currency, charges, price before a discount and the drop, area, land area, price per m² (`price_per_m2`), address, coordinates, tags, mortgage estimate, developer project, photos and videos. 15 per page. Listings are posted by private owners, whose names and contact details are never returned. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bezrealitky-search",
        "tags": [
          "Bezrealitky"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Place slug as used in bezrealitky.cz search links: a city (praha, brno, ostrava), a district (praha-praha-5) or a region (jihomoravsky-kraj). Omit for the whole Czech Republic.",
            "schema": {
              "type": "string"
            },
            "example": "praha"
          },
          {
            "name": "offer",
            "in": "query",
            "required": false,
            "description": "sale or rent.",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent"
              ]
            },
            "example": "sale"
          },
          {
            "name": "estate_type",
            "in": "query",
            "required": false,
            "description": "Property type.",
            "schema": {
              "type": "string",
              "enum": [
                "flat",
                "house",
                "land",
                "garage",
                "office",
                "commercial",
                "recreational"
              ]
            },
            "example": "flat"
          },
          {
            "name": "disposition",
            "in": "query",
            "required": false,
            "description": "Layouts, comma-separated: 1+kk, 1+1, 2+kk, 2+1 ... 7+1 (kk = kitchenette).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (CZK).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price (CZK).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "area_min",
            "in": "query",
            "required": false,
            "description": "Minimum floor area (m²).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "area_max",
            "in": "query",
            "required": false,
            "description": "Maximum floor area (m²).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "land_min",
            "in": "query",
            "required": false,
            "description": "Minimum land area (m²).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "land_max",
            "in": "query",
            "required": false,
            "description": "Maximum land area (m²).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "land_type",
            "in": "query",
            "required": false,
            "description": "Land types, comma-separated: building, garden, field, meadow, forest, pond, commercial, other.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ownership",
            "in": "query",
            "required": false,
            "description": "Ownership, comma-separated: personal, cooperative, municipal, other.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "construction",
            "in": "query",
            "required": false,
            "description": "Building types, comma-separated: brick, panel, mixed, prefab, skeleton, stone, wood.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "description": "Conditions, comma-separated: new, very_good, good, bad, after_reconstruction, after_partial_reconstruction, before_reconstruction, in_reconstruction, under_construction, project, demolition.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "equipped",
            "in": "query",
            "required": false,
            "description": "Furnishing, comma-separated: furnished, partly, unfurnished.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "balcony",
            "in": "query",
            "required": false,
            "description": "true: with a balcony.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "terrace",
            "in": "query",
            "required": false,
            "description": "true: with a terrace.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "loggia",
            "in": "query",
            "required": false,
            "description": "true: with a loggia.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "cellar",
            "in": "query",
            "required": false,
            "description": "true: with a cellar.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "front_garden",
            "in": "query",
            "required": false,
            "description": "true: with a front garden.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "parking",
            "in": "query",
            "required": false,
            "description": "true: with parking.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "garage",
            "in": "query",
            "required": false,
            "description": "true: with a garage.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "lift",
            "in": "query",
            "required": false,
            "description": "true: with a lift.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "pet_friendly",
            "in": "query",
            "required": false,
            "description": "true: pets allowed.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "barrier_free",
            "in": "query",
            "required": false,
            "description": "true: barrier-free.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "low_energy",
            "in": "query",
            "required": false,
            "description": "true: low-energy buildings.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "discounted",
            "in": "query",
            "required": false,
            "description": "true: only listings whose price was cut.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "roommate",
            "in": "query",
            "required": false,
            "description": "true: rooms in shared flats.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order of results; newest (default), price_asc, price_desc, area_asc or area_desc.",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "price_asc",
                "price_desc",
                "area_asc",
                "area_desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Results page (1 = first). Pass `next_page` back here.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
