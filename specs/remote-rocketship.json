    "/remoterocketship/v1/search": {
      "get": {
        "operationId": "remoterocketshipSearch",
        "summary": "Remote Rocketship job search",
        "description": "Jobs on Remote Rocketship, collected from company career pages, with every filter of the site's board: keywords (and excluded keywords), job titles, seniority, location (countries, regions such as Europe or Worldwide, and US states), cities, remote/hybrid/on-site, tech stack, required languages, company size, employment type, visa sponsorship, minimum salary, degree requirement, LinkedIn listing, ghost-job filter, industries (and excluded industries), one company, sorted by newest or highest salary. Each job: `id`, `slug`, `title`, `url`, `apply_url`, `created_at`, summaries, job title category and function, `seniority`, `employment_type`, `workplace`, location fields, `salary`, `tech_stack`, `required_languages`, `education`, `ghost_score` and the company (id, name, slug, logo, size, industries, website, H1B sponsor), plus `raw`. `total` is the number of matching jobs. Logged out the site answers the first 20 jobs of a search, so this returns the newest (or best-paid) 20; `next_page` is always null.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/remoterocketship-search",
        "tags": [
          "Remote Rocketship"
        ],
        "x-credits": 1,
