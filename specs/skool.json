    "/skool/v1/posts": {
      "get": {
        "operationId": "skoolPosts",
        "summary": "Community posts",
        "description": "A public Skool community's feed: posts with title, text, likes, comments, category, pinned flag, image or video, author and dates, plus the community's categories. Private communities answer 403. Pass `next_page` back as `page`, null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/skool-posts",
        "tags": [
          "Skool"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "group",
            "in": "query",
            "required": true,
            "description": "Community name in skool.com/<group>, or that link (in `url`).",
            "schema": {
              "type": "string"
            },
            "example": "ai-automation-society"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A skool.com community link instead of group.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Feed order: default (the site's), newest activity, or newest posts.",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "newest",
                "new_posts"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category id (from categories).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (30 a page).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/skool/v1/search": {
      "get": {
        "operationId": "skoolSearch",
        "summary": "Skool community search",
        "description": "Communities in Skool's public directory for keywords, category, type (free or paid) and language: id, slug, name, description, members, price (amount, currency, interval), free flag, rating and review count, logo, cover, created/updated dates and the about-page link. 30 per page; `total` is the directory's count (it lists up to 1,000). Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/skool-search",
        "tags": [
          "Skool"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `marketing`.",
            "schema": {
              "type": "string"
            },
            "example": "marketing"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug, e.g. `hobbies`, `music`, `money`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "free or paid.",
            "schema": {
              "type": "string",
              "enum": [
                "free",
                "paid"
              ]
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Language name, e.g. `english`, `spanish`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-50). Pass `next_page` from the previous response.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
