    "/hitta/v1/search": {
      "get": {
        "operationId": "hittaSearch",
        "summary": "Hitta.se business search",
        "description": "Search Swedish businesses on Hitta.se: name, link, phone numbers, email, categories, street address, postcode, city, district, municipality, county, position, rating and review count, number of offices and products. Add a place with `where` (e.g. `Stockholm`); without one the whole of Sweden is searched. 25 per page; `total` is the number of matches. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/hitta-search",
