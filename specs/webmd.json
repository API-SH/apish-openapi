    "/webmd/v1/drug-reviews": {
      "get": {
        "operationId": "webmdDrugReviews",
        "summary": "WebMD drug reviews",
        "description": "Patient reviews of a drug on WebMD: each review's id, screen name, date, condition, overall rating and effectiveness, ease of use and satisfaction (1-5), text, reviewer type, age range, gender, time on the drug and helpful votes; plus the overall rating, the star breakdown per criterion and the conditions with review counts. Filter by `condition_id`, sort. 20 a page; pass `next_page` back as `page`, null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 2 credits per successful call. Docs: https://api.sh/docs/webmd-drug-reviews",
        "tags": [
          "WebMD"
        ],
        "x-credits": 2,
        "parameters": [
          {
            "name": "drug",
            "in": "query",
            "required": true,
            "description": "`reviews_slug` from /webmd/v1/drug, a reviews link, or the drug slug.",
            "schema": {
              "type": "string"
            },
            "example": "drugreview-lisinopril-prinivil-zestril-and-others"
          },
          {
            "name": "condition_id",
            "in": "query",
            "required": false,
            "description": "Condition id from `conditions`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "most_recent (default), most_helpful, highest_rating, high_satisfaction or low_satisfaction.",
            "schema": {
              "type": "string",
              "enum": [
                "most_recent",
                "most_helpful",
                "highest_rating",
                "high_satisfaction",
                "low_satisfaction"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
