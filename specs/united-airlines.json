    "/united/v1/airports": {
      "get": {
        "operationId": "unitedAirports",
        "summary": "United airport search",
        "description": "Airports and city groups matching a city, airport name or code, as United's search box shows them: code, city code, name, display name, state, country, and whether the entry is an all-airports city group.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/united-airports",
        "tags": [
          "United Airlines"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "City, airport name or code (2+ characters).",
            "schema": {
              "type": "string"
            },
            "example": "chicago"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "chicago",
                  "count": 3,
                  "airports": [
                    {
                      "code": "ORD",
                      "city_code": "CHI",
                      "name": "Chicago, IL, US (ORD - O'Hare)",
                      "display_name": "Chicago, IL, US (ORD)",
                      "state": "IL",
                      "country_code": "US",
                      "country": "United States",
                      "all_airports": false
                    },
                    {
                      "code": "CHI",
                      "city_code": "CHI",
                      "name": "Chicago, IL, US (All Airports)",
                      "display_name": "Chicago, IL, US (All Airports)",
                      "state": "IL",
                      "country_code": "US",
                      "country": "United States",
                      "all_airports": true
                    },
                    "… 1 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
