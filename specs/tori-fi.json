    "/tori/v1/seller": {
      "get": {
        "operationId": "toriSeller",
        "summary": "Tori shop and its ads",
        "description": "A business seller (shop) on Tori and every ad it has up: with an ad id the shop's name, phone, website, address, logo, profile page and company lookup link; then its ads with price, location, coordinates, date, photos and labels, and the total. Private sellers have no public list of ads. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/tori-seller",
        "tags": [
          "Tori.fi"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "One of the shop's ads (id or link): gives the shop profile too.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "An ad link instead of id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "org_id",
            "in": "query",
            "required": false,
            "description": "The shop's organisation id instead of an ad.",
            "schema": {
              "type": "string"
            },
            "example": "6735364"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
