    "/tori/v1/search": {
      "get": {
        "operationId": "toriSearch",
        "summary": "Search Tori.fi ads",
        "description": "Tori.fi (tori.fi) marketplace ads for a keyword with category, location, radius around a point, price, condition, seller type, trade type, shipping, published today and sort, plus any other filter the site lists in `filters` (pass as `filters=name:value`). Each result has price (EUR), location and coordinates, published time, photos, labels and, for business sellers, the shop name. Private sellers' names, phone numbers and email addresses are never returned (masked in ad text).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/tori-search",
        "tags": [
          "Tori.fi"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords.",
            "schema": {
              "type": "string"
            },
            "example": "sohva"
          },
          {
            "name": "vertical",
            "in": "query",
            "required": false,
            "description": "marketplace (the only vertical on Tori).",
            "schema": {
              "type": "string",
              "enum": [
                "marketplace"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category value(s) from `filters` (e.g. 0.93), comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Location value(s) from `filters`, comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude for a radius search (with lng).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "description": "Longitude (with lat).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "description": "Radius in km (default 10).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (EUR).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price (EUR).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "description": "Condition 1 (new) .. 5, comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "seller_type",
            "in": "query",
            "required": false,
            "description": "private or business.",
            "schema": {
              "type": "string",
              "enum": [
                "private",
                "business"
              ]
            }
          },
          {
            "name": "trade_type",
            "in": "query",
            "required": false,
            "description": "Ad type.",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "giveaway",
                "wanted"
              ]
            }
          },
          {
            "name": "shipping",
            "in": "query",
            "required": false,
            "description": "true: only ads with shipping.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "published_today",
            "in": "query",
            "required": false,
            "description": "true: only ads published today.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "Any other site filter as name:value, comma-separated (names and values from `filters`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "price_asc",
                "price_desc",
                "closest"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Results page, 1 for the first. Pass back `next_page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
