    "/tori/v1/listing": {
      "get": {
        "operationId": "toriListing",
        "summary": "Tori.fi ad details",
        "description": "One Tori.fi marketplace ad: price, trade type, condition, full description, every attribute, category path, location (postcode, place, coordinates), photos, last edit, shipping options and, for business sellers, the shop profile. Pass `id`, `url`, or `latest=1` with search params. Private sellers' names, phone numbers and email addresses are never returned (masked in ad text).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/tori-listing",
        "tags": [
          "Tori.fi"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Tori.fi ad id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Tori.fi ad url.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`1`: open the first current result of a search made with this route's search params (q, location and filters) instead of an id. Ads expire, so this keeps a link working.",
            "schema": {
              "type": "string"
            },
            "example": "1"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search keywords (with latest=1).",
            "schema": {
              "type": "string"
            },
            "example": "sohva"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Location value (with latest=1).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "seller_type",
            "in": "query",
            "required": false,
            "description": "With latest=1.",
            "schema": {
              "type": "string",
              "enum": [
                "private",
                "business"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "49438540",
                  "url": "https://www.tori.fi/recommerce/forsale/item/49438540",
                  "title": "Vaalea 3 istuttava suuri sohva",
                  "description": "Halvalla lähtee.Irroitettavat istuin tyynyt ja 4 selkä tyynyä.Lieviä käytön jälkiä.Haku paikanpäältä ja tinkausvara.",
                  "price": 100,
