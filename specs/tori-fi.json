                      "name": "Auto-, vene- ja moottoripyörätarvikkeet",
                      "level": "category",
                      "listings": 331969,
                      "children": [
                        {
                          "id": "1.90.70",
                          "name": "Asuntoauto- ja matkailuautotarvikkeet",
                          "level": "sub_category",
                          "listings": 4878
                        },
                        {
                          "id": "1.90.82",
                          "name": "Auton osat",
                          "level": "sub_category",
                          "listings": 229965,
                          "children": [
                            {
                              "…": "4 fields"
                            },
                            {
                              "…": "4 fields"
                            },
                            "… 6 more"
