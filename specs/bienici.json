                  "deposit": null,
                  "area_m2": 123.76,
                  "land_m2": null,
                  "rooms": 4,
                  "bedrooms": 2,
                  "bathrooms": null,
                  "toilets": null,
                  "floor": 3,
                  "floors": 6,
                  "year_built": null,
                  "exposition": "Nord",
                  "energy": {
                    "class": "D",
                    "value": 207,
                    "ghg_class": "D",
                    "ghg_value": 44,
                    "min_yearly_cost": 2170,
                    "max_yearly_cost": 2950
                  },
                  "features": {
                    "lift": true,
                    "work_to_do": false
                  },
                  "city": "Paris 7e",
                  "postal_code": "75007",
                  "district": "Champ de Mars",
                  "department": "75",
                  "latitude": 48.855121521939274,
                  "longitude": 2.303284548300216,
                  "exact_location": false,
                  "published": null,
                  "modified": "2026-10-15T23:16:45.312Z",
                  "virtual_tours": [],
                  "images": [
                    "https://media.apimo.pro/cache/622eb51a0128ab5ff28c221fc0e4a7ee_a0219f31f2_1448-original.jpg",
                    "https://media.apimo.pro/cache/284f8cede55eec18cc73b4fb5f1a776c_c701b2893b_1448-original.jpg",
                    "… 12 more"
                  ],
                  "agency": {
                    "id": "apimo-10313",
                    "name": "CREHANGE INTERNATIONAL",
