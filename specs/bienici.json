          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/bienici/v1/places": {
      "get": {
        "operationId": "bieniciPlaces",
        "summary": "Bien'ici places",
        "description": "Place suggestions on Bien'ici (cities, districts, departments, regions) with their zone ids for /bienici/v1/search, postal codes, INSEE code, population and bounding box.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bienici-places",
        "tags": [
          "Bien'ici"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Place name.",
            "schema": {
              "type": "string"
            },
            "example": "bordeaux"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
