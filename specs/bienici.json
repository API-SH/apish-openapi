    "/bienici/v1/search": {
      "get": {
        "operationId": "bieniciSearch",
        "summary": "Bien'ici property search",
        "description": "Homes and other property for sale and rent in France on Bien'ici with the site's filters: place (or zone ids), property types, price, area, rooms, bedrooms, land area, new or old, energy class, features (pool, garden, terrace, balcony, lift, parking, cellar, fireplace, not on the ground floor, accessible, furnished, exclusive) and keywords, plus sort. Each result has id, link, reference, title, transaction, property type, price, price without fees, price per m², price drop flag, fees, area, land, rooms, bedrooms, bathrooms, floor, year built, energy and greenhouse ratings with yearly cost, features, city, postal code, district, coordinates, dates, virtual tours, photos and the agency (a private seller's name is left out). Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bienici-search",
        "tags": [
          "Bien'ici"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "A French place (city, district, department, region); the best match is used. Or give `zone_id`.",
            "schema": {
              "type": "string"
            },
            "example": "Lyon"
          },
          {
            "name": "zone_id",
            "in": "query",
            "required": false,
            "description": "Zone ids from /bienici/v1/places (comma list).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transaction",
            "in": "query",
            "required": false,
            "description": "Buy or rent.",
            "schema": {
              "type": "string",
              "enum": [
                "buy",
                "rent"
              ]
            },
            "example": "buy"
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Property types, comma list: house, flat, loft, castle, townhouse, programme, parking, terrain, shop, office, premises, building, others (default house,flat).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (EUR).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price (EUR).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "area_min",
            "in": "query",
            "required": false,
            "description": "Minimum area (m²).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "area_max",
            "in": "query",
            "required": false,
            "description": "Maximum area (m²).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "rooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum rooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "rooms_max",
            "in": "query",
            "required": false,
            "description": "Maximum rooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bedrooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bedrooms_max",
            "in": "query",
            "required": false,
            "description": "Maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "land_min",
            "in": "query",
            "required": false,
            "description": "Minimum garden/land area (m²).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "construction",
            "in": "query",
            "required": false,
            "description": "New-build or old.",
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "old"
              ]
            }
          },
          {
            "name": "energy_class",
            "in": "query",
            "required": false,
            "description": "Energy classes, comma list of A to G.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "features",
            "in": "query",
            "required": false,
            "description": "Features, comma list: pool, garden, terrace, balcony, lift, parking, cellar, fireplace, not_ground_floor, accessible, furnished, exclusive.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "keywords",
            "in": "query",
            "required": false,
            "description": "Words in the listing.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "price_asc",
                "price_desc",
                "price_m2_asc",
                "area_desc"
              ]
            },
            "example": "relevance"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page (max 100).",
            "schema": {
              "type": "integer"
            },
            "example": "24"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Result page (1 = first).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
