    "/doctolib/v1/search": {
      "get": {
        "operationId": "doctolibSearch",
        "summary": "Doctolib practitioner search",
        "description": "Find practitioners, practices and health centres on Doctolib (France, Germany or Italy) by specialty and place, with the site's filters: regulation sector (fr), languages, accepting new patients, insurance sector and video consultation (de, it). Each result: name, title, type (individual practitioner or organisation), specialty, address, postcode, city, coordinates, languages, regulation sector, online booking and video consultation flags, the visit reason that matched with its calendars, photo, profile slug and link, and `raw`. The response also lists the specialty and place the site matched and, on page 1, the filters the site offers for that specialty. 20 results per page; pass `next_page` back as `page`; null on the last page (the site serves up to 10,000 results).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/doctolib-search",
        "tags": [
          "Doctolib"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "speciality",
            "in": "query",
            "required": true,
            "description": "Specialty slug or search term in the site's language, e.g. dentiste, dermatologue, medecin-generaliste (fr), hautarzt, zahnarzt (de), cardiologo, dentista (it). See /doctolib/v1/autocomplete.",
            "schema": {
              "type": "string"
            },
            "example": "dentiste"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Place slug, e.g. paris, lyon, lyon-69003, muenchen, milano. Or use place_id.",
            "schema": {
              "type": "string"
            },
            "example": "paris"
          },
          {
            "name": "place_id",
            "in": "query",
            "required": false,
            "description": "A place_id from /doctolib/v1/places (instead of location).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Site: fr (default), de or it.",
            "schema": {
              "type": "string",
              "enum": [
                "fr",
                "de",
                "it"
              ]
            }
          },
          {
            "name": "regulation_sector",
            "in": "query",
            "required": false,
            "description": "fr: contracted, contracted_with_extra, organization_contracted, organization_non_contracted; comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "languages",
            "in": "query",
            "required": false,
