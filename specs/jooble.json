{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Jooble",
    "version": "1.0.0",
    "description": "The Jooble API from API.SH: public Jooble data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Jooble",
      "description": "1 endpoint (jobs & b2b)",
      "x-slug": "jooble",
      "x-domains": [
        "jooble.org"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jooble/v1/search": {
      "get": {
        "operationId": "joobleSearch",
        "summary": "Jooble job search",
        "description": "Jobs on Jooble, the job search engine that gathers ads from thousands of job sites, on any of its country sites, for keywords and/or a place, with every filter of the site: date posted, employment type, remote, exact place or radius, minimum salary per hour, month or year, and only ads that show a salary. Each job: `id`, `title`, `url` (Jooble's link to the original ad), `company` (with logo and verified flag), `location`, `remote`, `salary` as the ad shows it and `estimated_salary` when Jooble estimates one, `job_type`, `posted_at` and `posted_text`, `snippet`, the full `description` (text and HTML), `easy_apply`, `premium`, `tags`, `applies_count`, and `raw` with the site's record. `total` is the site's count for the search; `average_salary` and `currency` describe the search's pay; `applied_filters` echoes what the site applied. 20 jobs per page, up to page 10. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jooble-search",
        "tags": [
          "Jooble"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `nurse`, `python developer`. Required unless `location` is given.",
            "schema": {
              "type": "string"
            },
            "example": "nurse"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, region or state as you would type it on the site, e.g. `Austin, TX`, `Texas`, `London`, `Berlin`.",
            "schema": {
              "type": "string"
            },
            "example": "Texas"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Jooble country site (default `us` = jooble.org).",
            "schema": {
              "type": "string",
              "enum": [
                "us",
                "uk",
                "ca",
                "au",
                "nz",
                "ie",
                "in",
                "za",
                "ng",
                "sg",
                "my",
                "ph",
                "id",
                "pk",
                "ae",
                "de",
                "at",
                "ch",
                "fr",
                "be",
                "nl",
                "es",
                "pt",
                "it",
                "pl",
                "cz",
                "sk",
                "hu",
                "ro",
                "bg",
                "gr",
                "se",
                "dk",
                "fi",
                "no",
                "ua",
                "tr",
                "kz",
                "br",
                "mx",
                "ar",
                "cl",
                "co",
                "pe",
                "jp",
                "kr"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Date posted: last 24 hours, 3 days or 7 days.",
            "schema": {
              "type": "string",
              "enum": [
                "any",
                "24h",
                "3d",
                "7d"
              ]
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "Employment type: `full_time`, `part_time`, `temporary`, `internship`; several comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remote",
            "in": "query",
            "required": false,
            "description": "`true`: remote jobs only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Distance around `location` in the site's steps (miles on jooble.org and uk, kilometres on most other country sites), or `exact` for the place only.",
            "schema": {
              "type": "string",
              "enum": [
                "exact",
                "3",
                "5",
                "11",
                "15",
                "25",
                "50"
              ]
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "required": false,
            "description": "Minimum salary in the site's currency, per `salary_period`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "salary_period",
            "in": "query",
            "required": false,
            "description": "Period of `salary_min` (default `year`).",
            "schema": {
              "type": "string",
              "enum": [
                "hour",
                "month",
                "year"
              ]
            }
          },
          {
            "name": "with_salary",
            "in": "query",
            "required": false,
            "description": "`true`: only ads that show a salary.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "country": "us",
                  "site": "https://jooble.org",
                  "search_url": "https://jooble.org/SearchResult?ukw=nurse&rgns=Texas",
                  "q": "nurse",
                  "location": "Texas",
                  "page": 1,
                  "total": 99031,
                  "average_salary": 91084,
                  "currency": "$",
                  "no_results_in_location": false,
                  "applied_filters": {
                    "search": "nurse",
                    "region": "Texas",
                    "regionId": 44,
                    "isCityRegion": false,
                    "jobTypes": [],
                    "coords": null
                  },
                  "count": 20,
                  "jobs": [
                    {
                      "id": "-6641173183146895942",
                      "title": "Licensed Psychiatric Nurse Practitioner",
                      "url": "https://jooble.org/away/-6641173183146895942?p=1&pos=1&rgn=44&pageType=20&ckey=nurse&sid=-9168035576666226874&jobAge=357&relb=110&brelb=110&…",
                      "company": "Headway",
                      "company_logo": null,
                      "company_verified": false,
                      "company_url": null,
                      "location": "Texas",
                      "remote": false,
                      "coordinates": null,
                      "salary": "$144 per hour",
                      "estimated_salary": null,
                      "job_type": null,
                      "posted_at": "2026-10-22T00:00:00",
                      "posted_text": "14 days ago",
                      "snippet": "Job Description \" Licensed Psychiatric Nurse Practitioner \\n \\n Wage: Up to $196.58/hour \\n Did you know that you can build a flexible priva…",
                      "description": "Job Description\n\"\nLicensed Psychiatric Nurse Practitioner \\n\n\\n Wage: Up to $196.58/hour\n\\n Did you know that you can build a flexible priva…",
                      "description_html": "<h3> Job Description </h3><p><p>&quot;</p><b> Licensed Psychiatric Nurse Practitioner </b>\\n <p>&#160;</p>\\n <p><b> Wage: Up to $196.58/hour…",
                      "easy_apply": false,
                      "premium": false,
                      "new": false,
                      "resume_required": true,
