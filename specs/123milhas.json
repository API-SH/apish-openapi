{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: 123Milhas",
    "version": "1.0.0",
    "description": "The 123Milhas API from API.SH: public 123Milhas data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "123Milhas",
      "description": "1 endpoint (travel & events)",
      "x-slug": "123milhas",
      "x-domains": [
        "123milhas.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/123milhas/v1/flights": {
      "get": {
        "operationId": "123milhasFlights",
        "summary": "123Milhas flight search",
        "description": "One-way or round-trip flights from 123Milhas, the Brazilian travel site that sells airline tickets issued with miles and partner fares. Returns every offer the site shows: price per adult and total in BRL, service fee, discount, the airline's own total, Pix and installment terms, the fare source and whether it is a partner fare, and the outbound and inbound flight options it covers. Each flight has airline, flight number, times, duration, stops, baggage, the 123Milhas price next to the airline's price and the saving, taxes and segments with operator and connection times (times carry the local UTC offset). `best_prices` gives the cheapest fares by number of stops. Results are the full set for the search (no paging). Filter by airline and stops; sort by price, duration or departure. A search takes 10-30 seconds.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/123milhas-flights",
        "tags": [
          "123Milhas"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "origin",
            "in": "query",
            "required": true,
            "description": "Departure airport or city code (IATA), e.g. GRU, CGH or SAO (all São Paulo airports).",
            "schema": {
              "type": "string"
            },
            "example": "GRU"
          },
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "description": "Arrival airport or city code (IATA), e.g. REC, RIO or LIS.",
            "schema": {
              "type": "string"
            },
            "example": "REC"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Departure date, YYYY-MM-DD. Give this or `days_ahead`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days_ahead",
            "in": "query",
            "required": false,
            "description": "Departure date as days from today (Brazil time), 0-360; used when `date` is not given.",
            "schema": {
              "type": "integer"
            },
            "example": "60"
          },
          {
            "name": "return_date",
            "in": "query",
            "required": false,
            "description": "Return date (YYYY-MM-DD) for a round trip.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return_days",
            "in": "query",
            "required": false,
            "description": "Round trip: return this many days after the departure date (instead of `return_date`).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "adults",
            "in": "query",
            "required": false,
            "description": "Adults, 1-9 (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "children",
            "in": "query",
            "required": false,
            "description": "Children aged 2-11, 0-8 (default 0). Adults plus children at most 9.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "infants",
            "in": "query",
            "required": false,
            "description": "Infants under 2 on a lap, at most one per adult (default 0).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cabin",
            "in": "query",
            "required": false,
            "description": "Cabin class (default economy).",
            "schema": {
              "type": "string",
              "enum": [
                "economy",
                "business"
              ]
            }
          },
          {
            "name": "max_stops",
            "in": "query",
            "required": false,
            "description": "Only flight options with at most this many stops (0 = nonstop).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order of the offers: price (lowest total first, default), duration (shortest outbound option first) or departure (earliest outbound option first).",
            "schema": {
              "type": "string",
              "enum": [
                "price",
                "duration",
                "departure"
              ]
            }
          },
          {
            "name": "airlines",
            "in": "query",
            "required": false,
            "description": "Only offers with these airline codes, comma separated: GOL, TAM (LATAM), AZU (Azul) and the other codes a response shows.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "search_id": 2326381000,
                  "origin": "GRU",
                  "destination": "REC",
                  "date": "2027-01-03",
                  "return_date": null,
                  "trip_type": "one_way",
                  "adults": 1,
                  "children": 0,
                  "infants": 0,
                  "cabin": "economy",
                  "sort": "price",
                  "applied_filters": {},
                  "sources_searched": [
