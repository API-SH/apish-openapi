    "/kakaomap/v1/search": {
      "get": {
        "operationId": "kakaomapSearch",
        "summary": "KakaoMap place search",
        "description": "Places in South Korea matching a keyword on KakaoMap (15 per page): id, name, category and its path, phone, road and lot addresses, postcode, coordinates, rating and rating count, blog review count, homepage, image, brand, extra facts (parking, delivery, Wi-Fi... where listed) and the place link; matching addresses too, and how KakaoMap read the query (e.g. a keyword plus an area). Add an area to the keyword (e.g. `스타벅스 강남`) to search a place; a keyword alone is matched around an area KakaoMap picks. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kakaomap-search",
        "tags": [
          "KakaoMap"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keyword, optionally with an area (Korean or English), e.g. `스타벅스 강남`, `Gyeongbokgung`.",
            "schema": {
              "type": "string"
            },
            "example": "명동교자"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
