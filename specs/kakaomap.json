    "/kakaomap/v1/place/reviews": {
      "get": {
        "operationId": "kakaomapPlaceReviews",
        "summary": "KakaoMap place reviews",
        "description": "A place's KakaoMap reviews (about 20 per page): rating, text, photos, likes, dates, the owner's reply, and the reviewer's masked nickname plus the name and profile image the page shows, level and review stats; with the place's average rating, review count and strength counts. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kakaomap-place-reviews",
        "tags": [
          "KakaoMap"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "KakaoMap place id or link.",
            "schema": {
              "type": "string"
            },
            "example": "1479300828"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "Sort order (default `recommended`).",
            "schema": {
              "type": "string",
              "enum": [
                "recommended",
                "latest"
              ]
            }
          },
          {
            "name": "photo_only",
            "in": "query",
            "required": false,
            "description": "Only reviews with photos.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "`next_cursor` from the previous page.",
            "schema": {
              "type": "string"
            }
