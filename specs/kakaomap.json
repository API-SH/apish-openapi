    "/kakaomap/v1/place/photos": {
      "get": {
        "operationId": "kakaomapPlacePhotos",
        "summary": "KakaoMap place photos",
        "description": "A place's photos on KakaoMap with counts by type (food, menu, indoor, outdoor, reviews, video): photo id, image link, source type (review, blog, owner), blog link, date and the uploader's masked nickname plus shown name and profile image for review photos. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kakaomap-place-photos",
        "tags": [
          "KakaoMap"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
