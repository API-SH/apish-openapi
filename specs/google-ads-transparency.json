    "/google/v1/company/ads": {
      "get": {
        "operationId": "googleCompanyAds",
        "summary": "Google ads of an advertiser or domain",
        "description": "Ads an advertiser (or the advertisers of a domain or company name) ran on Google, from the public Ads Transparency Center: advertiser, creative id, format, first and last shown, days shown, preview and link. Filter by region, format, `platform` (play, maps, search, shopping, youtube) and a `date_from`/`date_to` range the ads were shown in; `limit` sets the page size (default 40). `details=true` adds the ad copy and media of the first 20 ads; `include=regions` adds each ad's regions with impressions ranges (shown for EU regions and political ads), first and last shown per region and per platform, and `total_reach`. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/google-company-ads",
        "tags": [
          "Google Ads Transparency"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "advertiser_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "AR16735076323512287233"
          },
          {
            "name": "domain",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "nike.com"
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "description": "Advertiser name.",
            "schema": {
              "type": "string"
            },
            "example": "nike"
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "US"
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "text, image or video.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "details",
            "in": "query",
            "required": false,
            "description": "true adds the ad copy and media of the first 20 ads.",
            "schema": {
              "type": "string"
            },
            "example": "false"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Value of `next_cursor` from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "description": "Only ads shown on these Google surfaces, comma-separated: play, maps, search, shopping, youtube.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "description": "Only ads shown on or after this day (YYYY-MM-DD; the center covers roughly the last year).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "description": "Only ads shown on or before this day (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Ads per page (1-100, default 40).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "description": "`regions`: add each ad's regions with impressions ranges and first/last shown (first 20 ads).",
            "schema": {
              "type": "string",
              "enum": [
                "regions"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
