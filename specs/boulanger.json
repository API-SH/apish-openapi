    "/boulanger/v1/reviews": {
      "get": {
        "operationId": "boulangerReviews",
        "summary": "Boulanger product reviews",
        "description": "Customer reviews of one Boulanger product: rating, title, text, nickname, date and experience date, helpful and unhelpful votes, review type, photos and Boulanger's replies, with the average rating and total. Sort like the site. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/boulanger-reviews",
        "tags": [
          "Boulanger"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The product reference or its boulanger.com/ref/<id> link.",
            "schema": {
              "type": "string"
            },
            "example": "1202703"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "newest (default), helpful, rating_desc, rating_asc, photos (with photos first), testers (tester reviews first).",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "helpful",
                "rating_desc",
                "rating_asc",
                "photos",
                "testers"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page, 1-50 (default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "product_id": "1202703",
                  "applied_filters": {
                    "sort": "newest",
                    "page": 1,
                    "limit": 20
                  },
