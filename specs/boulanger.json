    "/boulanger/v1/search": {
      "get": {
        "operationId": "boulangerSearch",
        "summary": "Boulanger product search",
        "description": "Search boulanger.com (France): products with title, price (with and without VAT), discount, brand, rating and review count, availability, condition (new or refurbished), seller (Boulanger or a marketplace seller), colour, categories and image, the total, and every filter the shop shows for the query (product family, brand, condition, store availability, technical attributes) with counts. Filter with `facets[].values[].filter` values and sort by price or rating. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/boulanger-search",
