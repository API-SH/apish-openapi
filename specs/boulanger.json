        "tags": [
          "Boulanger"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The product reference (e.g. 1243116) or its boulanger.com/ref/<id> link.",
