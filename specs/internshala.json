    "/internshala/v1/search": {
      "get": {
        "operationId": "internshalaSearch",
        "summary": "Internshala internship and job search",
        "description": "Internships or jobs on Internshala (India) for a skill, role or category, a city and/or work from home: id, type, title, company, link, locations, stipend or salary, duration (internships), experience (jobs), snippet, skills, categories, posted time, labels (part time, job offer, early applicant...), logo. `total` is the site's count. Pass `next_page` back as `page`; null on the last page. Optional filters: minimum stipend (internships) or salary (jobs), duration, start date, part time, job offer after the internship (ppo), openings for women, and early-applicant openings; `filters` echoes those applied. Each result also has `pay_min`, `pay_max`, `pay_period` (week, month or year) and `pay_currency` parsed from the pay text, `duration_months`, `is_part_time`, `ppo` and `ppo_text` (job offer after the internship), and `posted_ago`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/internshala-search",
        "tags": [
          "Internshala"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Skill, role or category, e.g. `python`, `marketing`.",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "internships (default) or jobs.",
            "schema": {
              "type": "string",
              "enum": [
                "internships",
                "jobs"
              ]
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, e.g. `bangalore`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "work_from_home",
            "in": "query",
            "required": false,
            "description": "1 = work-from-home only.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "stipend_min",
            "in": "query",
            "required": false,
            "description": "Internships: minimum monthly stipend in INR.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "required": false,
            "description": "Jobs: minimum salary in lakhs per annum (LPA).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "description": "Internships: maximum duration in months.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "description": "Internships: starting on or after this date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "part_time",
            "in": "query",
            "required": false,
            "description": "Part-time openings only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "ppo",
            "in": "query",
            "required": false,
            "description": "Internships: only those with a job offer after the internship.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "women_only",
            "in": "query",
            "required": false,
            "description": "Openings for women (the site's women-only listings).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "early_applicant",
            "in": "query",
            "required": false,
            "description": "Internships: only openings with few applicants so far.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "type": "internships",
                  "query": "python",
                  "location": null,
                  "work_from_home": false,
                  "page": 1,
                  "total": 234,
                  "count": 51,
                  "next_page": 2,
