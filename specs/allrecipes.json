    "/allrecipes/v1/reviews": {
      "get": {
        "operationId": "allrecipesReviews",
        "summary": "Allrecipes recipe reviews",
        "description": "A recipe's reviews with the site's sorts and filters: id, stars, text, the tags the reviewer picked (e.g. Easy to follow), date and edit date, helpful votes, reply count, reviewer name and profile link, and photos; plus the total. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/allrecipes-reviews",
        "tags": [
          "Allrecipes"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The recipe's link (or id with the name part, e.g. `10813/best-chocolate-chip-cookies`), or its `doc_id` from /allrecipes/v1/recipe.",
            "schema": {
              "type": "string"
            },
            "example": "10813/best-chocolate-chip-cookies"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default `newest`).",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest",
                "most_helpful",
                "most_positive",
                "least_positive"
              ]
            }
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Only these star ratings, comma-separated (e.g. `5,4`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "with_photo",
            "in": "query",
            "required": false,
            "description": "`true`: reviews with a photo only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page (default 20, max 50).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pass `next_cursor` from the previous answer to get the next page; null on the last page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
