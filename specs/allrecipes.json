    "/allrecipes/v1/questions": {
      "get": {
        "operationId": "allrecipesQuestions",
        "summary": "Allrecipes recipe questions and answers",
        "description": "Questions people asked about a recipe, 10 per page, each with its text, author, date, badges and its answers (text, author, date, badges); plus the total. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/allrecipes-questions",
        "tags": [
          "Allrecipes"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The recipe's link (or id with the name part, e.g. `10813/best-chocolate-chip-cookies`), or its `doc_id` from /allrecipes/v1/recipe.",
            "schema": {
              "type": "string"
            },
            "example": "10813/best-chocolate-chip-cookies"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back; null on the last page.",
            "schema": {
              "type": "integer"
