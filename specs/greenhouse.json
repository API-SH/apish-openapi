    "/greenhouse/v1/jobs": {
      "get": {
        "operationId": "greenhouseJobs",
        "summary": "Greenhouse job board",
        "description": "Every open job on a company's Greenhouse job board (thousands of company career sites run on it). Without `content`, a light list with departments; `content=true` adds the full description, offices and pay metadata (much larger for big boards). `total` counts the jobs after the filters; pages are `per_page` jobs; pass `next_page` back as `page`, null on the last page. Each job: `id`, `title`, `department`, `team`, `location`, `locations`, `workplace_type`, `remote`, `employment_type`, `compensation` (summary, min, max, currency, interval) when the company publishes it, `posted_at`, `updated_at`, `description_html` and `description` (plain text) when included, `apply_url`, `url` and `raw` (the board's own record). The same shape on every job board endpoint. Filter by last update or first-publish date with `updated_after` / `posted_after`, and order with `sort`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/greenhouse-jobs",
        "tags": [
          "Greenhouse"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "description": "The company's Greenhouse board name (the part after the host in its job board URL), or that URL.",
            "schema": {
              "type": "string"
            },
            "example": "gitlab"
          },
          {
            "name": "content",
            "in": "query",
            "required": false,
            "description": "`true`: include each job's full description, departments and offices.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Only jobs whose title contains all these words.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Only jobs whose department or team contains this text.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Only jobs whose location (or workplace type, e.g. `remote`) contains this text.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Jobs per page (default 100, max 500).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "updated_after",
            "in": "query",
            "required": false,
            "description": "Only jobs updated after this date (YYYY-MM-DD or ISO timestamp).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "posted_after",
            "in": "query",
            "required": false,
            "description": "Only jobs first published after this date (YYYY-MM-DD or ISO timestamp).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: `updated` or `posted` (newest first), `title` or `location` (A-Z). Default: the board's own order.",
            "schema": {
              "type": "string",
              "enum": [
                "updated",
                "posted",
                "title",
                "location"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
