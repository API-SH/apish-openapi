    "/fresha/v1/venue": {
      "get": {
        "operationId": "freshaVenue",
        "summary": "Fresha venue profile",
        "description": "One Fresha venue: id, slug, name, link, business type, description, business phone, currency, full address with coordinates and map link, rating, review count and the star histogram, price range, open status, opening hours per day, amenities, payment methods, languages, bookable, verified, new, featured, gift-card and deals flags, every service by group with duration, price, price type, discounts and variants, featured services, photos, team members, the latest reviews (rating, text, date, author, reply, photos), nearby venues, breadcrumbs and related pages. Also the venue logo, directions link, the business's website and social links when listed (`online_links`), portfolio photos with captions, online-payment, voucher, membership, package, product-store and group-appointment flags, the owner business, its other locations, and whether more reviews exist (`reviews_more`).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/fresha-venue",
        "tags": [
          "Fresha"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The venue's fresha.com/a/<slug> link (from /fresha/v1/search).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.fresha.com/a/marhaba-beauty-aesthetics-london-5-kensington-high-street-greater-i4qe5uo4"
          },
          {
            "name": "slug",
            "in": "query",
            "required": false,
            "description": "The venue slug instead of url.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
