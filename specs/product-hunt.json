    "/producthunt/v1/posts": {
      "get": {
        "operationId": "producthuntPosts",
        "summary": "Product Hunt leaderboard and topic products",
        "description": "The Product Hunt leaderboard for a day, week or month (the top 20 launches in rank order: name, tagline, votes, comments, daily/weekly/monthly rank, featured date, topics, thumbnail, product and website), or, with `topic`, the products listed under a topic (name, tagline, rating, reviews, followers, latest launch). Pass one of date, week, month or topic; without any the current day's leaderboard is returned.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/producthunt-posts",
        "tags": [
          "Product Hunt"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Day (YYYY-MM-DD, US Pacific).",
            "schema": {
              "type": "string"
            },
            "example": "2026-10-27"
          },
          {
            "name": "week",
            "in": "query",
            "required": false,
            "description": "ISO week (YYYY-WW).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "Month (YYYY-MM).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "description": "Topic slug or URL, e.g. developer-tools.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
