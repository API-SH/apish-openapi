    "/hepsiburada/v1/reviews": {
      "get": {
        "operationId": "hepsiburadaReviews",
        "summary": "Hepsiburada reviews",
        "description": "A Hepsiburada product's reviews: rating, text, author, date, verified purchase, seller, reactions, per-feature ratings (battery, screen...), photos and video, with paging. Sort (newest, most helpful, highest or lowest rating) and filter by star rating, reviews with photos, seller or words in the review; `all_variants=true` covers every colour/size of the product (and adds the site's AI review summary). `summary` gives the star counts, sellers and frequent keywords for the reviews matching the other filters; `feature_averages=true` adds `summary.all_variants`: the product family's average, star breakdown, review count and per-feature averages (battery, screen...).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/hepsiburada-reviews",
        "tags": [
          "Hepsiburada"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Product link.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.hepsiburada.com/apple-iphone-17-pro-max-256-gb-kozmik-turuncu-p-HBCV00009Z3Z8C"
          },
          {
            "name": "sku",
            "in": "query",
            "required": false,
            "description": "Product SKU instead of url.",
            "schema": {
              "type": "string"
            },
            "example": "HBCV00009Z3Z8C"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), newest, helpful, highest, lowest.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "helpful",
                "highest",
                "lowest"
              ]
            }
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Star ratings to keep, 1-5, comma separated (e.g. 1,2).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "with_media",
            "in": "query",
            "required": false,
            "description": "true: only reviews with photos or video.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "seller",
            "in": "query",
            "required": false,
            "description": "Seller names to keep, comma separated (as in `summary.sellers`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words that must appear in the review.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "all_variants",
            "in": "query",
            "required": false,
            "description": "true: reviews of every variant (colour, size) of the product, not just this SKU.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "feature_averages",
            "in": "query",
            "required": false,
            "description": "true: add `summary.all_variants` with the average, star breakdown and per-feature averages. Costs an extra lookup.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page, 1-50 (default 20).",
            "schema": {
              "type": "integer"
            },
            "example": "20"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
