    "/hepsiburada/v1/search": {
      "get": {
        "operationId": "hepsiburadaSearch",
        "summary": "Hepsiburada search",
        "description": "Hepsiburada product search or category listing (Turkey), 36 a page: SKU, name, link, price, original price, rating, review count, campaign texts, variant count and image, with brand, price range and the site's other filters. `sort` orders results (price, rating, newest, best-selling, most reviewed, discount). `facets` lists the filter sidebar: each group's `key`, `name` and `values` (`value`, `label`, `selected`); pass `key:value` in `filter` to apply one (the site shows no counts).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/hepsiburada-search",
        "tags": [
          "Hepsiburada"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (or category).",
            "schema": {
              "type": "string"
            },
            "example": "iphone"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category page path, e.g. cep-telefonlari-c-371965.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand slugs, comma separated.",
            "schema": {
              "type": "string"
            },
            "example": "apple"
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Lowest price in lira.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Highest price in lira.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Other site filters as key:value,value; separated by semicolons, e.g. renk:siyah. Keys and values are the `key` and `value` items of `facets`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), price_asc, price_desc, rating, newest, best_selling, most_reviewed, discount.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "rating",
                "newest",
                "best_selling",
                "most_reviewed",
                "discount"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "iphone",
                  "category": null,
                  "page": 1,
