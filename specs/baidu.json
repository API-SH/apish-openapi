    "/baidu/v1/news": {
      "get": {
        "operationId": "baiduNews",
        "summary": "Baidu News",
        "description": "Baidu News articles: 10 per page with title, URL, source, date, snippet and image. Pass `next_page` back as `page`. Every response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/baidu-news",
        "tags": [
          "Baidu"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query.",
            "schema": {
              "type": "string"
            },
            "example": "华为"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1 = first).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
