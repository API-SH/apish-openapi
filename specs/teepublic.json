    "/teepublic/v1/store": {
      "get": {
        "operationId": "teepublicStore",
        "summary": "TeePublic artist store",
        "description": "An artist's TeePublic store: name, link, store and artist ids, description, follower and following counts, outside links, avatar and banner, and the store's designs (same card as search), optionally on one product type or matching a search. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/teepublic-store",
        "tags": [
          "TeePublic"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "Artist name from the store link (teepublic.com/user/<name>) or the link itself.",
            "schema": {
              "type": "string"
            },
            "example": "theladyernestember"
          },
          {
            "name": "product",
            "in": "query",
            "required": false,
            "description": "Only this product type, e.g. stickers.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search within the store.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer"
            }
