    "/teepublic/v1/search": {
      "get": {
        "operationId": "teepublicSearch",
        "summary": "TeePublic design search and tag listings",
        "description": "Search TeePublic's independent-artist designs on one product type (t-shirts, hoodies, stickers, mugs, phone cases, posters and more), or list a tag's page. Each design: design id, title, product name, link, product and canvas ids, price, regular and sale price, currency, on-sale flag, artist name, id and store link, primary tag and tags, SKU, the shown variant (fit, style, colour) and image. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/teepublic-search",
        "tags": [
          "TeePublic"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (required unless `tag` is given).",
            "schema": {
              "type": "string"
            },
            "example": "cat"
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "A tag's listing instead of a search, e.g. `cat` (teepublic.com/t-shirts/cat).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "product",
            "in": "query",
            "required": false,
            "description": "Product type as in the site's links: t-shirts (default), hoodies, stickers, mugs, phone-cases, posters-and-art, tank-tops, kids-t-shirts, long-sleeve-t-shirts, crewneck-sweatshirts, hats, pins, magnets, socks, notebooks, pillows, totes, wall-art and others.",
            "schema": {
              "type": "string"
            },
            "example": "t-shirts"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default relevance).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "popular",
                "newest"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (36 designs per page).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "cat",
                  "tag": null,
                  "product": "t-shirts",
                  "sort": "relevance",
                  "page": 1,
                  "heading": "Cat T-Shirts",
                  "next_page": 2,
