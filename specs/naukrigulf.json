    "/naukrigulf/v1/search": {
      "get": {
        "operationId": "naukrigulfSearch",
        "summary": "Naukrigulf job search",
        "description": "Jobs on Naukrigulf (Gulf and Middle East) for a keyword and/or location, with every filter of the site's result page: years of experience, freshness, and the facets (industry, country, city, experience band, monthly salary band, gender, company or consultant, job title, nationality). Facet values come back in `facets` with counts; pass a value back in the matching parameter (comma separated for several). Each job: `id`, `title`, `url`, `company`, `company_id`, `logo`, `location`, experience range, `summary`, `highlights`, `keywords`, `vacancies`, `posted_at`, employer flags and `raw`. `total` is Naukrigulf's count (at most 45,000 reachable). Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/naukrigulf-search",
        "tags": [
          "Naukrigulf"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords (job title, skill or company). Required unless `location` is given.",
            "schema": {
              "type": "string"
            },
            "example": "accountant"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City or country, e.g. `dubai`, `saudi arabia`.",
            "schema": {
              "type": "string"
            },
            "example": "dubai"
          },
          {
            "name": "experience",
            "in": "query",
            "required": false,
            "description": "Your years of experience (0-50): jobs that fit it.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "freshness",
            "in": "query",
            "required": false,
            "description": "Posted within this many days.",
            "schema": {
              "type": "integer",
              "enum": [
                "1",
                "3",
                "7",
                "15",
                "30",
                "60"
              ]
            }
          },
          {
            "name": "industry",
            "in": "query",
            "required": false,
            "description": "Industry ids from `facets.industry` (e.g. `25` = IT), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country ids from `facets.country` (e.g. `17` = UAE), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City ids from `facets.city` (e.g. `17.4` = Dubai), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "experience_range",
            "in": "query",
            "required": false,
            "description": "Experience bands from `facets.experience_range` (0 = 0-1 years … 5 = 20+), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "salary_range",
            "in": "query",
            "required": false,
            "description": "Monthly salary bands from `facets.salary_range` (1 = under $500 … ), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "gender",
            "in": "query",
            "required": false,
            "description": "male, female, any or nm (not mentioned), from `facets.gender`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company_type",
            "in": "query",
            "required": false,
            "description": "1 = company, 2 = consultant (from `facets.company_type`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job_title",
            "in": "query",
            "required": false,
            "description": "Job title ids from `facets.job_title`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nationality",
            "in": "query",
            "required": false,
            "description": "Nationality group ids from `facets.nationality` (e.g. `994` = Indians), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Jobs per page, 1-49 (default 30).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
