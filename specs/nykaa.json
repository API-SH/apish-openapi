    "/nykaa/v1/search": {
      "get": {
        "operationId": "nykaaSearch",
        "summary": "Nykaa search",
        "description": "Nykaa search or category listing (India): id, SKU, name, brand, link, price, MRP, discount, rating and count, stock, offers count, tags and image, with brand, price band, discount, rating, sub-category and any listed filter, every sort and paging, plus the filter lists with counts.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/nykaa-search",
        "tags": [
          "Nykaa"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (or category).",
            "schema": {
              "type": "string"
            },
            "example": "lipstick"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category path, e.g. makeup/lips/c/15.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "popularity",
                "discount",
                "name",
                "customer_top_rated",
                "new_arrival",
                "price_desc",
                "price_asc"
              ]
            },
            "example": "price_asc"
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand ids from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price",
            "in": "query",
            "required": false,
            "description": "Price bands from the filters, e.g. 500-999.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "discount",
            "in": "query",
            "required": false,
            "description": "Discount bands from the filters.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Rating values from the filters.",
            "schema": {
