    "/nykaa/v1/reviews": {
      "get": {
        "operationId": "nykaaReviews",
        "summary": "Nykaa product reviews",
        "description": "Reviews of a Nykaa product by link, id or search words (`q` opens the first search result): rating, title, text, date, verified-buyer flag, helpful count, review photos, shade/variant id, reviewer review count and the product aspects the reviewer rated, with `raw`. Sort by site order, most recent, most helpful, positive or negative first. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/nykaa-reviews",
        "tags": [
          "Nykaa"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A Nykaa product link, e.g. https://www.nykaa.com/kay-beauty-signature-creme-lipstick-panache/p/16439255.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The product id (the number after /p/), instead of `url`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words: reviews of the first product that search returns (e.g. `lipstick`).",
            "schema": {
              "type": "string"
            },
            "example": "lipstick"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Site order (default), recent, helpful, positive (high ratings first) or negative (low ratings first).",
            "schema": {
              "type": "string",
              "enum": [
                "recent",
                "helpful",
                "positive",
                "negative"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
