    "/portal-zuk/v1/search": {
      "get": {
        "operationId": "portalZukSearch",
        "summary": "Portal Zuk property auction search",
        "description": "Search property auctions on Portal Zuk (banks, courts and companies selling Brazilian real estate) by state, city, region, neighborhood or a location path, property type, auction type and seller, with the site's filters (price, area, bedrooms, parking spaces, vacant only, minimum discount below valuation, installments accepted) and sorts. Each lot: id, lot code, link, title, property type, city, state, neighborhood, address, seller and seller slug, areas (useful, built, land, total, private, in m²), bedrooms, parking, bathrooms, every auction round (date, minimum bid, discount, closed), current minimum bid, next date, discount below valuation, occupied, judicial, fiduciary, installments and accepts-offers flags, coordinates and image. The first page also returns `total`. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/portal-zuk-search",
        "tags": [
          "Portal Zuk"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Two-letter state (UF), e.g. SP, RJ, MG.",
            "schema": {
              "type": "string"
            },
            "example": "SP"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City name or slug within `state` (see /portal-zuk/v1/locations).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "A region within `state`, e.g. interior, litoral, grande-sao-paulo (see /portal-zuk/v1/locations).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "neighborhood",
            "in": "query",
            "required": false,
            "description": "Neighborhood name or slug within `city`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Instead of the fields above, a `location` path from /portal-zuk/v1/locations (e.g. z/todos-imoveis/sp/sao-paulo/zona-sul) or a Portal Zuk listing link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Property type: all (default), residential, commercial, rural, land, apartments or houses.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "residential",
                "commercial",
                "rural",
                "land",
                "apartments",
                "houses"
              ]
            }
          },
          {
            "name": "auction_type",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "judicial",
                "extrajudicial",
                "fiduciary",
