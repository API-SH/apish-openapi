    "/dafiti/v1/search": {
      "get": {
        "operationId": "dafitiSearch",
        "summary": "Search Dafiti products",
        "description": "Dafiti (dafiti.com.br, Brazil's largest online fashion store) product search and category browse, 60 products a page: SKU, id, name, link, brand, color, price, list price, discount, installments, categories, a sponsored flag and images (model, product). Also returns every facet the shop shows (gender, category, size, brand, color, seller, character, closing, heel, sport, materials and more); pass a value's `filter` back as `filter` to apply it (filters stack: each `filter` already contains the ones applied before). Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/dafiti-search",
        "tags": [
          "Dafiti"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "What to search, e.g. `tenis`, `vestido`, `bolsa`. Optional when `category` or `filter` is given.",
            "schema": {
              "type": "string"
            },
            "example": "tenis"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A category path, e.g. `calcados-masculinos/tenis` or `feminino/roupas/vestidos`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "A facet value's `filter` from a previous response (e.g. `/nike/?q=tenis&segment=feminino`), or a dafiti.com.br listing link. Replaces `q` and `category`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default `popularity`).",
            "schema": {
              "type": "string",
              "enum": [
                "popularity",
                "price_asc",
                "price_desc",
                "newest",
                "discount",
                "name",
                "brand"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in whole reais, e.g. `100`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in whole reais, e.g. `300`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
