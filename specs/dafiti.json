    "/dafiti/v1/reviews": {
      "get": {
        "operationId": "dafitiReviews",
        "summary": "Dafiti product reviews",
        "description": "Customer reviews of a Dafiti product: rating, title, text, review and purchase dates, reviewer display name, recommend flag, votes, the fit survey (size, comfort, value, material, lightness...), photos, videos and comments. Page 1 also returns the summary: average, count, histogram, positive and negative counts, photo and video review counts, the store's overall rating, and the top positive and negative review. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/dafiti-reviews",
        "tags": [
          "Dafiti"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "A Dafiti SKU or product link, e.g. `VA134SCU65NLU`.",
            "schema": {
              "type": "string"
            },
            "example": "VA134SCU65NLU"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Which reviews and in what order (default `recent`).",
            "schema": {
              "type": "string",
              "enum": [
                "recent",
                "helpful",
                "positive",
                "negative",
                "photos"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page, 1-50 (default 10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
