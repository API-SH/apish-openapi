    "/truthsocial/v1/user/posts": {
      "get": {
        "operationId": "truthsocialUserPosts",
        "summary": "Truth Social user posts",
        "description": "Every response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/truthsocial-user-posts",
        "tags": [
          "Truth Social"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "handle",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "realDonaldTrump"
          },
          {
            "name": "replies",
            "in": "query",
            "required": false,
            "description": "true includes the account's replies (default false).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Value of `next_cursor` from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "only_media",
            "in": "query",
            "required": false,
            "description": "Only posts with images or videos.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "exclude_reblogs",
            "in": "query",
            "required": false,
            "description": "Leave out re-truths (reposts).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "pinned",
            "in": "query",
            "required": false,
            "description": "Only the account's pinned posts (one page).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "min_id",
            "in": "query",
            "required": false,
            "description": "Only posts newer than this post id (Truth Social returns the oldest of them first page-wise).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since_id",
            "in": "query",
            "required": false,
            "description": "Only posts newer than this post id (newest first).",
            "schema": {
              "type": "string"
            }
          },
