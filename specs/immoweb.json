          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/immoweb/v1/search": {
      "get": {
        "operationId": "immowebSearch",
        "summary": "Immoweb property search",
        "description": "Belgian property listings for sale or rent with every filter the site offers: property type and subtypes, postal codes, districts, provinces, countries, price, bedrooms, living and land area, construction year, facades, parking, garden and terrace size, EPC score, building condition, garden orientation, yes/no features (new build, public sale, life annuity, investment, furnished, pool, lift, fireplace, pets allowed and more), agency, and sort. Each listing has price, type and subtype, bedrooms, surfaces, EPC, full address with coordinates, flags, project ranges, agency and photos, plus `raw`. 60 a page; pass `next_page` back as `page` (null on the last page). The site serves at most 166 pages per search; `total` is the full match count.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/immoweb-search",
        "tags": [
          "Immoweb"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Property type (default house).",
            "schema": {
              "type": "string",
              "enum": [
                "house",
                "apartment",
                "house_and_apartment",
                "new_project_houses",
                "new_project_apartments",
                "office",
                "commercial",
                "industry",
                "land",
                "garage",
                "other",
                "all"
              ]
            },
            "example": "apartment"
          },
          {
            "name": "transaction",
            "in": "query",
            "required": false,
            "description": "sale or rent (default sale).",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent"
              ]
            },
            "example": "rent"
          },
          {
            "name": "postal_codes",
            "in": "query",
            "required": false,
            "description": "Belgian postal codes, comma separated.",
            "schema": {
              "type": "string"
            },
            "example": "1000,1050"
          },
          {
            "name": "districts",
            "in": "query",
            "required": false,
            "description": "District names in capitals, comma separated (e.g. GENT, BRUSSELS).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "provinces",
            "in": "query",
            "required": false,
            "description": "Province names in capitals, comma separated (e.g. ANTWERP, BRUSSELS, LIEGE).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "countries",
            "in": "query",
            "required": false,
            "description": "Two-letter country codes, comma separated (default BE).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "property_subtypes",
            "in": "query",
            "required": false,
            "description": "Subtypes in capitals, comma separated (e.g. VILLA, APARTMENT_BLOCK, PENTHOUSE, DUPLEX, STUDIO, KOT).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "agency_id",
            "in": "query",
            "required": false,
            "description": "Only this agency's listings (the id from /immoweb/v1/agency or a listing's agencies).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price in EUR.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price in EUR.",
            "schema": {
              "type": "integer"
            },
            "example": "1500"
          },
          {
            "name": "bedrooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms.",
            "schema": {
              "type": "integer"
            },
            "example": "2"
          },
          {
            "name": "bedrooms_max",
            "in": "query",
            "required": false,
            "description": "Maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "living_area_min",
            "in": "query",
            "required": false,
            "description": "Minimum living area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "living_area_max",
            "in": "query",
            "required": false,
            "description": "Maximum living area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "land_area_min",
            "in": "query",
            "required": false,
            "description": "Minimum land area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "land_area_max",
            "in": "query",
            "required": false,
            "description": "Maximum land area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "construction_year_min",
            "in": "query",
            "required": false,
            "description": "Built in or after this year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "construction_year_max",
            "in": "query",
            "required": false,
            "description": "Built in or before this year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "facades_min",
            "in": "query",
            "required": false,
            "description": "Minimum facades.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "facades_max",
            "in": "query",
            "required": false,
            "description": "Maximum facades.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "parking_min",
            "in": "query",
            "required": false,
            "description": "Minimum parking places.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "garden_area_min",
            "in": "query",
            "required": false,
            "description": "Minimum garden area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "terrace_area_min",
            "in": "query",
            "required": false,
            "description": "Minimum terrace area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "epc",
            "in": "query",
            "required": false,
            "description": "EPC scores, comma separated (A++, A+, A, B, C, D, E, F, G).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "description": "Building condition, comma separated: as_new, just_renovated, good, to_be_done_up, to_renovate, to_restore.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "garden_orientation",
            "in": "query",
            "required": false,
            "description": "Garden orientation, comma separated: north, north_east, east, south_east, south, south_west, west, north_west.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "newly_built",
            "in": "query",
