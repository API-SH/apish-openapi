    "/mercadona/v1/search": {
      "get": {
        "operationId": "mercadonaSearch",
        "summary": "Mercadona product search",
        "description": "Mercadona products matching a query, as the shop's search box finds them, with brand and category filters: id, link, name, brand, packaging, price, previous price and price-drop flag, unit price per kg/L, size, pack size, selling method (unit / weight / bunch), VAT, order limit, availability, new flag, image and categories; plus the brands among the results with counts. Prices depend on the warehouse. Pass `next_page` back as `page` (null on the last page).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/mercadona-search",
        "tags": [
          "Mercadona"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search text.",
            "schema": {
              "type": "string"
            },
            "example": "leche"
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Only these brands (names from `brands`, up to 10 separated by commas).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Only this category or subcategory (an id from /mercadona/v1/categories).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Products per page, 1 to 100 (default 24).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language: es (default) or en.",
            "schema": {
              "type": "string",
              "enum": [
                "es",
                "en"
              ]
            }
          },
          {
            "name": "warehouse",
            "in": "query",
            "required": false,
            "description": "Warehouse (default mad1, Madrid).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
