    "/mercadona/v1/product": {
      "get": {
        "operationId": "mercadonaProduct",
        "summary": "Mercadona product",
        "description": "One Mercadona product: price, previous price, unit price, size, VAT, EAN, brand, origin, legal name, description, ingredients, allergens, storage and usage instructions, mandatory mentions, alcohol by volume, suppliers, category path and photos.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/mercadona-product",
        "tags": [
          "Mercadona"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Product id (the number in a tienda.mercadona.es/product/<id>/... link) or that link.",
            "schema": {
              "type": "string"
            },
            "example": "4241"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language: es (default) or en.",
            "schema": {
              "type": "string",
              "enum": [
                "es",
                "en"
              ]
            }
          },
          {
            "name": "warehouse",
            "in": "query",
            "required": false,
            "description": "Warehouse (default mad1, Madrid).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
