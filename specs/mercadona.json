    "/mercadona/v1/warehouses": {
      "get": {
        "operationId": "mercadonaWarehouses",
        "summary": "Mercadona warehouse for a postal code",
        "description": "The Mercadona online warehouse that serves a Spanish postal code (the `warehouse` id that product prices and availability depend on on the other Mercadona routes), and whether online delivery reaches it.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/mercadona-warehouses",
        "tags": [
          "Mercadona"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "postal_code",
            "in": "query",
            "required": true,
            "description": "A Spanish postal code (5 digits).",
            "schema": {
              "type": "string"
            },
            "example": "46001"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
