{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Decolar",
    "version": "1.0.0",
    "description": "The Decolar API from API.SH: public Decolar data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Decolar",
      "description": "3 endpoints (travel & events)",
      "x-slug": "decolar",
      "x-domains": [
        "decolar.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/decolar/v1/autocomplete": {
      "get": {
        "operationId": "decolarAutocomplete",
        "summary": "Decolar place autocomplete",
        "description": "Decolar's (decolar.com) search box suggestions for a few letters: cities, airports and other places with their codes, Decolar place ids, coordinates and parent region and country. Use `type` for the flights, hotels, cars, packages or activities box; the flights box gives the city and airport codes the flight routes take.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/decolar-autocomplete",
        "tags": [
          "Decolar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "What was typed (2-80 characters), e.g. rio, salvador, lisboa.",
            "schema": {
              "type": "string"
            },
            "example": "rio"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "flights (default), hotels, cars, packages or activities.",
            "schema": {
              "type": "string",
              "enum": [
                "flights",
                "hotels",
                "cars",
                "packages",
                "activities"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "rio",
                  "type": "flights",
                  "count": 9,
                  "results": [
                    {
                      "id": "CIT_6381",
                      "type": "CITY",
                      "group": "CITY",
                      "code": "RIO",
                      "name": "Rio de Janeiro, Rio de Janeiro, Brasil",
                      "place_id": "6381",
                      "gid": "CIT_6381",
                      "latitude": -22.905273461,
                      "longitude": -43.214721679,
                      "parents": {
                        "continent": "CON_30003",
                        "country": "COU_20028",
                        "administrative_division": "ADM_12925"
                      }
                    },
                    {
                      "id": "CIT_6285",
                      "type": "CITY",
                      "group": "CITY",
                      "code": "RBR",
                      "name": "Rio Branco, Acre, Brasil",
                      "place_id": "6285",
                      "gid": "CIT_6285",
                      "latitude": -9.974,
                      "longitude": -67.80759999999998,
                      "parents": {
                        "continent": "CON_30003",
                        "country": "COU_20028",
                        "administrative_division": "ADM_30542"
                      }
                    },
                    "… 7 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/decolar/v1/calendar-prices": {
      "get": {
        "operationId": "decolarCalendarPrices",
        "summary": "Decolar fare calendar",
        "description": "Decolar's (decolar.com, Brazil) cheapest fares in BRL for the days around a flight search: one-way, the three days before and after the date; round trip, a 7 x 7 grid of departure and return dates. Returns each date (pair) with its price, the cheapest one, the searched date's price and the spread between the highest and lowest. Prices are the site's own estimates from recent searches.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/decolar-calendar-prices",
        "tags": [
          "Decolar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Departure airport or city code (GRU, SAO).",
            "schema": {
              "type": "string"
            },
            "example": "SAO"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Arrival airport or city code (REC, RIO).",
            "schema": {
              "type": "string"
            },
            "example": "RIO"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Departure date YYYY-MM-DD (default: 30 days from today).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days_ahead",
            "in": "query",
            "required": false,
            "description": "Departure date as days from today (0-330), instead of date.",
            "schema": {
              "type": "integer"
            },
            "example": "60"
          },
          {
            "name": "return_date",
            "in": "query",
            "required": false,
            "description": "Return date YYYY-MM-DD for a round-trip grid (default one-way).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "trip_days",
            "in": "query",
            "required": false,
            "description": "Return as days after the departure date, instead of return_date.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "adults",
            "in": "query",
            "required": false,
            "description": "Adults 1-9 (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "children",
            "in": "query",
            "required": false,
            "description": "Children's ages 2-17, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "infants",
            "in": "query",
            "required": false,
            "description": "Infants under 2 (0 to the number of adults).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "from": "SAO",
                  "to": "RIO",
                  "date": "2027-01-03",
                  "return_date": null,
                  "adults": 1,
                  "children": [],
                  "infants": 0,
                  "trip": "one_way",
                  "count": 7,
                  "cheapest": {
                    "date": "2027-01-06",
                    "return_date": null,
                    "price": 348,
                    "currency": "BRL",
                    "searched": false,
                    "status": "VALID"
                  },
                  "searched_price": 573,
                  "min_price": 348,
                  "price_spread": 225,
                  "currency": "BRL",
                  "note": "As previsões se baseiam em um histórico de buscas e foram criadas para fornecer informações adicionais na cotação de um voo. Use-as levando …",
                  "prices": [
                    {
                      "date": "2026-12-31",
                      "return_date": null,
                      "price": 353,
                      "currency": "BRL",
                      "searched": false,
                      "status": "VALID"
                    },
                    {
                      "date": "2027-01-01",
                      "return_date": null,
                      "price": 353,
                      "currency": "BRL",
                      "searched": false,
                      "status": "VALID"
                    },
                    "… 5 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/decolar/v1/flights": {
      "get": {
        "operationId": "decolarFlights",
        "summary": "Decolar flight search",
        "description": "Flight search on Decolar (decolar.com, Brazil), one-way or round trip, with Decolar's prices in BRL: each itinerary's total price, price per adult, taxes and charges, fare type, validating airline, payment and installment details, and every leg's options (departure and arrival times, airports, stops, duration, cabin, seats remaining, baggage allowance) with each segment's flight number, airline, operating airline, aircraft and booking class. Filter by stops, airlines, baggage, cabin, price range, departure and return time windows and maximum duration; sort by recommended, price, duration, stops, airline or arrival. `filters_available` lists the site's filters for the search with counts. Give the date as `date` or as `days_ahead` (days from today) and the return as `return_date` or `trip_days` (days after departure). Pass `next_page` back as `page`; it is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/decolar-flights",
        "tags": [
          "Decolar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Departure airport or city code (GRU, CGH, SAO, RIO).",
            "schema": {
              "type": "string"
            },
            "example": "GRU"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Arrival airport or city code (REC, SDU, LIS).",
            "schema": {
              "type": "string"
            },
            "example": "REC"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Departure date YYYY-MM-DD (default: 30 days from today).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days_ahead",
            "in": "query",
            "required": false,
            "description": "Departure date as days from today (0-330), instead of date.",
            "schema": {
              "type": "integer"
            },
            "example": "60"
          },
          {
            "name": "return_date",
            "in": "query",
            "required": false,
            "description": "Return date YYYY-MM-DD for a round trip (default one-way).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "trip_days",
            "in": "query",
            "required": false,
            "description": "Return as days after the departure date, instead of return_date.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "adults",
            "in": "query",
            "required": false,
            "description": "Adults 1-9 (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "children",
            "in": "query",
            "required": false,
            "description": "Children's ages 2-17, comma separated (e.g. 8,5).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "infants",
            "in": "query",
            "required": false,
            "description": "Infants under 2 on a lap (0 to the number of adults).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "recommended (default), price, duration, stops, airline or arrival.",
            "schema": {
              "type": "string",
              "enum": [
                "recommended",
                "price",
                "duration",
                "stops",
                "airline",
                "arrival"
              ]
            }
          },
          {
            "name": "stops",
            "in": "query",
            "required": false,
            "description": "Only these stop counts, comma separated: 0 (direct), 1, 2 (two or more).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "airlines",
            "in": "query",
            "required": false,
            "description": "Only these airlines, two-letter codes comma separated (AD = Azul, G3 = Gol, LA = LATAM).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "baggage",
            "in": "query",
            "required": false,
            "description": "carry_on (cabin bag included) or checked (checked bag included).",
            "schema": {
              "type": "string",
              "enum": [
                "carry_on",
                "checked"
              ]
            }
          },
          {
            "name": "cabin",
            "in": "query",
            "required": false,
            "description": "ECONOMY, PREMIUM_ECONOMY, BUSINESS or FIRSTCLASS.",
            "schema": {
              "type": "string",
              "enum": [
                "ECONOMY",
                "PREMIUM_ECONOMY",
                "BUSINESS",
                "FIRSTCLASS"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest total price in BRL.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest total price in BRL.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "departure_time",
            "in": "query",
            "required": false,
            "description": "Outbound departure window HH:MM-HH:MM (e.g. 06:00-12:00).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return_time",
            "in": "query",
            "required": false,
            "description": "Return departure window HH:MM-HH:MM (round trips).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_duration_hours",
            "in": "query",
            "required": false,
            "description": "Longest journey time per leg, in hours.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
