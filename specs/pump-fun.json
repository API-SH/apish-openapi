    "/pump-fun/v1/coins": {
      "get": {
        "operationId": "pumpFunCoins",
        "summary": "pump.fun token list",
        "description": "Tokens launched on pump.fun, sorted by market cap, all-time-high market cap, newest or latest trade: mint, name, symbol, description, image, links, creator wallet, created and last-trade time, USD price, market cap, FDV, all-time-high cap, 1 h volume, liquidity, supply, graduated flag and pool. Search by name or symbol (`q`), list one creator's tokens, filter graduated or bonding-curve tokens. The market cap, age and link filters apply to each page's tokens: `page_filters` echoes them and `page_size_before_filters` gives the page's size before filtering, so a page can hold fewer than `limit` tokens while `next_page` is still set. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/pump-fun-coins",
        "tags": [
          "pump.fun"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "market_cap (default), ath_market_cap, newest or last_trade.",
            "schema": {
              "type": "string",
              "enum": [
                "market_cap",
                "ath_market_cap",
                "newest",
                "last_trade"
              ]
            },
            "example": "market_cap"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "desc (default) or asc.",
            "schema": {
              "type": "string",
              "enum": [
                "desc",
                "asc"
              ]
            }
          },
          {
            "name": "graduated",
            "in": "query",
            "required": false,
            "description": "true: graduated tokens only; false: tokens still on the bonding curve.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "nsfw",
            "in": "query",
            "required": false,
            "description": "true includes tokens marked NSFW.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Tokens per page, 1-50 (default 50).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (token name or symbol).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "creator",
            "in": "query",
            "required": false,
            "description": "Creator wallet address: that wallet's tokens only.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_market_cap",
            "in": "query",
            "required": false,
            "description": "Minimum USD market cap (applied to each page's tokens).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_market_cap",
            "in": "query",
            "required": false,
            "description": "Maximum USD market cap (applied to each page's tokens).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_age_hours",
            "in": "query",
            "required": false,
            "description": "Created at least this many hours ago (applied to each page's tokens).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_age_hours",
            "in": "query",
            "required": false,
            "description": "Created at most this many hours ago (applied to each page's tokens).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "has_twitter",
            "in": "query",
            "required": false,
            "description": "true: tokens with an X/Twitter link; false: without (applied to each page's tokens).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "has_website",
            "in": "query",
            "required": false,
            "description": "true: tokens with a website; false: without (applied to each page's tokens).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "has_telegram",
            "in": "query",
            "required": false,
            "description": "true: tokens with a Telegram link; false: without (applied to each page's tokens).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "sort": "market_cap",
                  "order": "desc",
                  "graduated": null,
