    "/bhphoto/v1/search": {
      "get": {
        "operationId": "bhphotoSearch",
        "summary": "B&H Photo product search",
        "description": "Products matching words on B&H Photo Video (bhphotovideo.com, US), one results page at a time: each product with B&H id, name, link, B&H number and manufacturer number, price, list price and savings when discounted, star rating and review count, key features, stock status, shipping message, in-store display, the used price when a used unit is offered, and image. `facets` lists the page's filter groups (category, brand, savings & stock, rating …) with counts; pass a value's `filters` back as `filters` to narrow the search. Some brand words open a brand page instead of a result list (`redirected_to`). Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bhphoto-search",
        "tags": [
          "B&H Photo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "sony a7"
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "A `filters` value from `facets`, e.g. `fct_category:mirrorless_system_cameras_16158:REGULAR`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
