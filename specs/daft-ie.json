    "/daft/v1/search": {
      "get": {
        "operationId": "daftSearch",
        "summary": "Daft.ie property search",
        "description": "Search Ireland's property listings on Daft.ie in every section: homes for sale, to rent, room shares, new homes, commercial for sale or rent, parking, student accommodation, holiday homes and sold properties (sold price and date). Takes every filter the site's search has: location, property type, price, bedrooms, bathrooms, floor size, BER energy rating, facilities, furnishing, room type, suitable for, owner occupied, lease length, number of tenants, auction or offers, video or virtual tour, available or sale agreed, added within N days, sold or available date ranges, keywords, and the sort order. Each listing: id, title, price (text and number), sold price and date, bedrooms, bathrooms, property type, floor area, BER, price per m², stamp duty, year built, publish dates, coordinates, address, facilities, features, description, images, units of a development, views, the advertiser (agent name, branch, phone, licence, logo; private advertisers keep the name and picture the site shows, never a phone), link and `raw`. 20 per page; pass `next_page` back as `page`, null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/daft-search",
        "tags": [
          "Daft.ie"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "Which listings: for-sale (default), for-rent, sharing, new-homes, commercial-for-sale, commercial-for-rent, parking-for-sale, parking-for-rent, student-accommodation, student-sharing, holiday-homes, sold.",
            "schema": {
              "type": "string",
              "enum": [
                "for-sale",
                "for-rent",
                "sharing",
                "new-homes",
                "commercial-for-sale",
                "commercial-for-rent",
                "parking-for-sale",
                "parking-for-rent",
                "student-accommodation",
                "student-sharing",
                "holiday-homes",
                "sold"
              ]
            },
            "example": "for-sale"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Location slug (default ireland), e.g. dublin, dublin-city, cork-city, galway; find slugs with /daft/v1/locations.",
            "schema": {
              "type": "string"
            },
            "example": "dublin-city"
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Comma-separated: houses, detached-houses, semi-detached-houses, terraced-houses, end-of-terrace-houses, townhouses, apartments, studio-apartments, duplexes, bungalows, sites (commercial: office-spaces, retail-units, industrial-units, restaurants-bars-hotels, commercial-sites, agricultural-land, development-land, industrial-sites, investment-properties; sharing: houses, apartments, flats).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (sale price, or monthly rent for rentals).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "beds_min",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "beds_max",
            "in": "query",
            "required": false,
            "description": "Maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "baths_min",
            "in": "query",
            "required": false,
            "description": "Minimum bathrooms.",
            "schema": {
              "type": "integer"
