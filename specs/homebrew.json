{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Homebrew",
    "version": "1.0.0",
    "description": "The Homebrew API from API.SH: public Homebrew data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Homebrew",
      "description": "4 endpoints (reference)",
      "x-slug": "homebrew",
      "x-domains": [
        "brew.sh"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/homebrew/v1/analytics": {
      "get": {
        "operationId": "homebrewAnalytics",
        "summary": "Homebrew install analytics",
        "description": "Homebrew's public install rankings: installs, installs on request, cask installs, build errors or OS versions over 30, 90 or 365 days, with rank, count and percent; `q` filters by name. Updated daily. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/homebrew-analytics",
        "tags": [
          "Homebrew"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "install (default), install-on-request, cask-install, build-error or os-version.",
            "schema": {
              "type": "string",
              "enum": [
                "install",
                "install-on-request",
                "cask-install",
                "build-error",
                "os-version"
              ]
            },
            "example": "install"
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "30d (default), 90d or 365d.",
            "schema": {
              "type": "string",
              "enum": [
                "30d",
                "90d",
                "365d"
              ]
            },
            "example": "30d"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Only names containing this text.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` gives the next one; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Rows per page, 1-1000 (default 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "category": "install",
                  "period": "30d",
                  "start_date": "2026-10-04",
                  "end_date": "2026-11-03",
                  "total_count": 25037196,
                  "q": null,
                  "items": [
                    {
                      "rank": 1,
                      "formula": "ca-certificates",
                      "count": 495053,
                      "percent": 1.98,
                      "options": null,
                      "url": "https://formulae.brew.sh/formula/ca-certificates"
                    },
                    {
                      "rank": 2,
                      "formula": "openssl@4",
                      "count": 459548,
                      "percent": 1.84,
                      "options": null,
                      "url": "https://formulae.brew.sh/formula/openssl@4"
                    },
                    "… 98 more"
                  ],
                  "count": 100,
                  "total": 21579,
                  "page": 1,
                  "next_page": 2,
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
