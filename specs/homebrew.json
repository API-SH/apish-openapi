    "/homebrew/v1/search": {
      "get": {
        "operationId": "homebrewSearch",
        "summary": "Search Homebrew formulae and casks",
        "description": "Searches Homebrew formulae (command-line packages) and casks (macOS apps) by name, best match first. `details=true` adds each result's description, version, homepage and 30-day installs. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/homebrew-search",
        "tags": [
          "Homebrew"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "git"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "all (default), formula or cask.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "formula",
                "cask"
              ]
            }
          },
          {
            "name": "details",
            "in": "query",
            "required": false,
            "description": "true to add description, version, homepage and installs (max 10 per page).",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` gives the next one; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page, 1-100 (default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "git",
                  "type": "all",
                  "items": [
                    {
                      "type": "formula",
                      "name": "git",
                      "label": "git",
                      "disabled": false,
                      "deprecated": false,
                      "url": "https://formulae.brew.sh/formula/git"
                    },
                    {
                      "type": "formula",
                      "name": "bash-git-prompt",
                      "label": "bash-git-prompt",
                      "disabled": false,
                      "deprecated": false,
                      "url": "https://formulae.brew.sh/formula/bash-git-prompt"
                    },
                    "… 16 more"
                  ],
                  "count": 18,
                  "total_hits": 7843,
                  "page": 1,
                  "next_page": 2,
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
