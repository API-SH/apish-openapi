    "/jobs-ch/v1/job": {
      "get": {
        "operationId": "jobsChJob",
        "summary": "jobs.ch / jobup.ch job details",
        "description": "One jobs.ch or jobup.ch job ad: title, company, place, street and postcode, publication and end dates, workload, employment type and position ids, industry, language skills, the lead and full description (HTML and text), skills, benefits, application method and link, images, videos, and the recruiter contact and application e-mail when the ad shows them. Removed jobs answer 404. Give id/url, or q to open the first current result of a search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jobs-ch-job",
        "tags": [
          "jobs.ch"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job id (UUID) or the job's jobs.ch / jobup.ch URL (`url` is accepted too).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Instead of id: keywords; opens the first current result of that search (all /jobs-ch/v1/search filters apply).",
            "schema": {
              "type": "string"
            },
            "example": "informatiker"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "With q: town or postcode.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "description": "jobs (default) or jobup.",
            "schema": {
