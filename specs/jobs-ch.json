    "/jobs-ch/v1/search": {
      "get": {
        "operationId": "jobsChSearch",
        "summary": "jobs.ch / jobup.ch job search",
        "description": "Swiss jobs on jobs.ch (or jobup.ch with `site=jobup`) with every filter of the site's search: location, region, category, industry, employment type, position, workload range, company size segment, language, company and sort. Each job: `id`, `title`, `url`, `company`, `company_id`, `company_slug`, `logo`, `place`, `coordinates`, `preview`, publication dates, `workload`, employment type and position ids, language skills, category and region paths, plus `raw`. `facets` gives the ids with counts. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jobs-ch-search",
        "tags": [
          "jobs.ch"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords. Required unless `location` or a filter is given.",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Town or postcode.",
            "schema": {
              "type": "string"
            },
            "example": "Zürich"
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Region ids from `facets.region`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category ids from `facets.category`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "industry",
            "in": "query",
            "required": false,
            "description": "Industry ids from `facets.industry`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employment_type",
            "in": "query",
            "required": false,
            "description": "Employment type ids from `facets.employment_type`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position",
            "in": "query",
            "required": false,
            "description": "Position ids from `facets.position`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company_segment",
            "in": "query",
            "required": false,
            "description": "Company size segments from `facets.company_segment` (e.g. `kmu`, `gu`), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Required language codes from `facets.language`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company_id",
            "in": "query",
            "required": false,
            "description": "Company ids (from results or /jobs-ch/v1/company), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workload_min",
            "in": "query",
            "required": false,
            "description": "Minimum workload in percent (0-100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "workload_max",
            "in": "query",
            "required": false,
            "description": "Maximum workload in percent (0-100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "date"
              ]
            }
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "description": "jobs (default) or jobup.",
            "schema": {
              "type": "string",
              "enum": [
                "jobs",
                "jobup"
              ]
            }
          },
          {
            "name": "limit",
