    "/elcorteingles/v1/search": {
      "get": {
        "operationId": "elcorteinglesSearch",
        "summary": "Search El Corte Inglés products",
        "description": "El Corte Inglés (Spain) product search: product id, title, brand, link, image, price, original price and discount, availability, EAN, seller and marketplace flag, promotions, colours, variant count, categories and badges, with the total result count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/elcorteingles-search",
        "tags": [
          "El Corte Inglés"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "cafetera espresso"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: relevance (default), price_asc, price_desc, bestseller, newest, rating, discount, availability, name_asc, name_desc.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "bestseller",
                "newest",
                "rating",
                "discount",
                "availability",
                "name_asc",
                "name_desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1 for the first. Pass back `next_page`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
