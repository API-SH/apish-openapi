    "/stackshare/v1/search": {
      "get": {
        "operationId": "stackshareSearch",
        "summary": "Search StackShare",
        "description": "Search StackShare tools, companies and stacks: type, name, slug, link, title, description, image, popularity, votes, verification, stacks, category, reasons and aliases, with the site's record in `raw`. `total` is the match count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/stackshare-search",
        "tags": [
          "StackShare"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "react"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Result type (default all).",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "tool",
                "company",
                "stack"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page (1-50, default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer"
            }
