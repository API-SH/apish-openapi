    "/instahyre/v1/job": {
      "get": {
        "operationId": "instahyreJob",
        "summary": "Instahyre job ad",
        "description": "One job ad on Instahyre: title, employer, the recruiter's name, title and photo when the ad shows them, locations, experience range, category and functions, skills, internship details and the full description. Give `id` or `url`, or `q` (plus any search filter) to open the first matching current ad.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/instahyre-job",
        "tags": [
          "Instahyre"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job id (the number in /job-<id>-... URLs).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Job URL on instahyre.com.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Skills or keywords, comma separated (e.g. python,django).",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Cities, comma separated (Bangalore, Mumbai, Delhi / NCR, Hyderabad, Pune, Chennai, Work From Home; see facets.locations).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "description": "Company names, comma separated (see facets.companies).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job_function",
            "in": "query",
            "required": false,
            "description": "Job function ids, comma separated (10 backend, 1 full stack, 9 data science / ML, 8 DevOps; see facets.job_functions).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "industry",
            "in": "query",
            "required": false,
            "description": "Industry ids, comma separated (13 software / IT; see facets.industries).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "experience",
            "in": "query",
            "required": false,
            "description": "Years of experience the candidate has (0-30).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company_size",
            "in": "query",
            "required": false,
            "description": "Company size.",
            "schema": {
              "type": "string",
              "enum": [
                "small",
                "medium",
                "large"
              ]
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "Full-time jobs, internships or both.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "full_time",
                "internship"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "447614",
                  "url": "https://www.instahyre.com/job-447614-python-developer-at-topdoc-bangalore/",
                  "title": "Python Developer",
