    "/instahyre/v1/search": {
      "get": {
        "operationId": "instahyreSearch",
        "summary": "Search Instahyre jobs",
        "description": "Job ads on Instahyre (India, tech and corporate jobs) for skills or keywords, with the site's filters: city, company, job function, industry, years of experience, company size and job type. Each result has the title, locations, skills and the employer's name, tagline, founding year, size and logo. `facets` gives counts by job function, industry, company size, top companies, top locations, job type and experience level. 35 per page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/instahyre-search",
        "tags": [
          "Instahyre"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Skills or keywords, comma separated (e.g. python,django).",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Cities, comma separated (Bangalore, Mumbai, Delhi / NCR, Hyderabad, Pune, Chennai, Work From Home; see facets.locations).",
            "schema": {
              "type": "string"
            },
            "example": "Bangalore"
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "description": "Company names, comma separated (see facets.companies).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job_function",
            "in": "query",
            "required": false,
            "description": "Job function ids, comma separated (10 backend, 1 full stack, 9 data science / ML, 8 DevOps; see facets.job_functions).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "industry",
            "in": "query",
            "required": false,
            "description": "Industry ids, comma separated (13 software / IT; see facets.industries).",
            "schema": {
              "type": "string"
            }
