    "/foundit/v1/search": {
      "get": {
        "operationId": "founditSearch",
        "summary": "foundit job search",
        "description": "Jobs on foundit (formerly Monster India) for keywords and/or location, with experience, freshness and sort: id, title, company, locations, experience range, salary range (when shown), skills, industries, functions, roles, employment types, job types, employer type (company or consultant), qualifications, experience label, posting and closing dates, applicant count, urgent and walk-in flags, the company's jobs page, job link and apply link. Filter further by experience range, salary range (INR per year on the India site), job type (work from home, contract), employer type, industry, function, skills, role, designation, employment type and qualification; `site` searches the Gulf, Singapore or Malaysia site instead of India. `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/foundit-search",
        "tags": [
          "foundit"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `python`.",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, e.g. `bangalore`.",
            "schema": {
              "type": "string"
            },
            "example": "bangalore"
          },
          {
            "name": "experience",
            "in": "query",
            "required": false,
            "description": "Years of experience the job must accept.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "experience_min",
            "in": "query",
            "required": false,
            "description": "Minimum years of experience (0-99). Use instead of experience.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "experience_max",
            "in": "query",
            "required": false,
            "description": "Maximum years of experience (0-99). Use instead of experience.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "required": false,
            "description": "Minimum yearly salary in INR (jobs that show a salary).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "salary_max",
            "in": "query",
            "required": false,
            "description": "Maximum yearly salary in INR (jobs that show a salary).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "wfh (work from home) and/or contract, comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employer_type",
            "in": "query",
            "required": false,
            "description": "Jobs posted by the hiring company or by a recruitment consultant (comma-separate for both).",
            "schema": {
              "type": "string",
              "enum": [
                "company",
                "consultant"
              ]
            }
          },
          {
            "name": "industry",
            "in": "query",
            "required": false,
            "description": "Industry names as the site labels them (the values in jobs[].industries, e.g. `Internet`, `IT/Computers - Software`), comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "function",
            "in": "query",
            "required": false,
            "description": "Function names as the site labels them (the values in jobs[].functions, e.g. `IT`, `Software Development`), comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "skills",
            "in": "query",
            "required": false,
            "description": "Skills the job must list (e.g. `python`, `java`), comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "role",
            "in": "query",
            "required": false,
            "description": "Role names as the site labels them (the values in jobs[].role_names, e.g. `Software Engineer`, `Data Scientist`), comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "designation",
            "in": "query",
            "required": false,
            "description": "Job titles as the site labels them (the values in jobs[].roles, e.g. `Software Engineer/Programmer`), comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employment_type",
            "in": "query",
            "required": false,
            "description": "`full_time`, `part_time`, `internship`, `freelance`, `temporary`; comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "qualification",
            "in": "query",
            "required": false,
            "description": "Qualifications exactly as the site labels them (the values in jobs[].qualifications, e.g. `Bachelor Of Technology (B.Tech/B.E)`), comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "description": "Which foundit country site to search: `in` India (default), `gulf` (UAE, Saudi Arabia and the Gulf; salaries in AED), `sg` Singapore, `my` Malaysia. Job links point at that site.",
            "schema": {
              "type": "string",
              "enum": [
                "in",
                "gulf",
                "sg",
                "my"
              ]
            }
          },
          {
            "name": "freshness",
            "in": "query",
            "required": false,
            "description": "Posted within this many days: 1, 3, 7, 15, 30.",
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "3",
                "7",
                "15",
                "30"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default) or date.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "date"
              ]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Results per page (max 50, default 15).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "company_id",
            "in": "query",
            "required": false,
            "description": "Only this company's jobs (the company_id of a job).",
            "schema": {
              "type": "string"
            },
            "example": "501221"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "python",
                  "location": "bangalore",
                  "page": 1,
                  "per_page": 15,
                  "total": 9142,
                  "count": 19,
                  "next_page": 2,
                  "jobs": [
                    {
                      "id": "69709349",
                      "title": "Senior Software Engineer (Go & Python, Al)",
                      "company": "NETAPP",
                      "company_id": 441960,
                      "locations": [
                        "Bengaluru",
                        "India"
                      ],
                      "experience_min": 0,
                      "experience_max": 0,
                      "salary_min": null,
                      "salary_max": null,
                      "salary_currency": "INR",
                      "skills": [
                        "ClickHouse",
                        "Go",
                        "… 12 more"
                      ],
                      "industries": [
                        "IT/Computers - Hardware & Networking"
                      ],
                      "functions": [
                        "Software Engineering"
                      ],
                      "roles": [
                        "Software Engineer/Programmer"
                      ],
