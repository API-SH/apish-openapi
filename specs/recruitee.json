    "/recruitee/v1/jobs": {
      "get": {
        "operationId": "recruiteeJobs",
        "summary": "Recruitee careers-site jobs",
        "description": "Every open job on a company's Recruitee careers site (<company>.recruitee.com), with filters for keywords, department, location, country, tag, employment type, remote and hybrid. Each job has the title, department, tags, locations, work mode, employment type, experience and education levels, hours, salary when shown, dates and links. `facets` counts departments, locations, employment types and tags.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/recruitee-jobs",
        "tags": [
          "Recruitee"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "description": "Careers-site name (the part before .recruitee.com).",
            "schema": {
              "type": "string"
            },
            "example": "bunq"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Text in the title, department or tags.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Department name contains.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Location, city or country contains.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "2-letter country code.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Tag (exact).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employment_type",
            "in": "query",
            "required": false,
            "description": "Employment type code (e.g. fulltime_permanent, parttime, internship).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remote",
            "in": "query",
            "required": false,
            "description": "1 = remote jobs.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "hybrid",
            "in": "query",
            "required": false,
            "description": "1 = hybrid jobs.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
