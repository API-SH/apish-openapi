                    },
                    {
                      "id": 3729,
                      "code": "abrdn",
                      "slug": "aberdeen-nc-nc",
                      "name": "Aberdeen, NC",
                      "country": "United States",
                      "country_code": "US",
                      "region": null,
                      "time_zone": "EST5EDT",
                      "lat": 35.131547,
                      "lon": -79.4294789,
                      "radius_miles": 4,
                      "listed": true,
                      "url": "https://resy.com/cities/aberdeen-nc-nc"
                    },
                    "… 1841 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
