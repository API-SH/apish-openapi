    "/resy/v1/search": {
      "get": {
        "operationId": "resySearch",
        "summary": "Resy restaurants with tables on a date",
        "description": "Restaurants on Resy in a city for a date and party size, optionally matching a query (name, cuisine, neighbourhood), ordered by availability that day: id, name, slug, link, cuisines, neighbourhood, locality, region, country, rating and count, price band (1-4), currency, coordinates, phone, maximum party, waitlist and Global Dining Access flags, collections, the day's open time slots with seating type, and images, with the total and the matching cuisines. The first 20 venues; narrow with query.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/resy-search",
        "tags": [
          "Resy"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "Resy city slug: new-york-ny (default), los-angeles-ca, miami-fl, chicago-il, san-francisco-ca, washington-dc, austin-tx, london-uk...",
            "schema": {
              "type": "string"
            },
            "example": "new-york-ny"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Date YYYY-MM-DD (default tomorrow).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "seats",
            "in": "query",
            "required": false,
            "description": "Party size, 1-20 (default 2).",
            "schema": {
              "type": "integer"
            },
            "example": "2"
          },
          {
            "name": "query",
            "in": "query",
            "required": false,
            "description": "Name, cuisine or neighbourhood.",
            "schema": {
              "type": "string"
            },
            "example": "italian"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
