    "/resy/v1/collection/venues": {
      "get": {
        "operationId": "resyCollectionVenues",
        "summary": "Resy collection restaurants",
        "description": "The restaurants of one Resy curated list with cuisine, price band, rating, ratings count, neighbourhood, coordinates, average ticket, link and the open slots (start, end, seating type) for the date and party size. Lists are long and carry every slot of the day, so this call is heavier than most.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 4 credits per successful call. Docs: https://api.sh/docs/resy-collection-venues",
        "tags": [
          "Resy"
        ],
        "x-credits": 4,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "Resy city slug (default new-york-ny).",
            "schema": {
              "type": "string"
            },
            "example": "new-york-ny"
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Collection id or slug from /resy/v1/collection.",
            "schema": {
              "type": "string"
            },
            "example": "1056"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Date for open slots (YYYY-MM-DD, default today).",
            "schema": {
              "type": "string"
