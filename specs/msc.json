{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: MSC",
    "version": "1.0.0",
    "description": "The MSC API from API.SH: public MSC data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "MSC",
      "description": "3 endpoints (logistics)",
      "x-slug": "msc",
      "x-domains": [
        "msc.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/msc/v1/schedule": {
      "get": {
        "operationId": "mscSchedule",
        "summary": "MSC sailing schedules",
        "description": "MSC sailing schedules, either between two ports from a date (each sailing's service, departure, arrival, transit time, vessel, voyage, CO2 footprint, cut-off dates and legs with terminals and port calls) or for one vessel (its port calls with arrival and departure times, service and voyage).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/msc-schedule",
        "tags": [
          "MSC"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Port of loading: UN/LOCODE or port name. With to, for sailings between two ports.",
            "schema": {
              "type": "string"
            },
            "example": "CNSHA"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "Port of discharge: UN/LOCODE or port name.",
            "schema": {
              "type": "string"
            },
            "example": "NLRTM"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Earliest departure (YYYY-MM-DD, today or later). Default today.",
            "schema": {
              "type": "string"
            },
            "example": "2026-11-10"
          },
          {
            "name": "vessel",
            "in": "query",
            "required": false,
            "description": "A vessel's IMO number or name (see /msc/v1/vessels), instead of from and to.",
            "schema": {
              "type": "string"
            },
            "example": "9839430"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "from": {
                    "name": "SHANGHAI",
                    "code": "CNSHA",
                    "country": "CHINA"
                  },
                  "to": {
                    "name": "ROTTERDAM",
                    "code": "NLRTM",
                    "country": "NETHERLANDS"
                  },
                  "date": "2026-12-15",
                  "as_of": "Search schedule results provided by MSC on 04.11.2026 at 06:50 Central Europe Standard Time",
                  "count": 22,
                  "sailings": [
                    {
                      "service": "GRIFFIN SERVICE",
                      "direct": true,
                      "routing": "Direct",
                      "departure": "2026-12-15T05:30:00",
                      "arrival": "2027-01-29T18:30:00",
                      "transit_days": 45,
                      "transit": "45 days",
                      "vessel": "HMM GAON",
                      "voyage": "0025W",
                      "co2": "2.2915 Tons",
                      "cutoffs": {
                        "container_yard": "Fri 11th Dec 2026 08:00",
                        "reefer": "Fri 11th Dec 2026 08:00",
                        "dangerous_cargo": "Fri 4th Dec 2026 00:00",
                        "shipping_instructions": "Wed 9th Dec 2026 22:00",
                        "verified_gross_mass": "Fri 11th Dec 2026 08:00"
                      },
                      "legs": [
                        {
                          "sequence": 1,
                          "from": "SHANGHAI",
                          "from_code": "CNSHA",
                          "from_terminal": "SHANGHAI YANGSHAN SHANGDONG TERMINAL",
                          "to": "ROTTERDAM",
                          "to_code": "NLRTM",
                          "to_terminal": "ECT DELTA DDE TERMINAL",
                          "departure": "2026-12-15T05:30:00",
                          "arrival": "2027-01-29T18:30:00",
                          "vessel": {
                            "…": "4 fields"
                          },
                          "service": "GRIFFIN SERVICE",
                          "voyage": "0025W",
                          "port_calls": [
                            {
                              "…": "4 fields"
                            },
                            {
                              "…": "4 fields"
                            },
                            "… 2 more"
                          ]
                        }
                      ]
                    },
                    {
                      "service": "GRIFFIN SERVICE",
                      "direct": true,
                      "routing": "Direct",
                      "departure": "2026-12-16T22:30:00",
                      "arrival": "2027-02-01T03:30:00",
                      "transit_days": 47,
                      "transit": "47 days",
                      "vessel": "YM TROPHY",
                      "voyage": "023W",
                      "co2": "2.2915 Tons",
                      "cutoffs": {
                        "container_yard": "",
                        "reefer": "",
                        "dangerous_cargo": "",
                        "shipping_instructions": "",
                        "verified_gross_mass": ""
                      },
                      "legs": [
                        {
                          "sequence": 1,
                          "from": "SHANGHAI",
                          "from_code": "CNSHA",
                          "from_terminal": "SHANGHAI YANGSHAN SHANGDONG TERMINAL",
                          "to": "ROTTERDAM",
                          "to_code": "NLRTM",
                          "to_terminal": "ECT DELTA DDE TERMINAL",
                          "departure": "2026-12-16T22:30:00",
                          "arrival": "2027-02-01T03:30:00",
                          "vessel": {
                            "…": "4 fields"
                          },
                          "service": "GRIFFIN SERVICE",
                          "voyage": "023W",
