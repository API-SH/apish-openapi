    "/shutterstock/v1/search": {
      "get": {
        "operationId": "shutterstockSearch",
        "summary": "Shutterstock image search",
        "description": "Photos, vectors and illustrations on Shutterstock for keywords, with the site's filters (image type, orientation, sort, color, people, gender, age, ethnicity, excluded keywords, category): id, title, description, link, image type, aspect, editorial flag, upload date, preview images (260, 600, 1500 px; watermarked), the downloadable sizes, channels and contributor id. Also the total, the related searches and the filters applied. 100 images per page, pages up to 1000. Adult items are left out unless `include_nsfw=true` (which also turns the site's safe search off); every item carries `adult`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/shutterstock-search",
        "tags": [
          "Shutterstock"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keywords, e.g. `cat`.",
            "schema": {
              "type": "string"
            },
            "example": "cat"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-1000). Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "image_type",
            "in": "query",
            "required": false,
            "description": "photo, vector or illustration.",
            "schema": {
              "type": "string",
              "enum": [
                "photo",
                "vector",
                "illustration"
              ]
            }
          },
          {
            "name": "orientation",
            "in": "query",
            "required": false,
            "description": "horizontal or vertical.",
            "schema": {
              "type": "string",
              "enum": [
                "horizontal",
                "vertical"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevant (default), popular, newest or random.",
            "schema": {
              "type": "string",
              "enum": [
                "relevant",
                "popular",
                "newest",
                "random"
              ]
            }
          },
          {
            "name": "color",
            "in": "query",
            "required": false,
            "description": "A hex color, e.g. `ff0000`: images close to it.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "people_only",
            "in": "query",
            "required": false,
            "description": "`true`: only images with model-released people.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "number_of_people",
            "in": "query",
            "required": false,
            "description": "0, 1, 2, 3 or 4 (4 = four or more).",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1",
                "2",
                "3",
                "4"
              ]
            }
          },
          {
            "name": "gender",
            "in": "query",
            "required": false,
            "description": "male, female or both.",
            "schema": {
              "type": "string",
              "enum": [
                "male",
                "female",
                "both"
              ]
            }
          },
          {
            "name": "age",
            "in": "query",
            "required": false,
            "description": "infants, children, teenagers, 20s, 30s, 40s, 50s, 60s or older.",
            "schema": {
              "type": "string",
              "enum": [
                "infants",
                "children",
                "teenagers",
                "20s",
                "30s",
                "40s",
                "50s",
                "60s",
                "older"
              ]
            }
          },
          {
            "name": "ethnicity",
            "in": "query",
            "required": false,
            "description": "e.g. african, black, caucasian, chinese, east_asian, hispanic, japanese, middle_eastern, native_american, pacific_islander, south_asian, southeast_asian, other.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exclude",
            "in": "query",
            "required": false,
            "description": "Keywords to leave out, e.g. `cartoon`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A Shutterstock category name, e.g. `Animals/Wildlife`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_nsfw",
            "in": "query",
            "required": false,
            "description": "Opt in to items the site marks adult (and turn its safe search off). Default off.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
