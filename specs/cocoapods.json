    "/cocoapods/v1/search": {
      "get": {
        "operationId": "cocoapodsSearch",
        "summary": "Search CocoaPods",
        "description": "Searches CocoaPods (iOS and macOS libraries) by name, summary or author, best match first, with indexed version, summary, homepage, license, authors (names), platforms, Swift version, source, dependencies and historical download and app totals. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cocoapods-search",
        "tags": [
          "CocoaPods"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "json"
          },
          {
            "name": "author",
            "in": "query",
