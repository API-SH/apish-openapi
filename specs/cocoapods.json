    "/cocoapods/v1/versions": {
      "get": {
        "operationId": "cocoapodsVersions",
        "summary": "CocoaPods pod versions",
        "description": "Every published version of a pod with its publish time, newest first by default. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cocoapods-versions",
        "tags": [
          "CocoaPods"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "name",
            "in": "query",
            "required": true,
            "description": "Pod name (Alamofire), a Podfile line (pod 'Alamofire'), or a cocoapods.org link.",
            "schema": {
              "type": "string"
            },
            "example": "Alamofire"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "desc (newest first, default) or asc.",
            "schema": {
              "type": "string",
              "enum": [
                "desc",
                "asc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` gives the next one; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Versions per page, 1-500 (default 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "name": "Alamofire",
                  "latest_version": "5.12.2",
                  "versions": [
                    {
                      "version": "5.12.2",
                      "published": "2026-09-10T01:47:20Z"
                    },
                    {
                      "version": "5.12.1",
                      "published": "2026-09-09T02:42:12Z"
                    },
                    "… 98 more"
                  ],
                  "count": 100,
                  "total": 101,
                  "page": 1,
                  "next_page": 2,
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Create keys at https://app.api.sh/keys. Authorization: Bearer <key> also works."
      }
    },
    "parameters": {
      "raw": {
        "name": "raw",
        "in": "query",
        "required": false,
        "description": "0 leaves out the bulky `raw` source blocks (often 10-30x smaller).",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Comma-separated fields to return, e.g. `posts.id,posts.title`. Call metadata is always included.",
        "schema": {
          "type": "string"
        }
      },
      "fresh": {
        "name": "fresh",
        "in": "query",
        "required": false,
        "description": "1 skips the 24-hour cache and fetches live.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "output": {
        "name": "output",
        "in": "query",
        "required": false,
        "description": "csv or ndjson returns the response's records (its main list, or the object as one row) as CSV or NDJSON instead of JSON.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "ndjson"
          ]
        }
      },
      "records": {
        "name": "records",
        "in": "query",
        "required": false,
        "description": "With output=csv|ndjson: the top-level list to turn into rows (e.g. `reviews`), or `.` for the whole object as one row.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "On a 503 for a paused endpoint: the status page, which lists open incidents."
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "responses": {
      "E400": {
        "description": "A parameter is missing or invalid. Not charged (unless the call ran and the source rejected the value; credits_used says).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E402": {
        "description": "Not enough credits, a spend limit you set was reached (`spend_limit`), or the key's monthly credit cap was reached (`key_cap`). Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
        "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E502": {
        "description": "The source site failed this time; retry. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E503": {
        "description": "Endpoint paused or temporarily unavailable; may include retry-after, and status_url (https://api.sh/status) for a paused endpoint. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "headers": {
      "x-request-id": {
        "description": "The call's id (logs, re-fetch with /v1/results/{id}).",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "x-credits-used": {
        "description": "Credits charged for this call.",
        "schema": {
          "type": "integer"
        }
      },
      "x-credits-remaining": {
        "description": "Balance after the call.",
        "schema": {
          "type": "integer"
        }
      }
    }
  },
  "externalDocs": {
    "url": "https://api.sh/docs"
  }
}
