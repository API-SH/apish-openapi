    "/librarything/v1/reviews": {
      "get": {
        "operationId": "librarythingReviews",
        "summary": "LibraryThing member reviews",
        "description": "Member reviews of a LibraryThing work: review id, the reviewer's username and number of reviews, star rating, full text, date (and whether it was edited), thumbs-up count and link, plus the work's total review count.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/librarything-reviews",
        "tags": [
          "LibraryThing"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, from 1 (7 reviews a page, as on the site). Pass next_page back as page; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "featured (default), recent or thumbs.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Only reviews with this star rating (0.5-5).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Work id, or a librarything.com/work/... link.",
            "schema": {
              "type": "string"
            },
            "example": "8065"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
