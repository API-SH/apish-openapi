    "/gupy/v1/search": {
      "get": {
        "operationId": "gupySearch",
        "summary": "Search Gupy jobs",
        "description": "Job ads on the Gupy job portal (Brazil) by keyword, with every filter the portal has: work model (remote, hybrid, on site), job type (effective, internship, apprentice, trainee, temporary and the rest), state and city, company, ads also open to people with disabilities (PwD) and companies with the feedback badge, sorted by relevance, newest or oldest. Each job has id, title, link, company name, slug, logo and career page, type, work model, city, state, publication date, application deadline, PwD and feedback-badge flags and the description text. Pass `next_offset` back as `offset`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/gupy-search",
        "tags": [
          "Gupy"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Job title or keyword (e.g. desenvolvedor, analista, vendedor).",
            "schema": {
              "type": "string"
            },
            "example": "desenvolvedor"
          },
          {
            "name": "workplace",
            "in": "query",
            "required": false,
            "description": "remote, hybrid, on-site (or remoto, hibrido, presencial), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Job types, comma separated: effective, internship, apprentice, trainee, temporary, talent_pool, associate, summer, outsource, volunteer, lecturer, freelancer, autonomous, intermittent, legal_entity, partner.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "State name as the portal writes it (e.g. São Paulo, Rio de Janeiro, Minas Gerais).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City name (e.g. Campinas); use with state.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "description": "Company (career page) name exactly as shown on the portal, e.g. Stefanini Group.",
            "schema": {
