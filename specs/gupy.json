    "/gupy/v1/job": {
      "get": {
        "operationId": "gupyJob",
        "summary": "Gupy job ad",
        "description": "One job ad on a Gupy career page: title, internal code, status, job type, work model, PwD flag, publication date, application deadline and expiry, full address, hiring reason, the full description, responsibilities, requirements and additional information as text, the hiring steps (registration, tests, interviews), and the company (name, slug, logo, website, about). Give the job's link, or `id` with `company`, or `q` (plus any search filter) to open the newest matching current ad.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/gupy-job",
        "tags": [
          "Gupy"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Job link on <company>.gupy.io (/jobs/<id> or the portal's /job/<code> link).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job id (with company).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "description": "Career page slug, e.g. stefanini (with id).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Instead of url: open the first current job for this keyword (any search filter can be added).",
            "schema": {
              "type": "string"
            },
            "example": "analista"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "With q: relevance, newest or oldest.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "oldest"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": 12845927,
                  "url": "https://stefaninilatam.gupy.io/jobs/12845927",
                  "title": "Analista ETL - Oracle",
                  "code": "54256-12845927",
                  "status": "published",
                  "type": "effective",
                  "workplace": "hybrid",
                  "pwd": false,
                  "published_at": "2026-11-06T04:46:11.591Z",
                  "application_deadline": "2027-01-05",
                  "expires_at": "2026-12-25",
                  "address": {
                    "line": "San Salvador, San Salvador, El Salvador",
                    "district": null,
                    "city": "San Salvador",
                    "state": "San Salvador",
                    "state_code": null,
                    "country": "El Salvador",
                    "country_code": "SV",
                    "zip": null
                  },
                  "language": null,
                  "reason": "staff_increase",
                  "publication_type": "external",
                  "quick_apply": false,
                  "description": "¡Sé parte de Stefanini!\n\nEn Stefanini somos más de 30.000 genios, conectados desde 41 países, haciendo lo que les apasiona y co-creando un f…",
                  "responsibilities": "• Solucionar incidencias en procesos de generación de información que son utilizados en el día a día por las áreas de negocio.\n\n• Desarrolla…",
