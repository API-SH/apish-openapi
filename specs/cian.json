    },
    "/cian/v1/search": {
      "get": {
        "operationId": "cianSearch",
        "summary": "Cian property search (Russia)",
        "description": "Search Cian, Russia's largest property portal: flats, houses, land and commercial property for sale or rent, and flats in new-build complexes, in any region, with the total count. Filters: rooms (studio, 1-6, free layout), price, total, kitchen and living area, floor and floors in the building, build year, new-build or resale, owner listings only, long-term or daily rent, house type, publication date, one agent's or agency's listings (`user_id`), and any other Cian search filter through `json_query`. Sorts: price, price per m², area, newest. Each offer has its id, link, title, price in rubles, price per m², deposit and fees, rooms, areas, floor, building facts (floors, year, material, lifts), address with its parts, coordinates, districts, metro stations with walking or transport minutes, description, photos and layouts, phone numbers, the seller (agent, agency or owner), the new-build complex, the publication date, plus `raw`. 28 offers a page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cian-search",
        "tags": [
          "Cian"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "deal",
            "in": "query",
            "required": false,
            "description": "For sale (default) or for rent.",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent"
              ]
            },
            "example": "sale"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "flat (default: flats and rooms), house (houses, townhouses, land), commercial (offices, retail, warehouses and the like), newbuilding (flats in new-build complexes, sale only).",
            "schema": {
              "type": "string",
              "enum": [
                "flat",
                "house",
                "commercial",
                "newbuilding"
              ]
            },
            "example": "flat"
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Cian region id (default 1 Moscow; 2 Saint Petersburg, 4593 Moscow Oblast, 4588 Leningrad Oblast; all ids in /cian/v1/regions). Several comma-separated.",
            "schema": {
              "type": "string"
            },
            "example": "1"
          },
          {
            "name": "rooms",
            "in": "query",
            "required": false,
            "description": "Rooms, comma-separated: studio, 1, 2, 3, 4, 5, 6 (6 or more), free (free layout).",
            "schema": {
              "type": "string"
            },
            "example": "1,2"
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in rubles (monthly rent for rentals).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in rubles.",
            "schema": {
              "type": "number"
            },
            "example": "20000000"
          },
          {
            "name": "area_min",
            "in": "query",
            "required": false,
            "description": "Smallest total area, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "area_max",
            "in": "query",
            "required": false,
            "description": "Largest total area, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "kitchen_min",
            "in": "query",
            "required": false,
            "description": "Smallest kitchen, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "kitchen_max",
            "in": "query",
            "required": false,
            "description": "Largest kitchen, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "living_min",
            "in": "query",
            "required": false,
            "description": "Smallest living area, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "living_max",
            "in": "query",
            "required": false,
            "description": "Largest living area, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "floor_min",
            "in": "query",
            "required": false,
            "description": "Lowest floor.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "floor_max",
            "in": "query",
            "required": false,
            "description": "Highest floor.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "floors_total_min",
            "in": "query",
            "required": false,
            "description": "Fewest floors in the building.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "floors_total_max",
            "in": "query",
            "required": false,
            "description": "Most floors in the building.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_min",
            "in": "query",
            "required": false,
            "description": "Built in or after this year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_max",
            "in": "query",
            "required": false,
            "description": "Built in or before this year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "not_first_floor",
            "in": "query",
            "required": false,
            "description": "true: leave out ground-floor flats.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "not_last_floor",
            "in": "query",
            "required": false,
            "description": "true: leave out top-floor flats.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "building",
            "in": "query",
            "required": false,
            "description": "new: new-build only; secondary: resale only.",
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "secondary"
              ]
            }
          },
          {
            "name": "owner_only",
            "in": "query",
            "required": false,
            "description": "true: only listings by the owner (no agents).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "rent_term",
            "in": "query",
            "required": false,
            "description": "Flat rentals: long-term or daily.",
            "schema": {
              "type": "string",
              "enum": [
                "long",
                "daily"
              ]
            }
          },
          {
            "name": "house_type",
            "in": "query",
            "required": false,
            "description": "type=house: house, part (part of a house), land, townhouse; comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "published",
            "in": "query",
            "required": false,
            "description": "Only listings published within this window.",
            "schema": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "week",
                "month"
              ]
            }
          },
          {
            "name": "user_id",
            "in": "query",
            "required": false,
            "description": "Only this agent's or agency's listings (the seller id from a listing or /cian/v1/agent).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default relevance, as on the site).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "price_per_m2_asc",
                "area_desc",
                "newest"
              ]
            }
          },
          {
            "name": "json_query",
            "in": "query",
            "required": false,
            "description": "Any other Cian search filters as a JSON object in Cian's own format (each search answer echoes the full `json_query` it ran), e.g. {\"metro\":{\"type\":\"terms\",\"value\":[10]}}.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1, up to 60).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
