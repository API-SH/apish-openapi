    "/cian/v1/newbuildings": {
      "get": {
        "operationId": "cianNewbuildings",
        "summary": "Cian new-build complexes",
        "description": "New-build residential complexes (ЖК) in a region, with the total count: id, name, link, address, nearest metro with walking and driving minutes, description, rating and review count, builders with links and logos, sales status and completion dates, flats on sale by room count with price ranges, minimum areas and links, offer counts from the developer and from agents, promotions and photos, plus `raw`. 25 complexes a page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cian-newbuildings",
        "tags": [
          "Cian"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Cian region id (default 1 Moscow; see /cian/v1/regions).",
            "schema": {
              "type": "string"
            },
            "example": "1"
          },
          {
            "name": "rooms",
            "in": "query",
            "required": false,
            "description": "Only complexes with flats of these room counts: studio, 1-6, free; comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest flat price in rubles.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest flat price in rubles.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "finish_year",
            "in": "query",
            "required": false,
            "description": "Completion year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
