    "/cian/v1/regions": {
      "get": {
        "operationId": "cianRegions",
        "summary": "Cian regions",
        "description": "Cian's regions (Moscow, Saint Petersburg and every oblast, republic and krai) with the id for the `region` param of the other Cian endpoints, or with `parent_id` the cities and towns inside one region (their ids work as `region` too, e.g. 4777 Kazan): name, full name, parent, coordinates and whether it has districts and metro.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cian-regions",
        "tags": [
          "Cian"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Only places whose name contains this text (Russian names).",
            "schema": {
              "type": "string"
            },
            "example": "Татар"
          },
          {
            "name": "parent_id",
            "in": "query",
            "required": false,
            "description": "A region id: list the cities and towns inside it (e.g. 4618 Tatarstan).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
