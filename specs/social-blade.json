    "/socialblade/v1/top-growth": {
      "get": {
        "operationId": "socialbladeTopGrowth",
        "summary": "Social Blade top gainers and losers",
        "description": "Creators who gained (or lost) the most on a platform over the last 1 or 3 days, by metric: the top 10, 50 or 100 with each creator's gains (`gained`).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/socialblade-top-growth",
        "tags": [
          "Social Blade"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "platform",
