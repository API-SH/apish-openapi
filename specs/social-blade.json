    "/socialblade/v1/top": {
      "get": {
        "operationId": "socialbladeTop",
        "summary": "Social Blade top creators lists",
        "description": "Social Blade's top lists: the top 10, 50 or 100 creators of a platform by a metric, highest or lowest first. YouTube lists can be filtered by country, category and made-for-kids. Each creator has rank, id, username, name, counts and links.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/socialblade-top",
        "tags": [
          "Social Blade"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "platform",
            "in": "query",
            "required": false,
            "description": "Platform: `youtube`, `tiktok`, `instagram`, `twitch` or `facebook`.",
            "schema": {
              "type": "string",
              "enum": [
                "youtube",
                "tiktok",
                "instagram",
                "twitch",
                "facebook"
              ],
              "default": "youtube"
            },
            "example": "youtube"
          },
          {
            "name": "field",
            "in": "query",
            "required": false,
            "description": "Metric to rank by. YouTube: subscribers (default), views, videos. TikTok: followers (default), likes. Instagram: followers (default), posts. Twitch: followers. Facebook: likes (default), talking_about.",
            "schema": {
              "type": "string",
              "enum": [
                "subscribers",
                "views",
                "videos",
                "followers",
                "likes",
                "posts",
                "talking_about"
              ]
            },
            "example": "subscribers"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "`desc` (highest first, default) or `asc`.",
            "schema": {
              "type": "string",
              "enum": [
                "desc",
                "asc"
              ],
              "default": "desc"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "List size: 10, 50 or 100 (default).",
            "schema": {
              "type": "string",
              "enum": [
                "10",
                "50",
                "100"
              ],
              "default": "100"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "YouTube only: two-letter country code (e.g. `US`, `IN`, `GB`).",
            "schema": {
              "type": "string"
            },
            "example": "US"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "YouTube only: channel category.",
            "schema": {
              "type": "string",
              "enum": [
                "games",
                "entertainment",
                "people",
                "animals",
                "film",
                "music",
                "sports",
                "tech",
                "howto",
                "news",
                "education",
                "comedy",
                "nonprofit",
                "autos",
                "travel",
                "shows"
              ]
            }
          },
          {
            "name": "made_for_kids",
            "in": "query",
            "required": false,
            "description": "YouTube only: `true` for made-for-kids channels only, `false` to exclude them.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
