    "/canva/v1/templates": {
      "get": {
        "operationId": "canvaTemplates",
        "summary": "Canva template search",
        "description": "Canva's public templates for keywords or a category, with every filter of the templates page: format, style, theme, feature (animation, video, audio), subject, topic, grade, event, cause, free or Pro, and colour. Each template: id, title, link, free or Pro, page count, background colour, thumbnails, and for animated templates their video previews. Also the total, related searches and the facets (each filter group with its options, values and counts). 50 per page; pass `next_cursor` back as `cursor`; null on the last page (the site lists up to 5,000).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/canva-templates",
        "tags": [
          "Canva"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `resume` or `instagram post`. Required unless `category` is given.",
            "schema": {
              "type": "string"
            },
            "example": "resume"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A category slug from /canva/v1/categories, e.g. `resumes` or `presentations` (instead of `query`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "format",
            "in": "query",
            "required": false,
            "description": "Format code from the Format facet (presentations), e.g. `0br` for 16:9.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "style",
            "in": "query",
            "required": false,
            "description": "Style, e.g. `modern`, `minimalist`, `professional` (values in the Style facet); several comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "theme",
            "in": "query",
            "required": false,
            "description": "Theme, e.g. `corporate`, `education` (values in the Theme facet).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "feature",
            "in": "query",
            "required": false,
            "description": "animation, video or audio.",
            "schema": {
              "type": "string",
              "enum": [
                "animation",
                "video",
                "audio"
              ]
            }
          },
          {
            "name": "subject",
            "in": "query",
            "required": false,
            "description": "Subject (education templates), e.g. `business`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "topic",
            "in": "query",
            "required": false,
            "description": "Topic, e.g. `graphic_design`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "grade",
            "in": "query",
            "required": false,
            "description": "Grade, e.g. `kindergarten`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "event",
            "in": "query",
            "required": false,
            "description": "Event, e.g. `christmas`, `halloween`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cause",
            "in": "query",
            "required": false,
            "description": "Cause, e.g. `sustainable`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price",
            "in": "query",
            "required": false,
            "description": "free or pro.",
            "schema": {
              "type": "string",
              "enum": [
                "free",
                "pro"
              ]
            }
          },
          {
            "name": "color",
            "in": "query",
            "required": false,
            "description": "A colour from the Color facet as six hex digits, e.g. `101020`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pass `next_cursor` back (a multiple of 50).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
