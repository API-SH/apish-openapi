    "/kakaku/v1/search": {
      "get": {
        "operationId": "kakakuSearch",
        "summary": "Kakaku.com product search",
        "description": "Products matching a keyword on Kakaku.com (価格.com): `id`, `name`, `maker`, `category`, `url`, `image`, `price` (lowest, yen; `price_from` when it is a starting price), `rating`, `reviews`, `comments`, `release`, `shops`, `specs`, `sponsored`. `categories` lists category codes with counts for `category`. 50 a page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kakaku-search",
        "tags": [
          "Kakaku.com"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keyword (Japanese or English).",
            "schema": {
              "type": "string"
            },
            "example": "iphone"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "`popular` (default), `price_asc` or `price_desc`.",
            "schema": {
              "type": "string",
              "enum": [
                "popular",
                "price_asc",
                "price_desc"
              ]
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Lowest price (yen).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
