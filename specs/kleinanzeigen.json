    "/kleinanzeigen/v1/search": {
      "get": {
        "operationId": "kleinanzeigenSearch",
        "summary": "Kleinanzeigen listing search",
        "description": "Classified listings on Kleinanzeigen (Germany) for keywords, with the site's filters: category, location and radius, price range, private or commercial sellers, offers or wanted ads, and sort (newest, lowest or highest price). Each listing: id, title, link, description snippet, price and label, negotiable (VB) and free flags, postal code and place, posting time, shipping and direct-buy flags, image and image count, shop link for commercial sellers. `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kleinanzeigen-search",
        "tags": [
          "Kleinanzeigen"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keywords, e.g. `iphone`.",
            "schema": {
              "type": "string"
            },
            "example": "iphone"
          },
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "description": "The site's category number, e.g. 173 (phones), 217 (bicycles).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location_id",
            "in": "query",
            "required": false,
            "description": "The site's location number, e.g. 3331 (Berlin).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Kilometres around the location: 5, 10, 20, 30, 50, 100, 150, 200.",
            "schema": {
              "type": "string",
              "enum": [
                "5",
                "10",
                "20",
                "30",
                "50",
                "100",
                "150",
                "200"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in euros.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in euros.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "seller",
            "in": "query",
            "required": false,
            "description": "private or commercial.",
            "schema": {
              "type": "string",
              "enum": [
                "private",
                "commercial"
              ]
            }
          },
          {
            "name": "ad_type",
            "in": "query",
            "required": false,
            "description": "offer (items offered) or wanted (people looking for an item). Default: both.",
            "schema": {
              "type": "string",
              "enum": [
                "offer",
                "wanted"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "newest (default), price_asc or price_desc.",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "price_asc",
                "price_desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "iphone",
                  "sort": "newest",
                  "page": 1,
                  "heading": "1 - 25 von 158.892 Ergebnissen für „iphone“ in Deutschland",
                  "total": 158892,
                  "count": 27,
                  "next_page": 2,
                  "url": "https://www.kleinanzeigen.de/s-iphone/k0",
                  "items": [
                    {
                      "id": "3427324948",
                      "title": "iPhone 16 Pro 256GB TOP ZUSTAND Aussteller mit 1 Jahr Garantie v. DE Händler",
                      "url": "https://www.kleinanzeigen.de/s-anzeige/iphone-16-pro-256gb-top-zustand-aussteller-mit-1-jahr-garantie-v-de-haendler/3427324948-173-1907",
                      "description": "Wir haben das iPhone 16 Pro 256GB im Angebot.\n\n- Neuwertiger Zustand\n- Voll funktionsfähig und in einem einwandfreien Zustand\n- Akkukapazitä…",
