{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Barcode Lookup",
    "version": "1.0.0",
    "description": "The Barcode Lookup API from API.SH: public Barcode Lookup data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Barcode Lookup",
      "description": "1 endpoint (public data)",
      "x-slug": "barcode-lookup",
      "x-domains": []
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/barcode/v1/lookup": {
      "get": {
        "operationId": "barcodeLookup",
        "summary": "Product by barcode (GTIN / EAN / UPC)",
        "description": "A product by its barcode: EAN-13, EAN-8, UPC-A, UPC-E or GTIN-14 (the check digit is verified; UPC-E is expanded). Looked up in the open product databases (food, cosmetics, pet food and other products; open data under the ODbL, `source` and `license` say where a record comes from). Returns name, generic name, brands, quantity and net quantity, serving size, categories, labels, origins, manufacturing places, countries and stores, packaging, packager codes, ingredients, allergens, traces, additives, vegan / vegetarian / palm-oil-free flags, nutrition facts per 100 g and per serving (energy, fat, saturated fat, carbohydrates, sugars, fiber, protein, salt, sodium and, when the label lists them, vitamins A, B1-B12, C, D, E and K, minerals such as calcium, iron, magnesium, zinc, phosphorus, potassium, copper, selenium and iodine, mono- and polyunsaturated fat, omega-3 and omega-6, starch, polyols, lactose, caffeine and taurine, all in grams), `ingredients_detail` (the parsed ingredient list: id, text, stated and estimated percent, vegan / vegetarian / palm-oil flags, E-number and additive class, origins and sub-ingredients), Nutri-Score, NOVA group, Eco-Score, food groups, product images (front, ingredients, nutrition, packaging), languages, completeness, scan count and created / updated dates. `raw=true` adds the full record. Answers 404 when no database knows the barcode.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/barcode-lookup",
        "tags": [
          "Barcode Lookup"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "gtin",
            "in": "query",
            "required": true,
            "description": "Barcode digits (8, 12, 13 or 14).",
            "schema": {
              "type": "string"
            },
            "example": "3017624010701"
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "Which database to ask.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "food",
                "beauty",
                "petfood",
                "products"
              ],
              "default": "all"
            }
          },
          {
            "name": "raw",
            "in": "query",
            "required": false,
            "description": "Also return the full record.",
            "schema": {
              "type": "boolean",
              "default": "false"
            }
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "gtin": "3017624010701",
                  "gtin_normalized": "3017624010701",
                  "check_digit_valid": true,
                  "found": true,
                  "product": {
                    "gtin": "3017624010701",
                    "name": "Nutella",
                    "generic_name": null,
                    "brands": [
                      "Ferrero"
                    ],
                    "brand_owner": null,
                    "quantity": "400.0 g",
                    "net_quantity": 400,
                    "net_quantity_unit": "g",
                    "serving_size": null,
                    "categories": [
                      "breakfasts",
                      "spreads",
                      "… 6 more"
                    ],
                    "labels": [
                      "no gluten"
                    ],
                    "origins": null,
                    "manufacturing_places": null,
                    "countries": [
                      "france",
                      "united kingdom"
                    ],
                    "stores": [
                      "Sainsbury's",
                      "Tesco"
                    ],
                    "packaging": [
                      "glass jar"
                    ],
                    "packager_codes": [],
                    "ingredients": "sugar, palm oil, hazelnuts (13%), skimmed milk powder (8.7%), fat reduced cocoa (7.4%), emulsifier: lecithins (soya), vanillin",
                    "ingredients_count": 7,
                    "ingredients_detail": [
                      {
                        "id": "de:sugar",
                        "text": "sugar",
                        "percent": null,
                        "percent_estimate": 58.62,
                        "percent_min": null,
                        "percent_max": null,
                        "vegan": null,
                        "vegetarian": null,
                        "from_palm_oil": null,
                        "e_number": null,
                        "additive_class": null,
                        "origins": null,
                        "labels": null,
                        "processing": null,
                        "sub_ingredients": []
                      },
                      {
                        "id": "de:palm oil",
                        "text": "palm oil",
                        "percent": null,
                        "percent_estimate": 18.04,
                        "percent_min": null,
                        "percent_max": null,
                        "vegan": null,
                        "vegetarian": null,
                        "from_palm_oil": null,
                        "e_number": null,
                        "additive_class": null,
                        "origins": null,
                        "labels": null,
                        "processing": null,
                        "sub_ingredients": []
                      },
                      "… 5 more"
                    ],
                    "allergens": [
                      "nuts"
                    ],
                    "traces": [
                      "milk",
                      "nuts",
                      "… 1 more"
                    ],
                    "additives": [],
                    "vegan": false,
                    "vegetarian": false,
                    "palm_oil_free": false,
                    "nutrition_per": "100g",
                    "nutrition_100g": {
                      "energy_kcal": 539,
                      "energy_kj": 2228,
                      "fat_g": 30.9,
                      "saturated_fat_g": 10.6,
                      "carbohydrates_g": 57.5,
                      "sugars_g": 56.3,
                      "added_sugars_g": 0,
                      "proteins_g": 6.3,
                      "salt_g": 0.1075,
                      "sodium_g": 0.043
                    },
                    "nutrition_serving": null,
                    "nutriscore_grade": "e",
                    "nutriscore_score": 31,
                    "nova_group": null,
                    "ecoscore_grade": "d",
                    "ecoscore_score": 35,
                    "food_groups": [
                      "sugary snacks",
                      "sweets"
                    ],
                    "period_after_opening": null,
                    "images": {
                      "front": "https://images.openfoodfacts.org/images/products/301/762/401/0701/front_en.100.400.jpg",
                      "ingredients": "https://images.openfoodfacts.org/images/products/301/762/401/0701/ingredients_en.60.400.jpg",
                      "nutrition": "https://images.openfoodfacts.org/images/products/301/762/401/0701/nutrition_en.63.400.jpg",
                      "packaging": "https://images.openfoodfacts.org/images/products/301/762/401/0701/packaging_en.65.400.jpg"
                    },
                    "manufacturer_url": null,
                    "languages": [
                      "de",
                      "en",
                      "… 2 more"
                    ],
                    "completeness": 0.7625,
                    "…": "7 more fields"
                  },
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Create keys at https://app.api.sh/keys. Authorization: Bearer <key> also works."
      }
    },
    "parameters": {
      "raw": {
        "name": "raw",
        "in": "query",
        "required": false,
        "description": "0 leaves out the bulky `raw` source blocks (often 10-30x smaller).",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Comma-separated fields to return, e.g. `posts.id,posts.title`. Call metadata is always included.",
        "schema": {
          "type": "string"
        }
      },
      "fresh": {
        "name": "fresh",
        "in": "query",
        "required": false,
        "description": "1 skips the 24-hour cache and fetches live.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "output": {
        "name": "output",
        "in": "query",
        "required": false,
        "description": "csv or ndjson returns the response's records (its main list, or the object as one row) as CSV or NDJSON instead of JSON.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "ndjson"
          ]
        }
      },
      "records": {
        "name": "records",
        "in": "query",
        "required": false,
        "description": "With output=csv|ndjson: the top-level list to turn into rows (e.g. `reviews`), or `.` for the whole object as one row.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "On a 503 for a paused endpoint: the status page, which lists open incidents."
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "responses": {
      "E400": {
        "description": "A parameter is missing or invalid. Not charged (unless the call ran and the source rejected the value; credits_used says).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E402": {
        "description": "Not enough credits, a spend limit you set was reached (`spend_limit`), or the key's monthly credit cap was reached (`key_cap`). Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
        "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E502": {
        "description": "The source site failed this time; retry. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E503": {
        "description": "Endpoint paused or temporarily unavailable; may include retry-after, and status_url (https://api.sh/status) for a paused endpoint. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "headers": {
      "x-request-id": {
        "description": "The call's id (logs, re-fetch with /v1/results/{id}).",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "x-credits-used": {
        "description": "Credits charged for this call.",
        "schema": {
          "type": "integer"
        }
      },
      "x-credits-remaining": {
        "description": "Balance after the call.",
        "schema": {
          "type": "integer"
        }
      }
    }
  },
  "externalDocs": {
    "url": "https://api.sh/docs"
  }
}
