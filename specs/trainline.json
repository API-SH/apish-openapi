    "/trainline/v1/route": {
      "get": {
        "operationId": "trainlineRoute",
        "summary": "Trainline route: times, trains per day, fares from",
        "description": "Everything Trainline publishes about a train route between two cities or stations: average, fastest and slowest journey time, trains per day (and direct ones), first and last departure, changes, distance, operators, lowest fare and currency, a sample timetable of upcoming departures, customer rating and short reviews (first name only), editorial trip reviews, the FAQ, similar routes and top destinations from both ends. Works for British and European routes (London to Manchester, Paris to Lyon, Rome to Milan).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/trainline-route",
        "tags": [
          "Trainline"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Origin city or station name or slug (e.g. `london`, `paris`, `london-euston`).",
            "schema": {
              "type": "string"
            },
            "example": "london"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Destination city or station name or slug.",
            "schema": {
              "type": "string"
            },
            "example": "manchester"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "url": "https://www.thetrainline.com/train-times/london-to-manchester",
                  "from": {
                    "id": "2144c4ddc11461cf9b03af198933e8df",
                    "name": "London",
                    "slug": "london",
                    "urn": "urn:trainline:generic:loc:182gb",
                    "code": "182",
                    "country_code": "GB",
                    "lat": null,
                    "lng": null
                  },
