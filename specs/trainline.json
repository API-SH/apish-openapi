    "/trainline/v1/locations": {
      "get": {
        "operationId": "trainlineLocations",
        "summary": "Trainline station and city search",
        "description": "Stations, station groups (a city with all its stations), bus stops and airports that Trainline sells tickets to across Great Britain and Europe: code (URN), short code, type, country, time zone, the carriers that serve it, and a slug for the route and board endpoints.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/trainline-locations",
        "tags": [
          "Trainline"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Station or city name (2+ characters).",
            "schema": {
              "type": "string"
            },
            "example": "manchester"
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Language of the names. Default `en-GB`.",
            "schema": {
              "type": "string",
              "enum": [
                "en-GB",
                "en-US",
                "fr-FR",
                "de-DE",
                "it-IT",
                "es-ES",
                "nl-NL",
                "pt-PT",
                "pl-PL",
                "cs-CZ",
                "sv-SE",
                "da-DK"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Only one location type, e.g. `station` or `stationGroup`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "manchester",
                  "locale": "en-GB",
                  "count": 17,
                  "locations": [
                    {
                      "code": "urn:trainline:generic:loc:MAN2968gb",
