    "/trainline/v1/service": {
      "get": {
        "operationId": "trainlineService",
        "summary": "Trainline UK train calling points",
        "description": "One train from a live board (or the next one leaving the station when no id is given): operator, every calling point with scheduled and expected time, platform, whether the train has left, and where it is now. Service ids come from /trainline/v1/departures or /trainline/v1/arrivals and are valid on their day only.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/trainline-service",
        "tags": [
          "Trainline"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "station",
            "in": "query",
            "required": true,
            "description": "The board station the id came from (name or slug).",
            "schema": {
              "type": "string"
            },
            "example": "london-euston"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Service `id` from a departures or arrivals board. Without it: the next service on the station's board.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "board",
            "in": "query",
            "required": false,
            "description": "Board the id came from. Default `departures`.",
            "schema": {
              "type": "string",
              "enum": [
                "departures",
                "arrivals"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
