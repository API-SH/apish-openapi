    "/compass/v1/listing": {
      "get": {
        "operationId": "compassListing",
        "summary": "Compass home details",
        "description": "One home on Compass: ids, status, price, price per sq ft, last sold price, address, neighborhood, coordinates, beds, baths, size, lot, stories, property type, year built, description, amenities, key details (taxes, HOA, days on market, MLS type...), listing details, pet policy, outdoor space, parking, view, tax assessment, nearby schools with grades and ratings, parcel number, every photo, listed and updated dates, status and price history, and the listing agents (name, role, company, phone, email, profile), plus `raw`. `latest=true` takes the first result of a search instead of a link.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/compass-listing",
        "tags": [
          "Compass"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A compass.com /homedetails/... link (url of a search result).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.compass.com/homedetails/1011-Brodie-St-Unit-14-Austin-TX-78704/1F40XY_pid/"
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "Use the first result of a search (pass the search params, e.g. location).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
