    "/compass/v1/search": {
      "get": {
        "operationId": "compassSearch",
        "summary": "Compass home search",
        "description": "Homes for sale, for rent or recently sold on Compass in a US city or neighborhood, with the site's filters: price, beds, baths, size, year built, HOA, days on market, property type, features (pool, garage, waterfront, doorman, elevator, washer in unit, outdoor space, air conditioning, basement, accessible) and keywords, plus sort. Each result has the listing id, link, price, address, beds, baths, size, lot, property type, status, badges (e.g. coming soon), coordinates and photos. `total` is the site's match count. 41 per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/compass-search",
        "tags": [
          "Compass"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "description": "City or neighborhood: a Compass place slug such as austin-tx, manhattan-ny or bouldin-creek-austin-tx, a compass.com search link, or a name such as \"Austin, TX\".",
            "schema": {
              "type": "string"
            },
            "example": "austin-tx"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Listing status (sold: the last 90 days).",
            "schema": {
              "type": "string",
              "enum": [
                "for_sale",
                "rent",
                "sold"
              ]
            },
            "example": "for_sale"
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Property type.",
            "schema": {
              "type": "string",
              "enum": [
                "single_family",
                "condo",
                "townhouse",
                "co_op",
                "multi_family",
                "land",
                "other"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (USD).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price (USD).",
            "schema": {
              "type": "number"
            },
            "example": "900000"
          },
          {
            "name": "beds_min",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "beds_max",
            "in": "query",
            "required": false,
            "description": "Maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "baths_min",
            "in": "query",
            "required": false,
            "description": "Minimum bathrooms.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "baths_max",
            "in": "query",
            "required": false,
            "description": "Maximum bathrooms.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sqft_min",
            "in": "query",
            "required": false,
            "description": "Minimum size (sq ft).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sqft_max",
            "in": "query",
            "required": false,
            "description": "Maximum size (sq ft).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "year_built_min",
            "in": "query",
            "required": false,
            "description": "Built in or after this year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_built_max",
            "in": "query",
            "required": false,
            "description": "Built in or before this year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hoa_max",
            "in": "query",
            "required": false,
            "description": "Maximum monthly HOA fee (USD).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "days_on_market_max",
            "in": "query",
            "required": false,
            "description": "Listed within this many days.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "features",
            "in": "query",
            "required": false,
            "description": "Required features, comma list: pool, garage, waterfront, doorman, elevator, washer_in_unit, outdoor_space, air_conditioning, basement, accessible.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "keywords",
            "in": "query",
            "required": false,
            "description": "Keywords in the listing.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_desc",
                "price_asc",
                "newest",
                "sqft_desc",
                "sqft_asc"
              ]
            },
            "example": "relevance"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Result page (1 = first).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
