    "/spitogatos/v1/search": {
      "get": {
        "operationId": "spitogatosSearch",
        "summary": "Spitogatos property search",
        "description": "Greek property listings for sale or rent (residential, commercial, land) in one or more areas, with the site's filters: property types, price, living area, rooms, floor, construction year, energy class, and yes/no features (new development, air conditioning, furnished, elevator, parking garage, storage, fireplace, garden, pool, view, penthouse, student home, auction, accessible, reduced price and more), recently added, and sort. Each listing has price and price changes, area, rooms, bathrooms, floor, location with coordinates, description, flags, dates, photos and the agency (name, phones, address), plus `raw`. 30 a page; pass `next_page` back as `page` (null on the last page).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/spitogatos-search",
        "tags": [
          "Spitogatos"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "area_ids",
            "in": "query",
            "required": true,
            "description": "Area ids, comma separated (from /spitogatos/v1/areas; 100 is Athens - Center).",
            "schema": {
              "type": "string"
            },
            "example": "100"
          },
          {
            "name": "listing_type",
            "in": "query",
            "required": false,
            "description": "sale or rent (default sale).",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Default residential.",
            "schema": {
              "type": "string",
              "enum": [
                "residential",
                "commercial",
                "land",
                "other"
              ]
            }
          },
          {
            "name": "property_types",
            "in": "query",
            "required": false,
            "description": "Comma separated (e.g. apartment, studio, maisonette, detached, villa, building, loft, bungalow).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (EUR).",
            "schema": {
              "type": "integer"
            },
            "example": "100000"
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price (EUR).",
            "schema": {
              "type": "integer"
            },
            "example": "300000"
          },
          {
            "name": "area_min",
            "in": "query",
            "required": false,
            "description": "Minimum living area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "area_max",
            "in": "query",
            "required": false,
            "description": "Maximum living area (m²).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "rooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "rooms_max",
            "in": "query",
            "required": false,
            "description": "Maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "floor_min",
            "in": "query",
            "required": false,
            "description": "Lowest floor.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "floor_max",
            "in": "query",
            "required": false,
            "description": "Highest floor.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "construction_year_min",
            "in": "query",
            "required": false,
            "description": "Built in or after.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "construction_year_max",
            "in": "query",
            "required": false,
            "description": "Built in or before.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "energy_class",
            "in": "query",
            "required": false,
            "description": "That energy class or better: A+, A, B+, B, C, D, E, F, G, H.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "new_development",
            "in": "query",
            "required": false,
            "description": "true: new developments.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "air_conditioning",
            "in": "query",
            "required": false,
            "description": "true: with air conditioning.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "furnished",
            "in": "query",
            "required": false,
            "description": "true: furnished.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "elevator",
            "in": "query",
            "required": false,
            "description": "true: with elevator.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "garage",
            "in": "query",
            "required": false,
            "description": "true: with parking.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "storage",
            "in": "query",
            "required": false,
