    "/batdongsan/v1/search": {
      "get": {
        "operationId": "batdongsanSearch",
        "summary": "Batdongsan property search",
        "description": "Vietnamese property listings from Batdongsan for any category and place, by the site's own search path (for example `ban-can-ho-chung-cu-ha-noi` for apartments for sale in Hanoi, `cho-thue-nha-rieng-tp-hcm` for houses to rent in Ho Chi Minh City), or by a full search link with every filter and sort the site's search adds to it. Each listing has title, price, area, price per m², bedrooms, bathrooms, district and ward, description, posting date, listing tier, project id, the agent's name and profile link, video flag, photo count and photos. `total` is the site's count. 30 a page; pass `next_page` back as `page` (null on the last page).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/batdongsan-search",
        "tags": [
          "Batdongsan"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": false,
            "description": "A search path from the site, e.g. `ban-can-ho-chung-cu-ha-noi`, `ban-nha-rieng-quan-7`, `cho-thue-van-phong-ha-noi` (default `nha-dat-ban`, all property for sale).",
            "schema": {
              "type": "string"
            },
            "example": "ban-can-ho-chung-cu-ha-noi"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A batdongsan.com.vn search link, with any filters and sort the site put in it (e.g. `?sortValue=8`), instead of `path`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
