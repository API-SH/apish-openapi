    "/milanuncios/v1/search": {
      "get": {
        "operationId": "milanunciosSearch",
        "summary": "Milanuncios classifieds search",
        "description": "Search Spain's largest general classifieds site in any category and place, with every filter the site's search accepts: keywords, category, location, price, seller type (private or professional), offers or wanted ads, publication age, and the motor, property and boat filters (year, kilometres, power, fuel, gearbox, environmental label, make and model, rooms, bathrooms, surface, length and more). Any other filter of the site's search links (for example `fuels`, `cajacambio`, `carMake`, `environmentalLabel`, `itemCondition`) is accepted under its own name. Each ad has title, description, price (cash and financed), category path, city/province/region, seller type and id, tags, flags and photos, plus `raw`. `applied_filters` echoes how the site read the search. About 40 ads a page; pass `next_page` back as `page` (null on the last page, the site serves up to 200 pages).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/milanuncios-search",
        "tags": [
          "Milanuncios"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `bicicleta`.",
            "schema": {
              "type": "string"
            },
            "example": "bicicleta"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug as in the site's links, e.g. `coches-de-segunda-mano`, `pisos`, `moviles` (default all categories). See /milanuncios/v1/categories.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Place slug as in the site's links: a province (`madrid`), or a city with its province (`vigo-pontevedra`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "price_asc",
                "price_desc",
                "year_desc",
                "year_asc",
                "km_asc",
                "surface",
                "length",
                "distance"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price in EUR.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price in EUR.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "seller_type",
            "in": "query",
            "required": false,
            "description": "Only private or professional sellers.",
            "schema": {
              "type": "string",
              "enum": [
                "private",
                "professional"
              ]
            }
          },
          {
            "name": "transaction",
            "in": "query",
            "required": false,
            "description": "`offer` (default) or `demand` for wanted ads.",
            "schema": {
              "type": "string",
              "enum": [
                "offer",
                "demand"
              ]
            }
          },
          {
            "name": "published_within_days",
            "in": "query",
            "required": false,
            "description": "Only ads published in the last N days (1, 7, 15, 30).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_min",
            "in": "query",
            "required": false,
            "description": "Vehicles: first registration year from.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_max",
            "in": "query",
            "required": false,
            "description": "Vehicles: first registration year to.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "km_min",
            "in": "query",
            "required": false,
            "description": "Vehicles: kilometres from.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "km_max",
            "in": "query",
            "required": false,
            "description": "Vehicles: kilometres to.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hp_min",
