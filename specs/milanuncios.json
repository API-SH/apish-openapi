    "/milanuncios/v1/shop": {
      "get": {
        "operationId": "milanunciosShop",
        "summary": "Milanuncios professional shop",
        "description": "A professional shop on Milanuncios (a dealer, agency or business) and its ads: shop id, name, type, address and areas, then the ads with price, category path, location, business phone and photos. About 30 ads a page; pass `next_page` back as `page` (null on the last page).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/milanuncios-shop",
        "tags": [
          "Milanuncios"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "shop",
            "in": "query",
            "required": true,
            "description": "Shop slug from its link (`/tiendas-profesionales/rodovigo--328282`), or the link.",
            "schema": {
              "type": "string"
            },
            "example": "rodovigo--328282"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
