    "/workday/v1/jobs": {
      "get": {
        "operationId": "workdayJobs",
        "summary": "Workday career site jobs",
        "description": "Open jobs on any company's Workday career site (`*.myworkdayjobs.com`), with search and the site's own facets (job category, location, country, job type, time type…). `total` is the site's count (Workday reports at most 2,000). Facets come back in `facets`; pass a value's `filter` (e.g. `jobFamilyGroup:0c40f6bd1d8f10ae43ffaefd46dc7e78`) back as `filter` (repeatable). Each job: `id` (its path, for `/workday/v1/job`), `title`, `location`, `locations`, `employment_type`, `posted_at` (date from the site's \"Posted N Days Ago\"), `posted_label`, `requisition_id`, `url`, `apply_url` and `raw`, in the same shape as the other job board endpoints. Pass `next_page` back as `page`; null on the last page. An unknown career site answers 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/workday-jobs",
        "tags": [
          "Workday"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "description": "The company's Workday career site URL (`https://<tenant>.wdN.myworkdayjobs.com/<site>`, any page of it, with or without a locale), a `wdN.myworkdaysite.com/recruiting/<tenant>/<site>` URL, or the short form `<tenant>.wdN/<site>`.",
            "schema": {
              "type": "string"
            },
            "example": "https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Facet filters as `facet:id` from `facets[].values[].filter`. Repeatable.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Jobs per page (default and max 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "company": "nvidia",
                  "site": "NVIDIAExternalCareerSite",
                  "board_url": "https://nvidia.wd5.myworkdayjobs.com/NVIDIAExternalCareerSite",
                  "total": 2000,
                  "count": 20,
                  "page": 1,
                  "per_page": 20,
                  "next_page": 2,
