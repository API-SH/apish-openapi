    "/drushim/v1/job": {
      "get": {
        "operationId": "drushimJob",
        "summary": "Drushim job ad",
        "description": "One Drushim job ad: title, employer, categories and subcategories, regions, zones and addresses, scope, experience, salary range, benefits, the full description and requirements (HTML and text), employment type, posting and expiry dates, apply link and recommended jobs. Give the job `url` (url in search results), or `q` (with search filters) to open the first current result.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/drushim-job",
        "tags": [
          "Drushim"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The job's drushim.co.il URL (drushim.co.il/job/<code>/<hash>/).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords: opens the first current search result.",
            "schema": {
              "type": "string"
            },
            "example": "developer"
          },
          {
            "name": "area",
            "in": "query",
            "required": false,
            "description": "With q: area ids.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
