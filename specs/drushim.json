          }
        }
      }
    },
    "/drushim/v1/search": {
      "get": {
        "operationId": "drushimSearch",
        "summary": "Search Drushim jobs",
        "description": "Job ads on Drushim (Israel) for keywords, with the site's filters: category, subcategory, area, experience, job scope and no-CV-needed. Each result has the title, employer, categories, regions and zones, addresses with coordinates, scope, experience, salary range, benefits, description and requirements and the posting time. `facets` gives every filter value with counts. 10 per page; pass `next_page` back as `page`. Texts are mostly in Hebrew.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/drushim-search",
        "tags": [
          "Drushim"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords (Hebrew or English).",
            "schema": {
              "type": "string"
            },
            "example": "developer"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category id (facets.categories; e.g. 6 high-tech software).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subcategory",
            "in": "query",
            "required": false,
            "description": "Subcategory ids, comma separated (facets.subcategories).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "area",
