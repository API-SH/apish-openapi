    "/cvlibrary/v1/job": {
      "get": {
        "operationId": "cvlibraryJob",
        "summary": "CV-Library job",
        "description": "One CV-Library job in full: title, employer (id, name, type, logo), the contact named on the advert, location (area, county, postcode, coordinates), salary, job types, categories, remote flag, posted and closing dates, summary, full description as text and HTML, number of applications, apply type and link, featured and hidden-salary flags and the employer's reference. A job that has closed answers 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cvlibrary-job",
        "tags": [
          "CV-Library"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job number (e.g. 225788486) or the job's link (id or latest is needed).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.cv-library.co.uk/job/225788486/data-developer-12-month-contract"
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "true: the newest London developer job (an example that never expires).",
            "schema": {
              "type": "boolean"
            }
          },
