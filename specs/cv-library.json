              "type": "string"
            },
            "example": "london"
          },
          {
            "name": "distance",
            "in": "query",
            "required": false,
            "description": "Radius in miles around the location (1, 2, 5, 7, 10, 15, 20, 25, 35, 50, 75, 100, 250, 500, 750; default 15).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "posted",
            "in": "query",
            "required": false,
            "description": "Posted within this many days: 1, 2, 3, 7, 15 or 30.",
