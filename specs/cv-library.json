    "/cvlibrary/v1/search": {
      "get": {
        "operationId": "cvlibrarySearch",
        "summary": "CV-Library job search",
        "description": "Search UK jobs on CV-Library by keyword and/or location with the site's filters: radius in miles, posted within 1-30 days, job type (permanent, contract, temporary, part time; several comma-separated), salary range (annual, daily or hourly GBP), sort (relevance, newest, salary high/low, distance) and 20 or 50 results per page. Each job has id, title, link, employer (id, name, type), location (area, county, coordinates, distance), salary (period, min/max and annualised), job types, categories, posted date, summary, remote and featured flags, number of applications, apply type and link, logo and the other locations the same job is posted in. Jobs the board takes from partner feeds have `partner_listing` true and link to their apply page. Also the resolved location and radius, and facets (nearby locations, categories, related job titles) with counts. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cvlibrary-search",
        "tags": [
          "CV-Library"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Job title, skill or keyword (q or location is needed).",
            "schema": {
              "type": "string"
            },
            "example": "developer"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
