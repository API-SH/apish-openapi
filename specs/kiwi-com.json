    "/kiwi/v1/places": {
      "get": {
        "operationId": "kiwiPlaces",
        "summary": "Kiwi.com place lookup",
        "description": "Places (cities, airports, countries, stations) matching a name or code, with the Kiwi.com place id the flight search takes, code, name, city, country, position and rank.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kiwi-places",
        "tags": [
          "Kiwi.com"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Place name or code, e.g. `london` or `JFK`.",
            "schema": {
              "type": "string"
            },
            "example": "london"
          },
          {
            "name": "types",
            "in": "query",
            "required": false,
            "description": "Only these place types, comma-separated: airport, city, country, bus_station, train_station, region, subdivision.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results, 1-50 (default 10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
