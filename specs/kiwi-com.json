{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Kiwi.com",
    "version": "1.0.0",
    "description": "The Kiwi.com API from API.SH: public Kiwi.com data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Kiwi.com",
      "description": "3 endpoints (travel & events)",
      "x-slug": "kiwi-com",
      "x-domains": [
        "kiwi.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/kiwi/v1/deals": {
      "get": {
        "operationId": "kiwiDeals",
        "summary": "Cheapest to anywhere",
        "description": "The cheapest one-way flight from a place to every destination (\"anywhere\") in a date window, cheapest first, one per destination city: destination and departure airports, price, discount and departure date. Open a route with /kiwi/v1/flights.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kiwi-deals",
        "tags": [
          "Kiwi.com"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Departure airport/city code, place name or place id.",
            "schema": {
              "type": "string"
            },
            "example": "london"
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "First departure date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            },
            "example": "2026-12-01"
          },
          {
            "name": "date_end",
            "in": "query",
            "required": false,
            "description": "Last departure date (default: date).",
            "schema": {
              "type": "string"
            },
            "example": "2026-12-10"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Only destinations in this country (2-letter code).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_stops",
            "in": "query",
            "required": false,
            "description": "Maximum stops (0-3).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "adults",
            "in": "query",
            "required": false,
            "description": "Adults (1-9).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Currency (3 letters).",
            "schema": {
              "type": "string"
            },
            "example": "usd"
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "description": "Market (2-letter country code).",
            "schema": {
              "type": "string"
            },
            "example": "us"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Destinations (default 50, max 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "from": [
                    "City:london_gb"
                  ],
                  "date": "2026-12-01",
                  "date_end": null,
                  "currency": "USD",
                  "market": "us",
                  "country": null,
                  "count": 50,
                  "destinations": [
                    {
                      "destination": {
                        "airport": "RAK",
                        "airport_name": "Marrakesh Menara",
                        "city": "Marrakesh",
                        "city_id": "marrakesh_ma",
                        "country_code": "MA",
                        "latitude": 31.6069444,
                        "longitude": -8.0363889
                      },
                      "source": {
                        "airport": "STN",
                        "airport_name": "London Stansted",
                        "city": "London",
                        "city_id": "london_gb",
                        "country_code": "GB",
                        "latitude": 51.885,
                        "longitude": 0.23500000000000001
                      },
                      "price": 24,
                      "price_eur": 21.439962,
                      "currency": "USD",
                      "discount_percent": null,
                      "departure": "2026-12-01T06:15:00"
                    },
                    {
                      "destination": {
                        "airport": "EDI",
                        "airport_name": "Edinburgh Airport",
                        "city": "Edinburgh",
                        "city_id": "edinburgh_gb",
                        "country_code": "GB",
                        "latitude": 55.95,
                        "longitude": -3.3725
                      },
                      "source": {
                        "airport": "STN",
                        "airport_name": "London Stansted",
                        "city": "London",
                        "city_id": "london_gb",
                        "country_code": "GB",
                        "latitude": 51.885,
                        "longitude": 0.23500000000000001
                      },
                      "price": 25,
                      "price_eur": 22.333293,
                      "currency": "USD",
                      "discount_percent": null,
                      "departure": "2026-12-01T19:30:00"
                    },
                    "… 48 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/kiwi/v1/flights": {
      "get": {
        "operationId": "kiwiFlights",
        "summary": "Kiwi.com flight search (one-way and return)",
        "description": "Flight itineraries on Kiwi.com between two places for a date or date range, one-way or return (give `return_date`, or `nights_min`/`nights_max` for a stay length), with passengers, cabin, stops, airlines, price and duration limits, bags and sort. Each itinerary: price (in `currency` and EUR), duration, seats left, included bags and bag prices, self-transfer, hidden-city and throwaway flags, outbound (and inbound) with departure, arrival, stops and every leg (airports, local and UTC times, carrier, operating carrier, flight number, cabin, duration, layover and baggage recheck) and booking options with links. `carriers` lists the airlines found. Places take an airport or city code, a name or a place id from /kiwi/v1/places. Pass `next_page` back as `page` (up to 200 itineraries); null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kiwi-flights",
        "tags": [
          "Kiwi.com"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Origin: airport or city code, place name or place id; comma-separated for several, e.g. `LON` or `City:london_gb`.",
            "schema": {
              "type": "string"
            },
            "example": "LON"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Destination, same forms as `from`, e.g. `NYC`.",
            "schema": {
              "type": "string"
            },
            "example": "NYC"
          },
          {
            "name": "date",
            "in": "query",
            "required": true,
            "description": "Departure date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            },
            "example": "2027-10-15"
          },
          {
            "name": "date_end",
            "in": "query",
            "required": false,
            "description": "Last departure date for a flexible range (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return_date",
            "in": "query",
            "required": false,
            "description": "Return date (YYYY-MM-DD); makes the search a return trip.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return_date_end",
            "in": "query",
            "required": false,
            "description": "Last return date for a flexible range (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nights_min",
            "in": "query",
            "required": false,
            "description": "Return trip: minimum nights at the destination.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "nights_max",
            "in": "query",
            "required": false,
            "description": "Return trip: maximum nights at the destination.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "adults",
            "in": "query",
            "required": false,
            "description": "Adults, 1-9 (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "children",
            "in": "query",
            "required": false,
            "description": "Children (default 0).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "infants",
            "in": "query",
            "required": false,
            "description": "Infants (default 0; at most one per adult).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cabin",
            "in": "query",
            "required": false,
            "description": "Cabin class (default economy).",
            "schema": {
              "type": "string",
              "enum": [
                "economy",
                "premium_economy",
                "business",
                "first"
              ]
            }
          },
          {
            "name": "mixed_cabins",
            "in": "query",
            "required": false,
            "description": "`true` allows itineraries mixing cabin classes.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "max_stops",
            "in": "query",
            "required": false,
            "description": "Maximum stops per direction, 0-3.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "carriers",
            "in": "query",
            "required": false,
            "description": "Only these airlines (2-letter codes, comma-separated), e.g. `LH,BA`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exclude_carriers",
            "in": "query",
            "required": false,
            "description": "Leave out these airlines (2-letter codes, comma-separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price in `currency`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price in `currency`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_duration",
            "in": "query",
            "required": false,
            "description": "Maximum travel time per direction in hours.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hold_bags",
            "in": "query",
            "required": false,
            "description": "Checked bags per passenger, 0-2 (prices include them).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hand_bags",
            "in": "query",
            "required": false,
            "description": "Cabin bags per passenger, 0-1.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "best (default), price, duration, date or popularity.",
            "schema": {
              "type": "string",
              "enum": [
                "best",
                "price",
                "duration",
                "date",
                "popularity"
              ]
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Price currency (3-letter code, default usd).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "description": "Market country (2-letter code, default us).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page, from 1.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Itineraries per page, 1-50 (default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "trip": "oneway",
                  "from": [
                    "City:london_gb"
                  ],
                  "to": [
                    "City:new-york-city_ny_us"
                  ],
                  "date": "2026-12-15",
                  "date_end": null,
                  "return_date": null,
                  "return_date_end": null,
                  "nights_min": null,
                  "nights_max": null,
                  "passengers": {
                    "adults": 1,
                    "children": 0,
                    "infants": 0
                  },
                  "cabin": "economy",
                  "sort": "best",
                  "currency": "USD",
                  "market": "us",
                  "page": 1,
                  "size": 20,
                  "total": 48,
                  "count": 20,
                  "next_page": 2,
                  "carriers": [
                    {
                      "code": "SP",
                      "name": "SATA Air Acores"
                    },
                    {
                      "code": "LG",
                      "name": "Luxair"
                    },
                    "… 170 more"
                  ],
                  "itineraries": [
                    {
                      "id": "ItineraryOneWay:eyJwcm92aWRlcnMiOiJLSVdJLUJBU0lDOktJV0kiLCJyb3V0ZV9kYXRhIjoiRlI6MTA4MDpTVE46MTc5NzMzMjQwMDpMSVM6MTc5NzM0MjYwMDplY29ub215OkZh…",
