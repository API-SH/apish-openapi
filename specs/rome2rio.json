    "/rome2rio/v1/search": {
      "get": {
        "operationId": "rome2rioSearch",
        "summary": "Rome2rio routes between two places",
        "description": "Every way to travel between two places from Rome2rio (rome2rio.com): each route's `name`, `group`, `duration_minutes`, `price` (indicative `low`/`high` in the chosen currency and the native one), `modes`, `stops`, and `segments` (from/to place with coordinates and codes, `mode`, `duration_minutes`, `transfer_minutes_after`, `price`, and `options` of `hops`: vehicle, line, carrier with website and phone, duration, distance, services per week, operating days, fares and booking notes, operator links). Also `cheapest`, `fastest`, a `summary` and travel `guides`. Prices are typical fares, not live quotes.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/rome2rio-search",
        "tags": [
          "Rome2rio"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Origin: a city, address, landmark or airport code.",
            "schema": {
              "type": "string"
            },
            "example": "London"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Destination, as for `from`.",
            "schema": {
              "type": "string"
            },
            "example": "Paris"
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "3-letter currency code (default `USD`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "2-letter language code (default `en`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "exclude",
            "in": "query",
            "required": false,
            "description": "Leave out modes, comma-separated: `air`, `rail`, `bus`, `ferry`, `car`, `rideshare`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "`recommended` (default), `duration` or `price`.",
            "schema": {
              "type": "string",
              "enum": [
                "recommended",
                "duration",
                "price"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "from": {
                    "name": "London",
                    "long_name": null,
                    "canonical_name": "London",
                    "kind": "metropolis",
                    "code": null,
                    "lat": 51.50779,
