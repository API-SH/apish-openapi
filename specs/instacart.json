    "/instacart/v1/product": {
      "get": {
        "operationId": "instacartProduct",
        "summary": "Instacart product",
        "description": "One product from Instacart's public catalogue by link or id: name, brand, size, category, description and details, ingredients, directions, warnings and allergens (when the product lists them), nutrition values (name, value, unit), dietary tags and attributes (e.g. gluten-free, vegetarian), the national starting price, rating, rating count and distribution, breadcrumbs, the prices at stores near the area the site picks (with that area's postal code), how many stores carry it, stock level and images.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/instacart-product",
        "tags": [
          "Instacart"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "An instacart.com/products/ link.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.instacart.com/products/3293710-iceberg-lettuce-each"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The product number, instead of `url`.",
            "schema": {
              "type": "string"
            }
