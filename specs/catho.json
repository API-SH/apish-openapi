    "/catho/v1/search": {
      "get": {
        "operationId": "cathoSearch",
        "summary": "Search Catho jobs",
        "description": "Job ads on Catho (Brazil) for a role or keyword and a city, with contract type and sort. Each result has the title, company, number of openings, city, salary text and publication date; `site_filters` echoes the filters the site applied. 20 per page. Filters: salary, work model (remote, hybrid, on site), publication date, job area and disability type; `applied_filters` and `site_filters` show what was applied.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/catho-search",
        "tags": [
          "Catho"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Role or keyword (e.g. desenvolvedor, analista, vendedor).",
            "schema": {
              "type": "string"
            },
            "example": "desenvolvedor"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City as in the site's URLs: name and state, e.g. sao-paulo-sp, rio-de-janeiro-rj, belo-horizonte-mg.",
            "schema": {
              "type": "string"
            },
            "example": "sao-paulo-sp"
          },
          {
            "name": "contract",
            "in": "query",
            "required": false,
            "description": "The site's contract type ids, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "date"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Results page (1-based). Pass next_page back; it is null on the last page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "required": false,
            "description": "Monthly salary from (BRL): picks the site's salary range at or below it (2,000; 3,000 ... 10,000; 15,000; above 20,000).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "salary_range",
            "in": "query",
            "required": false,
            "description": "The site's salary range id instead of salary_min: 3 up to R$ 2,000; 4 to 13 from R$ 2,000, 3,000, 4,000, 5,000, 6,000, 7,000, 8,000, 9,000, 10,000, 15,000; 14 above R$ 20,000.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "work_model",
            "in": "query",
            "required": false,
            "description": "remote, hybrid, presential (or remoto, hibrido, presencial), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "posted_within",
            "in": "query",
            "required": false,
            "description": "Only ads published in the last N days: 0 (today), 1, 2, 7, 15 or 30.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "area",
            "in": "query",
            "required": false,
            "description": "The site's job area ids, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "disability",
            "in": "query",
            "required": false,
            "description": "The site's disability (PcD) type ids, comma separated: ads open to candidates with that disability.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "desenvolvedor",
                  "location": "sao-paulo-sp",
                  "url": "https://www.catho.com.br/vagas/desenvolvedor/sao-paulo-sp/",
                  "applied_filters": {
                    "location": "sao-paulo-sp"
                  },
                  "site_filters": {
                    "profession": "desenvolvedor",
                    "cities": [
                      783
                    ],
                    "states": [],
                    "regions": [],
                    "idSalary": 0,
                    "workPlaceType": [],
                    "sectors": [],
                    "publishDate": null,
                    "contracts": [],
                    "disability": [],
                    "distance": null,
                    "salaryNegotiable": null,
                    "order": null
                  },
                  "count": 20,
                  "page": 1,
                  "next_page": 2,
                  "jobs": [
                    {
                      "id": "38915959",
