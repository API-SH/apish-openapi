    "/cryptopanic/v1/news": {
      "get": {
        "operationId": "cryptopanicNews",
        "summary": "CryptoPanic crypto news feed with filters",
        "description": "The CryptoPanic news feed (news articles, X posts, Reddit and media): title, publish time, source, original link, summary and content, coins mentioned, panic scores, sentiment and community votes. Filter like the site: rising, hot, bullish, bearish, important or lol; by coin (slug or ticker), by source, news or media only, keywords, and a panic-score period. 50 posts per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cryptopanic-news",
        "tags": [
          "CryptoPanic"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "rising, hot, bullish, bearish, important or lol.",
            "schema": {
              "type": "string",
              "enum": [
                "rising",
                "hot",
                "bullish",
                "bearish",
                "important",
                "lol"
              ]
            }
          },
          {
            "name": "coin",
            "in": "query",
            "required": false,
            "description": "Coin slug (bitcoin), ticker (BTC) or a cryptopanic.com/news/<coin>/ link.",
            "schema": {
              "type": "string"
            },
            "example": "bitcoin"
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "Source domain (coindesk.com) or @handle for X sources.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "all (default), news or media.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "news",
                "media"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keyword search.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "Rank by panic score over 1h, 6h, 24h, 7d, 30d, 3m, 6m or 12m.",
            "schema": {
              "type": "string",
              "enum": [
                "1h",
                "6h",
                "24h",
                "7d",
                "30d",
                "3m",
                "6m",
                "12m"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page (from 1, max 50).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
