    "/karriere-at/v1/search": {
      "get": {
        "operationId": "karriereAtSearch",
        "summary": "Search karriere.at jobs",
        "description": "Job ads on karriere.at (Austria) for keywords and a place, with every filter the site offers: job field, employment type, job level, monthly salary band, home office and radius. Each result has the title, employer with size and logo, locations, employment types, salary text, home office, summary and posting age. `facets` lists every filter value with its label and count. 15 per page; pass `next_page` back as `page`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/karriere-at-search",
        "tags": [
          "karriere.at"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords (title, skill or company).",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Place (e.g. wien, graz, linz, salzburg).",
            "schema": {
              "type": "string"
            },
            "example": "wien"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Distance around location in km.",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "10",
                "20",
                "30",
                "50",
                "75",
                "100"
              ]
            }
          },
          {
            "name": "field",
            "in": "query",
            "required": false,
            "description": "Job field ids, comma separated (facets.fields; e.g. 2172 IT).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employment_type",
            "in": "query",
            "required": false,
            "description": "Employment type ids, comma separated (3960 full time, 3961 part time, 3963 internship, 3965 apprenticeship, 3962 freelance, 3966 marginal, 3964 thesis).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "description": "Job level ids, comma separated (3954 entry, 3955 experienced, 3956 project or department lead, 3958 management, 11972 self-employed).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "salary",
            "in": "query",
            "required": false,
            "description": "Monthly gross salary band id (facets.salary; e.g. 10008 = from EUR 4,000).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "home_office",
            "in": "query",
            "required": false,
            "description": "1 = home office possible.",
            "schema": {
              "type": "string",
              "enum": [
                "1"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (from 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "python",
                  "location": "wien",
