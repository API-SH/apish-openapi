    "/karriere-at/v1/job": {
      "get": {
        "operationId": "karriereAtJob",
        "summary": "karriere.at job ad",
        "description": "One karriere.at job ad: title, employer with size, link and logo, locations and address, employment types, job level, salary text and range, home office, field and type ids, posting date, the full description (HTML and text), the apply link and similar jobs. Give `id` (or the job URL), or `q` (and `location`) to open the first current result.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/karriere-at-job",
        "tags": [
          "karriere.at"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job id (the number in karriere.at/jobs/<id>).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The job's URL.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords: opens the first current search result.",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "With q: place.",
            "schema": {
              "type": "string"
            },
            "example": "wien"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
