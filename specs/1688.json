    "/1688/v1/search": {
      "get": {
        "operationId": "1688Search",
        "summary": "1688 product search",
        "description": "Wholesale offers on 1688.com for a keyword (60 per page, sponsored ones included and marked `sponsored`): offer id and link, title, images, price (CNY, with `price_max` for a range), minimum order and unit, units sold and monthly sales, repeat-buyer rate, service tags (dropshipping, 48-hour shipping...), supplier name, years on the platform, power-merchant, super-factory and trade-assurance flags. Sort by the site's sales ranking or by lowest price, and filter by a price range. Pass `next_page` back as `page`; null on the last page. `total` is how many offers the site found. 1688's keyword listing matches fairly short keywords: when a query of several words finds nothing, its last word is dropped (up to 3 times) until something matches, and `matched_query` shows the words used (`relax=0` keeps the exact query and returns an empty list instead).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/1688-search",
        "tags": [
          "1688"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search keyword (Chinese or English).",
            "schema": {
              "type": "string"
            },
            "example": "手机壳"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1-50.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "default (the site's order), sales (the site's sales ranking) or price_asc (lowest price first). 1688 no longer sorts highest price first.",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "sales",
                "price_asc"
              ]
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Lowest price in CNY.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Highest price in CNY.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "relax",
            "in": "query",
            "required": false,
            "description": "1 (default) drops the last word of a query that finds nothing, up to 3 times (see matched_query); 0 keeps the exact query.",
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "0"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "手机壳",
                  "page": 1,
                  "next_page": 2,
                  "count": 40,
                  "currency": "CNY",
                  "items": [
                    {
                      "rank": 1,
                      "offer_id": "893290359232",
                      "url": "https://detail.1688.com/offer/893290359232.html",
                      "title": "适用苹果17E/16护眼凹槽滴胶手机壳iPhone18promax背卡手作素材壳",
                      "image": "https://cbu01.alicdn.com/img/ibank/O1CN015j1CpR255bd2n0jZO_!!2003997475-0-cib.jpg",
                      "price": 1.65,
                      "currency": "CNY",
                      "sales_text": "月销2733个",
                      "monthly_sales": 2733,
                      "brand": null,
                      "tags": [
                        "一件代发",
