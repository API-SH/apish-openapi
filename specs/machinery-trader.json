    "/machinerytrader/v1/search": {
      "get": {
        "operationId": "machinerytraderSearch",
        "summary": "Machinery Trader equipment search",
        "description": "Construction equipment for sale on Machinery Trader (excavators, loaders, dozers, cranes, skid steers, forklifts, lifts, attachments...), 28 per page: title, year, manufacturer, model, category, condition, price and currency, serial number, hours and the other specs shown on the card, description, machine location with coordinates, the selling dealer (name, contact, business phone, website, location), premium/featured flags, update time, photos and link. Filter by category, keywords, manufacturer, model, state, condition, year, price, hours, horsepower, serial or stock number, or one dealer location, and sort. `total` is the number of matches. Pass `next_page` back as `page`; null on the last page. Private-party sellers come back with the contact name the site shows and their town, without phone number or postcode.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/machinerytrader-search",
        "tags": [
          "Machinery Trader"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category id: 1031 excavators, 1033 mini excavators, 1055 skid steers, 1060 wheel loaders, 1025 dozers, 1046 loader backhoes, 1015 cranes, 1036 forklifts, 1040 lifts, 1038 telehandlers, 1048 motor graders, 1049 off-highway trucks, 1035 forestry, 1028 drills, 1001 aggregate, 1007 asphalt/pavers/concrete, 1057 sweepers, 1058 trenchers, 81 attachments.",
            "schema": {
              "type": "string"
            },
            "example": "1031"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "manufacturer",
            "in": "query",
            "required": false,
            "description": "Manufacturer as the site names it, e.g. CATERPILLAR, DEERE, KOMATSU.",
            "schema": {
              "type": "string"
            },
            "example": "CATERPILLAR"
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Model, e.g. 320.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "US state or Canadian province name, e.g. TEXAS.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "description": "New or Used.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_year",
            "in": "query",
            "required": false,
            "description": "Year from.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_year",
            "in": "query",
            "required": false,
            "description": "Year to.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum price (USD).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum price (USD).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_hours",
            "in": "query",
            "required": false,
            "description": "Minimum hours.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_hours",
            "in": "query",
            "required": false,
            "description": "Maximum hours.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_horsepower",
            "in": "query",
            "required": false,
            "description": "Minimum horsepower.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_horsepower",
            "in": "query",
            "required": false,
            "description": "Maximum horsepower.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "serial_number",
            "in": "query",
            "required": false,
            "description": "Serial number or VIN.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "stock_number",
            "in": "query",
            "required": false,
            "description": "Dealer stock number.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dealer_location_id",
            "in": "query",
            "required": false,
            "description": "A dealer location id (from a listing's seller.dealer_location_id): that dealer's stock.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), price_asc, price_desc, year_asc, year_desc, hours_asc, hours_desc, recently_added, recently_updated, manufacturer, model, serial_number or stock_number.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "year_asc",
                "year_desc",
                "hours_asc",
                "hours_desc",
                "recently_added",
                "recently_updated",
                "manufacturer",
                "model",
                "serial_number",
                "stock_number"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "applied_filters": {
                    "category": 1031,
                    "manufacturer": "CATERPILLAR"
                  },
                  "sort": "relevance",
                  "page": 1,
                  "page_size": 28,
                  "total": 9596,
                  "total_pages": 343,
                  "count": 28,
                  "next_page": 2,
                  "title": "CATERPILLAR Excavators For Sale",
                  "listings": [
                    {
                      "id": 260110453,
                      "title": "2018 CATERPILLAR 313FLGC",
                      "year": 2018,
                      "manufacturer": "CATERPILLAR",
                      "model": "313FLGC",
                      "category_id": 1032,
                      "category": "Crawler Excavators",
                      "condition": "Used",
                      "price": null,
                      "currency": "USD",
                      "price_text": "Auction",
                      "msrp": null,
                      "listing_type": "for sale",
                      "listing_types": [
                        "ForSale",
                        "Auction"
                      ],
                      "serial_number": "HDK10223",
                      "hours": 11228,
                      "specs": {
                        "Hours": "11,228",
                        "ROPS": "Enclosed",
                        "Serial Number": "HDK10223",
                        "Stock Number": "EP - HDK10223",
                        "A/C": "Yes",
                        "Heater": "Yes",
                        "Engine Manufacturer": "CATERPILLAR",
