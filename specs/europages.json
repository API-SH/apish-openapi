    "/europages/v1/search": {
      "get": {
        "operationId": "europagesSearch",
        "summary": "Europages company search",
        "description": "European B2B companies on Europages matching a product or service, with the site's filters: supplier country (one or more), supplier type, company size, verified suppliers only, and distance from a point with a radius (sorted by distance if asked). Each company has id, slug, name, profile link, description, website, business phone, street address, city, country, coordinates, logo, supplier types, employee band, founding year, distribution area, verified flag, certificate and product counts, response rate, keywords, its showcased products and pictures. `facets` gives the counts per country, supplier type, size band and verified flag for refining. 30 companies a page; pass `next_page` back as `page` (null on the last page). Business contact data only.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/europages-search",
        "tags": [
          "Europages"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Product, service or company keyword.",
            "schema": {
              "type": "string"
            },
            "example": "valves"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Supplier countries, ISO two-letter codes, comma separated (e.g. DE,IT).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "supplier_type",
            "in": "query",
            "required": false,
            "description": "Supplier types, comma separated: production, customer_specific_manufacturing, distribution, service, wholesaler.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employees",
            "in": "query",
            "required": false,
            "description": "Company size bands, comma separated: 1-4, 5-9, 10-19, 20-49, 50-99, 100-199, 200-499, 500-999, 1000+.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "verified",
            "in": "query",
            "required": false,
            "description": "true = verified suppliers only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of a point to search around (with lng).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "description": "Longitude of a point to search around (with lat).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "description": "Radius around lat/lng in km (50 by default; the site offers 10, 25, 50, 75, 100, 125, 250).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order; distance needs lat and lng.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "distance"
              ]
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language of the results and profile links.",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "de",
                "fr",
                "es",
                "it",
                "nl",
                "pl",
                "pt"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1 by default).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
