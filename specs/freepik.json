              "type": "string",
              "enum": [
                "all",
                "landscape",
                "portrait",
                "square",
                "panoramic"
              ]
            }
          },
          {
            "name": "color",
            "in": "query",
            "required": false,
            "description": "Main color.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "red",
                "orange",
                "pink",
                "yellow",
                "green",
                "cyan",
                "blue",
                "purple",
                "black",
                "gray",
                "white"
              ]
            }
          },
          {
            "name": "ai_generated",
            "in": "query",
            "required": false,
            "description": "Leave out or keep only AI-generated assets.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "exclude",
                "only"
              ]
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Site language for names and the search: en (default), es, de, fr, it, pt, ja, ko, nl, pl, ru, sv, tr, cs, id, zh, zh-tw.",
            "schema": {
