    "/freepik/v1/search": {
      "get": {
        "operationId": "freepikSearch",
        "summary": "Freepik asset search",
        "description": "Freepik vectors, photos, illustrations, PSD files, templates, mockups, videos, icons, 3D assets and fonts for keywords, with the site's filters (asset type, license, orientation, color, AI-generated) and sort: id, name, link, type, free or premium, AI-generated and prompt flags, online-editable flags, preview image with its size and the contributor (id, name, profile link, avatar, number of assets). Also the total, the last page and related tags. 50 per page, up to 50 pages. Pass `next_page` back as `page`; it is null on the last page. Downloads and original files are not included.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/freepik-search",
        "tags": [
          "Freepik"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Keywords, e.g. `watercolor flowers` or `business card`.",
            "schema": {
              "type": "string"
            },
            "example": "watercolor flowers"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-50). Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Asset type (default all).",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "vector",
                "illustration",
                "photo",
                "psd",
                "template",
                "mockup",
                "video",
                "icon",
                "3d",
                "font"
              ]
            }
          },
          {
            "name": "sort",
