          "Freepik"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "author",
            "in": "query",
            "required": true,
            "description": "Contributor slug or numeric id, or the profile link.",
            "schema": {
              "type": "string"
            },
            "example": "wirestock"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "`relevance` (default) or `recent`.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "recent"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-50). Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Site language, e.g. `en` (default).",
            "schema": {
