    "/whatnot/v1/user": {
      "get": {
        "operationId": "whatnotUser",
        "summary": "Whatnot seller",
        "description": "A Whatnot seller's public shop profile: display name, bio, profile and store images, rating, review count, items sold, followers, following, average ship days, live now, verified and business seller, premier shop, badges, and the seller's shows (live, upcoming and recent). Accounts that do not sell answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/whatnot-user",
        "tags": [
          "Whatnot"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": true,
            "description": "Seller username (the part after /user/ in a whatnot.com link).",
            "schema": {
              "type": "string"
            },
            "example": "blazing_cards"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Instead of username: a whatnot.com/user/... link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "username": "blazing_cards",
                  "display_name": "Blazing Cards",
                  "url": "https://www.whatnot.com/user/blazing_cards",
                  "bio": "Fresh Vintage Boxes, Blisters, Packs, and Slabs\n\nMake sure to follow on Instagram: @blazingcards & @blazingchristian\n\nMONDAY-FRIDAY 4AM-12PM…",
                  "image": "https://images.whatnot.com/eyJidWNrZXQiOiAid2hhdG5vdC1pbWFnZXMiLCAia2V5IjogInVzZXJzLzg4OTk1Mi9hZjljYmY2MS1hOGJlLTRlOWItODQ5NS04MTRmYjZhMWNiN…",
                  "store_image": "https://images.whatnot.com/eyJidWNrZXQiOiAid2hhdG5vdC1pbWFnZXMiLCAia2V5IjogInVzZXJzLzg4OTk1Mi9zdG9yZS81YTc1ZGJlOS04ODJiLTQ3YTEtODg0Yy04MmM4M…",
