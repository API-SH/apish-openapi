                  "rating": "A+",
                  "rating_reasons": [
                    "Customer Reviews are not used in the calculation of the BBB Letter Grade Rating."
                  ],
                  "not_rated_reason": null,
                  "accredited": true,
                  "accredited_since": "2013-05-06T00:00:00",
                  "review_rating": 5,
                  "review_count": 2,
                  "complaint_count": 0,
                  "complaints_closed_last_3_years": 0,
                  "complaints_closed_last_12_months": 0,
                  "phone": "+1 555 010 0000",
                  "email": "name@example.com",
                  "website": null,
                  "additional_phones": [],
