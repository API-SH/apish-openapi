    "/bbb/v1/reviews": {
      "get": {
        "operationId": "bbbReviews",
        "summary": "BBB customer reviews",
        "description": "Pass `next_page` from the previous response; `next_page` is null on the last page.\n\nCustomer reviews of a business, 10 per page: rating, author, date, text, the business response and the customer's reply.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bbb-reviews",
        "tags": [
          "BBB"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "BBB business profile URL.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.bbb.org/us/pa/philadelphia/profile/internet-providers/comcast-corporation-0241-80003221"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "newest (default), oldest, highest or lowest.",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest",
                "highest",
                "lowest"
              ]
            }
          },
