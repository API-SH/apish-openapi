    "/bbb/v1/categories": {
      "get": {
        "operationId": "bbbCategories",
        "summary": "BBB business categories",
        "description": "The Better Business Bureau's business categories that start with a letter: slug, name (usable as /bbb/v1/search's category) and link. With q, the categories starting with q's first letter that contain q.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bbb-categories",
        "tags": [
          "BBB"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "letter",
            "in": "query",
            "required": false,
            "description": "First letter, a to z (default a), or pass q.",
            "schema": {
              "type": "string"
            },
            "example": "p"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "A word: lists the categories that start with its first letter and contain it.",
            "schema": {
              "type": "string"
            },
            "example": "plumb"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "us (default) or ca.",
            "schema": {
              "type": "string",
              "enum": [
                "us",
                "ca"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "country": "us",
                  "letter": "p",
                  "query": "plumb",
                  "count": 7,
                  "categories": [
                    {
                      "category": "plumber",
                      "name": "Plumber",
                      "url": "https://www.bbb.org/us/category/plumber"
                    },
                    {
                      "category": "plumbing-fixtures",
                      "name": "Plumbing Fixtures",
                      "url": "https://www.bbb.org/us/category/plumbing-fixtures"
                    },
                    "… 5 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/bbb/v1/complaints": {
      "get": {
        "operationId": "bbbComplaints",
        "summary": "BBB complaints against a business",
        "description": "Pass `next_page` from the previous response; `next_page` is null on the last page.\n\nComplaints filed against a business, 10 per page: date, complaint type, status (answered or resolved), the complaint text and the business response, with the counts per status and type to filter by.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bbb-complaints",
        "tags": [
          "BBB"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "BBB business profile URL.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.bbb.org/us/pa/philadelphia/profile/internet-providers/comcast-corporation-0241-80003221"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Only complaints with this status: answered or resolved.",
            "schema": {
              "type": "string",
              "enum": [
                "answered",
                "resolved"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Only complaints of this type (a slug from `available_filters.type`, for example billingissues, serviceorrepair, productissues, customerservice, order, salesadvertising, delivery).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Pass `next_page` from the previous response; `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
