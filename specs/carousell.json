    "/carousell/v1/search": {
      "get": {
        "operationId": "carousellSearch",
        "summary": "Carousell listing search",
        "description": "Listings on Carousell (Singapore, Malaysia, Taiwan, Hong Kong) for a keyword or category, with the site's filters: category id, price range, condition, deal method (delivery or meet-up), sort, and every category-specific filter the search offers (`filter_options` lists each `field_name` with its values; pass them as `filter_<field_name>=v1,v2`, e.g. `filter_mobile_storage=MOBILE_STORAGE_128_GB`). Each listing: `id`, `url`, `title`, `price`, `price_value`, `description`, `condition`, `status`, `likes`, `category_id`, `seller` (id, username, name, picture, link), `marketplace`, `latitude`, `longitude`, `bumped_at`, `image`, `images` and `raw`. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/carousell-search",
        "tags": [
          "Carousell"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `iphone 15`.",
            "schema": {
              "type": "string"
            },
            "example": "iphone 15"
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "description": "Carousell market: `sg` (Singapore, default), `my` (Malaysia), `tw` (Taiwan), `hk` (Hong Kong).",
            "schema": {
              "type": "string",
              "enum": [
                "sg",
                "my",
                "tw",
                "hk"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category id (`category_id` of a listing, or `category.id` from /carousell/v1/listing).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in the market currency.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in the market currency.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "description": "`brand_new`, `like_new`, `lightly_used`, `well_used`, `heavily_used`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deal_method",
            "in": "query",
            "required": false,
            "description": "`delivery`, `meetup`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default `best_match`).",
            "schema": {
              "type": "string",
              "enum": [
                "best_match",
                "recent",
                "price_low",
                "price_high"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Listings per page, 1-48 (default 24).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "`next_cursor` from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "iphone 15",
                  "market": "sg",
                  "currency": "SGD",
