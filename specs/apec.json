    "/apec/v1/search": {
      "get": {
        "operationId": "apecSearch",
        "summary": "APEC job search (France)",
        "description": "Jobs on APEC (apec.fr, France's job board for managers and professionals) for keywords, with the site's filters: contract type, location, function, experience, sector, remote work, position status and company type; sort by relevance or date. `facets` lists each filter's ids with counts. Each job: `id` (offer number), `title`, `url`, `company`, `company_logo`, `location`, `lat`, `lng`, `salary`, `contract_type`, `snippet`, `published_at` and `raw`. 20 jobs a page; `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/apec-search",
        "tags": [
          "APEC"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `comptable`, `chef de projet`.",
            "schema": {
              "type": "string"
            },
            "example": "comptable"
          },
          {
            "name": "contract_type",
            "in": "query",
            "required": false,
            "description": "`cdi`, `cdd`, `interim`, `mission_interim`, `alternance`, `stage`, `cdi_interimaire` (comma separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Location ids from `facets.location` (e.g. `799` France), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "function",
            "in": "query",
            "required": false,
            "description": "Function ids from `facets.function`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "experience",
            "in": "query",
            "required": false,
            "description": "Experience ids from `facets.experience`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sector",
            "in": "query",
            "required": false,
            "description": "Sector ids from `facets.sector`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remote",
            "in": "query",
            "required": false,
            "description": "Remote-work ids from `facets.remote`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position_status",
            "in": "query",
            "required": false,
            "description": "Position status ids from `facets.position_status`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company_type",
            "in": "query",
            "required": false,
            "description": "Company type ids from `facets.company_type`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "date"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
