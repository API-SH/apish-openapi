    "/adzuna/v1/suggest": {
      "get": {
        "operationId": "adzunaSuggest",
        "summary": "Adzuna search suggestions",
        "description": "The suggestions of Adzuna's search boxes for a partial word: `what` (job titles and keywords), `where` (places with their location id for search) or `title` (UK salary-stats job titles and categories, with the slugs /adzuna/v1/salaries takes).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/adzuna-suggest",
        "tags": [
          "Adzuna"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "At least 2 characters.",
            "schema": {
              "type": "string"
            },
            "example": "devel"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Which box.",
            "schema": {
              "type": "string",
              "enum": [
                "what",
                "where",
                "title"
              ],
              "default": "what"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country site.",
            "schema": {
              "type": "string",
              "enum": [
                "gb",
                "us",
                "au",
                "ca",
                "de",
                "fr",
                "nl",
                "be",
                "at",
                "ch",
                "it",
                "es",
                "pl",
                "in",
                "sg",
                "nz",
                "za",
                "br",
                "mx"
              ],
              "default": "gb"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "country": "gb",
                  "q": "devel",
                  "type": "what",
                  "count": 10,
                  "suggestions": [
                    {
                      "value": "Aem Developer",
                      "label": "Aem Developer"
                    },
                    {
                      "value": "Analyst Developer",
                      "label": "Analyst Developer"
                    },
                    "… 8 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
