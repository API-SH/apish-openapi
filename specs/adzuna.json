                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/adzuna/v1/salaries": {
      "get": {
        "operationId": "adzunaSalaries",
        "summary": "Adzuna UK salary stats",
        "description": "Adzuna's live UK salary stats for a job title, optionally in one town or region: average advertised salary, the site's fast facts (vs national average, year-on-year change, vacancy count), the last 12 months of average salary and vacancy counts, the top hiring companies and related searches. 404 when Adzuna has no stats for the title.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/adzuna-salaries",
        "tags": [
          "Adzuna"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "title",
            "in": "query",
            "required": true,
            "description": "Job title (e.g. software developer) or an adzuna.co.uk/jobs/salaries link.",
            "schema": {
              "type": "string"
            },
            "example": "software developer"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Town or region, e.g. manchester, london, scotland. Omit for the whole UK.",
            "schema": {
              "type": "string"
            },
            "example": "manchester"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
