{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Adzuna",
    "version": "1.0.0",
    "description": "The Adzuna API from API.SH: public Adzuna data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Adzuna",
      "description": "4 endpoints (jobs & b2b)",
      "x-slug": "adzuna",
      "x-domains": [
        "adzuna.co.uk"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/adzuna/v1/job": {
      "get": {
        "operationId": "adzunaJob",
        "summary": "Adzuna job ad",
        "description": "One Adzuna job ad: title, company, advertiser, location and address, salary (as shown and as structured data), contract type and hours, breadcrumb (category), badges, date posted, closing date, the full description as text and HTML, and the apply link. `latest=true` with search parameters (`q`, `location`, filters) returns the newest matching ad. 404 when the ad has expired.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/adzuna-job",
        "tags": [
          "Adzuna"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Adzuna job id (the number in /details/<id>, `id` in search results) or a job link. A link sets the country. Required unless latest=true.",
            "schema": {
              "type": "string"
            },
            "example": "5295889392"
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`true`: the newest ad of a search with the other parameters (`q`, `location` and the search filters) instead of an `id`.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "With latest=true: search keywords.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "With latest=true: town, region or postcode.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country site of the id (ignored for a link).",
            "schema": {
              "type": "string",
              "enum": [
                "gb",
                "us",
                "au",
                "ca",
                "de",
                "fr",
                "nl",
                "be",
                "at",
                "ch",
                "it",
                "es",
                "pl",
                "in",
                "sg",
                "nz",
                "za",
                "br",
                "mx"
              ],
              "default": "gb"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "5953645937",
                  "country": "gb",
                  "url": "https://www.adzuna.co.uk/jobs/details/5953645937",
                  "title": "Software Systems Engineer",
                  "company": "IBM",
                  "company_slug": "ibm",
                  "company_url": "https://www.adzuna.co.uk/jobs/company/ibm",
                  "advertiser_logo": "https://zunastatic-abf.kxcdn.com/images/logo/jobs/partners/x5fDArs5BuyKapCtYfIRmk8ofpM.png",
                  "advertiser": "Direct Employers",
                  "location": "Hursley",
                  "address": {
                    "locality": "Hursley",
                    "region": "Winchester",
                    "postal_code": "SO212JX",
                    "country": "GB"
                  },
                  "latitude": 51.025299,
                  "longitude": -1.39064,
                  "salary": {
                    "text": "£53,063 per year",
                    "min": 53063,
                    "max": 53063,
                    "currency": "GBP",
                    "period": "year",
                    "estimated": true
                  },
                  "salary_structured": {
                    "value": 53063,
                    "min": null,
                    "max": null,
                    "unit": "YEAR",
                    "currency": "GBP"
                  },
                  "contract_type": "Permanent",
                  "contract_time": null,
                  "employment_type": [
                    "FULL_TIME"
                  ],
                  "breadcrumb": [
                    {
                      "name": "Jobs",
                      "url": "https://www.adzuna.co.uk"
                    },
                    {
                      "name": "South East England",
                      "url": "https://www.adzuna.co.uk/jobs/south-east-england"
                    },
                    "… 3 more"
                  ],
                  "badges": [
                    "NEW"
                  ],
                  "date_posted": "2026-07-22T04:24:08",
                  "valid_through": "2026-11-19T03:02:35",
                  "direct_apply": false,
                  "description": "**Introduction** THIS ROLE IS BASED IN IBM HURSLEY AND YOU MUST HAVE PERMANENT RIGHT TO WORK IN THE UK Data storage is at the heart of every…",
                  "description_html": "**Introduction** THIS ROLE IS BASED IN IBM HURSLEY AND YOU MUST HAVE PERMANENT RIGHT TO WORK IN THE UK Data storage is at the heart of every…",
