    "/adzuna/v1/search": {
      "get": {
        "operationId": "adzunaSearch",
        "summary": "Adzuna job search",
        "description": "Job ads on Adzuna in any of its 19 countries: title, company (with its Adzuna company page), location, advertised or estimated salary (min, max, period, currency), badges, snippet and logo, 10 per page; plus the total and, on page 1, the filter values the site offers for this search (locations, categories, companies, contract types, hours, date posted, salary bands) with the ids the filters take. Filter by place or postcode with a radius, location id, category, company, contract type, hours, salary range, date posted and remote; sort by relevance, date or salary. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/adzuna-search",
        "tags": [
          "Adzuna"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords (job title, skill, company). Required unless location, location_id, category or company_id is given.",
            "schema": {
              "type": "string"
            },
            "example": "developer"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Town, region or postcode (the site's \"where\" box), e.g. Manchester or SW1A.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "distance",
            "in": "query",
            "required": false,
            "description": "Radius around `location`, in miles (km in metric countries), e.g. 5, 10, 25.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "location_id",
            "in": "query",
            "required": false,
            "description": "Adzuna location id (from facets.locations or /adzuna/v1/suggest?type=where).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category id from facets.categories (e.g. 2 IT Jobs in the UK).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "company_id",
            "in": "query",
            "required": false,
            "description": "Company id from facets.companies.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "contract_type",
            "in": "query",
            "required": false,
            "description": "Contract type.",
            "schema": {
              "type": "string",
              "enum": [
                "permanent",
                "contract"
              ]
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "description": "Working hours.",
            "schema": {
              "type": "string",
              "enum": [
                "full_time",
                "part_time"
              ]
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "required": false,
            "description": "Minimum annual salary in the country's currency.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "salary_max",
            "in": "query",
            "required": false,
            "description": "Maximum annual salary in the country's currency.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Posted within this many days.",
            "schema": {
              "type": "integer",
              "enum": [
                "1",
                "3",
                "7",
                "14",
                "30"
              ]
            }
          },
          {
            "name": "remote",
            "in": "query",
            "required": false,
            "description": "true: remote jobs only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order of the results.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "date",
                "salary_desc",
                "salary_asc"
              ],
              "default": "relevance"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Adzuna country site (gb = adzuna.co.uk, us = adzuna.com, ...).",
            "schema": {
              "type": "string",
              "enum": [
                "gb",
                "us",
                "au",
                "ca",
                "de",
                "fr",
                "nl",
                "be",
                "at",
                "ch",
                "it",
                "es",
                "pl",
                "in",
                "sg",
                "nz",
                "za",
                "br",
                "mx"
              ],
              "default": "gb"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1 for the first. Pass back `next_page`.",
            "schema": {
