    "/finn/v1/search": {
      "get": {
        "operationId": "finnSearch",
        "summary": "Search FINN.no ads",
        "description": "FINN.no (finn.no) marketplace ads (or used cars with `vertical=cars`) for a keyword with category, location, radius around a point, price, condition, seller type, trade type, shipping, published today and sort, plus any other filter the site lists in `filters` (pass as `filters=name:value`). Each result has price (NOK), location and coordinates, published time, photos, labels and, for business sellers, the shop name; car results add make, model, year, mileage, fuel, transmission and dealer. Private sellers' names, phone numbers and email addresses are never returned (masked in ad text).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/finn-search",
        "tags": [
          "FINN.no"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords.",
            "schema": {
              "type": "string"
            },
            "example": "sykkel"
          },
          {
            "name": "vertical",
            "in": "query",
            "required": false,
            "description": "marketplace (default) or cars.",
            "schema": {
              "type": "string",
              "enum": [
                "marketplace",
                "cars"
              ]
            }
          },
          {
            "name": "category",
