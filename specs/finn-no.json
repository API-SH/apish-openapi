                          "level": "sub_category",
                          "listings": 78725
                        },
                        "… 4 more"
                      ]
                    },
                    {
                      "id": "0.77",
                      "name": "Dyr og utstyr",
                      "level": "category",
                      "listings": 74297,
                      "children": [
                        {
                          "id": "1.77.3976",
