    "/inmuebles24/v1/search": {
      "get": {
        "operationId": "inmuebles24Search",
        "summary": "Inmuebles24 property search",
        "description": "Property in Mexico on Inmuebles24 by type, operation and place, or any Inmuebles24 search link (with all the filters in it: price, bedrooms, bathrooms, area, amenities, sort...). Each result has id, code, link, title, type, prices per operation and currency, maintenance fee, main features (area, rooms, bathrooms, parking...), flags, address, location tree (zone, city, state), coordinates, description, media flags, status, date and the advertiser (agency name, page, logo and WhatsApp; a private owner's number is left out), plus photos. 30 per page; pass `next_page` back as `page`; null on the last page. With type, operation and location you can add minimum bedrooms, bathrooms and parking spaces, one price or area bound (min_price, max_price, min_area or max_area: the site reads only one of them per search) and a sort order.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/inmuebles24-search",
        "tags": [
          "Inmuebles24"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Property type.",
            "schema": {
              "type": "string",
              "enum": [
                "inmuebles",
                "departamentos",
                "casas",
                "terrenos",
                "oficinas",
                "locales-comerciales",
                "bodegas-comerciales",
                "casas-en-condominio",
                "desarrollos",
                "ranchos",
                "edificios",
                "naves-industriales",
                "cuartos"
              ]
            },
            "example": "departamentos"
          },
          {
            "name": "operation",
            "in": "query",
            "required": false,
            "description": "Operation.",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent",
                "temporary"
              ]
            },
            "example": "sale"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Place as in Inmuebles24 links (e.g. ciudad-de-mexico, guadalajara, benito-juarez, cancun).",
            "schema": {
              "type": "string"
            },
            "example": "ciudad-de-mexico"
          },
          {
            "name": "bedrooms",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms (1-10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bathrooms",
            "in": "query",
            "required": false,
            "description": "Minimum bathrooms (1-10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "parking",
            "in": "query",
            "required": false,
            "description": "Minimum parking spaces (1-10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum price in pesos. Only one of min_price, max_price, min_area and max_area per call.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum price in pesos. Only one of min_price, max_price, min_area and max_area per call.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_area",
            "in": "query",
            "required": false,
