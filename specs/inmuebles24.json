    "/inmuebles24/v1/listing": {
      "get": {
        "operationId": "inmuebles24Listing",
        "summary": "Inmuebles24 listing",
        "description": "One Inmuebles24 listing: id, code, type, operation, status, prices, maintenance fee, main features, every feature by group (general, services, amenities, outdoors), description, address, location tree, coordinates, photos and the advertiser (agency name, page, logo, licence and WhatsApp; a private owner's number is left out). Pass `latest=true` with search filters to open the newest matching listing.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/inmuebles24-listing",
        "tags": [
          "Inmuebles24"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "An inmuebles24.com/propiedades/...-<id>.html link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "true: open the first current result of a search made with the other filter params given here (the same as the search route's, e.g. type, operation, location), instead of `id`/`url`.",
            "schema": {
              "type": "boolean"
            },
            "example": "true"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "With `latest`: the search's `type` filter.",
            "schema": {
              "type": "string"
            },
            "example": "departamentos"
          },
          {
            "name": "operation",
            "in": "query",
            "required": false,
            "description": "With `latest`: the search's `operation` filter.",
            "schema": {
              "type": "string"
            },
            "example": "sale"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "With `latest`: the search's `location` filter.",
            "schema": {
              "type": "string"
            },
            "example": "ciudad-de-mexico"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
