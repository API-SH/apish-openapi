    "/unstop/v1/search": {
      "get": {
        "operationId": "unstopSearch",
        "summary": "Unstop jobs, internships and competitions search",
        "description": "Listings on Unstop (unstop.com, India) of one type, jobs, internships, competitions, hackathons, quizzes, scholarships, workshops, cultural events, hiring challenges or all, for a keyword, with the site's filters: open or closed, work type (work from home, in office, hybrid, field), timing, posting age, audience (freshers, college students, professionals), quick apply, paid or unpaid, online or offline; sort by relevance, latest, popular, prize or deadline. Each item: `id`, `title`, `url`, `type`, `status`, `registrations_open`, `organisation`, `logo`, `locations`, `work_type`, `timing`, `salary`, `experience`, `skills`, `eligibility`, `prizes`, `team_size`, registration dates, views, registrations, `snippet` and `raw`. 15 items a page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/unstop-search",
        "tags": [
          "Unstop"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Listing type (default `jobs`).",
            "schema": {
              "type": "string",
              "enum": [
                "jobs",
                "internships",
                "competitions",
                "hackathons",
                "quizzes",
                "scholarships",
                "workshops",
                "cultural",
                "hiring-challenges",
                "all"
              ]
            },
            "example": "jobs"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `python`, `marketing`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "`open`: only listings taking registrations.",
            "schema": {
              "type": "string",
              "enum": [
                "open",
                "closed",
                "recent",
                "all"
              ]
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "Work type (jobs and internships).",
            "schema": {
              "type": "string",
              "enum": [
                "wfh",
                "in_office",
                "hybrid",
                "on_field"
              ]
            }
          },
          {
            "name": "job_timing",
            "in": "query",
            "required": false,
            "description": "Timing (jobs and internships).",
            "schema": {
              "type": "string",
              "enum": [
                "full_time",
                "part_time",
                "contractual"
              ]
            }
          },
          {
            "name": "posted_within_days",
            "in": "query",
            "required": false,
            "description": "Only listings posted within this many days, e.g. `7`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "user_type",
            "in": "query",
            "required": false,
            "description": "Who can apply.",
            "schema": {
              "type": "string",
              "enum": [
                "fresher",
                "college_students",
                "professionals",
                "school_students",
                "everyone"
              ]
            }
          },
          {
            "name": "quick_apply",
            "in": "query",
            "required": false,
            "description": "`true`: only quick-apply listings.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "payment",
            "in": "query",
            "required": false,
            "description": "Paid or free to enter (competitions).",
            "schema": {
              "type": "string",
              "enum": [
                "paid",
                "unpaid",
                "all"
              ]
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Online or in-person (competitions).",
            "schema": {
              "type": "string",
              "enum": [
                "online",
                "offline"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "latest",
                "popular",
                "prize",
                "deadline"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
