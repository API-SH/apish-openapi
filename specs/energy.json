    "/energy/v1/demand": {
      "get": {
        "operationId": "energyDemand",
        "summary": "Electricity demand and forecast",
        "description": "Electricity demand (load) of a European country in MW for a day or a range of up to 7 days, hour by hour or at the source's own interval: actual load, residual load, renewable share of load, and the day-ahead and intraday load forecasts (forecasts run into the future for today and tomorrow), with min, max and average. Source: Energy-Charts (Fraunhofer ISE), CC BY 4.0.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/energy-demand",
        "tags": [
          "Energy"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country code: de (default), fr, es, it, nl, be, at, ch, pl, uk ... (the same list as /energy/v1/generation).",
            "schema": {
              "type": "string"
            },
            "example": "de"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "One day (YYYY-MM-DD); default today.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_date",
            "in": "query",
            "required": false,
            "description": "Range start (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "end_date",
            "in": "query",
            "required": false,
            "description": "Range end (YYYY-MM-DD), up to 7 days after start_date.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "required": false,
            "description": "hour (default) or raw (the source's 15-minute steps).",
            "schema": {
              "type": "string",
              "enum": [
                "hour",
                "raw"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "country": "de",
                  "start_date": "2026-11-04",
                  "end_date": "2026-11-04",
                  "resolution": "hour",
                  "unit": "MW",
                  "forecasts_available": {
                    "day_ahead": true,
                    "intraday": true
                  },
                  "load_stats": {
                    "min": 46704,
                    "max": 50527.5,
                    "avg": 48547
                  },
                  "forecast_day_ahead_stats": {
                    "min": 45657.2,
                    "max": 65018.5,
                    "avg": 57710
                  },
                  "count": 24,
                  "series": [
                    {
                      "time": "2026-11-03T23:00:00Z",
                      "load_mw": 50232.7,
                      "residual_load_mw": 31206.6,
                      "renewable_share_of_load_pct": 49.1,
                      "forecast_day_ahead_mw": 48301.4,
                      "forecast_intraday_mw": null
                    },
                    {
                      "time": "2026-11-04T00:00:00Z",
                      "load_mw": 47368.9,
                      "residual_load_mw": 29173.5,
                      "renewable_share_of_load_pct": 50.3,
                      "forecast_day_ahead_mw": 46536,
                      "forecast_intraday_mw": null
                    },
                    "… 22 more"
                  ],
                  "attribution": "Source: Energy-Charts (Fraunhofer ISE), CC BY 4.0",
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
