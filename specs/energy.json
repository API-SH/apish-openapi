    "/energy/v1/carbon-stats": {
      "get": {
        "operationId": "energyCarbonStats",
        "summary": "GB carbon intensity statistics",
        "description": "Great Britain's grid carbon intensity statistics (maximum, average, minimum in gCO2/kWh and the index) over a range of up to 30 days, as one block or split into blocks of 1-24 hours. Default: the last 7 days. Source: NESO Carbon Intensity API, CC BY 4.0.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/energy-carbon-stats",
        "tags": [
          "Energy"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Start (YYYY-MM-DD or YYYY-MM-DDTHH:MMZ).",
            "schema": {
              "type": "string"
            },
            "example": "2026-10-01"
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "End (YYYY-MM-DD or YYYY-MM-DDTHH:MMZ), up to 30 days after from. Default: now, or 30 days after from when that is earlier.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "block",
            "in": "query",
            "required": false,
            "description": "Split into blocks of this many hours (1-24).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
