    "/prettylittlething/v1/search": {
      "get": {
        "operationId": "prettylittlethingSearch",
        "summary": "PrettyLittleThing product search and category listing",
        "description": "Search PrettyLittleThing products by keywords, or list a category, with every filter the shop offers (colour, size, style, category type, classification such as Petite or Plus, collection, brand, sleeve length, price band, discount band, length, occasion, design, department, gender; comma list = any of) and five sort orders. Each product: code, name, brand, colour, price, was price, saving, rating, review count, colour variants with images, prices by colour, images and link, plus `raw`; also the filter values with counts. 40 per page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/prettylittlething-search",
        "tags": [
          "PrettyLittleThing"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords. Either q or category is required.",
            "schema": {
              "type": "string"
            },
            "example": "dress"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug (e.g. womens-dresses) or a /categories/ link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Shop country (prices and currency follow it). Default US.",
            "schema": {
              "type": "string",
              "enum": [
                "US",
                "GB",
                "IE",
                "AU",
                "CA",
                "FR",
                "DE",
                "PL",
                "SE",
                "AE"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "newest",
                "best_sellers"
              ]
            }
          },
          {
            "name": "colour",
            "in": "query",
            "required": false,
            "description": "Colour(s), e.g. Black,Red.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Size(s), e.g. 6,8.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "style",
            "in": "query",
            "required": false,
            "description": "Style(s) as listed in filters.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "classification",
            "in": "query",
            "required": false,
            "description": "e.g. Petite, Plus Size, Maternity.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "description": "Collection(s).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand(s).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_band",
            "in": "query",
            "required": false,
            "description": "Price band(s) as listed in filters.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "discount_band",
            "in": "query",
            "required": false,
            "description": "Discount band(s) as listed in filters.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sleeve_length",
            "in": "query",
            "required": false,
            "description": "Sleeve length(s).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "dress",
                  "category": null,
                  "country": "US",
                  "sort": "relevance",
                  "page": 1,
                  "applied_filters": {},
                  "total": 19049,
                  "pages": 477,
                  "count": 40,
                  "next_page": 2,
                  "products": [
                    {
                      "id": "PLT07736",
                      "name": "Petite  Off Shoulder Pleated Maxi Dress",
                      "brand": "PrettyLittleThing",
                      "colour": "almond",
                      "price_text": "$35.10",
                      "was_price_text": "$117.00",
                      "saving": "Save 70%",
                      "size": "0",
                      "rating": null,
                      "reviews": 0,
                      "premier": false,
                      "gift_with_purchase": false,
                      "colours": [
                        {
                          "colour": "baby pink",
                          "colour_group": "Pink",
                          "image": "https://mediahub.prettylittlething.com/cnn7998_baby%20pink_xl"
                        },
                        {
                          "colour": "almond",
                          "colour_group": "Beige",
                          "image": "https://mediahub.prettylittlething.com/cnn8075_almond_xl"
                        }
                      ],
