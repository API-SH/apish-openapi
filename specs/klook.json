    "/klook/v1/reviews": {
      "get": {
        "operationId": "klookReviews",
        "summary": "Klook activity reviews",
        "description": "Reviews of a Klook activity: author (masked), date, rating out of 5, text, language, English translation, package, photos and the operator's reply, with the activity's rating and review total. Filter by star rating, review language and photos. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/klook-reviews",
        "tags": [
          "Klook"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Activity id or klook.com activity URL.",
            "schema": {
              "type": "string"
            },
            "example": "695"
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Star ratings to keep, comma-separated (1-5).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "newest"
              ]
            },
            "example": "default"
          },
          {
            "name": "review_language",
            "in": "query",
            "required": false,
            "description": "Only reviews written in this language, e.g. en_US, ja_JP.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "with_photos",
            "in": "query",
            "required": false,
            "description": "true: only reviews with photos.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page, 1-50.",
            "schema": {
              "type": "integer"
            },
            "example": "20"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
