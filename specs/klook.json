    "/klook/v1/suggest": {
      "get": {
        "operationId": "klookSuggest",
        "summary": "Klook search suggestions",
        "description": "Klook's search-box suggestions for what was typed: destinations (with country), places, activities and keywords, each with type, title, subtitle, id and link, plus how many activities match.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/klook-suggest",
        "tags": [
          "Klook"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
