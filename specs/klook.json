    "/klook/v1/search": {
      "get": {
        "operationId": "klookSearch",
        "summary": "Klook search",
        "description": "Klook tours, attraction tickets, transport passes and stays matching a search: activity id, kind, title, category, city, link, image, price text, rating, review count, booked count, tags and coordinates, 15 a page, with the category tabs Klook offers for the query. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/klook-search",
        "tags": [
          "Klook"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search text: a place, attraction or activity.",
            "schema": {
              "type": "string"
            },
            "example": "tokyo disneyland"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category tab key from `categories` in a previous answer (1 tours and experiences, 2 attraction tickets, 30 transport, 54 hotels, 70 more).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "most_relevant",
                "price",
                "participants",
                "publish_time",
                "review_score"
              ]
            },
            "example": "most_relevant"
          },
          {
            "name": "city_id",
            "in": "query",
            "required": false,
            "description": "Only this Klook city id (`city_id` of a result).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Price currency.",
            "schema": {
              "type": "string"
            },
