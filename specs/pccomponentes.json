    "/pccomponentes/v1/search": {
      "get": {
        "operationId": "pccomponentesSearch",
        "summary": "Search PcComponentes products",
        "description": "PcComponentes product search or category browse with every filter the shop offers: article id, name, link, brand, part number, EAN, condition (new, refurbished, replay), price, original and reference price, discount, lowest price in the last 30/60/90 days and ever, shipping cost, rating and review count, seller (and whether PcComponentes sells it), availability, stock by store, delivery dates, category path, attributes, labels and image. `facets` lists brands, conditions, categories, sellers and every attribute group with value ids (pass them in `filters`) and counts. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/pccomponentes-search",
        "tags": [
          "PcComponentes"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search keywords (optional when category, brand or filters is given).",
            "schema": {
              "type": "string"
            },
            "example": "raton gaming"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category ids, comma-separated (e.g. 1115 for laptops; from a result's category_id or the category facet).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brands, comma-separated, as in the brand facet (e.g. Logitech,Razer).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "description": "new, refurbished or replay; comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum price in euros.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum price in euros.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "Attribute value ids from the facets, comma-separated (each must match); several values of one group joined with `|` (e.g. 285|2883).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sold_by_pccomponentes",
            "in": "query",
            "required": false,
            "description": "true for products sold by PcComponentes, false for marketplace sellers.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "in_stock",
            "in": "query",
            "required": false,
            "description": "true for products in stock.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: relevance (default), price_asc, price_desc, discount, best_selling.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "discount",
                "best_selling"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1 for the first. Pass back `next_page`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page, up to 100 (default 40).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Shop: es (pccomponentes.com, default), pt, fr or it.",
            "schema": {
              "type": "string",
              "enum": [
                "es",
                "pt",
                "fr",
                "it"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "rtx 4090",
                  "applied_filters": {
                    "country": "es",
                    "sort": "relevance",
                    "page": 1,
                    "limit": 40
                  },
                  "total": 20,
                  "page": 1,
                  "pages": 1,
                  "count": 20,
