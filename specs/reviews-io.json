    "/reviewsio/v1/reviews": {
      "get": {
        "operationId": "reviewsioReviews",
        "summary": "REVIEWS.io store reviews",
        "description": "A store's company reviews on REVIEWS.io: id, stars, title, text, date, verification, helpful votes, the company's replies, photos, videos, extra ratings, attributes and branch, with the store's average rating, review count and star distribution. Reviewers' names, order numbers and addresses are not returned. Page with `page`; `next_page` is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/reviewsio-reviews",
        "tags": [
          "REVIEWS.io"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "store",
            "in": "query",
            "required": true,
            "description": "The store id from reviews.io/company-reviews/store/<store>, or that URL.",
            "schema": {
              "type": "string"
            },
            "example": "gymshark"
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Only reviews with this many stars (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "date_desc",
                "date_asc",
                "highest_rating"
              ]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Reviews per page (1-100, default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-based); `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
