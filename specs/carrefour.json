                          "level": 2,
                          "url": "https://www.carrefour.fr/r/cremerie/yaourts-fromages-blancs"
                        },
                        {
                          "id": "36996",
                          "name": "Desserts et Compotes",
                          "path": "cremerie/desserts-compotes",
                          "level": 2,
                          "url": "https://www.carrefour.fr/r/cremerie/desserts-compotes"
                        },
                        "… 5 more"
                      ]
                    }
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/carrefour/v1/category": {
      "get": {
        "operationId": "carrefourCategory",
        "summary": "Carrefour France category products",
        "description": "The products of one Carrefour category, 30 a page, with the same fields, filters, sorts and facets as search, plus the category's breadcrumb. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/carrefour-category",
        "tags": [
          "Carrefour"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "A category path (e.g. cremerie/laits) or a carrefour.fr/r/<path> link.",
            "schema": {
              "type": "string"
            },
            "example": "cremerie/laits"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), price_asc, price_desc, unit_price_asc, unit_price_desc, rating.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "unit_price_asc",
                "unit_price_desc",
                "rating"
              ]
            }
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "Facet filters as field:value pairs separated by ';'.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "promotions",
            "in": "query",
            "required": false,
            "description": "true for products on promotion only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1 for the first, up to 99. Pass back `next_page`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
