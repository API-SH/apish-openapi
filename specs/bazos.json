    "/bazos/v1/search": {
      "get": {
        "operationId": "bazosSearch",
        "summary": "Search Bazoš ads",
        "description": "Bazoš (Czech Republic, Slovakia, Poland, Austria) classified ads for a keyword and section, around a postcode, with price and sort: title, short text, price, place, postcode, views, date, TOP flag and photo. 20 per page. Private sellers' names, phone numbers and email addresses are never returned (masked in ad text).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bazos-search",
        "tags": [
          "Bazos"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords.",
            "schema": {
              "type": "string"
            },
            "example": "iphone"
          },
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "Section (www = all, auto, moto, mobil, pc, foto, elektro, dum, reality, nabytek, deti, obleceni, sport, zvirata, hudba, knihy, prace, sluzby, stroje, ostatni).",
            "schema": {
              "type": "string"
            },
            "example": "mobil"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Site.",
            "schema": {
              "type": "string",
              "enum": [
                "cz",
                "sk",
                "pl",
                "at"
              ]
            }
          },
          {
            "name": "postcode",
            "in": "query",
            "required": false,
            "description": "Postcode to search around (e.g. 11000).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Radius in km (default 25).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "price_asc",
                "price_desc",
                "views"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Results page, 1 for the first. Pass back `next_page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
