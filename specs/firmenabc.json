    "/firmenabc/v1/suggest": {
      "get": {
        "operationId": "firmenabcSuggest",
        "summary": "FirmenABC industry and company suggestions",
        "description": "Industry and company suggestions for a term as FirmenABC.at shows them while typing: industries with `industry_id` (use it in /firmenabc/v1/search) and companies with their id and search link.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/firmenabc-suggest",
