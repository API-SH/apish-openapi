    "/firmenabc/v1/places": {
      "get": {
        "operationId": "firmenabcPlaces",
        "summary": "FirmenABC place suggestions",
        "description": "Austrian states, regions, districts, places and postal codes matching a term, each with `place_id` and `place_is_region` for /firmenabc/v1/search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/firmenabc-places",
        "tags": [
          "FirmenABC"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Place name or postal code (at least 2 letters or digits).",
            "schema": {
              "type": "string"
            },
            "example": "graz"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "graz",
                  "count": 2,
                  "places": [
                    {
                      "place_id": "601",
