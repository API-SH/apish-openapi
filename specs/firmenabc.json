    "/firmenabc/v1/search": {
      "get": {
        "operationId": "firmenabcSearch",
        "summary": "Search Austrian companies",
        "description": "Austrian companies from FirmenABC.at matching a company name, industry or keyword, optionally in a place, district or state: company id, name, street, postal code, city, logo, opening hours, badges (e.g. featured listings) and features, whether a credit report exists, and whether the listing is a featured one. Use `industry_id` and `place_id` from /firmenabc/v1/suggest and /firmenabc/v1/places to filter exactly. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/firmenabc-search",
        "tags": [
          "FirmenABC"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Company name, industry or keyword (optional when `industry_id` is given).",
            "schema": {
              "type": "string"
            },
            "example": "tischler"
          },
          {
            "name": "where",
            "in": "query",
            "required": false,
            "description": "Place, district, state or postal code as text.",
            "schema": {
              "type": "string"
            },
            "example": "Graz"
          },
          {
            "name": "industry_id",
            "in": "query",
            "required": false,
            "description": "Industry id from /firmenabc/v1/suggest (`industries[].industry_id`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "place_id",
            "in": "query",
            "required": false,
            "description": "Place id from /firmenabc/v1/places (`places[].place_id`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "place_is_region",
            "in": "query",
            "required": false,
            "description": "true when `place_id` is a region (`place_is_region` in /firmenabc/v1/places).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "`next_cursor` from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "tischler",
                  "where": "Graz",
                  "industry_id": null,
                  "place_id": null,
                  "title": "Ergebnisse",
                  "page": 1,
                  "total": null,
