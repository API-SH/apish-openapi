    "/talent/v1/search": {
      "get": {
        "operationId": "talentSearch",
        "summary": "Search Talent.com jobs",
        "description": "Job ads on Talent.com for a keyword and a place, on any of its country sites. Each job has the title, company, place with coordinates, remote flag, job types, salary range when the ad gives one, a text snippet, first-seen and posting dates, source and the employer's apply link; `resolved_location` is the place the site matched and `applied_filters` echoes what it applied. Logged out, the site shows the first page of results (about 20 jobs); open one with /talent/v1/job for its full description.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/talent-search",
        "tags": [
          "Talent.com"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Job title or keyword. Give q, location or both.",
            "schema": {
              "type": "string"
            },
            "example": "software engineer"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, region or postal code (e.g. New York, Texas, London).",
            "schema": {
              "type": "string"
            },
            "example": "New York"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country site, two-letter code: us (default), gb, fr, de, au, in, ch, nl, be, es, it, at, br, mx and the other Talent.com countries.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Language version of the country site when it has several, two-letter code (e.g. es on the US site).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "software engineer",
                  "location": "New York",
                  "country": "us",
                  "url": "https://www.talent.com/jobs/k-software-engineer-l-new-york",
                  "applied_filters": {
                    "k": "software engineer",
                    "l": "new york"
                  },
                  "resolved_location": {
                    "name": "New York, NY, USA",
                    "type": "locality",
                    "city": "New York",
                    "region": "New York",
                    "country_code": "US",
                    "lat": 40.7127753,
                    "lon": -74.0059728
                  },
                  "total_pages": 2,
                  "count": 20,
                  "jobs": [
                    {
                      "id": "578673798231892017",
                      "title": "Software Engineer",
                      "normalized_title": "Software Engineer",
                      "url": "https://www.talent.com/view?id=578673798231892017",
                      "company": "TradeJobsWorkForce",
                      "company_normalized": "TradeJobsWorkForce",
                      "location": "07032 Kearny, NJ, US",
                      "city": "Kearny",
                      "region": "New Jersey",
                      "country": "us",
                      "lat": 40.7593718,
                      "lon": -74.1181234,
                      "remote": "no",
                      "job_types": [],
                      "employment_type": "OTHER",
                      "category": null,
                      "soc_code": "15-1252.00",
                      "language": "en",
