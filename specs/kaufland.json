    "/kaufland/v1/reviews": {
      "get": {
        "operationId": "kauflandReviews",
        "summary": "Kaufland product reviews",
        "description": "A Kaufland.de product's customer reviews: rating, text, author, date, verified purchase, helpful votes, product-test flag and media, plus the average rating, total and the site's AI summary of the reviews. Sort by best or newest and filter by star rating. Pass `next_offset` back as `offset`; it is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kaufland-reviews",
        "tags": [
          "Kaufland"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The product id or link.",
            "schema": {
              "type": "string"
            },
            "example": "343111567"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "best (default) or newest.",
            "schema": {
              "type": "string",
              "enum": [
                "best",
                "newest"
              ]
            }
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Only reviews with this many stars (1-5).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page (default 20, max 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "`next_offset` from the previous page.",
            "schema": {
              "type": "integer"
            }
