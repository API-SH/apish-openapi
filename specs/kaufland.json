    "/kaufland/v1/search": {
      "get": {
        "operationId": "kauflandSearch",
        "summary": "Kaufland search",
        "description": "Product search on Kaufland.de (Germany): each product with id, title, brand, EAN, category, price in EUR, previous price and discount, rating and review count, images, delivery cost and dates, seller and sponsored flag, plus `raw`. Filter by price range, category, minimum rating, free delivery, deals or any filter the response lists (`filters[].key` with an option `value`). `total` is the site's result count. Pass `next_page` back as `page`; it is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kaufland-search",
        "tags": [
          "Kaufland"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words (optional with category_id).",
            "schema": {
              "type": "string"
            },
            "example": "kaffeemaschine"
          },
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "description": "Category id (from the categoryId filter of a response).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in EUR.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in EUR.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rating_min",
            "in": "query",
            "required": false,
            "description": "Minimum average rating 1-4.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "free_delivery",
            "in": "query",
            "required": false,
            "description": "true: only products with free delivery.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deals",
            "in": "query",
            "required": false,
            "description": "true: only discounted products.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "Other filters as key:value pairs, comma separated, from `filters[].key` and `options[].value` (e.g. manufacturer:51772).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "Nintendo Switch",
                  "total": 10000,
                  "page": 1,
                  "count": 40,
                  "items": [
                    {
                      "id": "512034296",
