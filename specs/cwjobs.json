    "/cwjobs/v1/search": {
      "get": {
        "operationId": "cwjobsSearch",
        "summary": "CWJobs job search (UK tech jobs)",
        "description": "IT and tech jobs on CWJobs (cwjobs.co.uk, UK) for a keyword and/or location, with every filter of the site: radius, job type (permanent, contract, temporary, part time, full time, work from home), posting age, agency or direct employer, minimum annual, daily or hourly salary, and sort by relevance, date, salary or distance. `facets` lists the filter values with the parameter to send. Each job: `id`, `title`, `url`, `company`, `company_id`, `company_url`, `logo`, `location`, `salary`, `snippet`, `posted_at`, `labels` and `raw`. 25 jobs a page; `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cwjobs-search",
        "tags": [
          "CWJobs"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `python`, `devops engineer`.",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Town, city, county or region, e.g. `london`, `manchester`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Distance from the location in miles: 0, 5, 10, 20 or 30 (the site's choices; other values use the next larger one, at most 30, shown in `applied_filters.radius`).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "Job type.",
            "schema": {
              "type": "string",
              "enum": [
                "permanent",
                "contract",
                "temporary",
                "part-time",
                "full-time",
                "work-from-home"
              ]
            }
          },
          {
            "name": "posted_within",
            "in": "query",
            "required": false,
            "description": "Only jobs posted within this many days.",
            "schema": {
