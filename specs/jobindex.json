    "/jobindex/v1/search": {
      "get": {
        "operationId": "jobindexSearch",
        "summary": "Search Jobindex jobs",
        "description": "Job ads on Jobindex (Denmark) for keywords, with the site's filters: area, category, employment type, working hours, posting age and home workplace, sorted by relevance or date. Each result has the title, company with profile link, website, followers and rating, area, addresses with coordinates, posting date and application deadline, summary and apply link. `facets` lists the ids for areas, categories, employment types, hours and posting age. 20 per page; pass `next_page` back as `page`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jobindex-search",
        "tags": [
          "Jobindex"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords (title, skill or company).",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "area",
            "in": "query",
            "required": false,
            "description": "Area ids, comma separated (facets.areas; e.g. 15182 Greater Copenhagen).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category ids, comma separated (facets.categories; e.g. 1 IT development).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employment_type",
            "in": "query",
            "required": false,
            "description": "1 permanent, 2 temporary, 3 student job, 4 apprentice, 5 graduate, 6 internship, 8 flex job, 9 volunteer, 10 youth job, 11 freelance, 12 hourly; comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hours",
            "in": "query",
