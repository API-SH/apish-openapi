{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Yad2",
    "version": "1.0.0",
    "description": "The Yad2 API from API.SH: public Yad2 data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Yad2",
      "description": "2 endpoints (real estate)",
      "x-slug": "yad2",
      "x-domains": [
        "yad2.co.il"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/yad2/v1/broker-listings": {
      "get": {
        "operationId": "yad2BrokerListings",
        "summary": "Yad2 agency or broker page with its real estate listings",
        "description": "The public page of a real estate agency on Yad2 (yad2.co.il), or of one broker in it, with its listings for sale, for rent or commercial, filtered and sorted the way the page does. Profile: agency id, office name, description, office address, phone, logo, licence number, specializations and opening hours (agency page), or the broker's id, name, description, phone, photo, licence number and office (broker page); the agency page also lists the team (each broker's id, name, listing count, licence number, avatar and page link). Each listing: token (use it with /yad2/v1/listing), link, deal type, price in ILS, property type, rooms, size in square metres, floor, region, area, city, neighbourhood, street, cover image, tags, exclusivity flag, plus `raw`. Also the listing counts per deal type, the applied filters and the totals. Text is in Hebrew as on the site. Pages hold 5 listings, as on the site: pass `next_page` back as `page`; it is null on the last page. Pass `url` instead of the ids to read a Yad2 agency or broker page address. An unknown agency or broker answers 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yad2-broker-listings",
        "tags": [
          "Yad2"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "agency_id",
            "in": "query",
            "required": false,
            "description": "Agency id from the page address (yad2.co.il/realestate/agency/<agency_id>/...). Required unless `url` is given.",
            "schema": {
              "type": "string"
            },
            "example": "1981137"
          },
          {
            "name": "broker_id",
            "in": "query",
            "required": false,
            "description": "Broker id within the agency (.../agency/<agency_id>/broker/<broker_id>/...). Omit for the whole agency.",
            "schema": {
              "type": "string"
            },
            "example": "766862"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A Yad2 agency or broker page address instead of the ids, e.g. https://www.yad2.co.il/realestate/agency/1981137/broker/766862/forsale (the deal type in it is used unless `deal_type` is given).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "deal_type",
            "in": "query",
            "required": false,
            "description": "Which listings: forsale (default), rent or commercial.",
            "schema": {
              "type": "string",
              "enum": [
                "forsale",
                "rent",
                "commercial"
              ],
              "default": "forsale"
            }
          },
          {
            "name": "commercial_deal",
            "in": "query",
            "required": false,
            "description": "With deal_type=commercial only: rent or sale.",
            "schema": {
              "type": "string",
              "enum": [
                "rent",
                "sale"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Results page, 1-based (5 listings a page).",
            "schema": {
              "type": "integer",
              "default": "1"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: date (newest first, default), price_asc or price_desc.",
            "schema": {
              "type": "string",
              "enum": [
                "date",
                "price_asc",
                "price_desc"
              ]
            }
          },
          {
            "name": "property",
            "in": "query",
            "required": false,
            "description": "Property type ids, comma-separated, as in the page filter. Homes: 1 apartment, 3 garden apartment, 4 studio/loft, 5 private house/cottage, 6 roof/penthouse, 7 duplex, 11 housing unit, 25 holiday home, 32 farm, 33 plot, 39 semi-detached, 41 general, 44 residential building, 45 storage, 49 basement, 50 purchase group, 51 triplex, 55 auxiliary farm, 61 assisted living, 30 parking.",
            "schema": {
              "type": "string"
            },
            "example": "1,5"
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Lowest price in ILS.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Highest price in ILS.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_rooms",
            "in": "query",
            "required": false,
            "description": "Fewest rooms (halves allowed, e.g. 3.5).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_rooms",
            "in": "query",
            "required": false,
            "description": "Most rooms.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_floor",
            "in": "query",
            "required": false,
            "description": "Lowest floor.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_floor",
            "in": "query",
            "required": false,
            "description": "Highest floor.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_sqm",
            "in": "query",
            "required": false,
            "description": "Smallest size in square metres.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_sqm",
            "in": "query",
            "required": false,
            "description": "Largest size in square metres.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/yad2/v1/listing": {
      "get": {
        "operationId": "yad2Listing",
        "summary": "Yad2 real estate listing",
        "description": "One Yad2 (yad2.co.il) real estate listing in full: deal type, price in ILS (and the asking-above price when shown), property type and group, condition, rooms, size and built size in square metres, balconies, parking spaces, floor and building height, entry date, yes/no features (parking, elevator, safe room, air conditioning, balcony, furniture, accessibility, exclusivity and more), description, every image, full address with coordinates and ids, tags, created, updated and end dates, and, for agency listings, the contact as the listing shows it (name, phone numbers, agency id, name, logo and about text, licence number and brokers with their phones); a private seller's listing has `contact.private_seller` true and no name or phone numbers. Plus `raw`. Text is in Hebrew as on the site. A listing that was removed answers 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yad2-listing",
        "tags": [
          "Yad2"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "token",
            "in": "query",
            "required": false,
            "description": "Listing id: the last part of a Yad2 item address (yad2.co.il/realestate/item/<token>) or `token` from /yad2/v1/broker-listings. Required unless `url` is given.",
            "schema": {
              "type": "string"
            },
            "example": "alrazglw"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A Yad2 listing address instead of the token.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Create keys at https://app.api.sh/keys. Authorization: Bearer <key> also works."
      }
    },
    "parameters": {
      "raw": {
        "name": "raw",
        "in": "query",
        "required": false,
        "description": "0 leaves out the bulky `raw` source blocks (often 10-30x smaller).",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Comma-separated fields to return, e.g. `posts.id,posts.title`. Call metadata is always included.",
        "schema": {
          "type": "string"
        }
      },
      "fresh": {
        "name": "fresh",
        "in": "query",
        "required": false,
        "description": "1 skips the 24-hour cache and fetches live.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "output": {
        "name": "output",
        "in": "query",
        "required": false,
        "description": "csv or ndjson returns the response's records (its main list, or the object as one row) as CSV or NDJSON instead of JSON.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "ndjson"
          ]
        }
      },
      "records": {
        "name": "records",
        "in": "query",
        "required": false,
        "description": "With output=csv|ndjson: the top-level list to turn into rows (e.g. `reviews`), or `.` for the whole object as one row.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "On a 503 for a paused endpoint: the status page, which lists open incidents."
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "responses": {
      "E400": {
        "description": "A parameter is missing or invalid. Not charged (unless the call ran and the source rejected the value; credits_used says).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E402": {
        "description": "Not enough credits, a spend limit you set was reached (`spend_limit`), or the key's monthly credit cap was reached (`key_cap`). Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
        "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E502": {
        "description": "The source site failed this time; retry. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E503": {
        "description": "Endpoint paused or temporarily unavailable; may include retry-after, and status_url (https://api.sh/status) for a paused endpoint. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "headers": {
      "x-request-id": {
        "description": "The call's id (logs, re-fetch with /v1/results/{id}).",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "x-credits-used": {
        "description": "Credits charged for this call.",
        "schema": {
          "type": "integer"
        }
      },
      "x-credits-remaining": {
        "description": "Balance after the call.",
        "schema": {
          "type": "integer"
        }
      }
    }
  },
  "externalDocs": {
    "url": "https://api.sh/docs"
  }
}
