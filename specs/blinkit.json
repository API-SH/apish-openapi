    "/blinkit/v1/search": {
      "get": {
        "operationId": "blinkitSearch",
        "summary": "Blinkit product search",
        "description": "Products on Blinkit (India, quick-commerce groceries) for keywords at a delivery location (New Delhi by default). Each product: id, name, brand, unit, price, MRP, discount, in-stock flag and quantity, delivery ETA (and in minutes), discount percent, sponsored flag, merchant type, product state, star rating and rating count, the card's tags and badges (delivery speed, offer, ad), the number of pack options, merchant and group id, link, image and `raw`. The site's search cards carry no veg/non-veg mark; `/blinkit/v1/product` returns `food_type` and `is_veg`. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/blinkit-search",
        "tags": [
          "Blinkit"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keywords, e.g. `milk`.",
            "schema": {
              "type": "string"
            },
            "example": "milk"
          },
          {
            "name": "latitude",
            "in": "query",
            "required": false,
            "description": "Delivery latitude in India (default 28.6139, New Delhi).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": false,
            "description": "Delivery longitude in India (default 77.2090).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pass `next_cursor` from the previous response.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
