                      "in_stock": true,
                      "inventory": 50,
                      "delivery_eta": "earliest",
                      "delivery_eta_minutes": 15,
                      "offer_pct": null,
                      "sponsored": false,
                      "merchant_type": "express",
                      "product_state": "available",
                      "merchant_id": "36778",
                      "group_id": "2056997",
                      "url": "https://blinkit.com/prn/mother-dairy-cow-milk/prid/339309",
                      "image": "https://cdn.grofers.com/da/cms-assets/cms/product/rc-upload-1780632898141-4.png"
                    },
                    {
                      "id": "12872",
                      "name": "Amul Gold Full Cream Milk",
                      "brand": "Amul",
                      "unit": "500 ml",
                      "price": 36,
                      "mrp": 36,
                      "currency": "INR",
                      "discount": null,
                      "in_stock": true,
                      "inventory": 24,
                      "delivery_eta": "earliest",
                      "delivery_eta_minutes": 15,
                      "offer_pct": null,
                      "sponsored": false,
                      "merchant_type": "express",
