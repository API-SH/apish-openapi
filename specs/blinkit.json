            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/blinkit/v1/product": {
      "get": {
        "operationId": "blinkitProduct",
        "summary": "Blinkit product",
        "description": "One Blinkit product by number (or link) at a delivery location (New Delhi by default): name, brand, unit, price, MRP, in-stock flag and quantity, description, every attribute the page shows (key features, ingredients, nutrition, shelf life, manufacturer…) plus named fields for key features, shelf life, country of origin, FSSAI license, manufacturer and seller (when shown), food type and veg flag, net weight, packaging type, storage tips, nutrition per 100 g, nutrition information and return policy, category ids, link, images and `raw`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/blinkit-product",
        "tags": [
          "Blinkit"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The product number (after `/prid/` in its link), e.g. `19512`.",
            "schema": {
              "type": "string"
            },
            "example": "19512"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A blinkit.com/prn/<name>/prid/<id> link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latitude",
            "in": "query",
            "required": false,
            "description": "Delivery latitude in India (default 28.6139, New Delhi).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "longitude",
            "in": "query",
            "required": false,
            "description": "Delivery longitude in India (default 77.2090).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
