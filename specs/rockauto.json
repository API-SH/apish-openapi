{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: RockAuto",
    "version": "1.0.0",
    "description": "The RockAuto API from API.SH: public RockAuto data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "RockAuto",
      "description": "3 endpoints (automotive)",
      "x-slug": "rockauto",
      "x-domains": [
        "rockauto.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/rockauto/v1/catalog": {
      "get": {
        "operationId": "rockautoCatalog",
        "summary": "RockAuto parts catalog",
        "description": "Walk the RockAuto catalog one level at a time: with no params the makes; then years for a make, models for a year, engines for a model, part categories for an engine and part types for a category. Each child has name, id (engines and part types), catalog path and link. Pass a child's `path` back as `path` to go one level down.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/rockauto-catalog",
        "tags": [
          "RockAuto"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "make",
            "in": "query",
            "required": false,
            "description": "Make (honda, ford...).",
            "schema": {
              "type": "string"
            },
            "example": "honda"
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "description": "Model year.",
            "schema": {
              "type": "integer"
            },
            "example": "2015"
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Model (civic, f-150...).",
            "schema": {
              "type": "string"
            },
            "example": "civic"
          },
          {
            "name": "engine",
            "in": "query",
            "required": false,
            "description": "Engine name as listed (1.8L L4) or its id (carcode).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Part category name (Brake & Wheel Hub).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "description": "A catalog path returned in `path` (instead of the names).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "path": "honda,2015,civic",
                  "url": "https://www.rockauto.com/en/catalog/honda,2015,civic",
                  "level": 3,
                  "children_level": "engine",
                  "vehicle": {
                    "make": "honda",
                    "year": 2015,
                    "model": "civic",
                    "engine": null,
                    "carcode": null
                  },
                  "count": 4,
                  "children": [
                    {
                      "name": "1.5L L4 ELECTRIC/GAS",
                      "id": "3310197",
                      "path": "honda,2015,civic,1.5l+l4+electric/gas,3310197",
                      "url": "https://www.rockauto.com/en/catalog/honda,2015,civic,1.5l+l4+electric/gas,3310197"
                    },
                    {
                      "name": "1.8L L4",
                      "id": "3310198",
                      "path": "honda,2015,civic,1.8l+l4,3310198",
                      "url": "https://www.rockauto.com/en/catalog/honda,2015,civic,1.8l+l4,3310198"
                    },
                    "… 2 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/rockauto/v1/part": {
      "get": {
        "operationId": "rockautoPart",
        "summary": "RockAuto part details",
        "description": "One RockAuto part's detail page: brand, part number, description, alternate inventory numbers, price, core charge, total, pack size, the purchase options with their prices, the full information text (notes, fitment and installation tips), warranty and images, and `available` (false for a part RockAuto no longer sells: its page stays, without a price). Use info_url (or part_key) from `/rockauto/v1/parts`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/rockauto-part",
        "tags": [
          "RockAuto"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A rockauto.com/en/moreinfo.php link (info_url of a parts result). url or pk is required.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.rockauto.com/en/moreinfo.php?pk=4826976&cc=3310198&pt=1684"
          },
          {
            "name": "pk",
            "in": "query",
            "required": false,
            "description": "The part key (part_key of a parts result).",
            "schema": {
              "type": "string"
            },
            "example": "4826976"
          },
          {
            "name": "cc",
            "in": "query",
            "required": false,
            "description": "The vehicle code from the same link (optional).",
            "schema": {
              "type": "string"
            },
            "example": "3310198"
          },
          {
            "name": "pt",
            "in": "query",
            "required": false,
            "description": "The part type id from the same link (optional).",
            "schema": {
              "type": "string"
            },
            "example": "1684"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "part_key": "16529641",
                  "url": "https://www.rockauto.com/en/moreinfo.php?pk=16529641&cc=3310198&pt=1684",
                  "brand": "FAMOUS BRAND",
                  "part_number": "1424639777",
                  "description": "OEF3 Ceramic",
                  "alternate_numbers": "1424639777:8",
                  "price": 8.74,
                  "core_charge": 0,
                  "total": 8.74,
                  "currency": "USD",
                  "pack": "1",
                  "options": [],
                  "information": [
                    "FAMOUS BRAND 1424639777",
                    "Point to Zoom"
                  ],
                  "warranty": "Wholesaler Closeout items have a 30 day warranty (but still are covered by our Return Policy ). Regular Inventory Warranty Information:",
                  "images": [
                    "https://www.rockauto.com/info/256/256_1424639777_1.jpg"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/rockauto/v1/parts": {
      "get": {
        "operationId": "rockautoParts",
        "summary": "RockAuto parts and prices",
        "description": "The parts RockAuto lists for one vehicle and part type: brand, part number, quality group (Economy, Daily Driver, Premium...), price, core charge, total, fitment notes, markets, purchase options with prices, images and the part's info link. Give make, year, model, engine, category and part type (names or ids), or a full catalog path from /rockauto/v1/catalog.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/rockauto-parts",
        "tags": [
          "RockAuto"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "make",
            "in": "query",
            "required": false,
            "description": "Make.",
            "schema": {
              "type": "string"
            },
            "example": "honda"
          },
          {
            "name": "year",
            "in": "query",
            "required": false,
            "description": "Model year.",
            "schema": {
              "type": "integer"
            },
            "example": "2015"
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Model.",
            "schema": {
              "type": "string"
            },
            "example": "civic"
          },
          {
            "name": "engine",
            "in": "query",
            "required": false,
            "description": "Engine name as listed or its id.",
            "schema": {
              "type": "string"
            },
            "example": "1.8L L4"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Part category name.",
            "schema": {
              "type": "string"
            },
            "example": "Brake & Wheel Hub"
          },
          {
            "name": "part_type",
            "in": "query",
            "required": false,
            "description": "Part type name or id.",
            "schema": {
              "type": "string"
            },
            "example": "Brake Pad"
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Only parts whose brand contains this.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "description": "A full catalog path instead of the names.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
