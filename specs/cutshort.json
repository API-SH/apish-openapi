    "/cutshort/v1/job": {
      "get": {
        "operationId": "cutshortJob",
        "summary": "Cutshort job details",
        "description": "One Cutshort job: title, company (slug, page, logo, founded, type, stage, funding, followers, website, description, tech stack), locations and address, remote policy, role and employment type, experience range, salary, skills, category, posted and valid-through dates, the poster's name and picture when the page includes them, the full description (HTML and text), similar jobs and related lists. Closed jobs answer 404. Give id/url, or q to open the first current result of a search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cutshort-job",
        "tags": [
          "Cutshort"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Job URL (cutshort.io/job/…) or its slug.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Instead of url: a role or skill; opens the first current job of that list (`city` and `remote` apply too).",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "With q: city as the site names it, e.g. `pune`.",
            "schema": {
              "type": "string"
            }
