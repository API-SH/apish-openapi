{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: jobs.ac.uk",
    "version": "1.0.0",
    "description": "The jobs.ac.uk API from API.SH: public jobs.ac.uk data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "jobs.ac.uk",
      "description": "2 endpoints (jobs & b2b)",
      "x-slug": "jobs-ac-uk",
      "x-domains": [
        "jobs.ac.uk"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jobsacuk/v1/job": {
      "get": {
        "operationId": "jobsacukJob",
        "summary": "jobs.ac.uk job ad",
        "description": "One job ad on jobs.ac.uk: title, employer and department, the employer's slug and jobs link, location(s), salary text with parsed minimum, maximum, currency and period, hours, contract type, placed, closing and expiry dates, job reference, apply link, the full description (text and HTML) and every row of the ad's details table. `latest=true` with search parameters returns the newest matching ad. Closed or removed ads answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jobsacuk-job",
        "tags": [
          "jobs.ac.uk"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The job id (e.g. `DTM067`, `id` in search results) or its jobs.ac.uk/job/<id>/<title> link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`true`: the newest ad of a search with the other parameters instead of an id (an example that never expires).",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "With `latest=true`: keywords (any search filter works too).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "DTN744",
                  "title": "PhD Studentship: The Physics of Learning in Robotic Metamaterials",
                  "url": "https://www.jobs.ac.uk/job/DTN744/phd-studentship-the-physics-of-learning-in-robotic-metamaterials",
                  "employer": "University of Birmingham",
                  "department": "School of Engineering",
                  "employer_slug": "university-of-birmingham",
                  "employer_jobs_url": "https://www.jobs.ac.uk/search/employer/university-of-birmingham",
                  "employer_profile_url": null,
                  "logo": "https://www.jobs.ac.uk/images/employer-logos/medium/45.gif",
                  "location": "Birmingham",
                  "locations": [
                    {
                      "locality": "Birmingham",
                      "region": "England",
                      "country": "United Kingdom"
                    }
                  ],
                  "salary": null,
                  "salary_min": null,
                  "salary_max": null,
                  "salary_currency": "GBP",
                  "salary_unit": "YEAR",
                  "hours": "Full Time",
                  "contract_type": null,
                  "employment_type": [
                    "Full Time",
                    "Fixed-Term/Contract"
                  ],
                  "placed_on": "5th November 2026",
                  "closes": "6th January 2027",
                  "expires": null,
                  "job_ref": null,
                  "date_posted": "2026-11-05T00:00:00+00:00",
                  "valid_through": "2027-01-06T00:00:00+00:00",
                  "apply_url": "https://www.birmingham.ac.uk/study/postgraduate/subjects/mechanical-engineering-courses/mechanical-engineering-phd,",
                  "description": "Join us!\n\nAre you a curiosity-driven scientist with a background in physics, engineering, applied mathematics or a related discipline? Join …",
                  "description_html": "<p><strong>Join us! </strong></p>\n<p>Are you a curiosity-driven scientist with a background in physics, engineering, applied mathematics or …",
                  "details": {
                    "qualification_type": "PhD",
                    "location": "Birmingham",
                    "funding_for": "UK Students",
                    "funding_amount": "£21,805",
                    "hours": "Full Time",
                    "placed_on": "5th November 2026",
                    "closes": "6th January 2027"
                  },
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/jobsacuk/v1/search": {
      "get": {
        "operationId": "jobsacukSearch",
        "summary": "jobs.ac.uk job search (academic, research and PhD jobs)",
        "description": "Jobs on jobs.ac.uk, the UK's academic and research job board (lecturer, research, professional services and PhD studentship ads from universities and research bodies in the UK and abroad), with every filter of the site's sidebar: academic discipline and sub-discipline, professional and support role, PhD or Masters studentship, qualification and funding type, location (region, country or city), workplace (on-site, hybrid, remote), salary band, hours, contract type and employer sector; sort by relevance, date placed or closing date. `employer` lists one employer's jobs. `facets` lists every filter value with its label and live count; send its `value` back in the matching parameter (comma-separate several). Each job: `id`, `title`, `url`, `employer`, `department`, `location`, `salary`, `date_placed`, `closes` or `expires`, `logo`. 25 jobs a page; `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jobsacuk-search",
        "tags": [
          "jobs.ac.uk"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `lecturer`, `machine learning`, `research fellow`. Leave out to browse every job.",
            "schema": {
              "type": "string"
            },
            "example": "lecturer"
          },
          {
            "name": "discipline",
            "in": "query",
            "required": false,
            "description": "Academic discipline slug(s), e.g. `computer-sciences`, `physical-and-environmental-sciences` (values in `facets.discipline`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sub_discipline",
            "in": "query",
            "required": false,
            "description": "Sub-discipline slug(s), e.g. `artificial-intelligence`, `biochemistry` (values in `facets.sub_discipline`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "non_academic",
            "in": "query",
            "required": false,
            "description": "Professional, managerial and support role slug(s), e.g. `it-services`, `human-resources` (values in `facets.non_academic`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "PhD or Masters studentships only.",
            "schema": {
              "type": "string",
              "enum": [
                "phds",
                "masters"
              ]
            }
          },
          {
            "name": "qualification",
            "in": "query",
            "required": false,
            "description": "Studentship qualification slug(s), e.g. `phd`, `professional-doctorate`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "funding",
            "in": "query",
            "required": false,
            "description": "Studentship funding slug(s): `uk-students`, `eu-students`, `international-students`, `self-funded-students`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Location slug(s): a region, country or city, e.g. `united-kingdom`, `london`, `scotland`, `europe` (values in `facets.location`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workplace",
            "in": "query",
            "required": false,
            "description": "`on-site`, `hybrid` or `remote` (comma-separate several).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "salary_band",
            "in": "query",
            "required": false,
            "description": "Salary band slug(s), e.g. `40000-49999`, `over-100000` (values in `facets.salary_band`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hours",
            "in": "query",
            "required": false,
            "description": "`full-time` or `part-time`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "contract",
            "in": "query",
            "required": false,
            "description": "`permanent`, `fixed-term-contract` or `temporary`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sector",
            "in": "query",
            "required": false,
            "description": "Employer sector slug(s), e.g. `universities-higher-education-institutions`, `science-and-research-organisations`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employer",
            "in": "query",
            "required": false,
            "description": "One employer's jobs: its slug (`employer_slug` of a job, e.g. `university-of-oxford`) or its jobs.ac.uk/search/employer/<slug> link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: relevance (default), newest first, or soonest closing date first.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "date",
                "closing"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "lecturer",
                  "employer": null,
                  "applied_filters": {
                    "q": "lecturer",
                    "sort": "relevance"
                  },
                  "total": 362,
