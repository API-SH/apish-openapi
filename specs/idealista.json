    "/idealista/v1/search": {
      "get": {
        "operationId": "idealistaSearch",
        "summary": "Idealista search",
        "description": "Property listings on idealista.com, .pt or .it: id, title, price and price per m², price drop, rooms, size, floor, details, description, tags, agency, images and link. Pass a search link as `url`, or build the search on idealista.com with `location` and filters: operation (sale or rent), property type, price and size range, bedrooms, bathrooms, features (garage, pool, terrace, lift, air conditioning, garden...) and sort (price, newest, size, price per m², biggest discount, floor). Pass `next_page` from the previous response; `next_page` is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/idealista-search",
        "tags": [
          "Idealista"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "An idealista.com, .pt or .it search link. Leave out to build the search from `location` and the filters below.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.idealista.com/en/venta-viviendas/madrid-madrid/"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Location as idealista.com spells it in its search links, e.g. `madrid-madrid`, `barcelona-barcelona`, `malaga-provincia`, or a district path such as `madrid/barrio-de-salamanca` (Spain).",
            "schema": {
              "type": "string"
            },
            "example": "madrid-madrid"
          },
          {
            "name": "operation",
            "in": "query",
            "required": false,
            "description": "sale (default) or rent. With `location`.",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent"
              ]
            }
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Default homes. With `location`.",
            "schema": {
