                      "mappings": {
                        "CHISCO3": "351",
                        "CHISCO5": "35120",
                        "BFS": "51101391",
                        "X28": "11000899",
                        "AVAM": "101784"
                      }
                    },
                    "… 8 more"
                  ],
                  "classifications": [
                    {
