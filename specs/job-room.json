    "/job-room/v1/search": {
      "get": {
        "operationId": "jobRoomSearch",
        "summary": "Job-Room (arbeit.swiss) job search",
        "description": "Swiss jobs on Job-Room (job-room.ch), the job platform of the Swiss public employment service linked from arbeit.swiss, with every filter of its search: keywords, occupations, cantons, communes, a radius around a point, workload range, permanent or temporary, company, days online and sort. Each job: `id`, `url`, `job_number`, `title`, `description` (text; keyword hits shortened by the site), `company` (name, address), `location` (city, postcode, commune, canton, coordinates), workload range, contract flags, start and end dates, `occupations` (codes), `language_skills`, `apply` (link, email, phone where given), `contact` (the employer's public contact when shown), publication dates and status. `total` is the number of matches. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/job-room-search",
        "tags": [
          "Job-Room"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords; several keywords separated by commas.",
            "schema": {
              "type": "string"
            },
            "example": "koch"
          },
          {
            "name": "canton",
            "in": "query",
            "required": false,
            "description": "Canton codes, comma separated (e.g. `ZH,BE,GE`).",
            "schema": {
              "type": "string"
            },
            "example": "ZH"
          },
          {
            "name": "occupation",
            "in": "query",
            "required": false,
            "description": "Occupation codes from /job-room/v1/occupations (`filter`, e.g. `AVAM:101784`), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "communal_code",
            "in": "query",
            "required": false,
            "description": "Swiss commune numbers (BFS, from /job-room/v1/places `communal_code`), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of a point in Switzerland for a radius search (with `lon` and `radius`).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Longitude of the radius search point.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Radius in km around `lat`/`lon` (default 20, max 200).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "workload_min",
            "in": "query",
            "required": false,
            "description": "Minimum workload in percent (default 10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "workload_max",
            "in": "query",
            "required": false,
            "description": "Maximum workload in percent (default 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "contract",
            "in": "query",
            "required": false,
            "description": "Contract type.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "permanent",
                "temporary"
              ]
            }
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "description": "Company name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "online_since",
            "in": "query",
            "required": false,
            "description": "Only jobs published in the last N days (1-60, default 60).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default `date_desc`).",
            "schema": {
              "type": "string",
              "enum": [
                "date_desc",
                "date_asc",
                "relevance"
              ]
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Preferred language of the job texts when an ad has several (default `de`).",
            "schema": {
              "type": "string",
              "enum": [
                "de",
                "fr",
                "it",
                "en"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Jobs per page (default 20, max 30).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (from 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
