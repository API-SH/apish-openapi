    "/job-room/v1/occupations": {
      "get": {
        "operationId": "jobRoomOccupations",
        "summary": "Job-Room occupation suggestions",
        "description": "Occupation names matching a prefix, as Job-Room's search form suggests them: label, classification type and code, the mapped codes (AVAM, X28, BFS, CHISCO) and `filter`, the value to pass as `occupation` to /job-room/v1/search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/job-room-occupations",
        "tags": [
          "Job-Room"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Start of an occupation name (2-80 characters).",
            "schema": {
              "type": "string"
            },
            "example": "Informatik"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language of the labels (default `de`).",
            "schema": {
              "type": "string",
              "enum": [
                "de",
                "fr",
                "it",
                "en"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of suggestions (default 10, max 50).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "Informatik",
                  "lang": "de",
                  "count": 10,
                  "occupations": [
                    {
                      "label": "Informatik Allrounder",
                      "type": "X28",
                      "code": "11000899",
                      "language": "de",
                      "filter": "AVAM:101784",
                      "avam_code": "101784",
                      "mappings": {
                        "CHISCO3": "351",
                        "CHISCO5": "35120",
                        "BFS": "51101391",
                        "X28": "11000899",
                        "AVAM": "101784"
                      }
                    },
                    {
                      "label": "Informatik Allrounderin",
                      "type": "X28",
                      "code": "11000899",
                      "language": "de",
                      "filter": "AVAM:101784",
