    "/job-room/v1/places": {
      "get": {
        "operationId": "jobRoomPlaces",
        "summary": "Job-Room place suggestions",
        "description": "Swiss places matching a name or postcode, as Job-Room's search form suggests them: city, postcode, commune number (`communal_code` for /job-room/v1/search), canton, region and coordinates (for a radius search), plus matching cantons.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/job-room-places",
        "tags": [
          "Job-Room"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Place name or postcode.",
            "schema": {
              "type": "string"
            },
            "example": "Zürich"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of suggestions (default 10, max 50).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
