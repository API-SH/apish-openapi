    "/wuzzuf/v1/search": {
      "get": {
        "operationId": "wuzzufSearch",
        "summary": "Wuzzuf job search",
        "description": "Jobs on Wuzzuf (wuzzuf.net, Egypt and the Middle East) for a keyword, with every filter of the site: country, city, area, job type, workplace (on-site, hybrid, remote), career level, job category, posting age and years of experience. `facets` lists each filter's values with counts. Each job: `id`, `title`, `url`, `company`, `company_id`, `company_logo`, `country`, `city`, `area`, `job_types`, `workplace`, `career_level`, `experience_years`, `vacancies`, `roles`, `skills`, `education`, `salary` when public, `description`, `requirements`, `posted_at`, `expires_at` and `raw`. 15 jobs a page; `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wuzzuf-search",
        "tags": [
          "Wuzzuf"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `engineer`, `accountant`.",
            "schema": {
              "type": "string"
            },
            "example": "engineer"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country names as in `facets` (e.g. `Egypt`, `Saudi Arabia`), several separated by `|`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City names as in `facets` (e.g. `Cairo`, `Giza`), several separated by `|`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "area",
            "in": "query",
            "required": false,
            "description": "Area names as in `facets` (e.g. `New Cairo`), several separated by `|`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "`full_time`, `part_time`, `internship`, `shift_based`, `freelance_project` (several separated by `|`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workplace",
            "in": "query",
            "required": false,
            "description": "`on_site`, `hybrid` or `remote`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "career_level",
            "in": "query",
            "required": false,
            "description": "`Student`, `Entry Level`, `Experienced`, `Manager` or `Senior Management`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Job category as in `facets.category` (e.g. `IT/Software Development`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "posted_within",
            "in": "query",
            "required": false,
            "description": "Only jobs posted within this many days.",
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "7",
                "30"
              ]
            }
          },
          {
            "name": "experience_min",
            "in": "query",
            "required": false,
            "description": "Minimum years of experience.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "experience_max",
            "in": "query",
            "required": false,
            "description": "Maximum years of experience.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "engineer",
                  "applied_filters": {},
                  "total": 2009,
                  "page": 1,
                  "count": 15,
                  "next_page": 2,
                  "facets": [
                    {
                      "name": "area",
                      "values": [
                        {
                          "value": "New Cairo",
                          "count": 218
                        },
                        {
                          "value": "6th of October",
                          "count": 170
                        },
                        "… 95 more"
                      ]
                    },
                    {
                      "name": "country",
                      "values": [
                        {
                          "value": "Egypt",
                          "count": 1963
                        },
                        {
                          "value": "Saudi Arabia",
                          "count": 16
                        },
                        "… 14 more"
                      ]
                    },
                    "… 6 more"
                  ],
                  "jobs": [
                    {
