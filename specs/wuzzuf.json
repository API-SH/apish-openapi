    "/wuzzuf/v1/job": {
      "get": {
        "operationId": "wuzzufJob",
        "summary": "Wuzzuf job ad",
        "description": "One job ad on Wuzzuf with its employer's profile: description and requirements (text and HTML), salary when public, location with coordinates, job types, workplace, career level, experience, vacancies, roles, skills, education, application type, views, posted and expiry dates, and `company_profile` (about, industries, website, social links, founding year, address). `latest=true` with search parameters returns the first matching ad. Removed ads answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wuzzuf-job",
        "tags": [
          "Wuzzuf"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job id (`id` in search results) or its wuzzuf.net/jobs/p/... link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`true`: the first ad of a search with the other parameters instead of an id (an example that never expires).",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "With `latest=true`: keywords.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
