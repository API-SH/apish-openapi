                      "currency": "USD",
                      "in_stock": true,
                      "gender": "women",
                      "category_ids": [
                        3,
                        98,
                        "… 1 more"
                      ],
                      "url": "https://www.ssense.com/en-us/women/product/khaite/gray-ellen-hoodie/19712611",
                      "image": "https://res.cloudinary.com/ssenseweb/image/upload/b_white,c_lpad,g_south,w_640/262914F097000_1.jpg"
                    },
                    {
                      "id": "19712781",
