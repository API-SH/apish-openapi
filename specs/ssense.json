    "/ssense/v1/products": {
      "get": {
        "operationId": "ssenseProducts",
        "summary": "SSENSE products",
        "description": "Products of an SSENSE listing: a gender's catalogue, a designer, a category, the sale or a keyword search, in the site's sorts. Each product: id, name, designer, SKU, price and regular price, sale and discount percent, currency, in stock, category ids, link, image and `raw`, 120 per page. Prices are in the chosen shop country's currency. Pass `next_page` back as `page`; it is null on the last page. Designer slugs come from /ssense/v1/designers; a pasted ssense.com listing link (`url`) works too.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ssense-products",
        "tags": [
          "SSENSE"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "gender",
            "in": "query",
            "required": false,
            "description": "Catalogue (default women).",
            "schema": {
              "type": "string",
              "enum": [
                "women",
                "men",
                "everything-else"
              ]
            },
            "example": "women"
          },
          {
            "name": "designer",
            "in": "query",
            "required": false,
            "description": "A designer slug, e.g. `khaite` or `acne-studios` (from /ssense/v1/designers).",
            "schema": {
              "type": "string"
            },
            "example": "khaite"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A category slug, e.g. `jeans`, `bags`, `shoes` or `shoes/boots`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sale",
            "in": "query",
            "required": false,
            "description": "Only products on sale.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default: the site's own).",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "latest",
                "trending",
                "price_asc",
                "price_desc",
                "discount_desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Shop country, two letters (default us): prices and stock for that country, e.g. gb, ca, de, jp.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "An ssense.com listing link instead of the parameters above.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "gender": "women",
                  "designer": "khaite",
                  "category": null,
                  "sale": false,
                  "q": null,
                  "sort": "default",
                  "country": "US",
                  "page": 1,
                  "total_pages": 2,
                  "count": 120,
                  "next_page": 2,
                  "url": "https://www.ssense.com/en-us/women/designers/khaite",
                  "products": [
                    {
                      "id": "19712611",
