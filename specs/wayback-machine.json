    "/wayback/v1/snapshots": {
      "get": {
        "operationId": "waybackSnapshots",
        "summary": "Wayback Machine captures of a URL",
        "description": "Every capture the Wayback Machine holds of a URL, or of every URL under a prefix, host or domain, with date range, HTTP status and MIME filters, de-duplication by hour/day/month/year, content or URL, oldest or newest first. Each capture: timestamp, date, original URL, snapshot and raw links, MIME type, status, digest and size. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wayback-snapshots",
        "tags": [
          "Wayback Machine"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "A page link or a domain, with or without https://.",
            "schema": {
              "type": "string"
            },
            "example": "example.com"
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "From date: YYYY, YYYYMM, YYYYMMDD or YYYYMMDDhhmmss (dashes allowed).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "To date, same forms.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "match",
            "in": "query",
            "required": false,
            "description": "exact (default), prefix, host or domain.",
            "schema": {
              "type": "string",
              "enum": [
                "exact",
                "prefix",
                "host",
                "domain"
              ]
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "HTTP status filter: 200, 3xx, !404.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mime",
            "in": "query",
            "required": false,
            "description": "MIME type filter: text/html, application/pdf, image/*.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collapse",
            "in": "query",
            "required": false,
            "description": "One capture per hour, day, month, year, content or url.",
            "schema": {
              "type": "string",
              "enum": [
                "hour",
                "day",
                "month",
                "year",
                "content",
                "url"
              ]
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "oldest (default) or newest.",
            "schema": {
              "type": "string",
              "enum": [
                "oldest",
                "newest"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Captures per page, up to 1000 (default 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "next_cursor from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "url": "example.com",
                  "applied_filters": {},
                  "limit": 100,
                  "count": 100,
                  "next_cursor": "eJxLzs_VSa1IzC3ISdXUVzAyMDAxMDMyMzQ0MDI1AgB_dgeP",
