    "/wayback/v1/summary": {
      "get": {
        "operationId": "waybackSummary",
        "summary": "Wayback Machine capture summary of a URL and its site",
        "description": "How the Wayback Machine has captured a URL and its whole site: first and last capture, total captures, captures per year and month with each month's main status class, and for the site (host): captures, distinct URLs, new URLs and archived size per year, by content type.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wayback-summary",
        "tags": [
          "Wayback Machine"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "A page link or a domain, with or without https://.",
            "schema": {
              "type": "string"
            },
            "example": "example.com"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
