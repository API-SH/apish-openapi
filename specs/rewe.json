    "/rewe/v1/offers": {
      "get": {
        "operationId": "reweOffers",
        "summary": "REWE store offers",
        "description": "This week's offers of one REWE store: product title, details (pack size, variety), unit price, offer price, offer type (Aktion, Tiefpreis, Knaller...), REWE Bonus credit, badges, image and offer category, with the validity period and the store's offer categories and their counts. Filter by category. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/rewe-offers",
        "tags": [
          "REWE"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "market",
            "in": "query",
            "required": true,
            "description": "Store id from /rewe/v1/markets (or a REWE store or offers link).",
            "schema": {
              "type": "string"
            },
            "example": "3200008"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Offer category id from `categories[].id` (e.g. `obst-und-gemuese`, `bier`, `rewe-bonus-produkte`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Offers per page, 1-60 (default 40).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
