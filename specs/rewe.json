    "/rewe/v1/search": {
      "get": {
        "operationId": "reweSearch",
        "summary": "REWE online shop search",
        "description": "Products of the REWE online shop for search words: product id, name, link, image and badges (organic, chilled, regional...), with the total, the page count, the categories and brands to narrow by. The shop shows prices only once a store is chosen; get a product's online price from /rewe/v1/product. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/rewe-search",
        "tags": [
          "REWE"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "milch"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug from `categories[].slug` (e.g. `frischmilch`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand names from `brands`, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (40 products per page).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "milch",
                  "page": 1,
                  "total": 3580,
                  "pages": 90,
                  "count": 40,
                  "items": [
                    {
                      "id": "1042422",
