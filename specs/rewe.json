              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "50667",
                  "page": 1,
                  "total": 18,
                  "count": 10,
                  "markets": [
                    {
                      "id": "1940281",
                      "name": "REWE Armin Lenzen oHG",
