    "/rewe/v1/product": {
      "get": {
        "operationId": "reweProduct",
        "summary": "REWE product",
        "description": "One REWE online shop product: name, brand, GTIN, price and regular price, pack size, legal name, description, categories, tags, organic and new flags, images, ingredients and allergens, nutrition per 100 g/ml, manufacturer with address, seller and order limit.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/rewe-product",
        "tags": [
          "REWE"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Product id or a rewe.de/shop/p/ link.",
            "schema": {
              "type": "string"
            },
            "example": "1042422"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
