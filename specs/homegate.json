                      },
                      "latitude": 47.41936545165778,
                      "longitude": 8.666361227913432,
                      "parents": [
                        [
                          "geo-country-switzerland"
                        ]
                      ],
                      "children_count": 12,
                      "rent_search_url": "https://www.homegate.ch/rent/real-estate/canton-zurich/matching-list",
