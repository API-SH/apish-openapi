                      "children_count": 36,
                      "rent_search_url": "https://www.homegate.ch/rent/real-estate/city-zurich/matching-list",
                      "buy_search_url": "https://www.homegate.ch/buy/real-estate/city-zurich/matching-list"
                    },
                    {
                      "id": "geo-canton-zurich",
