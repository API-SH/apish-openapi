    "/homegate/v1/search": {
      "get": {
        "operationId": "homegateSearch",
        "summary": "Homegate search",
        "description": "Homegate (CH) listings, 20 per page, with every filter the site offers. Give `url` (a Homegate search URL) or `location` (Homegate geo slug such as city-zurich, zip-8004, canton-geneva; comma-separated for several) with `offer` and `category`. Homegate's own URL codes (ac, ag, ah, ak, aw, ax, be, o, ...) are also accepted as-is.\n\nPass `next_page` back as `page`; `next_page` is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/homegate-search",
        "tags": [
          "Homegate"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A Homegate search URL. Optional when `location` is given.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.homegate.ch/rent/real-estate/city-zurich/matching-list"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Homegate geo slug(s): city-zurich, zip-8004, canton-geneva, ...",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offer",
            "in": "query",
            "required": false,
            "description": "rent (default) or buy.",
            "schema": {
              "type": "string",
              "enum": [
                "rent",
                "buy"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "real-estate (default), apartment, house, parking-space, commercial-property, plot, ...",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum rent or price, CHF.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum rent or price, CHF.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_rooms",
            "in": "query",
            "required": false,
            "description": "Minimum rooms.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_rooms",
            "in": "query",
            "required": false,
            "description": "Maximum rooms.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_area",
            "in": "query",
            "required": false,
            "description": "Minimum living space, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_area",
            "in": "query",
            "required": false,
            "description": "Maximum living space, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_usable_area",
            "in": "query",
            "required": false,
            "description": "Minimum usable area, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_usable_area",
            "in": "query",
            "required": false,
            "description": "Maximum usable area, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_plot_area",
