    "/yellowpages/v1/search": {
      "get": {
        "operationId": "yellowpagesSearch",
        "summary": "Yellow Pages search",
        "description": "Pass `next_page` from the previous response; `next_page` is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yellowpages-search",
        "tags": [
          "Yellow Pages"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "pizza"
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "New York, NY"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
