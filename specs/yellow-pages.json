    "/yellowpages/v1/reviews": {
      "get": {
        "operationId": "yellowpagesReviews",
        "summary": "Yellow Pages business reviews",
        "description": "Every review a yellowpages.com business page carries: reviewer, date, overall star rating and the per-aspect ratings (expertise, professionalism, promptness and so on), text, helpful votes and the business's reply, with the business's average rating and review count. A business without reviews answers an empty list.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yellowpages-reviews",
        "tags": [
          "Yellow Pages"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "A yellowpages.com business page (https://www.yellowpages.com/<city>/mip/<business>), as `businesses[].url` in /yellowpages/v1/search.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.yellowpages.com/los-angeles-ca/mip/ritz-plumbing-heating-air-electrical-9270807"
