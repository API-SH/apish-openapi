    "/wehkamp/v1/search": {
      "get": {
        "operationId": "wehkampSearch",
        "summary": "Wehkamp product search",
        "description": "Search products on wehkamp.nl with every filter the site offers for the results: pass a facet's `param` from `filters` with one or more of its values (e.g. kleur=zwart, merk=only, maat=38, geslacht=dames, sale=ja), a price range in euros and a sort. Each product: product number, title, brand, price, previous price, discount, rating, review count, availability text, stock, colours, sizes, labels, images, link and `raw`. The response lists the facets with values and counts. 96 products per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wehkamp-search",
        "tags": [
          "Wehkamp"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "jas"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "aanbevolen (default), laagste-prijs, hoogste-prijs, titel, nieuwste-collectie or hoogste-korting (or relevance, price_asc, price_desc, title, newest, discount).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in euros.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in euros.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "kleur",
            "in": "query",
            "required": false,
            "description": "Example facet: colour value(s), e.g. zwart; any facet `param` from `filters` works the same way.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "merk",
            "in": "query",
            "required": false,
            "description": "Example facet: brand value(s), e.g. only.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-based).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
