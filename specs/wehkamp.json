          "Wehkamp"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "What you would type, e.g. nike.",
            "schema": {
              "type": "string"
            },
            "example": "nike"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
