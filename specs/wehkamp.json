        "tags": [
          "Wehkamp"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "description": "A category path such as /baby-mode/, or a wehkamp.nl category link.",
            "schema": {
              "type": "string"
            },
            "example": "/baby-mode/"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "As in search.",
