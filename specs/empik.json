    "/empik/v1/reviews": {
      "get": {
        "operationId": "empikReviews",
        "summary": "Empik product reviews",
        "description": "Customer reviews of an Empik product: id, date, rating, title, text, author (the site's nickname; full names shortened to first name and initial) and `author_name` (the nickname as the page shows it), verified purchase, commercial flag, useful and useless votes. Also the rating distribution, the site's review summary, total and hidden counts. Sort by relevance, helpfulness, rating or date. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/empik-reviews",
        "tags": [
          "Empik"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Empik product id or a product link.",
            "schema": {
              "type": "string"
            },
            "example": "p1756075948"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevant",
                "helpful",
                "rating_desc",
                "rating_asc",
                "newest",
                "oldest"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (from `next_page`).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
