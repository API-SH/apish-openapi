    "/empik/v1/search": {
      "get": {
        "operationId": "empikSearch",
        "summary": "Empik product search and category listings",
        "description": "Search Empik (Poland: books, music, films, games, toys and general retail, with marketplace sellers) or browse a category, with every filter the listing offers: the answer lists each filter group with its param name, values and counts (author, publisher, series, brand, format, seller, delivery time, rating, condition, free delivery, good choice, payment methods, categories, price range). Pass a group's `param` with a value to filter (repeat it for several values), price_min/price_max and a sort. Each product: id, name, link, price, previous price, discount, category, brand, authors, format, type, rating, availability, delivery, free-delivery flag, seller, sponsored flag and image. 60 per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/empik-search",
        "tags": [
          "Empik"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search keywords.",
            "schema": {
              "type": "string"
            },
            "example": "harry potter"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A category path such as /ksiazki,31,s (from the categories filter), or an Empik category link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "popular",
                "price_asc",
                "price_desc",
                "discount",
                "discount_amount",
                "newest"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in PLN.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in PLN.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": false,
            "description": "Filter: an author value from `filters`.",
            "schema": {
              "type": "string"
            }
          },
          {
