    "/doordash/v1/store": {
      "get": {
        "operationId": "doordashStore",
        "summary": "DoorDash store with its full menu",
        "description": "One DoorDash restaurant or store: name, cuisines, business (chain), address, coordinates, time zone, phone, website, rating and rating count, public review count, price range, delivery fee text, delivery and pickup times, open status, store hours and DoorDash ordering hours per day, delivery / pickup / group order / catering / scheduling flags, DashPass partner, images, the menus, and every menu category with every item (id, name, description, price, strikethrough price, image, dietary tags, rating, badges), plus the latest public reviews (author, stars, date, text, ordered items, photos). Use the item id with /doordash/v1/item for its options.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/doordash-store",
        "tags": [
          "DoorDash"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Store id, or a doordash.com store link (doordash.com/store/<name>-<id>/).",
            "schema": {
              "type": "string"
            },
            "example": "29640787"
          },
          {
            "name": "menu_id",
            "in": "query",
            "required": false,
            "description": "A specific menu of the store (ids in `menu.menus`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fulfillment",
            "in": "query",
            "required": false,
            "description": "delivery (default) or pickup prices and times.",
            "schema": {
              "type": "string",
              "enum": [
                "delivery",
                "pickup"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
