    "/marinetraffic/v1/vessel": {
      "get": {
        "operationId": "marinetrafficVessel",
        "summary": "MarineTraffic vessel details, position and voyage",
        "description": "One vessel: name, IMO, MMSI, call sign, flag, type and market segment, size class, length and width, AIS class; its latest AIS position (lat/lon, speed, course, heading, rate of turn, draught, navigational status, sea area, time, source); and the current voyage (reported destination, ETA, departure and arrival ports with UN/LOCODE and coordinates, departure time, progress), with a short summary and the vessel photo link.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/marinetraffic-vessel",
        "tags": [
          "MarineTraffic"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "imo",
            "in": "query",
            "required": false,
            "description": "IMO number (7 digits).",
            "schema": {
              "type": "string"
            },
            "example": "9811000"
          },
          {
            "name": "mmsi",
            "in": "query",
            "required": false,
            "description": "MMSI (9 digits).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ship_id",
            "in": "query",
            "required": false,
            "description": "MarineTraffic ship id (from search).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Vessel name (the first match is used).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A marinetraffic.com vessel link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "ship_id": 5630138,
                  "name": "EVER GIVEN",
                  "ais_name": "EVER GIVEN",
                  "imo": 9811000,
                  "mmsi": 636026627,
                  "eni": null,
                  "call_sign": "A8AB9",
                  "flag": "LIBERIA",
                  "flag_code": "LR",
                  "vessel_type": "Container Ship",
                  "ais_ship_type": "Cargo - Hazard A (Major)",
                  "type_id": 71,
                  "fleet_group": "CONTAINER SHIPS",
                  "market": "CONTAINER SHIPS",
                  "size_class": "ULCV",
                  "length_m": 399.94,
                  "width_m": 59,
                  "year_built": null,
                  "service_status": null,
                  "home_port": null,
                  "ais_transponder_class": "Class A",
                  "navigational_aid": false,
