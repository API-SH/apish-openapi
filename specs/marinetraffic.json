    "/marinetraffic/v1/search": {
      "get": {
        "operationId": "marinetrafficSearch",
        "summary": "MarineTraffic vessel and port search",
        "description": "Finds vessels by name, IMO, MMSI or call sign (ship id, name, type, flag) or ports by name or UN/LOCODE (port id, name, country).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/marinetraffic-search",
        "tags": [
          "MarineTraffic"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Vessel name, IMO, MMSI or call sign; or a port name or UN/LOCODE.",
            "schema": {
              "type": "string"
            },
            "example": "ever given"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "What to search.",
            "schema": {
              "type": "string",
              "enum": [
                "vessel",
                "port"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "ever given",
                  "type": "vessel",
                  "count": 1,
                  "results": [
                    {
                      "ship_id": 5630138,
                      "name": "EVER GIVEN",
                      "description": "Container Ship [LR]",
                      "vessel_type": "Container Ship",
