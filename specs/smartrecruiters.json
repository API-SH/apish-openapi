    "/smartrecruiters/v1/jobs": {
      "get": {
        "operationId": "smartrecruitersJobs",
        "summary": "SmartRecruiters job board",
        "description": "Open jobs on a company's SmartRecruiters career site, newest first, with search and location filters. `total` comes from SmartRecruiters. Pass `next_page` back as `page`; null on the last page. A company id SmartRecruiters does not know answers `total: 0`. Each job: `id`, `title`, `department`, `team`, `location`, `locations`, `workplace_type`, `remote`, `employment_type`, `compensation` (summary, min, max, currency, interval) when the company publishes it, `posted_at`, `updated_at`, `description_html` and `description` (plain text) when included, `apply_url`, `url` and `raw` (the board's own record). The same shape on every job board endpoint. Filter by release date with `released_after` and by workplace with `location_type` (or `remote=1`).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/smartrecruiters-jobs",
        "tags": [
          "SmartRecruiters"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "description": "The company's SmartRecruiters board name (the part after the host in its job board URL), or that URL.",
            "schema": {
              "type": "string"
            },
            "example": "BoschGroup"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Two-letter country code, e.g. `pt`, `us`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Region or state.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Department id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Posting language, e.g. `en`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Jobs per page (default 20, max 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "released_after",
            "in": "query",
            "required": false,
            "description": "Only postings released after this date (YYYY-MM-DD or ISO timestamp).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location_type",
            "in": "query",
            "required": false,
            "description": "Workplace: `remote`, `hybrid` or `onsite`.",
            "schema": {
              "type": "string",
              "enum": [
                "remote",
                "hybrid",
                "onsite"
              ]
            }
          },
          {
            "name": "remote",
            "in": "query",
            "required": false,
            "description": "`1` for remote postings only (same as `location_type=remote`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "company": "BoschGroup",
                  "board_url": "https://jobs.smartrecruiters.com/BoschGroup",
                  "total": 4995,
                  "count": 20,
                  "page": 1,
                  "per_page": 20,
                  "next_page": 2,
                  "applied_filters": {},
                  "jobs": [
                    {
