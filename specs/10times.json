    "/10times/v1/events": {
      "get": {
        "operationId": "10timesEvents",
        "summary": "Trade show and conference listings",
        "description": "Events on 10times for a type, place and industry (the listing's first page, about 15-25 events): name, url, type, dates, status, frequency, edition, description, website, logo, pricing, audience, estimated size, share of international visitors, online or hybrid, rating and rating count, followers, estimated visitors and exhibitors, listed exhibitors and speakers, venue with address and coordinates, city, state and country, categories, products shown, and the organizer (name, website, country, event counts). Later pages of a listing are shown only to signed-in 10times members: narrow with `country`/`city` and `industry` instead.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/10times-events",
        "tags": [
          "10times"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Event type.",
            "schema": {
              "type": "string",
              "enum": [
                "tradeshows",
                "conferences",
                "workshops",
                "events"
              ]
            },
            "example": "tradeshows"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "A 10times country slug, e.g. usa, germany, unitedkingdom, india, china.",
            "schema": {
              "type": "string"
            },
            "example": "usa"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "Instead of country: a 10times city slug, e.g. lasvegas-us, london-uk, shanghai-cn.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "industry",
            "in": "query",
            "required": false,
            "description": "A 10times industry slug, e.g. automotive, technology, medical-pharma, food-beverage.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Instead of the above: a 10times listing page, e.g. https://10times.com/usa/automotive/tradeshows.",
