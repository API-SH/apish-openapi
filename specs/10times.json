    "/10times/v1/visitors": {
      "get": {
        "operationId": "10timesVisitors",
        "summary": "Event visitors",
        "description": "People 10times lists as visiting an event, as the event's visitors page shows them logged out (about 40, from this and earlier editions): name, job title and company as shown, location (city and country), participation (e.g. attended in Nov 2024), the number of events the person follows, profile link (null for profiles the member keeps private), a private-profile flag and photo, plus the total the site gives. No contact details; later pages need a 10times account.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/10times-visitors",
        "tags": [
          "10times"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "event",
            "in": "query",
            "required": false,
            "description": "A 10times event slug, e.g. sema-show.",
            "schema": {
              "type": "string"
            },
            "example": "sema-show"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Instead of event: the event page url.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
