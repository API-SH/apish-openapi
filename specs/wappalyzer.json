    "/wappalyzer/v1/technologies": {
      "get": {
        "operationId": "wappalyzerTechnologies",
        "summary": "Wappalyzer technology search",
        "description": "Search all technologies Wappalyzer detects by name, optionally within one category, ranked by match and by the number of websites using them. Pass `q`, `category` or both. Pass `next_offset` back as `offset`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wappalyzer-technologies",
        "tags": [
          "Wappalyzer"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Name to search for, e.g. `shop`.",
            "schema": {
              "type": "string"
            },
            "example": "shop"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug to search within, e.g. `ecommerce`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results to return (1-200, default 50).",
            "schema": {
              "type": "integer",
              "default": "50"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Rows to skip; pass `next_offset` back here. Null on the last page.",
            "schema": {
              "type": "integer",
              "default": "0"
            },
            "example": "0"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
