    "/brave/v1/search": {
      "get": {
        "operationId": "braveSearch",
        "summary": "Brave Search",
        "description": "Brave Search web results (about 20 per page, up to 6 pages) from Brave's independent index: title, URL, displayed URL, snippet, date, source, favicon, sitelinks and rich data (products, ratings, articles); plus related searches, FAQ (people also ask), knowledge panel, top news, videos, discussions and places when shown. Pass `next_page` back as `page`. Every response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/brave-search",
        "tags": [
          "Brave"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query.",
            "schema": {
              "type": "string"
            },
            "example": "coffee machine"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Two-letter country, e.g. us, de, fr.",
            "schema": {
              "type": "string"
            },
            "example": "us"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1 = first).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "time",
            "in": "query",
            "required": false,
            "description": "Only results from the past day, week, month or year.",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            }
          },
          {
            "name": "safe",
            "in": "query",
            "required": false,
            "description": "Safe search.",
            "schema": {
              "type": "string",
              "enum": [
                "strict",
                "moderate",
                "off"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "search_parameters": {
                    "engine": "brave",
                    "q": "Eiffel Tower",
                    "country": "us",
                    "page": 1,
                    "time": null,
                    "safe": null
                  },
                  "query": "Eiffel Tower",
                  "page": 1,
                  "count": 20,
                  "results": [
                    {
                      "position": 1,
                      "title": "Eiffel Tower - Wikipedia",
                      "url": "https://en.wikipedia.org/wiki/Eiffel_Tower",
                      "displayed_url": "en.wikipedia.org › wiki › Eiffel_Tower",
                      "snippet": "The Eiffel Tower (/ˈaɪfəl/ ⓘ EYE-fəl; French: Tour Eiffel [tuʁ ɛfɛl] ⓘ) is a lattice tower on the Champ de Mars in Paris, France. It is name…",
