    "/bewakoof/v1/search": {
      "get": {
        "operationId": "bewakoofSearch",
        "summary": "Bewakoof search",
        "description": "Bewakoof search or collection listing (India): id, name, link, price, MRP, discount, member price, rating, colour and image, with gender, category, colour, size, design, fit, sleeve, neck, brand, rating and discount filters, every sort and paging, plus the filter lists with counts.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bewakoof-search",
        "tags": [
          "Bewakoof"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (or use collection).",
            "schema": {
              "type": "string"
            },
            "example": "shoes"
          },
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "description": "Collection handle, e.g. men-t-shirts.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "popular",
                "new",
                "price_asc",
                "price_desc"
              ]
            },
            "example": "price_asc"
          },
          {
            "name": "gender",
            "in": "query",
            "required": false,
            "description": "Gender values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "color",
            "in": "query",
            "required": false,
            "description": "Color values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sizes",
            "in": "query",
            "required": false,
            "description": "Sizes values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "design",
            "in": "query",
            "required": false,
            "description": "Design values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fit",
            "in": "query",
            "required": false,
            "description": "Fit values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sleeve",
            "in": "query",
            "required": false,
            "description": "Sleeve values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "neck",
            "in": "query",
            "required": false,
            "description": "Neck values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ratings",
            "in": "query",
            "required": false,
            "description": "Ratings values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "discount",
            "in": "query",
            "required": false,
            "description": "Discount values from the filters, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
