          {
            "name": "level",
            "in": "query",
            "required": false,
            "description": "Position level ids, comma separated (1 trainee, 3 assistant, 17 junior, 4 mid, 18 senior, 19 expert, 5 team lead, 20 manager, 6 director; see facets.position_levels).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "contract",
            "in": "query",
            "required": false,
            "description": "Contract type ids, comma separated (0 employment contract, 1 contract for specific work, 2 mandate contract, 3 B2B, 4 replacement, 5 agency, 6 temporary, 7 internship).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "schedule",
            "in": "query",
            "required": false,
            "description": "Work schedule ids, comma separated (0 full time, 1 part time, 2 additional or temporary).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "description": "Work modes, comma separated: full-office, hybrid, home-office (remote), mobile.",
            "schema": {
              "type": "string"
            },
            "example": "hybrid"
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Region (voivodeship) ids, comma separated (see facets.regions; 7 mazowieckie, 6 malopolskie).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "posted",
            "in": "query",
            "required": false,
            "description": "Only ads published in the last N days.",
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "3",
                "7",
                "14",
                "30"
              ]
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly salary in PLN (1 = only ads that show a salary).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company_id",
            "in": "query",
            "required": false,
