    "/costco/v1/warehouses": {
      "get": {
        "operationId": "costcoWarehouses",
        "summary": "Warehouse locator",
        "description": "Costco's warehouse locator: the nearest warehouses to a point with id, name, address, phone, distance, position, opening date, region, warehouse, pharmacy, business and gas hours, upcoming holiday hours and closures, which departments it has (gas, tires, pharmacy, optical, hearing, food court, business, car wash), service phone numbers, specialty departments, pickup options and a link.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/costco-warehouses",
        "tags": [
          "Costco"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "latitude",
            "in": "query",
            "required": true,
            "description": "Latitude.",
            "schema": {
              "type": "string"
            },
            "example": "40.71"
          },
          {
            "name": "longitude",
            "in": "query",
            "required": true,
            "description": "Longitude.",
            "schema": {
              "type": "string"
            },
            "example": "-74.01"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Number of warehouses (up to 50, default 10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "latitude": 40.71,
                  "longitude": -74.01,
                  "count": 10,
                  "warehouses": [
                    {
                      "id": 318,
                      "name": "Brooklyn",
                      "address": "976 3RD AVE",
                      "city": "BROOKLYN",
                      "state": "NY",
                      "postal_code": "11232-2400",
                      "country": "US",
                      "phone": "+1 555 010 0000",
                      "distance_miles": 3.8,
                      "latitude": 40.655,
                      "longitude": -74.009,
                      "opened": "Nov 21, 1996",
                      "region": "NE",
