    "/costco/v1/reviews": {
      "get": {
        "operationId": "costcoReviews",
        "summary": "Costco product reviews",
        "description": "Customer reviews of one costco.com product, with the product's average rating, review count, recommended count and star distribution. Each review has rating, title, text, date, author nickname and location, recommended flag, helpful votes, verified-purchaser and incentivized flags, badges, photos and Costco's replies. Sort by relevance, newest, oldest, highest, lowest or most helpful; filter by star rating or reviews with photos. Pass `next_page` back as `page`; it is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/costco-reviews",
        "tags": [
          "Costco"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The product id at the end of a costco.com/p/… URL.",
            "schema": {
              "type": "string"
            },
            "example": "100234271"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A costco.com product URL, instead of id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words, instead of id or url: the most-reviewed product matching them is used.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default relevant).",
            "schema": {
              "type": "string",
              "enum": [
                "relevant",
                "newest",
                "oldest",
                "highest",
                "lowest",
                "helpful"
              ]
            }
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Only reviews with this many stars (1 to 5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "photos",
            "in": "query",
            "required": false,
            "description": "true: only reviews with photos.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page, 1 to 100 (default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
