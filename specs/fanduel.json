    "/fanduel/v1/events": {
      "get": {
        "operationId": "fanduelEvents",
        "summary": "FanDuel Sportsbook events for a league",
        "description": "A league's listed events on FanDuel Sportsbook: event id, name, home and away team, start time, whether it is in play, competition and the number of betting markets listed for it. Use the id with the event route for every market. Simulated e-sports games are left out. Cached 60 seconds.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/fanduel-events",
        "tags": [
          "FanDuel"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "league",
            "in": "query",
            "required": true,
            "description": "League or sport. US leagues: nfl, ncaaf, nba, ncaab, wnba, nhl, mlb. Soccer: soccer (every listed competition), epl, champions-league, la-liga, serie-a, bundesliga, ligue-1, mls. Sports: tennis, golf, boxing, ufc (UFC / MMA).",
            "schema": {
              "type": "string",
              "enum": [
                "nfl",
                "ncaaf",
                "nba",
                "ncaab",
                "wnba",
                "nhl",
                "mlb",
                "soccer",
                "epl",
                "champions-league",
                "la-liga",
                "serie-a",
                "bundesliga",
                "ligue-1",
                "mls",
                "tennis",
                "golf",
                "boxing",
                "ufc"
              ]
            },
            "example": "nfl"
          },
          {
            "name": "team",
            "in": "query",
            "required": false,
            "description": "Only events whose team names contain this text.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Only events starting on this UTC date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Max events (default 50, max 200).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "timezone",
            "in": "query",
            "required": false,
            "description": "Time zone for `start_time_local` (IANA name such as America/Chicago, Europe/London or UTC; default America/New_York). When given, `date` is matched against the local date.",
            "schema": {
              "type": "string",
              "default": "America/New_York"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "league": "nfl",
                  "league_name": "NFL",
                  "sport": "american_football",
