    "/fanduel/v1/odds": {
      "get": {
        "operationId": "fanduelOdds",
        "summary": "FanDuel Sportsbook game lines for a league",
        "description": "A league's (or sport's) games on FanDuel Sportsbook with moneyline, spread (puck line / run line) and total, each side in decimal, American and fractional odds (soccer: the 3-way moneyline with `draw`; tennis, golf matchups, boxing and UFC: the match winner as moneyline), plus the other markets shown with each game on the league page (player and game props when listed). `include_other=true` adds the league's other markets (futures, awards, season specials) with every selection's price. Every game also has `start_time_local` in `timezone`. `tabs` lists the league page's tabs (games, conference or division winners, playoffs and finals, futures, awards, player props ...); `tab=<slug>` adds that tab's markets in its sections (e.g. ncaaf `conference-winners` for each conference's championship winner, `cfb-playoff`; nba `nba-finals`, `conference`, and the playoffs tab while the playoffs run). Simulated e-sports games listed on the same pages are left out. Cached 60 seconds.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/fanduel-odds",
        "tags": [
          "FanDuel"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "league",
            "in": "query",
            "required": true,
            "description": "League or sport. US leagues: nfl, ncaaf, nba, ncaab, wnba, nhl, mlb. Soccer: soccer (every listed competition), epl, champions-league, la-liga, serie-a, bundesliga, ligue-1, mls. Sports: tennis, golf, boxing, ufc (UFC / MMA).",
            "schema": {
              "type": "string",
              "enum": [
                "nfl",
                "ncaaf",
                "nba",
                "ncaab",
                "wnba",
                "nhl",
                "mlb",
                "soccer",
                "epl",
                "champions-league",
                "la-liga",
                "serie-a",
                "bundesliga",
                "ligue-1",
                "mls",
                "tennis",
                "golf",
                "boxing",
                "ufc"
              ]
            },
            "example": "nba"
          },
          {
            "name": "team",
            "in": "query",
            "required": false,
            "description": "Only games whose team names contain this text.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Only games starting on this UTC date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include_other",
            "in": "query",
            "required": false,
            "description": "Also return the league's futures and other non-game markets (default false: only their count).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "tab",
            "in": "query",
            "required": false,
