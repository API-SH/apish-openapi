    "/chrono24/v1/search": {
      "get": {
        "operationId": "chrono24Search",
        "summary": "Chrono24 watch search",
        "description": "Watch listings on Chrono24 for keywords (or a brand, model, collection or reference alone), with the site's sort, condition, price range, currency, dealer countries, year of production, case size, box and papers, in-stock and Certified filters, plus every other filter of the site through `filters` (movement, case and band material, dial, condition grade, seller type and more; values from /chrono24/v1/facets). Each listing: id, title, subtitle, price and price label, currency, shipping note, dealer country code and name, seller type, Certified label, reference number and its page (`reference`, `reference_url`), case size in mm when the title gives it (`case_size_mm`), badges, link and images. Year, condition grade and movement are not shown on the site's result cards; /chrono24/v1/listing returns them. 60 per page; `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/chrono24-search",
        "tags": [
          "Chrono24"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `rolex submariner`. Optional when brand, model_id, collection_id, reference or filters is given.",
            "schema": {
              "type": "string"
            },
            "example": "rolex submariner"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), price_asc, price_desc, newest.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "newest"
              ]
            }
          },
          {
            "name": "condition",
            "in": "query",
            "required": false,
            "description": "`new` or `used`.",
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "used"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price, whole units of `currency`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price, whole units of `currency`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Price currency: USD (default), EUR, GBP, CHF, CAD, AUD, JPY, HKD, SGD, AED.",
            "schema": {
              "type": "string",
              "enum": [
                "USD",
                "EUR",
                "GBP",
                "CHF",
                "CAD",
                "AUD",
                "JPY",
                "HKD",
                "SGD",
                "AED"
              ]
            }
          },
          {
            "name": "dealer_country",
            "in": "query",
            "required": false,
            "description": "Only listings from sellers in these countries (two-letter codes, comma-separated), e.g. `US` or `DE,CH`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year_min",
            "in": "query",
            "required": false,
            "description": "Produced in or after this year. A range spans at most 80 years; year_max alone covers the 80 years before it.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_max",
            "in": "query",
            "required": false,
            "description": "Produced in or before this year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "case_diameter",
            "in": "query",
            "required": false,
            "description": "Case size in mm, one or more comma-separated (either matches), e.g. `40,41`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "box_papers",
            "in": "query",
            "required": false,
            "description": "true: only watches with original box and original papers.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "in_stock",
            "in": "query",
            "required": false,
            "description": "true: only items the seller has in stock.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "certified",
            "in": "query",
            "required": false,
            "description": "true: only Chrono24 Certified listings.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand id(s), comma-separated (the `brand` facet of /chrono24/v1/facets; Rolex is 221).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "model_id",
            "in": "query",
            "required": false,
            "description": "Model id(s) from the facets (`catalogModelId`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "collection_id",
            "in": "query",
            "required": false,
            "description": "Collection id(s) from the facets (`catalogCollectionId`; Rolex Submariner is 438).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "reference",
            "in": "query",
            "required": false,
            "description": "Reference number(s), comma-separated, with `brand` (e.g. `114060` with brand=221), or the facets value such as `114060$221`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "Any other site filter: comma list of `param:value` pairs, the `filter` value of /chrono24/v1/facets (e.g. `movementTypes:1,condition:1302`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (up to 100). Pass `next_page` from the previous response.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "rolex submariner",
                  "sort": "relevance",
                  "page": 1,
                  "currency": "USD",
                  "total": 9193,
                  "count": 60,
                  "next_page": 2,
                  "url": "https://www.chrono24.com/rolex/submariner--mod1.htm?dosearch=true&query=rolex+submariner&currencyId=USD&sortorder=0&pageSize=60",
                  "items": [
                    {
