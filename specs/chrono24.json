                      "badges": [
                        "Popular"
                      ],
                      "url": "https://www.chrono24.com/rolex/submariner-am-baguette-diamonds-ref-14060-watch-only--id49552613.htm",
                      "images": [
                        "https://img.chrono24.com/images/uhren/49552613-v5a49wntvle3bcyein765xa2-Square480.jpg",
                        "https://img.chrono24.com/images/uhren/49552613-qlcslhnhtsr9uopmd4qvejv3-Square480.jpg",
                        "… 3 more"
                      ]
                    },
                    {
