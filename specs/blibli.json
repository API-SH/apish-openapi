    "/blibli/v1/search": {
      "get": {
        "operationId": "blibliSearch",
        "summary": "Blibli product search",
        "description": "Search Blibli (Indonesian marketplace) with the site's sorts and filters: price range, brand, category, rating, store location, color, size, promo, seller type, delivery option, Blibli services, discount, warranty type and official stores only. Each product: SKU, item SKU, name, link, price, list price, discount, price text (IDR), rating, review count, seller rating, brand, category, merchant code, store location, status, number of variants, tags (free shipping, 0% installments...), images, and the site's original record in `raw`. Page 1 also returns sponsored products and the filter groups with their values (feed `value` back as the filter's `param`). Up to 60 per page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/blibli-search",
        "tags": [
          "Blibli"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "keyword",
            "in": "query",
            "required": true,
            "description": "Search text.",
            "schema": {
              "type": "string"
            },
            "example": "iphone"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default relevance).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "best_selling",
                "price_asc",
                "price_desc",
                "popular",
                "newest"
              ]
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Lowest price in IDR.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Highest price in IDR.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand name(s) as in the brand filter, e.g. Apple; comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category id(s) from the category filter, e.g. 54593.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Minimum rating value from the rating filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Store location value(s) from the location filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "color",
            "in": "query",
            "required": false,
            "description": "Color value(s) from the color filter.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
