    "/blibli/v1/reviews": {
      "get": {
        "operationId": "blibliReviews",
        "summary": "Blibli product reviews",
        "description": "A product's reviews in the site's order: id, rating, text, reviewer name as shown, verified-buyer flag, date, likes, purchased variant, photos and the seller's reply when present, with totals. Filter by star rating. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/blibli-reviews",
        "tags": [
          "Blibli"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Product SKU or link.",
            "schema": {
              "type": "string"
            },
            "example": "APF-70017-00969"
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Only reviews with this star rating (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page (default and max 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (from 1).",
            "schema": {
              "type": "integer"
            }
          },
