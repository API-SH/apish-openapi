    "/dhl/v1/tracking": {
      "get": {
        "operationId": "dhlTracking",
        "summary": "DHL shipment tracking",
        "description": "Pass tracking_numbers (up to 10, comma separated) to track several shipments in one call: the answer is count, found and items (one per number: tracking_number, found, error and result in the single-number shape). A number with no shipment, or one that fails this time, is reported in its own item instead of failing the call.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 2 credits per successful call. Docs: https://api.sh/docs/dhl-tracking",
        "tags": [
          "DHL"
        ],
        "x-credits": 2,
        "parameters": [
          {
            "name": "tracking_number",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "LBAA19526"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Alias of tracking_number.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tracking_numbers",
            "in": "query",
            "required": false,
            "description": "Up to 10 tracking numbers, comma separated, tracked in one call (used instead of tracking_number). Each number is billed as one tracking.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
