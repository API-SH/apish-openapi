    "/magento/v1/product": {
      "get": {
        "operationId": "magentoProduct",
        "summary": "Magento shop product",
        "description": "One product of a Magento 2 shop from its page link (or shop + SKU or URL key): prices and tier prices, stock, description, gallery (images and videos), configurable options with every variant's SKU, attributes, price and stock, bundle and grouped items, custom options, weight, related, up-sell and cross-sell products, and its native reviews (20 a page).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/magento-product",
        "tags": [
          "Magento"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Product page link.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.coxandcox.co.uk/ayana-floor-lamp/"
          },
          {
            "name": "store",
            "in": "query",
            "required": false,
            "description": "The shop's domain, with sku or url_key instead of url.",
            "schema": {
              "type": "string"
            },
            "example": "www.coxandcox.co.uk"
          },
          {
            "name": "sku",
            "in": "query",
            "required": false,
            "description": "Product SKU (with store).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url_key",
            "in": "query",
            "required": false,
            "description": "Product URL key (with store).",
            "schema": {
              "type": "string"
            },
            "example": "ayana-floor-lamp"
          },
          {
            "name": "reviews_page",
            "in": "query",
            "required": false,
            "description": "Page of reviews to include (default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/magento/v1/products": {
      "get": {
        "operationId": "magentoProducts",
        "summary": "Magento shop product search",
        "description": "Products of any Magento 2 / Adobe Commerce shop (the whole catalog when no words or filters are given): search words, category, price range, SKU and any filterable attribute of the shop, with the shop's sorts. Each product has its name, SKU, type, link, price, regular price, discount, maximum price, stock status and only-left count, rating, review count, image, categories and short description. The response also lists the shop's facets with counts (attribute codes and values to pass back in `filter`) and its sort options.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/magento-products",
        "tags": [
          "Magento"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "store",
            "in": "query",
            "required": true,
            "description": "The shop's domain (any Magento 2 / Adobe Commerce shop with its public GraphQL API).",
            "schema": {
              "type": "string"
            },
            "example": "www.coxandcox.co.uk"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (or use a filter).",
            "schema": {
              "type": "string"
            },
            "example": "lamp"
          },
          {
            "name": "category_uid",
            "in": "query",
            "required": false,
            "description": "Category uids, comma separated (from facets or /magento/v1/categories).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "description": "Category ids, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Lowest price.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Highest price.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sku",
            "in": "query",
            "required": false,
            "description": "SKUs, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Attribute filters from the facets as code:value,value; separated by semicolons, e.g. color:49,50;size:167.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance, price_asc, price_desc, name_asc, name_desc, position, newest, or attribute:ASC|DESC from sort_options. A sort the shop does not offer is ignored (sort_ignored: true).",
            "schema": {
              "type": "string"
            },
            "example": "price_asc"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Products per page, 1-100 (default 24).",
            "schema": {
              "type": "integer"
            },
            "example": "24"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "store": "www.coxandcox.co.uk",
                  "query": "lamp",
                  "page": 1,
                  "limit": 24,
                  "total": 152,
                  "total_pages": 7,
                  "next_page": 2,
                  "sort": null,
