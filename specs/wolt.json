    "/wolt/v1/venues": {
      "get": {
        "operationId": "woltVenues",
        "summary": "Wolt restaurants and stores near a point",
        "description": "Restaurants and stores that Wolt lists for a point (30 countries), or the venues and dishes matching a search (`q`). Each venue: id, slug, name, link, description, address, country, coordinates, rating score, label and count, price range, currency, tags, product line, open and delivers flags, status, delivery estimate, delivery-fee promotions, badges, Wolt+ flag, preview items with prices, image and logo. Filters: cuisine, price range, open now, Wolt+, minimum rating, venue type; sorts: recommended, rating, delivery price, delivery time, distance. Without `q`, the response lists the area's cuisines. `limit` sets the page size; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wolt-venues",
        "tags": [
          "Wolt"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
