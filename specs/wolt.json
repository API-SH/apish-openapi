    "/wolt/v1/venue": {
      "get": {
        "operationId": "woltVenue",
        "summary": "Wolt venue details, hours and fees",
        "description": "One Wolt venue: id, slug, name, brand, description, link, address, post code, city, country, timezone, phone, website, product line, currency, rating score, label and count, open status with next open/close, opening hours and delivery hours per day, delivery methods, self-delivery, pickup and group-order flags, base delivery price, the delivery price at a point with its distance bands, minimum order and small-order surcharge, service fee range, delivery options with estimates, current offers, the seller's legal details, the delivery area polygon, image, logo and menu id. Pass lat and lon for fees and estimates at an address.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wolt-venue",
        "tags": [
          "Wolt"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "required": false,
            "description": "The venue slug (from /wolt/v1/venues).",
            "schema": {
              "type": "string"
            },
            "example": "mcdonalds-forum-katutaso"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The venue's wolt.com link instead of slug.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of the delivery point (with lon).",
            "schema": {
              "type": "number"
            },
            "example": "60.1699"
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Longitude of the delivery point (with lat).",
            "schema": {
              "type": "number"
            },
            "example": "24.9384"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
