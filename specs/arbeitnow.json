    "/arbeitnow/v1/search": {
      "get": {
        "operationId": "arbeitnowSearch",
        "summary": "Arbeitnow job search",
        "description": "Jobs on Arbeitnow (arbeitnow.com, Germany and Europe; many English-speaking and visa-sponsorship jobs) for a keyword, with every filter of the site: tags (the site's quick filters such as `visa sponsorship`, `english speaking`, `remote`, `berlin`, `junior`, `part time`, or any category, skill or job-type tag shown on a card), date posted and sort. Each job: `id`, `title`, `url`, `company`, `company_url`, `company_slug`, `company_logo`, `location`, `remote`, `categories`, `tags`, `salary` when shown, `posted_at`. `trending_tags` lists the site's current quick filters. 35 jobs a page; `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/arbeitnow-search",
        "tags": [
          "Arbeitnow"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `python`, `data analyst`. Leave empty for all jobs.",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "description": "Tags, comma separated (all must match), e.g. `visa sponsorship,remote`. Values from `trending_tags` or the `categories`/`tags` of a job.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date_posted",
            "in": "query",
            "required": false,
            "description": "Only jobs posted in the last 24 hours, 3 days or 7 days.",
            "schema": {
              "type": "string",
              "enum": [
                "24h",
                "3d",
                "7d"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "python",
                  "applied_filters": {},
                  "total": 1382,
                  "page": 1,
                  "page_count": 40,
                  "per_page": 35,
                  "count": 35,
                  "next_page": 2,
                  "trending_tags": [
