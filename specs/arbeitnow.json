          "Arbeitnow"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "description": "Company slug (`company_slug` in search results, e.g. `haeger-consulting-gmbh`) or its arbeitnow.com/jobs/companies/... link.",
            "schema": {
              "type": "string"
            },
            "example": "haeger-consulting-gmbh"
          },
          {
            "name": "page",
            "in": "query",
