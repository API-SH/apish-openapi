        "summary": "Arbeitnow job ad",
        "description": "One job ad on Arbeitnow: full description (text and HTML), company with logo and about text, locations with postal code and region, remote flag, employment type, salary when given, the ad's tags (job type, experience, visa sponsorship…), apply link, posted and valid-through dates. `latest=true` with search parameters returns the first matching ad. Removed ads answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/arbeitnow-job",
        "tags": [
          "Arbeitnow"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The job's arbeitnow.com/jobs/companies/<company>/<job> link (`url` in search results), or `<company_slug>/<job id>`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`true`: the first ad of a search with the other parameters instead of an id (an example that never expires).",
