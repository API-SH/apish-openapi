    "/reed/v1/job": {
      "get": {
        "operationId": "reedJob",
        "summary": "Reed job details",
        "description": "One Reed job ad: title, recruiter (name, profile id and page, logo, agency or employer, reference), full location (town, county, region, country, postcode, remote, working option), salary (display text, from/to, yearly equivalents, type, negotiable, OTE, pro rata), contract type and hours, sector and parent sector, taxonomy, skills, dates, easy apply, the full description (HTML and text) and similar jobs. Removed jobs answer 404. Give id/url, or q to open the first current result of a search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/reed-job",
        "tags": [
          "Reed"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job id (the number at the end of the job URL) or the job URL (`url` is accepted too).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Instead of id: keywords; opens the first current result of that search (all /reed/v1/search filters apply).",
            "schema": {
              "type": "string"
            },
            "example": "nurse"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "With q: town, city or postcode.",
            "schema": {
              "type": "string"
            },
            "example": "london"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
