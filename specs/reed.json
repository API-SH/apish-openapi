    "/reed/v1/search": {
      "get": {
        "operationId": "reedSearch",
        "summary": "Reed job search",
        "description": "UK jobs on Reed.co.uk for a keyword and/or location with the result page's filters: radius, salary range, permanent, temporary, contract, full/part time, agency or employer, graduate, easy apply, early bird, visa sponsorship, remote/hybrid/on-site, date posted, sector, and hiding training jobs or jobs without a salary. Each job: `id`, `title`, `url`, `company`, `company_profile_id`, `company_url`, `logo`, `location`, `county`, `working_option`, `salary` (from, to, per day/hour/annum), `contract`, full/part time, `snippet`, category, dates and flags, plus `raw`. `facets` gives counts per filter and the sector ids. 25 jobs per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/reed-search",
