    "/magicbricks/v1/search": {
      "get": {
        "operationId": "magicbricksSearch",
        "summary": "Magicbricks property search",
        "description": "Property for sale or rent in an Indian city on Magicbricks, with the site's filters: localities, property type (flat, house, plot, farm house, agricultural land, office, shop, commercial land, co-working, warehouse, industrial building or shed), BHK, budget, furnishing, construction status, verified listings, RERA-registered listings, plus sort. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/magicbricks-search",
        "tags": [
          "Magicbricks"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": true,
            "description": "An Indian city, e.g. `Mumbai`, `New Delhi`, `Bangalore`, `Pune`, `Hyderabad`, `Gurgaon`, `Noida`, `Thane`.",
            "schema": {
              "type": "string"
            },
            "example": "Mumbai"
          },
          {
            "name": "purpose",
            "in": "query",
            "required": false,
            "description": "Buy or rent (default `sale`).",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent"
              ]
            }
          },
          {
            "name": "locality",
            "in": "query",
            "required": false,
            "description": "Locality name(s), comma-separated, e.g. `Andheri West` or `Baner,Wakad`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Comma list of `flat`, `house`, `plot`, `farm_house`, `agricultural_land`, `office`, `shop`, `commercial_land`, `coworking`, `warehouse`, `industrial_building`, `industrial_shed` (default: flats, houses and plots).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bedrooms",
            "in": "query",
            "required": false,
            "description": "BHK counts, comma-separated, e.g. `2,3`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "budget_min",
            "in": "query",
            "required": false,
            "description": "Minimum price in rupees (monthly rent for `purpose=rent`).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "budget_max",
            "in": "query",
            "required": false,
            "description": "Maximum price in rupees.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "furnishing",
            "in": "query",
            "required": false,
            "description": "Comma list of `furnished`, `semi_furnished`, `unfurnished`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Construction status.",
            "schema": {
              "type": "string",
              "enum": [
                "ready_to_move",
                "under_construction"
              ]
            }
          },
          {
            "name": "verified",
            "in": "query",
            "required": false,
            "description": "true: verified listings only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "rera",
            "in": "query",
            "required": false,
            "description": "true: RERA-registered listings only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default `relevance`).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "newest",
                "price_per_sqft_asc",
                "price_per_sqft_desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
