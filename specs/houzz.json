          "Houzz"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "user_id",
            "in": "query",
            "required": true,
            "description": "The professional's user id.",
            "schema": {
              "type": "string"
            },
            "example": "1057751"
          },
          {
            "name": "pro_id",
            "in": "query",
            "required": true,
            "description": "The professional's pro id.",
            "schema": {
              "type": "string"
            },
            "example": "55006"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A profile link, instead of user_id and pro_id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default newest).",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
