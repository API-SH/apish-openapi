    "/google-scholar/v1/metrics": {
      "get": {
        "operationId": "googleScholarMetrics",
        "summary": "Google Scholar Metrics",
        "description": "Scholar Metrics: the top publications overall or in a category or subcategory, ranked by h5-index, with h5-median and the link to the articles behind the index, plus the category's subcategories.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/google-scholar-metrics",
        "tags": [
          "Google Scholar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category (empty for the overall top 100).",
            "schema": {
              "type": "string",
              "enum": [
                "bus",
                "chm",
                "eng",
                "hum",
                "med",
                "phy",
                "soc",
                "bio"
              ]
            },
            "example": "eng"
          },
          {
            "name": "subcategory",
            "in": "query",
            "required": false,
