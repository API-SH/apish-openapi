    "/google-scholar/v1/cite": {
      "get": {
        "operationId": "googleScholarCite",
        "summary": "Google Scholar cite",
        "description": "The citation formats Google Scholar gives for an article (MLA, APA, Chicago, Harvard, Vancouver) and its BibTeX, EndNote, RefMan and RefWorks export links. `id` is the `id` of a /google-scholar/v1/search result; `bibtex=1` also returns the BibTeX entry.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/google-scholar-cite",
        "tags": [
          "Google Scholar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "id of a /google-scholar/v1/search result.",
            "schema": {
              "type": "string"
            },
            "example": "5Gohgn6QFikJ"
          },
          {
            "name": "bibtex",
            "in": "query",
            "required": false,
            "description": "1 to include the BibTeX entry.",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "hl",
            "in": "query",
            "required": false,
            "description": "Language, e.g. en.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "5Gohgn6QFikJ",
                  "citations": [
                    {
                      "title": "MLA",
                      "snippet": "Vaswani, Ashish, et al. \"Attention is all you need.\" Advances in neural information processing systems 30 (2017)."
                    },
                    {
                      "title": "APA",
                      "snippet": "Vaswani, A., Shazeer, N., Parmar, N., Uszkoreit, J., Jones, L., Gomez, A. N., ... & Polosukhin, I. (2017). Attention is all you need. Advanc…"
                    },
                    "… 3 more"
                  ],
                  "links": [
                    {
