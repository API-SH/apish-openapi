    "/google-scholar/v1/search": {
      "get": {
        "operationId": "googleScholarSearch",
        "summary": "Google Scholar search",
        "description": "Scholar results: title, link, type, authors, venue, year, snippet, cited-by count and link, versions and PDF. 10 per page via `start`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/google-scholar-search",
        "tags": [
          "Google Scholar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search terms.",
            "schema": {
              "type": "string"
            },
            "example": "machine learning"
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "description": "Result offset (0, 10, 20 ...).",
            "schema": {
              "type": "integer"
            },
            "example": "0"
          },
          {
            "name": "year_from",
            "in": "query",
            "required": false,
            "description": "Earliest year.",
            "schema": {
              "type": "integer"
            },
            "example": "2020"
          },
          {
            "name": "year_to",
            "in": "query",
            "required": false,
            "description": "Latest year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "date for newest first (default relevance).",
            "schema": {
              "type": "string",
              "enum": [
                "date"
              ]
            }
          },
          {
            "name": "author",
            "in": "query",
            "required": false,
            "description": "Restrict to an author.",
            "schema": {
              "type": "string"
            },
            "example": "Hinton"
          },
          {
            "name": "include_citations",
            "in": "query",
            "required": false,
            "description": "0 to leave out citation-only entries.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "include_patents",
            "in": "query",
            "required": false,
            "description": "0 to leave out patents.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Language code for `lr` (en, de, fr, ...).",
            "schema": {
              "type": "string"
            },
            "example": "en"
          },
          {
            "name": "hl",
            "in": "query",
            "required": false,
            "description": "Interface language, default en.",
            "schema": {
              "type": "string"
            },
            "example": "en"
          },
          {
            "name": "cites",
            "in": "query",
            "required": false,
            "description": "Articles citing a paper: its cites id(s) (from /author articles or a result).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cluster",
            "in": "query",
            "required": false,
            "description": "All versions of one paper (cluster id).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
