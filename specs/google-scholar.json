    "/google-scholar/v1/case-law": {
      "get": {
        "operationId": "googleScholarCaseLaw",
        "summary": "Google Scholar case law",
        "description": "Search US legal opinions on Google Scholar: case title, court and year, snippet, cited-by count and links, with Scholar's own options (years, sort by date, start offset). `court` narrows to Scholar's court ids. Pass the next start back as `start`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/google-scholar-case-law",
        "tags": [
          "Google Scholar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search terms.",
            "schema": {
              "type": "string"
            },
            "example": "miranda warnings"
          },
          {
            "name": "court",
            "in": "query",
            "required": false,
            "description": "Scholar court ids, comma-separated (e.g. 4,33); default all federal and state courts.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year_from",
            "in": "query",
            "required": false,
            "description": "From this year.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year_to",
            "in": "query",
            "required": false,
            "description": "Up to this year.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "date"
              ]
            }
          },
          {
            "name": "start",
            "in": "query",
            "required": false,
            "description": "Result offset (0, 10, 20...).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hl",
            "in": "query",
            "required": false,
            "description": "Interface language (default en).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "miranda warnings",
                  "start": 0,
                  "hl": "en",
                  "total_results": 175000,
                  "count": 10,
                  "next_start": 10,
                  "results": [
