    "/wikiloc/v1/place": {
      "get": {
        "operationId": "wikilocPlace",
        "summary": "Wikiloc place",
        "description": "A popular place on Wikiloc (a summit, lake, waterfall, viewpoint...): name, type, nearest town, elevation, number of contributors, photos, locality, region, country, breadcrumbs and its top trails (name, link, activity, near, distance, elevation gain, difficulty, author, photos). Wikiloc lists a place's top 3 trails to visitors who are not signed in; `/wikiloc/v1/search` with the place's name or a point finds more.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wikiloc-place",
        "tags": [
          "Wikiloc"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "A place code (as in wikiloc.com/waypoints/f25B38/...) or that link.",
            "schema": {
              "type": "string"
            },
            "example": "f25B38"
          },
