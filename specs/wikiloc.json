    "/wikiloc/v1/search": {
      "get": {
        "operationId": "wikilocSearch",
        "summary": "Wikiloc trail search",
        "description": "GPS trails on Wikiloc (wikiloc.com) by text, by area (a point and radius, or a bounding box) and by country or region, 24 per page. Each trail: `id`, `name`, `url`, `activity`, `near`, `latitude`, `longitude`, `distance_km`, `distance_mi`, `elevation_gain_m`, `elevation_gain_ft`, `difficulty`, `rating`, `ratings`, `trailrank`, `trending`, `author`, `photos` and `raw`. Also `total`. Wikiloc applies activity, length, elevation, difficulty and sort filters only for signed-in members, so they are not offered here. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wikiloc-search",
        "tags": [
          "Wikiloc"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Text in the trail name or description, e.g. `angels landing`. Optional when an area, country or region is given.",
            "schema": {
              "type": "string"
            },
            "example": "angels landing"
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of a centre point (with `lng`).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "description": "Longitude of the centre point.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "description": "Radius around the point in km (1-500, default 10).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "south",
            "in": "query",
            "required": false,
            "description": "Bounding box: southern latitude (with west, north, east).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "west",
            "in": "query",
            "required": false,
            "description": "Bounding box: western longitude.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "north",
            "in": "query",
            "required": false,
            "description": "Bounding box: northern latitude.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "east",
            "in": "query",
            "required": false,
            "description": "Bounding box: eastern longitude.",
            "schema": {
