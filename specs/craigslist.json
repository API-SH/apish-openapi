{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Craigslist",
    "version": "1.0.0",
    "description": "The Craigslist API from API.SH: public Craigslist data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Craigslist",
      "description": "5 endpoints (e-commerce)",
      "x-slug": "craigslist",
      "x-domains": [
        "craigslist.org"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/craigslist/v1/categories": {
      "get": {
        "operationId": "craigslistCategories",
        "summary": "Craigslist categories",
        "description": "Craigslist's category codes in their groups (for sale, housing, jobs, gigs, services, community, events and classes, resumes): code, id, name, whether it is the by-owner or by-dealer half, and with `city` the search link on that city's site. Each group also has its all-categories code (sss, hhh, jjj, ...). Use the codes as `category` in /craigslist/v1/search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/craigslist-categories",
        "tags": [
          "Craigslist"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "Craigslist city (sfbay, newyork, london...) to add its search links.",
            "schema": {
              "type": "string"
            },
            "example": "sfbay"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Only one group: S = for sale, H = housing, J = jobs, G = gigs, B = services, C = community, E = events and classes, R = resumes, L = event calendar.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "city": "sfbay",
                  "count": 178,
                  "groups": [
                    {
                      "type": "S",
                      "name": "for sale",
                      "all_code": "sss",
                      "url": "https://sfbay.craigslist.org/search/sss",
                      "count": 87,
                      "categories": [
                        {
                          "code": "for",
                          "id": 5,
                          "name": "general for sale - by owner",
                          "seller": "owner",
                          "url": "https://sfbay.craigslist.org/search/for"
                        },
                        {
                          "code": "sys",
                          "id": 7,
                          "name": "computers - by owner",
                          "seller": "owner",
                          "url": "https://sfbay.craigslist.org/search/sys"
                        },
                        "… 85 more"
                      ]
                    },
                    {
                      "type": "H",
                      "name": "housing",
                      "all_code": "hhh",
                      "url": "https://sfbay.craigslist.org/search/hhh",
                      "count": 13,
                      "categories": [
                        {
                          "code": "apa",
                          "id": 1,
                          "name": "apartments / housing for rent",
                          "seller": null,
                          "url": "https://sfbay.craigslist.org/search/apa"
                        },
                        {
                          "code": "hou",
                          "id": 2,
                          "name": "wanted: apts",
                          "seller": null,
                          "url": "https://sfbay.craigslist.org/search/hou"
                        },
                        "… 11 more"
                      ]
                    },
                    "… 7 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/craigslist/v1/post": {
      "get": {
        "operationId": "craigslistPost",
        "summary": "One Craigslist posting",
        "description": "One posting by URL: id, title, price, location, coordinates, posted and updated times, area, subarea, category, attributes (condition, make, model, size, ...), full description and all image URLs. Removed or expired postings answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/craigslist-post",
        "tags": [
          "Craigslist"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Craigslist posting URL (any form, e.g. https://sfbay.craigslist.org/sby/bik/d/<slug>/<id>.html). Postings expire after a few weeks. Or use latest=true.",
            "schema": {
              "type": "string"
            },
            "example": "https://sfbay.craigslist.org/pen/bik/d/brisbane-2017-tomos-sprint-classic-a55a/7986502410.html"
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "true: open the first posting of a search with the search params given alongside (city, q, category and the other /craigslist/v1/search params). Then url is not needed.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "With latest=true, the city subdomain (sfbay, newyork, losangeles, ...) or its name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "With latest=true, the search text.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "With latest=true, the 3-letter category code (default sss = all for sale), e.g. bia (bikes).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/craigslist/v1/search": {
      "get": {
        "operationId": "craigslistSearch",
        "summary": "Craigslist search",
        "description": "Search one Craigslist city: posting id, title, price, posted time, location text, subarea, coordinates, category id, posting URL, image URLs and `attributes` (bedrooms and sqft for housing, odometer for vehicles, when the result shows them) (up to 360 results per search; narrow with filters for more). Any other Craigslist filter is passed on (hasPic=1, postedToday=1, purveyor=owner, condition, auto_make_model, bicycle_type, min_year, max_auto_miles, ...); `available_filters` lists the filters of the chosen category and `applied_filters` echoes them.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/craigslist-search",
        "tags": [
          "Craigslist"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": true,
            "description": "Craigslist city subdomain (sfbay, newyork, losangeles, london, ...) or its name.",
            "schema": {
              "type": "string"
            },
            "example": "sfbay"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search text.",
            "schema": {
              "type": "string"
            },
            "example": "bike"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "3-letter category code (default sss = all for sale), e.g. bia (bikes), cta (cars+trucks), fua (furniture), apa (apartments), jjj (jobs).",
            "schema": {
              "type": "string"
            },
            "example": "bia"
          },
          {
            "name": "subarea",
            "in": "query",
            "required": false,
            "description": "Subarea code within the city, e.g. sfc, eby, brk, mnh.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "date, dateoldest, rel, priceasc, pricedsc or dist.",
            "schema": {
              "type": "string",
              "enum": [
                "date",
                "dateoldest",
                "rel",
                "priceasc",
                "pricedsc",
                "dist"
              ]
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum price.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum price.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "postal",
            "in": "query",
            "required": false,
            "description": "ZIP code for a distance search.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "search_distance",
            "in": "query",
            "required": false,
            "description": "Miles around `postal`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "city": "sfbay",
                  "area": "SF bay area",
                  "category": "sss",
                  "query": "iphone",
                  "sort": "rel",
                  "applied_filters": {},
                  "total": 1529,
                  "count": 360,
                  "items": [
                    {
                      "id": "7992802173",
                      "title": "Iphone 15+ Plus 128G Unlocked, Perfect Condition.",
                      "price": 330,
                      "price_text": "$330",
                      "posted": "2026-11-04T05:40:22.000Z",
                      "site": "sfbay",
                      "location": "alameda",
                      "neighborhood": "alameda",
                      "subarea": "eby",
                      "lat": 37.7587,
                      "lon": -122.231,
                      "category_id": 153,
                      "url": "https://www.craigslist.org/view/d/oakland-iphone-15-plus-128g-unlocked/kRB4Maxuuk3kSGKFqBtmNY",
                      "images": [
                        "https://images.craigslist.org/00303_evvuIjFl4Sz_0x20oM_600x450.jpg",
                        "https://images.craigslist.org/00808_1iOdVv7kFpR_0x20oM_600x450.jpg"
                      ],
                      "attributes": {}
                    },
                    {
                      "id": "7994944419",
                      "title": "iPhone 11 Pro Max 512GB – Mineral Green – Unlocked – 329 OBO",
                      "price": 329,
                      "price_text": "$329",
                      "posted": "2026-11-04T05:07:55.000Z",
                      "site": "sfbay",
                      "location": "Dublin",
                      "neighborhood": null,
                      "subarea": "eby",
                      "lat": 37.716,
                      "lon": -121.912,
                      "category_id": 153,
                      "url": "https://www.craigslist.org/view/d/dublin-iphone-11-pro-max-512gb-mineral/vGS8YqqNWkr5Uu5hMjRojP",
                      "images": [
                        "https://images.craigslist.org/01111_8vle0Tmftja_0t20CI_600x450.jpg",
                        "https://images.craigslist.org/00g0g_aA2BF0wz3Bg_0t20CI_600x450.jpg",
                        "… 2 more"
                      ],
                      "attributes": {}
                    },
                    "… 358 more"
                  ],
                  "available_filters": [
                    {
                      "name": "query",
                      "label": "query",
                      "type": "text"
                    },
                    {
                      "name": "sort",
                      "label": "sort by",
                      "type": "select",
                      "options": [
                        {
                          "label": "newest",
                          "value": "date"
                        },
                        {
                          "label": "oldest",
                          "value": "dateoldest"
                        },
                        "… 4 more"
                      ]
                    },
                    "… 9 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/craigslist/v1/search-rss": {
      "get": {
        "operationId": "craigslistSearchRss",
        "summary": "Craigslist search across nearby areas",
        "description": "One craigslist search run on a city and its nearest craigslist areas (or a list of cities), merged and sorted, each listing tagged with its city: id, title, price, posted time, location, neighborhood, sub-area, coordinates, link, images and attributes; plus each area searched with its distance and result total. Any other search filter of /craigslist/v1/search (min_price, max_price, hasPic, purveyor, condition, ...) is passed on.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/craigslist-search-rss",
        "tags": [
          "Craigslist"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": true,
            "description": "Home city (craigslist subdomain or name).",
            "schema": {
              "type": "string"
            },
            "example": "sfbay"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "trek"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "3-letter category code (default sss = all for sale); see /craigslist/v1/categories.",
            "schema": {
              "type": "string"
            },
            "example": "bia"
          },
          {
            "name": "nearby",
            "in": "query",
            "required": false,
            "description": "How many nearest areas to add (0-8, default 4).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "description": "Only add areas within this distance (default 300).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cities",
            "in": "query",
            "required": false,
            "description": "Comma-separated extra cities to search (up to 9).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "date (default), dateoldest, rel, priceasc, pricedsc, dist.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit_per_area",
            "in": "query",
            "required": false,
            "description": "Listings kept per area (default 60, max 360).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "city": "sfbay",
