          "Craigslist"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Two-letter country, e.g. US, CA, GB.",
            "schema": {
              "type": "string"
            },
            "example": "US"
          },
          {
            "name": "region",
            "in": "query",
