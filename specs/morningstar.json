    "/morningstar/v1/fund": {
      "get": {
        "operationId": "morningstarFund",
        "summary": "Morningstar fund",
        "description": "A mutual fund on Morningstar: NAV and 1-day return, fund size, adjusted and net expense ratio, fee level, share class, Morningstar category, style box, minimum investment, status, TTM yield, turnover, the analyst's one-line summary, the top 10 holdings with weights, values and sectors and `sector_weights` (equity sectors and, for bond funds, fixed-income sectors: the fund, its category and its index). ETFs (type=etf) give the analyst summary and holdings. Medalist and star ratings are subscriber-only and not included. `details=true` adds the security `id` and: `asset_allocation` (US equity, non-US equity, bond, cash, other: net, long and short percent with category and index comparison), `trailing_returns` (1 day to since inception: NAV and market return, difference to category, category rank percentile and fund count), `star_rating` (overall, 3, 5 and 10 years), `risk` (alpha, beta, R-squared, standard deviation and Sharpe ratio over 1 to 15 years for the fund, its category and index where published, plus risk and return versus category) and `management` (advisor, manager count, average and longest manager tenure, current and past managers with start dates).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/morningstar-fund",
        "tags": [
          "Morningstar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "ticker",
            "in": "query",
            "required": true,
            "description": "Fund or ETF ticker.",
            "schema": {
              "type": "string"
            },
            "example": "VFIAX"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "fund (default) or etf.",
            "schema": {
              "type": "string",
              "enum": [
                "fund",
                "etf"
              ]
            },
            "example": "fund"
          },
          {
            "name": "exchange",
            "in": "query",
            "required": false,
            "description": "Morningstar market code. Default xnas for funds; arcx, xnas, then bats for ETFs.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "details",
            "in": "query",
            "required": false,
            "description": "true adds asset allocation, trailing returns, star rating, risk statistics and management (default false).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "ticker": "VFIAX",
                  "type": "fund",
                  "exchange": "xnas",
                  "url": "https://www.morningstar.com/funds/xnas/vfiax/quote",
                  "name": "Vanguard 500 Index Fund Admiral Shares",
                  "nav": 698.88,
