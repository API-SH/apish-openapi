    "/morningstar/v1/holdings": {
      "get": {
        "operationId": "morningstarHoldings",
        "summary": "Morningstar holdings",
        "description": "A fund's or ETF's holdings on Morningstar, largest first, 100 a page: name, ticker, ISIN, CUSIP, type, sector, country, weight, shares, share change and market value; with the portfolio date, holding counts, top 10 weight, turnover and benchmark, and (first page) the sector breakdown against the category and index and the country weights of the listed holdings.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/morningstar-holdings",
        "tags": [
          "Morningstar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "ticker",
            "in": "query",
            "required": true,
            "description": "Fund or ETF ticker.",
            "schema": {
              "type": "string"
            },
            "example": "SPY"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "fund or etf. Default: ETF first, then mutual fund.",
            "schema": {
              "type": "string",
              "enum": [
                "fund",
                "etf"
              ]
            },
            "example": "etf"
          },
          {
            "name": "exchange",
            "in": "query",
            "required": false,
            "description": "Morningstar market code. Default xnas for funds; arcx, xnas, bats, then xnys for ETFs.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1), 100 holdings a page. `next_page` is null on the last page.",
            "schema": {
