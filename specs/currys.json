    "/currys/v1/search": {
      "get": {
        "operationId": "currysSearch",
        "summary": "Search Currys products",
        "description": "Currys (UK) product search with every sort and refinement the shop offers. Each product has its id, sku, link, name, brand, price, was-price and saving, rating and review count, EANs, offers, delivery/collection availability, care plans with prices, category path and image. Use `q` or a `category` id. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/currys-search",
        "tags": [
          "Currys"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search keywords.",
            "schema": {
              "type": "string"
            },
            "example": "kettle"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A Currys category id (instead of or with q).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: relevance (default), price_asc, price_desc, rating, newest.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "rating",
                "newest"
              ]
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Only these brands (comma-separated, e.g. NINJA,BREVILLE).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "colour",
            "in": "query",
            "required": false,
            "description": "Only these colours (comma-separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Only these product types (comma-separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "availability",
            "in": "query",
            "required": false,
            "description": "Delivery available or Collect from store.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_rating",
            "in": "query",
            "required": false,
            "description": "Minimum average rating (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in GBP.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in GBP.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Any other refinement: name:value[|value], several separated by ; (names in `filter_names`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1 = first).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Products per page (default 24, max 30).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "kettle",
                  "applied_filters": {
                    "sort": "relevance"
                  },
                  "page": 1,
                  "limit": 24,
                  "total": 537,
                  "count": 24,
                  "next_page": 2,
                  "sort_options": [
                    "relevance",
                    "price_asc",
                    "… 3 more"
