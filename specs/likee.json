    "/likee/v1/user/videos": {
      "get": {
        "operationId": "likeeUserVideos",
        "summary": "Likee user videos",
        "description": "A Likee creator's videos, newest first: post id, link, caption, date, country, plays, likes, comments, shares, cover, size, hashtags, mentions, sound and music, with the creator's profile on the first call. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/likee-user-videos",
        "tags": [
          "Likee"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "handle",
            "in": "query",
            "required": false,
            "description": "Likee ID, @handle or profile URL (or give uid).",
            "schema": {
              "type": "string"
            },
            "example": "theAINA"
          },
          {
            "name": "uid",
            "in": "query",
            "required": false,
            "description": "Likee numeric uid instead of handle (saves the profile lookup).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Videos per page, 1-50 (default 30).",
            "schema": {
              "type": "integer"
            },
            "example": "30"
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "`next_cursor` from the previous page; null on the last page.",
            "schema": {
              "type": "string"
            }
          },
