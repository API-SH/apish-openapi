    "/likee/v1/video": {
      "get": {
        "operationId": "likeeVideo",
        "summary": "Likee video",
        "description": "One Likee video with its creator: post id, link, caption, date, country, type, plays, likes, comments, shares, cover, size, photos, hashtags, mentions, sound and music, the creator's profile (followers, likes, level, bio, links) and `raw` (the site's record). Give a video link (it carries the creator's handle), or `handle` with `id`; `latest=true` with `handle` returns the creator's newest video. The video is found among the creator's latest videos (200 by default, up to 500 with `pages`).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/likee-video",
        "tags": [
          "Likee"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A video link: likee.video/@<handle>/video/<id>.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "handle",
            "in": "query",
            "required": false,
            "description": "The creator's Likee ID or @handle (with `id` or `latest`).",
            "schema": {
              "type": "string"
            },
            "example": "theAINA"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Video post id (the number at the end of a video link).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "true returns the creator's newest video.",
            "schema": {
              "type": "boolean"
            },
            "example": "true"
          },
          {
            "name": "pages",
            "in": "query",
            "required": false,
            "description": "How far back to look for `id`, in pages of 50 videos (default 4, max 10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
