            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "featured",
                "newest",
                "hot_and_new",
                "highest_rated",
                "most_reviewed",
                "price_asc",
                "price_desc",
                "best_sellers"
              ]
            },
            "example": "highest_rated"
