            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tags",
            "in": "query",
            "required": false,
            "description": "Tags, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filetypes",
            "in": "query",
            "required": false,
