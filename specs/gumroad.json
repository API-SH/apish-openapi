        "tags": [
          "Gumroad"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (or category or tags).",
            "schema": {
              "type": "string"
            },
            "example": "notion"
          },
          {
            "name": "category",
            "in": "query",
