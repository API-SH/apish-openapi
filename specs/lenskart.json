    "/lenskart/v1/search": {
      "get": {
        "operationId": "lenskartSearch",
        "summary": "Lenskart search",
        "description": "Lenskart category listing (India): eyeglasses, sunglasses and their sub-collections with product name, link, price, MRP, discount, rating, frame size, shape and colour, and images. Returns the first page of the listing.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/lenskart-search",
        "tags": [
          "Lenskart"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "A listing name (words are joined with dashes), e.g. sunglasses or eyeglasses.",
            "schema": {
              "type": "string"
            },
            "example": "sunglasses"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category path, e.g. eyeglasses, sunglasses or eyeglasses/gender/men. Takes the place of q.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
