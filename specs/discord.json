                    "splash": "https://cdn.discordapp.com/splashes/267624335836053506/b7099fe221153a7faff76048dc2e63ef.png?size=1024",
                    "vanity_url_code": "python",
                    "verification_level": 2,
                    "nsfw": false,
                    "nsfw_level": 0,
                    "boosts": 27,
                    "features": [
                      "SWP_CHANNEL_MESSAGES_DISABLED",
                      "COMMUNITY",
                      "… 49 more"
                    ]
                  },
                  "members": 428294,
                  "online": 32460,
                  "channel": {
                    "id": "267631170882240512",
                    "name": "welcome",
                    "type": 0
                  },
                  "profile": {
                    "tag": "snek",
                    "traits": [],
                    "games": [],
                    "created_at": null
                  },
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
