    "/discord/v1/servers/search": {
      "get": {
        "operationId": "discordServersSearch",
        "summary": "Discord server search",
        "description": "Servers in Discord's public server directory matching a keyword: name, description, member and online counts, icon, vanity invite, categories and features. 12 per page; pass `next_offset` back as `offset` (null on the last page). `category` limits the search to one directory category, or browses it without `q`. Every response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/discord-servers-search",
        "tags": [
          "Discord"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keyword.",
            "schema": {
              "type": "string"
            },
            "example": "minecraft"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Value of `next_offset` from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Directory category: `gaming`, `music`, `entertainment`, `science-tech` or `education`. With a category, `q` is optional (leave it out to browse the category).",
            "schema": {
              "type": "string",
              "enum": [
                "gaming",
                "music",
                "entertainment",
                "science-tech",
                "education"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "minecraft",
                  "offset": 0,
                  "total": 4967,
                  "count": 12,
                  "servers": [
                    {
                      "id": "143852930036924417",
