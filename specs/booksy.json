    "/booksy/v1/search": {
      "get": {
        "operationId": "booksySearch",
        "summary": "Booksy businesses for a category in a city",
        "description": "Barbers, salons and other businesses on Booksy for a category, in a city or the whole country: id, name, link, categories, address, city, coordinates, regions, distance, rating, review count, website and social links, logo, cover and photos, promoted and recommended flags, payment options, amenities, top services and every service with variants (duration, price, deposit, promotion); plus the treatments offered there with business counts. Sort by relevance (default), rating or distance with `sort`. For one treatment (e.g. `beard-shave`) pass its slug from `treatments` as `category`. `total` is the number of businesses. 20 per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/booksy-search",
        "tags": [
          "Booksy"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug, e.g. `barber-shop`, `hair-salon`, `nail-salon`, `skin-care`, `massage`, `brows-lashes`, `makeup-artist`, `tattoo-shops`.",
            "schema": {
              "type": "string"
            },
            "example": "barber-shop"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "The site's <id>_<city> location key as in its search links, e.g. `18229_chicago` (leave out for the whole country).",
            "schema": {
              "type": "string"
            },
            "example": "18229_chicago"
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Site locale (default en-us), e.g. `en-us`, `en-gb`, `pl-pl`, `es-es`.",
            "schema": {
              "type": "string"
            },
            "example": "en-us"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), rating or distance.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "rating",
                "distance"
              ]
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A booksy.com/<locale>/s/<category>/<id>_<city> page instead of category and location.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "locale": "en-us",
                  "category": "barber-shop",
                  "category_name": "Barbershops",
                  "location": {
                    "id": 18229,
