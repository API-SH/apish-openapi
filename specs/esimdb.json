{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: eSIMDB",
    "version": "1.0.0",
    "description": "The eSIMDB API from API.SH: public eSIMDB data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "eSIMDB",
      "description": "3 endpoints (travel & events)",
      "x-slug": "esimdb",
      "x-domains": [
        "esimdb.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/esimdb/v1/destinations": {
      "get": {
        "operationId": "esimdbDestinations",
        "summary": "eSIM destinations",
        "description": "Countries and regions with travel eSIM plans: code, name, slug, region, flag, number of providers and plans; regions list their countries.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/esimdb-destinations",
        "tags": [
          "eSIMDB"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Text in the name, code or slug.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "count": 269,
                  "countries": [
                    {
                      "code": "FR",
                      "name": "France",
                      "slug": "france",
                      "region": "europe",
                      "flag": "🇫🇷",
                      "providers": 259,
                      "plans": 24203
                    },
                    {
                      "code": "ES",
                      "name": "Spain",
                      "slug": "spain",
                      "region": "europe",
                      "flag": "🇪🇸",
                      "providers": 259,
                      "plans": 25725
                    },
                    "… 247 more"
                  ],
                  "regions": [
                    {
                      "slug": "global",
                      "name": "Global (World)",
                      "flag": "🌎",
                      "providers": 199,
                      "plans": 4226,
                      "countries": []
                    },
                    {
                      "slug": "europe",
                      "name": "Europe",
                      "flag": "🌍",
                      "providers": 245,
                      "plans": 19670,
                      "countries": [
                        "AX",
                        "AL",
                        "… 51 more"
                      ]
                    },
                    "… 18 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/esimdb/v1/plans": {
      "get": {
        "operationId": "esimdbPlans",
        "summary": "Travel eSIM plans for a country or region",
        "description": "Every travel eSIM data plan listed for a country or region across providers: plan name, provider (with promo code), data in GB or unlimited, daily cap, validity in days, price in USD and the provider's currencies, promo price, price per GB, 5G, tethering, top-up, eKYC, phone number, subscription, pay-as-you-go, new-user-only, throttling and networks. Filter by minimum data, minimum and maximum days, maximum price, maximum price per GB, provider, network, 5G or unlimited, and by tethering, top-up, eKYC, phone number, low latency, subscription and new-user-only (the answer echoes the newer filters as `applied_filters`), and sort by price, price per GB, data or validity. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/esimdb-plans",
        "tags": [
          "eSIMDB"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country name, slug or 2-letter code (see /esimdb/v1/destinations). Give this or `region`.",
            "schema": {
              "type": "string"
            },
            "example": "japan"
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Region slug instead of a country: europe, asia, global, north-america, south-america, africa, middle-east, oceania, caribbean...",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_data_gb",
            "in": "query",
            "required": false,
            "description": "Only plans with at least this much data (GB); unlimited plans always match.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_days",
            "in": "query",
            "required": false,
            "description": "Only plans valid for at least this many days.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Only plans up to this price in USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "description": "Only this provider (name or slug, e.g. airalo, holafly, ubigi).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "has_5g",
            "in": "query",
            "required": false,
            "description": "true: only 5G plans.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "unlimited",
            "in": "query",
            "required": false,
            "description": "true: only unlimited-data plans.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "max_price_per_gb",
            "in": "query",
            "required": false,
            "description": "Only plans up to this price per GB in USD (unlimited plans have no price per GB and are left out).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_days",
            "in": "query",
            "required": false,
            "description": "Only plans valid for at most this many days.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "network",
            "in": "query",
            "required": false,
            "description": "Only plans on one of these networks: slugs as in `plans[].networks` (e.g. softbank-jp) or the operator part (softbank), comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tethering",
            "in": "query",
            "required": false,
            "description": "true: plans that allow hotspot use; false: plans that state they do not. Plans that do not say are left out.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "can_top_up",
            "in": "query",
            "required": false,
            "description": "true: plans that can be topped up; false: plans that state they cannot.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "ekyc",
            "in": "query",
            "required": false,
            "description": "true: plans that need identity verification; false: plans that state they do not.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "telephony",
            "in": "query",
            "required": false,
            "description": "true: plans with a phone number (calls / SMS); false: data-only plans that say so.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "low_latency",
            "in": "query",
            "required": false,
            "description": "true: only low-latency plans; false: the others.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "subscription",
            "in": "query",
            "required": false,
            "description": "true: only subscription plans; false: only one-off plans.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "new_user_only",
            "in": "query",
            "required": false,
            "description": "false: leave out offers limited to new customers; true: only those.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "price",
                "price_per_gb",
                "data",
                "validity"
              ]
            },
            "example": "price"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Plans per page, 1-100.",
            "schema": {
              "type": "integer"
            },
            "example": "50"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
