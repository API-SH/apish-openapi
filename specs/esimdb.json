    "/esimdb/v1/providers": {
      "get": {
        "operationId": "esimdbProviders",
        "summary": "eSIMDB providers",
        "description": "Every eSIM provider eSIMDB compares: name, slug, logo and the countries it covers (codes and count), most countries first. Filter by name with `q` or by a country it covers. Use /esimdb/v1/plans for their prices.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/esimdb-providers",
        "tags": [
          "eSIMDB"
        ],
