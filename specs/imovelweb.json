    "/imovelweb/v1/search": {
      "get": {
        "operationId": "imovelwebSearch",
        "summary": "Imovelweb search",
        "description": "Imovelweb (BR) listings, 30 per page. Give `url` (an Imovelweb listing URL) or numeric location ids (`city_id`, `province_id`, `zone_id`, `sub_zone_id`; every response returns the ids of its search under `search`). Filters run on the site's own search API and apply on top of the URL.\n\nPass `next_page` back as `page`; `next_page` is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/imovelweb-search",
        "tags": [
          "Imovelweb"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "An Imovelweb listing URL. Optional when a location id is given.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.imovelweb.com.br/apartamentos-aluguel-sao-paulo-sp.html"
          },
          {
            "name": "city_id",
            "in": "query",
            "required": false,
            "description": "Location id of a city (e.g. 109668 for São Paulo).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "province_id",
            "in": "query",
            "required": false,
            "description": "Location id of a state.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "zone_id",
            "in": "query",
            "required": false,
            "description": "Location id of a neighbourhood.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sub_zone_id",
            "in": "query",
            "required": false,
            "description": "Location id of a sub-zone.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "operation",
            "in": "query",
            "required": false,
            "description": "rent (default), buy, vacation, auction.",
            "schema": {
              "type": "string",
              "enum": [
                "rent",
                "buy",
                "vacation",
                "auction"
              ]
            }
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "apartment (default), house, land, commercial, rural (or a numeric type id).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum price, BRL.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum price, BRL.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_bedrooms",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_bedrooms",
            "in": "query",
            "required": false,
            "description": "Maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_bathrooms",
            "in": "query",
            "required": false,
            "description": "Minimum bathrooms (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_parking",
            "in": "query",
            "required": false,
            "description": "Minimum parking spaces (-1 for none, 1-4).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_area",
            "in": "query",
            "required": false,
            "description": "Minimum area, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_area",
            "in": "query",
            "required": false,
            "description": "Maximum area, m².",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_expenses",
            "in": "query",
            "required": false,
            "description": "Minimum condo fees, BRL.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_expenses",
            "in": "query",
            "required": false,
            "description": "Maximum condo fees, BRL.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_age",
            "in": "query",
            "required": false,
            "description": "Building age: -1 under construction, 0 launch soon, 5, 10, 20, 50, 51 (over 50 years).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "published_within_days",
            "in": "query",
            "required": false,
            "description": "0 today, 1, 7, 15, 30, 45.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "publisher_type",
            "in": "query",
            "required": false,
            "description": "all (default), company, owner.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "company",
                "owner"
              ]
            }
          },
          {
            "name": "features",
            "in": "query",
            "required": false,
            "description": "Amenity ids, comma-separated, e.g. 30027 (pool), 10071 (elevator), 20135 (pets allowed), 20126 (furnished), 20199 (balcony).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "multimedia",
            "in": "query",
            "required": false,
            "description": "1 videos, 4 360° tour, 10 floor plans.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "Free-text keyword.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), price_asc, price_desc, newest, most_viewed, price_drop.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "agency_id",
            "in": "query",
            "required": false,
            "description": "Only this advertiser's listings (publisher.id of a listing); needs no location.",
            "schema": {
              "type": "string"
            },
            "example": "47285457"
          },
          {
            "name": "value_zone_id",
            "in": "query",
            "required": false,
            "description": "Area id (id of an area from /imovelweb/v1/locations).",
            "schema": {
              "type": "string"
            },
            "example": "52"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
