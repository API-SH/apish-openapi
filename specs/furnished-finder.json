    "/furnishedfinder/v1/rent-stats": {
      "get": {
        "operationId": "furnishedfinderRentStats",
        "summary": "Furnished Finder rent statistics",
        "description": "Rent statistics for a Furnished Finder location: number of listings, lowest and highest monthly rent and a rent histogram (share of listings per rent band), optionally for one property type or bedroom count.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/furnishedfinder-rent-stats",
        "tags": [
          "Furnished Finder"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "description": "A location id (us--tx--austin), a place name, or a furnishedfinder.com/housing/... link.",
            "schema": {
              "type": "string"
            },
            "example": "us--tx--austin"
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Comma-separated: entire_unit, room, hotel.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bedrooms",
            "in": "query",
            "required": false,
            "description": "Bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bins",
            "in": "query",
            "required": false,
            "description": "Number of rent bands, up to 60 (default 30).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "location": "us--tx--austin",
                  "resolved": null,
                  "applied_filters": [],
                  "listings": 2190,
                  "rent_min": 0,
                  "rent_max": 5500,
                  "histogram": [
                    {
                      "from": 0,
                      "to": 183.33,
                      "percent": 0
                    },
                    {
                      "from": 183.33,
                      "to": 366.67,
                      "percent": 0
                    },
                    "… 28 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
