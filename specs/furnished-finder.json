    "/furnishedfinder/v1/search": {
      "get": {
        "operationId": "furnishedfinderSearch",
        "summary": "Furnished Finder rentals search",
        "description": "Furnished monthly rentals in the US on Furnished Finder for a city, neighborhood or place (hospitals included), with every filter the site offers: property type, rent range, bedrooms, bathrooms, sleeps, private bathroom, pets, utilities included, amenities and move-in/move-out dates (dates rank and flag availability as on the site). Each result has id, link, title, property type, rent per month, bedrooms, bathrooms and bath type, sleeps, laundry, minimum stay, availability, approximate coordinates, amenities, description, good-responder and new-listing flags and up to 6 photos. Landlord names and contact details are not included. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/furnishedfinder-search",
        "tags": [
          "Furnished Finder"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "description": "A Furnished Finder location id (us--tx--austin), a city, neighborhood or place name such as a hospital (the best match is used and returned as resolved), or a furnishedfinder.com/housing/... link.",
            "schema": {
              "type": "string"
            },
            "example": "us--tx--austin"
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Comma-separated: entire_unit, room, hotel.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum rent per month, USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum rent per month, USD.",
            "schema": {
              "type": "number"
            },
            "example": "2000"
          },
          {
            "name": "bedrooms",
            "in": "query",
            "required": false,
            "description": "Bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bathrooms",
            "in": "query",
            "required": false,
            "description": "Bathrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sleeps",
            "in": "query",
            "required": false,
            "description": "Sleeps at least.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "private_bathroom",
            "in": "query",
            "required": false,
            "description": "true: private bathroom only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "pets_allowed",
            "in": "query",
            "required": false,
            "description": "true: pets allowed.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "utilities_included",
            "in": "query",
            "required": false,
            "description": "true: utilities included.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "amenities",
            "in": "query",
            "required": false,
            "description": "Comma-separated: gym, laundry, free_parking, dedicated_workspace, king_bed, wifi, fenced_yard, air_conditioning, pool, ev_charger, blackout_curtains, wheelchair_accessible, elevator, disabled_parking, close_to_public_transport.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "move_in",
            "in": "query",
            "required": false,
            "description": "Move-in date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
