    "/yell/v1/search": {
      "get": {
        "operationId": "yellSearch",
        "summary": "Yell business search",
        "description": "Search Yell, the UK business directory, by keyword (or business name) and UK town, city or postcode, with the site's sort orders (relevance, distance, rating, most reviewed), content filters (businesses with reviews, websites, videos or photos) and category refinements. Each result: Yell id, advert id, slug (for /yell/v1/business), name, link, category, schema type, strapline, sponsored flag, years with Yell, phone numbers with their type, website, enquiry link, address or service area, opening status, listed services, rating and rating count, logo. Also: the total, the categories to refine by and whether the term also matches a business name. 25 results a page; pass `next_page` back as `page`; null on the last page. A search without matches answers an empty list.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yell-search",
        "tags": [
          "Yell"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "keywords",
            "in": "query",
            "required": false,
            "description": "What to find, e.g. plumbers, dentists, solicitors. Required unless company is given.",
            "schema": {
