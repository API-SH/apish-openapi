    "/thumbtack/v1/pros": {
      "get": {
        "operationId": "thumbtackPros",
        "summary": "Thumbtack top pros for a service in a city",
        "description": "The top pros Thumbtack shows for a service in a US city: id, name, profile link, avatar, description, business type, rating, review count and rating label, hires, response time, badges, facts, services and offered services, price, value signals, highlighted review, area served, founding year and employees; plus the service options with ids, the 25 most recent reviews across the city's pros, related cost guides and breadcrumbs. The site shows 5 to 10 pros on these pages; `zip` re-ranks them for that ZIP code.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/thumbtack-pros",
        "tags": [
          "Thumbtack"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "service",
            "in": "query",
            "required": false,
            "description": "Service slug as in Thumbtack's city pages, e.g. `plumbers`, `electricians`, `house-cleaning`, `photographers`, `personal-trainers`, `movers`.",
            "schema": {
              "type": "string"
            },
            "example": "plumbers"
          },
          {
            "name": "state",
            "in": "query",
            "required": false,
            "description": "Two-letter US state.",
            "schema": {
              "type": "string"
            },
            "example": "ny"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City slug, e.g. `new-york`, `brooklyn`, `chicago`.",
            "schema": {
              "type": "string"
            },
            "example": "new-york"
          },
          {
            "name": "zip",
            "in": "query",
            "required": false,
            "description": "Optional 5-digit ZIP code to rank the pros for.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A thumbtack.com/<state>/<city>/<service>/ page instead of service, state and city.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "url": "https://www.thumbtack.com/ny/new-york/plumbers/",
                  "title": "Top pros for your project",
                  "zip_code": "10001",
                  "category_id": "150850272033989083",
                  "count": 5,
                  "pros": [
