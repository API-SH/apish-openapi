    "/microcenter/v1/questions": {
      "get": {
        "operationId": "microcenterQuestions",
        "summary": "Micro Center product questions and answers",
        "description": "Customer questions about one microcenter.com product, each with its answers (text, date, nickname, brand and best-answer flags, helpful votes), plus question and answer counts. Sort by newest, oldest, most answered or most helpful; only answered questions or questions containing words. Pass `next_page` back as `page`; it is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/microcenter-questions",
        "tags": [
          "Micro Center"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Micro Center product id: the number after /product/ in a microcenter.com link, or the link itself.",
            "schema": {
              "type": "string"
            },
            "example": "659876"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default newest).",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest",
                "most_answered",
                "helpful"
              ]
            }
          },
          {
            "name": "answered",
            "in": "query",
            "required": false,
            "description": "true: only questions that have answers.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Only questions containing these words.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Questions per page, 1 to 100 (default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
