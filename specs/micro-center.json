    "/microcenter/v1/reviews": {
      "get": {
        "operationId": "microcenterReviews",
        "summary": "Micro Center product reviews",
        "description": "Customer reviews of one microcenter.com product with the average rating, review count, recommended counts, star distribution and secondary rating averages. Each review has rating, title, text, pros and cons, date, nickname and location, recommended flag, helpful votes, verified-purchaser and incentivized flags, badges, photos and Micro Center's replies. Sort by relevance, newest, oldest, highest, lowest or most helpful; filter by stars, photos or words. Pass `next_page` back as `page`; it is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/microcenter-reviews",
        "tags": [
          "Micro Center"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Micro Center product id: the number after /product/ in a microcenter.com link, or the link itself.",
            "schema": {
              "type": "string"
            },
            "example": "659876"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default relevant).",
            "schema": {
              "type": "string",
              "enum": [
                "relevant",
                "newest",
                "oldest",
                "highest",
                "lowest",
                "helpful"
              ]
            }
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Only reviews with this many stars.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "photos",
            "in": "query",
            "required": false,
            "description": "true: only reviews with photos.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Only reviews containing these words.",
            "schema": {
