    "/microcenter/v1/search": {
      "get": {
        "operationId": "microcenterSearch",
        "summary": "Micro Center product search",
        "description": "Search microcenter.com by keywords, with the site's category and attribute filters, sort orders and store selection. Each product has id, SKU, name, brand, category, department, link, image, price, was-price, member savings, open-box price, availability text for the chosen store and the id its reviews are filed under. The response has the total, the filter groups with counts and the value to pass back in `filters` (`facets`), and the list of Micro Center stores. Pass `next_page` back as `page`; it is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/microcenter-search",
        "tags": [
          "Micro Center"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "ssd"
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "Filter values from `facets` (field:value), several separated by ;, e.g. category_flat:SSD (Solid State Drives)|512.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "store_id",
            "in": "query",
            "required": false,
            "description": "3-digit Micro Center store number (the `stores` list in any search answer): prices and stock for that store. Default 131 (Dallas).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "all_items",
            "in": "query",
            "required": false,
            "description": "true: every item Micro Center sells, not only what ships or is stocked for the chosen store.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default relevance).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_low",
                "price_high",
                "top_rated",
                "most_reviewed",
                "newest"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Products per page: 24 (default), 48 or 96.",
            "schema": {
              "type": "integer",
              "enum": [
                "24",
                "48",
                "96"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "ssd",
                  "applied_filters": {
                    "filters": null,
                    "all_items": null,
                    "store_id": "131",
                    "sort": "match"
                  },
                  "total": 849,
                  "page": 1,
                  "count": 24,
                  "items": [
                    {
                      "id": "691300",
                      "sku": "815258",
                      "name": "9100 PRO 2TB Samsung V NAND TLC NAND (V8) PCIe Gen 5 x4 and PCIe Gen 5 x4 NVMe M.2 Internal SSD",
                      "brand": "Samsung",
                      "category": "SSD (Solid State Drives)",
                      "department": "Drives",
                      "url": "https://www.microcenter.com/product/691300/samsung-9100-pro-2tb-samsung-v-nand-tlc-nand-(v8)-pcie-gen-5-x4-and-pcie-gen-5-x4-nvme-m2-interna…",
                      "image": "https://productimages.microcenter.com/0691300_815258.jpg",
                      "price": 399.99,
                      "was_price": 899.99,
                      "member_saving": null,
                      "open_box_price": null,
                      "availability": "25+ IN STOCK at Dallas Store",
                      "highlights": [],
                      "rating_product_id": "0691300",
                      "store_id": "131"
                    },
                    {
                      "id": "661862",
                      "sku": "529776",
                      "name": "TN320 1TB SSD NVMe PCIe Gen 3.0x4 M.2 2280 3D NAND TLC Internal Solid State Drive",
                      "brand": "Inland",
                      "category": "SSD (Solid State Drives)",
                      "department": "Drives",
                      "url": "https://www.microcenter.com/product/661862/inland-tn320-1tb-ssd-nvme-pcie-gen-30x4-m2-2280-3d-nand-tlc-internal-solid-state-drive",
                      "image": "https://productimages.microcenter.com/0661862_529776.jpg",
                      "price": 169.99,
                      "was_price": 399.99,
                      "member_saving": null,
                      "open_box_price": null,
                      "availability": "25+ IN STOCK at Dallas Store",
                      "highlights": [],
                      "rating_product_id": "0661862",
                      "store_id": "131"
                    },
                    "… 22 more"
                  ],
                  "facets": {
                    "Select Category": [
                      {
                        "label": "Laptops/Notebooks",
                        "count": 252,
                        "filter": "category_flat:Laptops/Notebooks|618",
                        "selected": false
                      },
                      {
                        "label": "Desktop Computers",
                        "count": 139,
                        "filter": "category_flat:Desktop Computers|106",
                        "selected": false
                      },
                      "… 44 more"
                    ],
                    "Filter Results": [
                      {
                        "label": "Internal",
                        "count": 97,
                        "filter": "Subcategory:Internal",
                        "selected": false
                      },
                      {
                        "label": "External",
                        "count": 31,
                        "filter": "Subcategory:External",
                        "selected": false
                      },
                      "… 695 more"
                    ]
                  },
                  "stores": {
                    "101": "CA - Tustin",
                    "105": "NY - Yonkers",
                    "115": "NY - Brooklyn",
                    "121": "MA - Cambridge",
                    "125": "MD - Parkville",
                    "131": "TX - Dallas",
                    "141": "OH - Columbus",
                    "145": "NY - Flushing",
                    "151": "IL - Chicago",
                    "155": "TX - Houston",
                    "165": "IN - Indianapolis",
                    "171": "NY - Westbury",
                    "175": "NC - Charlotte",
                    "181": "CO - Denver",
                    "185": "FL - Miami",
                    "191": "KS - Overland Park",
                    "195": "CA - Santa Clara",
                    "205": "AZ - Phoenix",
                    "215": "TX - Austin",
                    "065": "GA - Duluth",
                    "041": "GA - Marietta",
                    "025": "IL - Westmont",
                    "085": "MD - Rockville",
                    "055": "MI - Madison Heights",
                    "045": "MN - St. Louis Park",
                    "095": "MO - Brentwood",
                    "075": "NJ - North Jersey",
                    "051": "OH  - Mayfield Heights",
                    "071": "OH - Sharonville",
                    "061": "PA - St. Davids",
                    "081": "VA - Fairfax"
                  },
                  "next_page": 2,
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Create keys at https://app.api.sh/keys. Authorization: Bearer <key> also works."
      }
    },
    "parameters": {
      "raw": {
        "name": "raw",
        "in": "query",
        "required": false,
        "description": "0 leaves out the bulky `raw` source blocks (often 10-30x smaller).",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Comma-separated fields to return, e.g. `posts.id,posts.title`. Call metadata is always included.",
        "schema": {
          "type": "string"
        }
      },
      "fresh": {
        "name": "fresh",
        "in": "query",
        "required": false,
        "description": "1 skips the 24-hour cache and fetches live.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "output": {
        "name": "output",
        "in": "query",
        "required": false,
        "description": "csv or ndjson returns the response's records (its main list, or the object as one row) as CSV or NDJSON instead of JSON.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "ndjson"
          ]
        }
      },
      "records": {
        "name": "records",
        "in": "query",
        "required": false,
        "description": "With output=csv|ndjson: the top-level list to turn into rows (e.g. `reviews`), or `.` for the whole object as one row.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "On a 503 for a paused endpoint: the status page, which lists open incidents."
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "responses": {
      "E400": {
        "description": "A parameter is missing or invalid. Not charged (unless the call ran and the source rejected the value; credits_used says).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E402": {
        "description": "Not enough credits, a spend limit you set was reached (`spend_limit`), or the key's monthly credit cap was reached (`key_cap`). Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
        "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E502": {
        "description": "The source site failed this time; retry. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E503": {
        "description": "Endpoint paused or temporarily unavailable; may include retry-after, and status_url (https://api.sh/status) for a paused endpoint. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "headers": {
      "x-request-id": {
        "description": "The call's id (logs, re-fetch with /v1/results/{id}).",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "x-credits-used": {
        "description": "Credits charged for this call.",
        "schema": {
          "type": "integer"
        }
      },
      "x-credits-remaining": {
        "description": "Balance after the call.",
        "schema": {
          "type": "integer"
        }
      }
    }
  },
  "externalDocs": {
    "url": "https://api.sh/docs"
  }
}
