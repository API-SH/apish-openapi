          }
        }
      }
    },
    "/croma/v1/search": {
      "get": {
        "operationId": "cromaSearch",
        "summary": "Croma search",
        "description": "Croma search (India): code, name, brand, link, price, MRP, discount, rating and counts, warranty, launch date and image, with every sort, any listed filter and paging, plus the filter lists with counts.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/croma-search",
        "tags": [
          "Croma"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "laptop"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price-asc",
                "price-desc",
                "discount-desc",
                "LatestArrival",
                "topRated"
              ]
            },
            "example": "price-asc"
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Facet filters as code:value; separated by semicolons (codes and values from the filters list), e.g. manufacturer:Apple.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "iphone",
                  "page": 1,
                  "sort": "relevance",
                  "total": 123,
