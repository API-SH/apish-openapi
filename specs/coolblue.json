    "/coolblue/v1/search": {
      "get": {
        "operationId": "coolblueSearch",
        "summary": "Search Coolblue products",
        "description": "Coolblue product search (Netherlands and Belgium): product id, name, brand, link, image, price incl. and excl. VAT, list price, availability, rating (out of 10) and review count, product type and highlights. Many searches lead to a category; those come back with `redirected_to_category` and the category's facets. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/coolblue-search",
