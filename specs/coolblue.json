        "tags": [
          "Coolblue"
        ],
        "x-credits": 2,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The number in a coolblue.nl/product/<id>/… link (e.g. 935113), or the link.",
            "schema": {
              "type": "string"
            },
            "example": "935113"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
