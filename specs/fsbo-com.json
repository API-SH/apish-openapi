      }
    },
    "/fsbo/v1/search": {
      "get": {
        "operationId": "fsboSearch",
        "summary": "FSBO.com homes for sale by owner",
        "description": "US homes for sale by owner on FSBO.com by place or keyword, with price, beds, baths, size, lot size, year built, HOA, home type, open-house, map-box and sort filters. Each result has id, link, headline, description, price, property type, beds, baths, square feet, year built, address with coordinates, status, plan, MLS flag, next open house and photos. Owners' own names and contact details are not returned. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/fsbo-search",
        "tags": [
          "FSBO.com"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, state, ZIP or address text (e.g. \"Austin, TX\", \"Florida\").",
            "schema": {
              "type": "string"
            },
            "example": "Austin, TX"
          },
          {
            "name": "keywords",
            "in": "query",
            "required": false,
            "description": "Words in the listing.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (USD).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price (USD).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "beds_min",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "baths_min",
            "in": "query",
            "required": false,
            "description": "Minimum bathrooms.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sqft_min",
            "in": "query",
            "required": false,
            "description": "Minimum square feet.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sqft_max",
            "in": "query",
            "required": false,
            "description": "Maximum square feet.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "lot_size_min",
            "in": "query",
            "required": false,
            "description": "Minimum lot size (acres).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "year_built_min",
            "in": "query",
            "required": false,
            "description": "Built in or after this year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "hoa_max",
            "in": "query",
            "required": false,
            "description": "Maximum monthly HOA fee (USD; 0 = no HOA).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "home_types",
            "in": "query",
            "required": false,
            "description": "Home types, comma-separated: SINGLE_FAMILY, CONDO, TOWNHOUSE, MULTI_FAMILY, LAND, MOBILE_HOME, OTHER.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "open_house_within",
            "in": "query",
            "required": false,
            "description": "Open house within the next 7, 14 or 28 days.",
            "schema": {
              "type": "string",
              "enum": [
                "7",
                "14",
                "28"
              ]
            }
          },
          {
            "name": "hide_pending",
            "in": "query",
            "required": false,
            "description": "true: leave out homes under contract.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sw_lat",
            "in": "query",
            "required": false,
            "description": "Map box south-west latitude (with sw_lng, ne_lat, ne_lng).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sw_lng",
            "in": "query",
            "required": false,
            "description": "Map box south-west longitude.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "ne_lat",
            "in": "query",
            "required": false,
            "description": "Map box north-east latitude.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "ne_lng",
            "in": "query",
            "required": false,
            "description": "Map box north-east longitude.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "price_asc",
                "price_desc",
                "sqft_desc"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page, 1-100.",
            "schema": {
              "type": "integer"
            },
            "example": "24"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "total": 59,
                  "page": 1,
                  "limit": 24,
                  "total_pages": 3,
                  "count": 24,
                  "next_page": 2,
                  "applied_filters": {
