    "/remoteok/v1/tags": {
      "get": {
        "operationId": "remoteokTags",
        "summary": "Remote OK tags and salaries",
        "description": "The tags (skills and roles) of the jobs in Remote OK's live feed, most jobs first, with the job count and the listed salary range and median per tag; narrow the feed to one tag with `tag`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/remoteok-tags",
        "tags": [
          "Remote OK"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Count within this tag's feed (e.g. dev, design, marketing).",
            "schema": {
              "type": "string"
            },
            "example": "dev"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "tag": "dev",
                  "jobs_in_feed": 99,
                  "count": 134,
                  "tags": [
                    {
                      "tag": "digital nomad",
