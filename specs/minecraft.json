    "/minecraft/v1/versions": {
      "get": {
        "operationId": "minecraftVersions",
        "summary": "Minecraft versions",
        "description": "Every Minecraft Java Edition version, newest first: id, type (release, snapshot, old_beta, old_alpha), release time and last update, with the latest release and snapshot.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/minecraft-versions",
        "tags": [
          "Minecraft"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "all (default), release, snapshot, old_beta or old_alpha.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "release",
                "snapshot",
                "old_beta",
                "old_alpha"
              ]
            },
            "example": "release"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Return only the newest N versions.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
