    "/zappos/v1/reviews": {
      "get": {
        "operationId": "zapposReviews",
        "summary": "Zappos reviews",
        "description": "A Zappos product's reviews: rating, comfort and look ratings, text, author, location, date, helpful votes, verified purchase, size/width/arch fit and photos, with sort, star filter and paging.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/zappos-reviews",
        "tags": [
          "Zappos"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Zappos product id.",
            "schema": {
              "type": "string"
            },
            "example": "9405856"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Product link instead of id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "helpful",
                "newest",
                "oldest",
                "rating_desc",
                "rating_asc"
              ]
            },
            "example": "newest"
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Only reviews with these stars (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page, 1-100 (default 25).",
            "schema": {
              "type": "integer"
            },
            "example": "25"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
