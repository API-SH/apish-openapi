    "/zappos/v1/search": {
      "get": {
        "operationId": "zapposSearch",
        "summary": "Zappos search",
        "description": "Zappos product search: brand, name, colour, link, price, original price, percent off, sale and new flags, rating, review count, gender, units in stock, badges, images by angle, other colours, plus sponsored results and facet counts (brand, colour, gender, category, price, sizes and more). Narrow with `filter` tokens from /zappos/v1/filters.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/zappos-search",
        "tags": [
          "Zappos"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (or a filter token).",
            "schema": {
              "type": "string"
            },
            "example": "boots"
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "A filter token from /zappos/v1/filters or a category path from a product's breadcrumbs, e.g. /filters/boots-adidas/YgEB4gIBDA.zso.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "newest",
                "recently_added",
                "rating",
                "popularity",
                "discount",
                "best_sellers"
              ]
            },
            "example": "price_asc"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Products per page, 1-100 (default 50).",
            "schema": {
              "type": "integer"
            },
            "example": "50"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
