    "/weibo/v1/post": {
      "get": {
        "operationId": "weiboPost",
        "summary": "Weibo post",
        "description": "One Weibo post by link, code or id: full text (long posts included), date, source, region, reposts, comments, likes, images, video, topics, the reposted post and the author.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/weibo-post",
        "tags": [
          "Weibo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A weibo.com/<uid>/<code> post link.",
            "schema": {
              "type": "string"
            },
            "example": "https://weibo.com/2656274875/RoVDyrETK"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The post's code (e.g. RoVDyrETK) or numeric id, instead of `url`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
