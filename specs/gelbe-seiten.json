    "/gelbe-seiten/v1/search": {
      "get": {
        "operationId": "gelbeSeitenSearch",
        "summary": "Gelbe Seiten business search",
        "description": "Businesses on Gelbe Seiten (Germany) for a trade or name in a place: id, name, category, street, postcode and city, distance from the search point, phone, website, rating and review count, open-now flag with the next opening, logo and link. Set a radius around the place, or include related trades. `total` is the number of matches. 50 per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/gelbe-seiten-search",
        "tags": [
          "Gelbe Seiten"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Trade or business name in German, e.g. `zahnarzt`, `bäckerei`, `rechtsanwalt`, `elektriker`.",
            "schema": {
              "type": "string"
            },
            "example": "zahnarzt"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, district or postcode, e.g. `München`, `10115` (leave out for all of Germany).",
            "schema": {
              "type": "string"
            },
            "example": "München"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Radius around the location in km, 1-100 (default: the site's automatic area).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "related",
            "in": "query",
            "required": false,
            "description": "true also returns businesses of related trades.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Businesses per page, 1-50 (default 50).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "zahnarzt",
                  "location": "München",
                  "radius_km": null,
                  "page": 1,
                  "total": 899,
                  "count": 50,
                  "items": [
                    {
                      "id": "7d9caa6e-0619-4e71-92ea-91acdcbbe033",
                      "name": "svea POLACK ZAHNARZT praxis",
                      "url": "https://www.gelbeseiten.de/gsbiz/7d9caa6e-0619-4e71-92ea-91acdcbbe033",
                      "category": "Zahnärzte",
                      "street": "Kirchenstr. 11",
                      "postal_city": "82194 Gröbenzell",
                      "distance_km": 16.4,
                      "phone": "+1 555 010 0000",
                      "website": "https://www.praxis-polack.de/",
                      "rating": 4.9,
                      "reviews_count": 10,
                      "open_now": false,
                      "opening_info": "Geschlossen – Öffnet um 08:00",
                      "logo": "https://ies.v4all.de/200/GS/0120/9/9499/70819499_maxhoehe_100.jpg",
                      "highlight": "Aus der Region"
                    },
                    {
                      "id": "c07dd1c5-2375-4844-8cfc-3f37116377c7",
                      "name": "Weller Rainer Dr. med. dent., Zahnarzt",
                      "url": "https://www.gelbeseiten.de/gsbiz/c07dd1c5-2375-4844-8cfc-3f37116377c7",
                      "category": "Zahnärzte",
                      "street": "Lazarettstr. 2",
                      "postal_city": "80636 München",
                      "distance_km": 2.7,
                      "phone": "+1 555 010 0000",
                      "website": "http://www.praxisweller.de",
                      "rating": 5,
