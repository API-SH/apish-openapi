    "/ssrn/v1/top-papers": {
      "get": {
        "operationId": "ssrnTopPapers",
        "summary": "SSRN top papers by downloads or citations",
        "description": "The most downloaded or most cited papers of an SSRN research network, eJournal or series for a period, as SSRN's own top-papers lists show them. Downloads: last month, last 12 months, this year or all time; citations: last 12 months, this year or all time. Same paper fields as `/ssrn/v1/papers`. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ssrn-top-papers",
        "tags": [
          "SSRN"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "An SSRN research network code (such as `lsn`, `ern`, `fen`; see `/ssrn/v1/networks`), or a numeric SSRN id of a network, eJournal (from `/ssrn/v1/network`) or paper series (the `journal_id` in SSRN links).",
            "schema": {
              "type": "string"
            },
            "example": "fen"
          },
          {
            "name": "by",
            "in": "query",
            "required": false,
            "description": "Rank by downloads or citations (default downloads).",
            "schema": {
              "type": "string",
              "enum": [
                "downloads",
                "citations"
              ]
            },
            "example": "downloads"
          },
          {
            "name": "period",
            "in": "query",
            "required": false,
            "description": "Period: last_month (downloads only), last_12_months, this_year or all_time. Default last_month for downloads, last_12_months for citations.",
            "schema": {
              "type": "string",
              "enum": [
                "last_month",
                "last_12_months",
                "this_year",
                "all_time"
              ]
            },
            "example": "last_12_months"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Papers per page, up to 100 (default 25).",
            "schema": {
              "type": "integer"
            },
            "example": "25"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
