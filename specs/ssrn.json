    "/ssrn/v1/papers": {
      "get": {
        "operationId": "ssrnPapers",
        "summary": "SSRN papers in a network, eJournal or series",
        "description": "Papers posted to an SSRN research network, eJournal or paper series, newest first or sorted by downloads or title, with an optional search inside it. Each paper has its SSRN id and DOI, title, authors (with their SSRN author ids and pages), affiliations, paper type, publication status, reference, page count, posting date and download counts (all time, last month, this year). Pass `next_page` back as `page`; null on the last page. SSRN serves the first 10,000 papers of a list.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ssrn-papers",
        "tags": [
          "SSRN"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "An SSRN research network code (such as `lsn`, `ern`, `fen`; see `/ssrn/v1/networks`), or a numeric SSRN id of a network, eJournal (from `/ssrn/v1/network`) or paper series (the `journal_id` in SSRN links).",
            "schema": {
              "type": "string"
            },
            "example": "lsn"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search within the papers of this network, eJournal or series.",
            "schema": {
              "type": "string"
            },
            "example": "copyright"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default newest).",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest",
                "most_downloaded",
                "least_downloaded",
                "title_asc",
                "title_desc"
              ]
            },
            "example": "newest"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Papers per page, up to 100 (default 25).",
            "schema": {
              "type": "integer"
            },
            "example": "25"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-based).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": 201,
