    "/athome/v1/rentals": {
      "get": {
        "operationId": "athomeRentals",
        "summary": "at home rental search",
        "description": "Rentals on at home (athome.co.jp) in a prefecture or city: `buildings` with `name`, `address`, `access`, `type`, `built`, `photos` and `rooms` (`id`, `room`, `rent`, `management_fee`, `deposit`, `key_money`, `layout`, `area_sqm`, `floor_plan`, `tags`, `url`). 30 buildings a page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/athome-rentals",
        "tags": [
          "at home"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "prefecture",
            "in": "query",
            "required": true,
            "description": "Prefecture in romaji, e.g. `tokyo`, `osaka`, `kanagawa`.",
            "schema": {
              "type": "string"
            },
            "example": "tokyo"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City in romaji as in athome.co.jp links, e.g. `chiyoda`, `shibuya`.",
            "schema": {
              "type": "string"
            },
            "example": "chiyoda"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Instead: any athome.co.jp/chintai/…/list/ link (its filters are kept).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
