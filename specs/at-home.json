          "at home"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Listing id (`rooms[].id` in `/athome/v1/rentals`) or its athome.co.jp/chintai/<id>/ link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "prefecture",
            "in": "query",
            "required": false,
            "description": "Instead of `id`: the first room of an `/athome/v1/rentals` search (prefecture in romaji).",
            "schema": {
              "type": "string"
            }
