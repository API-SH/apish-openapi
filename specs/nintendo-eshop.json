{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Nintendo eShop",
    "version": "1.0.0",
    "description": "The Nintendo eShop API from API.SH: public Nintendo eShop data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Nintendo eShop",
      "description": "3 endpoints (media & music)",
      "x-slug": "nintendo-eshop",
      "x-domains": [
        "nintendo.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/nintendo/v1/game": {
      "get": {
        "operationId": "nintendoGame",
        "summary": "Nintendo eShop game",
        "description": "One game with everything in search, plus live eShop prices for its eShop ids in a country.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/nintendo-game",
        "tags": [
          "Nintendo eShop"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Nintendo game id (from search).",
            "schema": {
              "type": "string"
            },
            "example": "1576884"
          },
          {
            "name": "nsuid",
            "in": "query",
            "required": false,
            "description": "Instead of id: a 14-digit eShop id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Instead of id: the best match for these words.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country for the live price (default GB).",
            "schema": {
              "type": "string"
            },
            "example": "GB"
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Catalogue language (default en).",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "de",
                "fr",
                "es",
                "it",
                "nl",
                "pt",
                "ru"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "765384",
                  "title": "Mario Kart 8",
                  "type": "GAME",
                  "url": "https://www.nintendo.com/en-gb/Games/Wii-U-games/Mario-Kart-8-765384.html",
                  "nsuids": [],
                  "application_id": null,
                  "product_code": "WUPPAMKP",
                  "systems": [
                    "Wii U"
                  ],
                  "system_types": [
                    "wiiu_digitaldistribution",
                    "wiiu_disc"
                  ],
                  "publisher": "Nintendo",
                  "developer": "Nintendo",
                  "release_date": "2014-05-30T00:00:00Z",
                  "release_date_text": "30/05/2014",
                  "genres": [
                    "Party",
                    "Racing"
                  ],
                  "series": "mario_kart",
                  "description": "Mario Kart 8 on Wii U brings antigravity to the world of racing!",
                  "age_rating": "PEGI 3",
                  "age_rating_system": "pegi",
                  "age_rating_value": 3,
                  "players_from": 1,
                  "players_to": 12,
                  "play_modes": {
                    "tv": null,
                    "tabletop": null,
                    "handheld": null
                  },
                  "languages": [
                    "english",
                    "spanish",
                    "… 6 more"
                  ],
                  "size": "7816.50 MB",
                  "price_eur_regular": null,
                  "price_eur_lowest": -1,
                  "discount_percent": 0,
                  "on_sale": null,
                  "digital": false,
                  "physical": true,
                  "demo": false,
                  "cloud_saves": null,
                  "online_play_requires_subscription": false,
                  "voucher_eligible": false,
                  "removed_from_eshop": false,
                  "downloads_rank": null,
                  "copyright": "© 2014 Nintendo",
                  "image": "https://www.nintendo.com/eu/media/images/05_packshots/games_13/wiiu_6/PS_WiiU_MarioKart8_PEGI3_image500w.png",
                  "banner": "https://www.nintendo.com/eu/media/images/10_share_images/games_15/wiiu_14/SI_WiiU_MarioKart8_image500w.jpg",
                  "updated": "2023-03-13T17:46:39Z",
                  "…": "5 more fields",
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/nintendo/v1/prices": {
      "get": {
        "operationId": "nintendoPrices",
        "summary": "Nintendo eShop prices",
        "description": "Live eShop prices for up to 50 eShop ids in any country: regular price, sale price, sale start and end, and sales status.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/nintendo-prices",
        "tags": [
          "Nintendo eShop"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "nsuid",
            "in": "query",
            "required": true,
            "description": "14-digit eShop ids, up to 50 separated by commas.",
            "schema": {
              "type": "string"
            },
            "example": "70010000063714"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country, two letters (default US).",
            "schema": {
              "type": "string"
            },
            "example": "US"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language, two letters (default en).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "country": "US",
                  "count": 1,
                  "prices": [
                    {
                      "nsuid": "70010000063714",
                      "sales_status": "onsale",
                      "regular_price": 69.99,
                      "regular_price_text": "$69.99",
                      "currency": "USD",
                      "sale_price": null,
                      "sale_price_text": null,
                      "sale_start": null,
                      "sale_end": null,
                      "gold_points": 0
                    }
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/nintendo/v1/search": {
      "get": {
        "operationId": "nintendoSearch",
        "summary": "Nintendo eShop search",
        "description": "Games (or DLC) in Nintendo's European catalogue by words, system, genre, publisher, price range (EUR), sale and demo, with every sort: eShop ids, systems, publisher, release date, genres, age rating, players, play modes, languages, size, price and discount.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/nintendo-search",
        "tags": [
          "Nintendo eShop"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (empty: all games).",
            "schema": {
              "type": "string"
            },
            "example": "zelda"
          },
          {
            "name": "system",
            "in": "query",
            "required": false,
            "description": "System, e.g. Nintendo Switch, Nintendo Switch 2.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "description": "Genre, e.g. Action, Adventure, RPG, Puzzle, Platformer.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "publisher",
            "in": "query",
            "required": false,
            "description": "Publisher name.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "on_sale",
            "in": "query",
            "required": false,
            "description": "Only games on sale.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "demo",
            "in": "query",
            "required": false,
            "description": "Only games with a demo.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (EUR).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price (EUR).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "What (default game).",
            "schema": {
              "type": "string",
              "enum": [
                "game",
                "dlc",
                "all"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default relevance with q, else popular).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "popular",
                "newest",
                "oldest",
                "price_asc",
                "price_desc",
                "title",
                "discount"
              ]
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Catalogue language (default en).",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "de",
                "fr",
                "es",
                "it",
                "nl",
                "pt",
                "ru"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page (1-100, default 24).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "zelda",
                  "locale": "en",
                  "sort": "relevance",
                  "type": "game",
                  "applied_filters": {},
                  "total": 54,
                  "page": 1,
                  "limit": 24,
                  "count": 24,
                  "next_page": 2,
                  "games": [
                    {
                      "id": "267464",
                      "title": "The Legend of Zelda",
                      "type": "GAME",
                      "url": "https://www.nintendo.com/en-gb/Games/Game-Boy-Advance/The-Legend-of-Zelda-267464.html",
                      "nsuids": [],
                      "application_id": null,
                      "product_code": null,
                      "systems": [
                        "Game Boy Advance"
                      ],
                      "system_types": [
                        "gameboyadvance_cartridge"
                      ],
                      "publisher": "Nintendo",
                      "developer": "Nintendo",
                      "release_date": "2004-07-09T00:00:00Z",
                      "release_date_text": "09/07/2004",
                      "genres": [
                        "Adventure",
                        "RPG"
                      ],
                      "series": "the_legend_of_zelda",
                      "description": "Discover where it all began with The Legend of Zelda.",
                      "age_rating": "TBD",
                      "age_rating_system": "pegi",
                      "age_rating_value": null,
                      "players_from": 1,
                      "players_to": 1,
                      "play_modes": {
                        "tv": null,
                        "tabletop": null,
                        "handheld": null
                      },
                      "languages": [],
                      "size": null,
                      "price_eur_regular": null,
                      "price_eur_lowest": -1,
                      "discount_percent": 0,
                      "on_sale": null,
                      "digital": false,
                      "physical": true,
                      "demo": false,
                      "cloud_saves": null,
                      "online_play_requires_subscription": false,
                      "voucher_eligible": false,
                      "removed_from_eshop": false,
