            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/firstcry/v1/search": {
      "get": {
        "operationId": "firstcrySearch",
        "summary": "FirstCry search",
        "description": "FirstCry search or category and brand listing (India), 20 per page: id, name, link, price, MRP, discount, FirstCry Club price, rating and review counts, stock, age range, category and image, with every sort and paging, plus the filter lists. Search words are matched to a product category; very broad store-wide words (e.g. \"toys\") need a more specific term or `subcat`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/firstcry-search",
        "tags": [
          "FirstCry"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (or use subcat or brand).",
            "schema": {
              "type": "string"
            },
            "example": "shoes"
          },
          {
            "name": "subcat",
            "in": "query",
            "required": false,
            "description": "Sub-category id (a number).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand id (a number).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type1",
            "in": "query",
            "required": false,
            "description": "Category type id (a number).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "popularity",
                "newest",
                "price-asc",
                "price-desc"
              ]
            },
            "example": "price-asc"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
