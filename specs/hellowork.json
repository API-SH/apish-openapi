    "/hellowork/v1/search": {
      "get": {
        "operationId": "helloworkSearch",
        "summary": "HelloWork job search",
        "description": "French jobs on HelloWork for a keyword and/or location with the result page's filters: contract, date posted, experience, working time and remote, full or part time, employer type, function, sector, radius, minimum salary, offers with a salary, Super recruiter offers and sort. Each job: `id`, `title`, `company`, `url`, `location`, `contract`, `salary` (text, min, max, period), `tags`, `posted`, `logo`, `cover`, `summary`. `facets` lists the codes each filter takes. 30 jobs per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/hellowork-search",
        "tags": [
          "HelloWork"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords. Required unless `location` is given.",
            "schema": {
              "type": "string"
            },
            "example": "développeur"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, department or region.",
            "schema": {
              "type": "string"
            },
            "example": "Paris"
          },
          {
            "name": "contract",
            "in": "query",
            "required": false,
            "description": "Contracts, comma separated (CDI, CDD, Travail_temp, Alternance, Stage, Freelance, Independant, Franchise, Fonctionnaire, Associe, Stage_de_lycee).",
            "schema": {
              "type": "string"
