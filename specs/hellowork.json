    "/hellowork/v1/job": {
      "get": {
        "operationId": "helloworkJob",
        "summary": "HelloWork job details",
        "description": "One HelloWork offer: title, company and its page, location, contract, salary (or HelloWork's estimate), sector, publication date, job family, domain, region, department and city, tags, skills, the job description and the profile sought (HTML and text), benefits, recruitment steps and where to apply. Removed offers answer 404. Give id/url, or q to open the first current result of a search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/hellowork-job",
        "tags": [
          "HelloWork"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Offer id or its hellowork.com/fr-fr/emplois/<id>.html URL (`url` is accepted too).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Instead of id: keywords; opens the first current result of that search (all /hellowork/v1/search filters apply).",
            "schema": {
              "type": "string"
            },
            "example": "comptable"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "With q: city, department or region.",
            "schema": {
              "type": "string"
            },
            "example": "Paris"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
