    "/walgreens/v1/reviews": {
      "get": {
        "operationId": "walgreensReviews",
        "summary": "Walgreens product reviews",
        "description": "Customer reviews of a Walgreens product: the rating summary (average, count, recommended count, star distribution) and each review with rating, title, text, date, nickname, location, recommendation, helpful votes, verified-purchaser and incentivized badges, photos, brand responses and the syndication source when the review comes from the brand's site. Sort and filter by star rating or photos. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/walgreens-reviews",
        "tags": [
          "Walgreens"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Product id (e.g. `prod6347302`) or a walgreens.com product link.",
            "schema": {
              "type": "string"
            },
            "example": "prod6347302"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevant",
                "newest",
                "oldest",
                "highest",
                "lowest",
                "helpful"
              ]
            }
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Only reviews with this many stars (1 to 5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "photos",
            "in": "query",
            "required": false,
            "description": "`true`: only reviews with photos.",
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page (default 20, up to 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "product": {
                    "id": "prod6347302",
                    "name": "Extra White Toothpaste",
                    "brand": "Crest Pro-Health Advanced",
                    "image": "http://pics.walgreens.com/prodimg/592342/155.jpg",
                    "rating": 4.57,
                    "review_count": 523,
                    "recommended_count": 6,
                    "rating_distribution": {
                      "1": 20,
                      "2": 5,
                      "3": 18,
                      "4": 94,
                      "5": 386
                    }
                  },
                  "sort": "relevant",
                  "applied_filters": {},
                  "page": 1,
                  "limit": 20,
                  "total": 523,
                  "count": 20,
                  "next_page": 2,
                  "reviews": [
                    {
                      "id": "415021396",
                      "rating": 5,
                      "title": null,
                      "text": null,
                      "submitted_at": "2026-10-17T17:55:24.000+00:00",
                      "author": null,
                      "location": null,
                      "recommended": null,
                      "helpful_yes": 0,
                      "helpful_no": 0,
                      "verified_purchaser": true,
                      "incentivized": false,
