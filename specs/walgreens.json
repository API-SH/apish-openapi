    "/walgreens/v1/product": {
      "get": {
        "operationId": "walgreensProduct",
        "summary": "Walgreens product",
        "description": "One Walgreens product by id or link: name, brand, size, product type, the category path, price (`regular_price`, `sale_price`, savings, `unit_price`), the current deal (e.g. Buy 1, Get 1), rewards and rebate offers with their dates, online stock and delivery options, clearance and new-item flags, FSA/EBT eligibility, GTIN/UPC, rating and review count, the full description, ingredients (active and inactive), warnings, shipping weight, dimensions and restricted states, and every product image. Pass `store` (a store number from /walgreens/v1/stores) to read pickup for that store. `raw` has the site's record.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/walgreens-product",
        "tags": [
          "Walgreens"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Product id (e.g. `prod6347302` or `300433857`, `id` in autocomplete results) or a walgreens.com product link.",
            "schema": {
              "type": "string"
            },
            "example": "prod6347302"
          },
          {
            "name": "store",
            "in": "query",
            "required": false,
            "description": "Walgreens store number (`id` from /walgreens/v1/stores) for that store's pickup status.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
