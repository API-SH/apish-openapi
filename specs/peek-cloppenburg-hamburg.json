    "/peek-cloppenburg-hamburg/v1/search": {
      "get": {
        "operationId": "peekCloppenburgHamburgSearch",
        "summary": "Peek & Cloppenburg Hamburg product search",
        "description": "Search the Peek & Cloppenburg Hamburg shop (peek-und-cloppenburg.de, Germany): every product (one per colour) with its product id, style number, brand, price and price before discount in EUR, discount, available and sold-out sizes, colours with their ids, labels, product facts and images, plus the shop's filters with counts. The shop's sort and every filter it offers. 60 a page: pass `next_page` as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/peek-cloppenburg-hamburg-search",
        "tags": [
          "Peek & Cloppenburg Hamburg"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keywords, e.g. mantel or levis 501.",
            "schema": {
              "type": "string"
            },
            "example": "mantel"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), popular, price_asc, price_desc, newest.",
