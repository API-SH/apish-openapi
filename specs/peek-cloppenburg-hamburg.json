    "/peek-cloppenburg-hamburg/v1/category": {
      "get": {
        "operationId": "peekCloppenburgHamburgCategory",
        "summary": "Peek & Cloppenburg Hamburg category listing",
        "description": "The products of one shop category with the same fields, filters, sort and paging as search, plus the category's subcategories. Pass a category id from /peek-cloppenburg-hamburg/v1/categories (e.g. 201009) or a shop category link.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/peek-cloppenburg-hamburg-category",
        "tags": [
          "Peek & Cloppenburg Hamburg"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "description": "A category id (e.g. 201009 for women's coats) or a shop link such as https://www.peek-und-cloppenburg.de/cat/201009/maentel/.",
            "schema": {
              "type": "string"
            },
            "example": "201009"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), popular, price_asc, price_desc, newest.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "popular",
                "price_asc",
                "price_desc",
                "newest"
              ]
            }
          },
          {
            "name": "gender",
            "in": "query",
            "required": false,
            "description": "women, men, girls or boys (Damen, Herren, Mädchen, Jungen).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand filter, comma = any of (brand names as in `filters`, e.g. Marc Cain, Levi's).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Size filter, comma = any of (S, M, 38, 32/32, ...; values in `filters`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "color",
            "in": "query",
            "required": false,
            "description": "Colour filter, comma = any of (schwarz, blau, beige, braun, grau, weiß, ...; values in `filters`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "material",
            "in": "query",
            "required": false,
            "description": "Material filter (Wolle, Baumwolle, Leder, ...; values in `filters`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pattern",
            "in": "query",
            "required": false,
            "description": "Pattern filter (values in `filters`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "occasion",
            "in": "query",
            "required": false,
            "description": "Occasion filter (Business, Outdoor, Party, ...; values in `filters`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sale",
            "in": "query",
            "required": false,
            "description": "true: reduced items only.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Lowest price in EUR.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Highest price in EUR.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Any other filter as name:value (names and values from `filters`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (60 products a page).",
            "schema": {
              "type": "integer"
