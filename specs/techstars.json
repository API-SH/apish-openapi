    "/techstars/v1/companies": {
      "get": {
        "operationId": "techstarsCompanies",
        "summary": "Techstars portfolio search",
        "description": "Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/techstars-companies",
        "tags": [
          "Techstars"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Free text over name, description, city, state, country, region, program and vertical, e.g. `ai`. Leave out for the whole portfolio.",
            "schema": {
              "type": "string"
            },
            "example": "ai"
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "World region(s), comma-separated: Americas, Europe, Asia, Africa, Oceania, Middle East.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subregion",
            "in": "query",
            "required": false,
            "description": "World subregion(s), e.g. `North America` or `Western Europe`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "vertical",
            "in": "query",
            "required": false,
            "description": "Vertical(s) as in the facet list, e.g. `Fintech` or `Healthtech`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "program",
            "in": "query",
            "required": false,
            "description": "Program name(s) as in the facet list, e.g. `Techstars London Accelerator`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "program_slug",
            "in": "query",
            "required": false,
            "description": "Program slug(s), e.g. `boston` or `london`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year_from",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_to",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "exit",
            "in": "query",
            "required": false,
            "description": "Only exited companies (true) or only not exited (false).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "unicorn",
            "in": "query",
            "required": false,
            "description": "Only companies valued at $1B or more.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "accelerator",
            "in": "query",
            "required": false,
            "description": "Only companies that went through an accelerator program.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "current",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "network",
            "in": "query",
            "required": false,
            "description": "Only network (non-accelerator) companies.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "newest",
                "oldest",
                "updated"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
