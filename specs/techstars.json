    "/techstars/v1/events": {
      "get": {
        "operationId": "techstarsEvents",
        "summary": "Techstars events",
        "description": "Techstars events (Startup Weekend, Startup Week, demo days and more): title, type, in-person or online, location, start and end dates and the event link. Upcoming events by default, soonest first; `upcoming=false` lists past events, newest first. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/techstars-events",
        "tags": [
          "Techstars"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Free text over title and location, e.g. `startup weekend` or `London`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "upcoming",
            "in": "query",
            "required": false,
            "description": "true (default) for upcoming events, false for past ones.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Results per page, 1-100 (default 24).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
