    "/ceneo/v1/search": {
      "get": {
        "operationId": "ceneoSearch",
        "summary": "Ceneo product search and category listings",
        "description": "Search Ceneo (Poland's price comparison site) or browse a category, brand or filtered listing with every filter the site offers: the answer lists each filter group (offer types, price bands, brands and the category's specifications) with options, counts and the `path` to pass back to apply one. Sort by relevance, popularity, price or rating. Each product: id, name, link, brand, category id, lowest price, rating, review count, number of shops and offers, free-delivery flag, variants, recent purchases, image and key parameters. 30 per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ceneo-search",
        "tags": [
          "Ceneo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search keywords.",
            "schema": {
              "type": "string"
            },
            "example": "iphone 15"
          },
          {
            "name": "path",
            "in": "query",
            "required": false,
            "description": "A category or filter path (e.g. /Smartfony or a filter option's `path`), or a Ceneo listing link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "popular",
                "price_asc",
                "price_desc",
                "rating"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (from `next_page`).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
