    "/vagas/v1/search": {
      "get": {
        "operationId": "vagasSearch",
        "summary": "Search jobs in Brazil",
        "description": "VAGAS.com.br job search by keywords and city, sorted by relevance or newest, 40 jobs a page (pass `next_page` back as `page`): title, id, company, level, openings, summary, location, posting date, company logo and link, plus the total and the counts of the site's filters (work model, contract, state, level, area, benefits).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/vagas-search",
        "tags": [
          "Vagas"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Job title or keywords (e.g. desenvolvedor, analista financeiro, enfermeiro).",
            "schema": {
              "type": "string"
            },
            "example": "desenvolvedor"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City (e.g. sao-paulo, rio-de-janeiro, belo-horizonte).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default) or newest.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1-100 (40 jobs a page). Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
