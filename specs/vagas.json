    "/vagas/v1/job": {
      "get": {
        "operationId": "vagasJob",
        "summary": "VAGAS.com.br job ad",
        "description": "One job ad: title, full description, company and its logo, locations, employment type, posting and closing dates, salary when given, openings and link. Pass id or url, or q to open the first current result of that search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/vagas-job",
        "tags": [
          "Vagas"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job id (e.g. 2839391).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Job URL instead of id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords: opens the first current job of that search.",
            "schema": {
              "type": "string"
            },
            "example": "desenvolvedor"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
