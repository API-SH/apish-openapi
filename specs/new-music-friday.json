      "get": {
        "operationId": "newmusicfridayWeeks",
        "summary": "New Music Friday weeks",
        "description": "The release weeks New Music Friday lists on its home page (about the last 50, newest first), each with its date and label, plus the latest week with releases in each genre and the genre list. Pass a week to /newmusicfriday/v1/releases as `date`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/newmusicfriday-weeks",
