{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: GoDaddy Auctions",
    "version": "1.0.0",
    "description": "The GoDaddy Auctions API from API.SH: public GoDaddy Auctions data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "GoDaddy Auctions",
      "description": "2 endpoints (e-commerce)",
      "x-slug": "godaddy-auctions",
      "x-domains": [
        "auctions.godaddy.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/godaddy-auctions/v1/feeds": {
      "get": {
        "operationId": "godaddyAuctionsFeeds",
        "summary": "GoDaddy auction feeds",
        "description": "The GoDaddy Auctions listing feeds: each feed this API reads (with its title, last update time and size) and every inventory file GoDaddy publishes, with size, update time and download link.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/godaddy-auctions-feeds",
        "tags": [
          "GoDaddy Auctions"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "count": 6,
                  "feeds": [
                    {
                      "feed": "most_active",
                      "title": "Most active listings",
                      "updated_at": "2026-11-05T15:04:01Z",
                      "file_size_bytes": 209732
                    },
                    {
                      "feed": "top_traffic",
                      "title": "Listings with parking traffic",
                      "updated_at": "2026-11-05T15:05:02Z",
                      "file_size_bytes": 90301
                    },
                    "… 4 more"
                  ],
                  "files": [
                    {
                      "name": "5_letter_auctions.json.zip",
                      "size_bytes": 2345950,
                      "updated_at": "2026-11-05T15:01:06Z",
                      "url": "https://inventory.auctions.godaddy.com/5_letter_auctions.json.zip"
                    },
                    {
                      "name": "5_letter_auctions.xml.zip",
                      "size_bytes": 2711735,
                      "updated_at": "2026-11-05T15:01:06Z",
                      "url": "https://inventory.auctions.godaddy.com/5_letter_auctions.xml.zip"
                    },
                    "… 36 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/godaddy-auctions/v1/listings": {
      "get": {
        "operationId": "godaddyAuctionsListings",
        "summary": "GoDaddy domain auction listings",
        "description": "Domain names in GoDaddy Auctions from the listing feeds GoDaddy publishes for domain investors: most active, recently added, ending today, ending tomorrow, five-letter names and listings with parking traffic. Each domain has auction type, price, number of bids, end time, age, GoDaddy valuation, monthly parking pageviews and revenue, the seller's description and SEO metrics (Majestic trust and citation flow, backlinks, referring domains; Semrush authority score, backlinks, search volume and CPC; Estibot exact-match and keyword counts). Filter by text in the name, TLD, auction type, price, bids, age, valuation, pageviews, name length, digits, hyphens and end time, and sort by any of these. The feeds are rebuilt once a day (`built_at`); bids and prices move between builds. `total` counts all matches when a sort is applied. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/godaddy-auctions-listings",
        "tags": [
          "GoDaddy Auctions"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "feed",
            "in": "query",
            "required": false,
            "description": "most_active (default), top_traffic, recent, ending_today, ending_tomorrow or five_letter.",
            "schema": {
              "type": "string",
              "enum": [
                "most_active",
                "top_traffic",
                "recent",
                "ending_today",
                "ending_tomorrow",
                "five_letter"
              ]
            },
            "example": "most_active"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Text the name (before the dot) must contain.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tld",
            "in": "query",
            "required": false,
            "description": "Extension(s), comma-separated, e.g. com,net.",
            "schema": {
              "type": "string"
            },
            "example": "com"
          },
          {
            "name": "auction_type",
            "in": "query",
            "required": false,
            "description": "Auction type as listed, e.g. Bid, BuyNow, Offer.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum price in USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum price in USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_bids",
            "in": "query",
            "required": false,
            "description": "Minimum number of bids.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_age",
            "in": "query",
            "required": false,
            "description": "Minimum domain age in years.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_age",
            "in": "query",
            "required": false,
            "description": "Maximum domain age in years.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_valuation",
            "in": "query",
            "required": false,
            "description": "Minimum GoDaddy valuation in USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_pageviews",
            "in": "query",
            "required": false,
            "description": "Minimum monthly parking pageviews.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_length",
            "in": "query",
            "required": false,
            "description": "Minimum name length (before the dot).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_length",
            "in": "query",
            "required": false,
            "description": "Maximum name length.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "no_digits",
            "in": "query",
            "required": false,
            "description": "true: names without digits.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "no_hyphens",
            "in": "query",
            "required": false,
            "description": "true: names without hyphens.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "include_adult",
            "in": "query",
            "required": false,
            "description": "true: include domains the feed marks as adult (left out by default).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "ends_after",
            "in": "query",
            "required": false,
            "description": "Only auctions ending at or after this ISO time.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "ends_before",
            "in": "query",
            "required": false,
            "description": "Only auctions ending before this ISO time.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "price, bids, end_time, valuation, age, pageviews, backlinks, authority, trust_flow, search_volume or length (default: feed order).",
            "schema": {
              "type": "string",
              "enum": [
                "price",
                "bids",
                "end_time",
                "valuation",
                "age",
                "pageviews",
                "backlinks",
                "authority",
                "trust_flow",
                "search_volume",
                "length"
              ]
            },
            "example": "bids"
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "asc or desc (default desc; asc for price, end_time and length).",
            "schema": {
              "type": "string",
              "enum": [
                "asc",
                "desc"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Domains per page, 1-100 (default 50).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "feed": "most_active",
                  "feed_title": "Go Daddy Auctions - Most Active Listings",
                  "built_at": "2026-11-05T14:03:16Z",
                  "applied_filters": {
