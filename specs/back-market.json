            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (optional when a filter or category is given).",
            "schema": {
              "type": "string"
            },
            "example": "iphone 13"
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Facet filters as `name:value` from `facets[].values[].filter` (e.g. backbox_grade:10 Excellent); several separated by |.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Only this category (e.g. Smartphones, Laptops, Tablets).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum price.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum price.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: relevance (default, best sellers first), price_asc, price_desc.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc"
              ]
