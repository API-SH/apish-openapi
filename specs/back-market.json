    "/backmarket/v1/search": {
      "get": {
        "operationId": "backmarketSearch",
        "summary": "Search Back Market refurbished products",
        "description": "Back Market refurbished-product search in every Back Market country (see `country`): product id, title, brand, model, category, colour, condition (grade), price, price when new, rating and review count, stock, warranty, seller id, offer id, image, links, durability/performance/camera/screen scores and tags. `facets` lists every filter for the query (brand, model, condition, storage, colour, carrier, year, shipping time and more) with counts and a ready `filter` value; `price_stats` gives the price range. Without `q`, a `filter` or `category` lists everything that matches. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/backmarket-search",
