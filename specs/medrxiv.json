    "/medrxiv/v1/published": {
      "get": {
        "operationId": "medrxivPublished",
        "summary": "medRxiv preprints published in journals",
        "description": "Preprints that appeared in a journal in a date window: preprint DOI, title, authors, category and date, and the journal, journal DOI and publication date. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/medrxiv-published",
        "tags": [
          "medRxiv"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "The last N days (default 30, max 366), when from/to are not given.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Start date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "End date (YYYY-MM-DD; default today).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Subject category (see /medrxiv/v1/categories), e.g. infectious diseases.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pass `next_cursor` back; null on the last page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "from": "2026-10-08",
                  "to": "2026-11-06",
                  "category": null,
                  "cursor": "0",
                  "count": 58,
                  "total": 58,
                  "next_cursor": null,
                  "items": [
