          "medRxiv"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "doi",
            "in": "query",
            "required": true,
            "description": "Preprint DOI or a medrxiv.org link.",
            "schema": {
              "type": "string"
            },
            "example": "10.1101/2020.02.18.20024364"
