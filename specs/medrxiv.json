    "/medrxiv/v1/recent": {
      "get": {
        "operationId": "medrxivRecent",
        "summary": "medRxiv preprints by date",
        "description": "Preprints posted in a date window (and new versions), optionally in one subject category: DOI, version, title, authors, corresponding author and institution, date, category, type, license, abstract and published DOI. 30 per page with the total. Pass `next_cursor` back as `cursor`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/medrxiv-recent",
        "tags": [
          "medRxiv"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "The last N days (default 7, max 366), when from/to are not given.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "from",
            "in": "query",
            "required": false,
            "description": "Start date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "to",
            "in": "query",
            "required": false,
            "description": "End date (YYYY-MM-DD; default today).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Subject category (see /medrxiv/v1/categories), e.g. infectious diseases.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pass `next_cursor` back; null on the last page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
