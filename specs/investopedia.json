                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "letter": "a",
                  "url": "https://www.investopedia.com/terms-beginning-with-a-4769351",
                  "count": 300,
                  "terms": [
                    {
                      "term": "A-B Trust",
                      "url": "https://www.investopedia.com/terms/a/a-b-trust.asp",
                      "slug": "a/a-b-trust"
                    },
                    {
                      "term": "A-Shares",
                      "url": "https://www.investopedia.com/terms/a/a-shares.asp",
                      "slug": "a/a-shares"
                    },
                    "… 298 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
