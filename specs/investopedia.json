    "/investopedia/v1/search": {
      "get": {
        "operationId": "investopediaSearch",
        "summary": "Investopedia search",
        "description": "Search Investopedia's terms, articles and answers: title, link, type, topic tag, author and image, 24 per page. Pass `next_offset` back as `offset`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/investopedia-search",
        "tags": [
          "Investopedia"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "etf"
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Results to skip, a multiple of 24 (the `next_offset` of the previous page).",
            "schema": {
              "type": "integer"
