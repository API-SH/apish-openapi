          "Lever"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "description": "The board name in jobs.lever.co/<company>, or a Lever board or posting link.",
            "schema": {
              "type": "string"
            },
            "example": "spotify"
