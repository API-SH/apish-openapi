    "/lever/v1/jobs": {
      "get": {
        "operationId": "leverJobs",
        "summary": "Lever job board",
        "description": "Open jobs on a company's Lever job board, newest first, with full descriptions and lists (responsibilities, requirements). Lever filters by `team`, `department`, `location`, `commitment` and `level` (exact names as the board shows them). Pages are `per_page` jobs; pass `next_page` back as `page`, null on the last page. Each job: `id`, `title`, `department`, `team`, `location`, `locations`, `workplace_type`, `remote`, `employment_type`, `compensation` (summary, min, max, currency, interval) when the company publishes it, `posted_at`, `updated_at`, `description_html` and `description` (plain text) when included, `apply_url`, `url` and `raw` (the board's own record). The same shape on every job board endpoint.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/lever-jobs",
        "tags": [
          "Lever"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "description": "The company's Lever board name (the part after the host in its job board URL), or that URL.",
            "schema": {
              "type": "string"
            },
            "example": "palantir"
          },
          {
            "name": "team",
            "in": "query",
            "required": false,
            "description": "Team name, exactly as on the board.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Department name, exactly as on the board.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Location name, exactly as on the board.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "commitment",
            "in": "query",
            "required": false,
            "description": "Commitment, e.g. `Full-time`, `Intern`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "level",
            "in": "query",
            "required": false,
            "description": "Level, where the board uses levels.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Jobs per page (default 20, max 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "company": "palantir",
                  "board_url": "https://jobs.lever.co/palantir",
                  "count": 20,
                  "page": 1,
                  "per_page": 20,
                  "next_page": 2,
