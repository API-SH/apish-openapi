{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Wizz Air",
    "version": "1.0.0",
    "description": "The Wizz Air API from API.SH: public Wizz Air data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Wizz Air",
      "description": "6 endpoints (travel & events)",
      "x-slug": "wizz-air",
      "x-domains": [
        "wizzair.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/wizzair/v1/airports": {
      "get": {
        "operationId": "wizzairAirports",
        "summary": "Wizz Air airports",
        "description": "Every airport Wizz Air flies to or from: code, name, country, currency, coordinates, city group (several airports of one city), aliases, rank and the number of destinations served. Filter by text or country.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wizzair-airports",
        "tags": [
          "Wizz Air"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Text to match in the code, name, country or aliases, e.g. `london`.",
            "schema": {
              "type": "string"
            },
            "example": "london"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country code or name, e.g. `HU`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "count": 2,
                  "airports": [
                    {
                      "code": "LTN",
                      "name": "London Luton",
                      "country": "United Kingdom",
                      "country_code": "GB",
                      "currency": "GBP",
                      "lat": 51.874722222222225,
                      "lng": -0.3683333333333333,
                      "city_group": "LON",
                      "aliases": [
                        "London Luton"
                      ],
                      "rank": 1,
                      "categories": [
                        1,
                        2,
                        "… 3 more"
                      ],
                      "destinations_count": 165
                    },
                    {
                      "code": "LGW",
                      "name": "London Gatwick",
                      "country": "United Kingdom",
                      "country_code": "GB",
                      "currency": "GBP",
                      "lat": 51.14805555555556,
                      "lng": -0.19027777777777777,
                      "city_group": "LON",
                      "aliases": [
                        "London Gatwick"
                      ],
                      "rank": 2,
                      "categories": [
                        1,
                        2,
                        "… 3 more"
                      ],
                      "destinations_count": 109
                    }
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/wizzair/v1/fare-chart": {
      "get": {
        "operationId": "wizzairFareChart",
        "summary": "Wizz Air fare chart around a date",
        "description": "The Wizz Air fare chart the booking page shows around a chosen day: the lowest fare of each day from `day_interval` days before to `day_interval` days after, with the fare class, for one way or a return trip (`return_date` or `return_days`). Routes Wizz Air does not fly answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wizzair-fare-chart",
        "tags": [
          "Wizz Air"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Departure airport code (IATA).",
            "schema": {
              "type": "string"
            },
            "example": "LTN"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Arrival airport code (IATA).",
            "schema": {
              "type": "string"
            },
            "example": "BUD"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Departure day, YYYY-MM-DD. Give this or `days_ahead`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days_ahead",
            "in": "query",
            "required": false,
            "description": "Departure day as days from today (0-365), when `date` is not given.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "return_date",
            "in": "query",
            "required": false,
            "description": "Return day (YYYY-MM-DD) for a return chart.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return_days",
            "in": "query",
            "required": false,
            "description": "Return day as days after the departure day.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "day_interval",
            "in": "query",
            "required": false,
            "description": "Days shown on each side of the chosen day (3-10, default 7).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_type",
            "in": "query",
            "required": false,
            "description": "`regular` (default) or `wdc`.",
            "schema": {
              "type": "string",
              "enum": [
                "regular",
                "wdc"
              ]
            }
          },
          {
            "name": "adults",
            "in": "query",
            "required": false,
            "description": "Adults (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "children",
            "in": "query",
            "required": false,
            "description": "Children (default 0).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "from": "LTN",
                  "to": "BUD",
                  "date": "2026-12-21",
                  "return_date": null,
                  "day_interval": 7,
                  "count": 15,
                  "days": [
                    {
                      "date": "2026-12-14",
                      "price": {
                        "amount": 51.99,
                        "currency": "GBP"
                      },
                      "price_type": "price",
                      "fare_class": "B",
                      "city_group_airport": false
                    },
                    {
                      "date": "2026-12-15",
                      "price": {
                        "amount": 77.99,
                        "currency": "GBP"
                      },
                      "price_type": "price",
                      "fare_class": "K",
                      "city_group_airport": false
                    },
                    "… 13 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/wizzair/v1/fares": {
      "get": {
        "operationId": "wizzairFares",
        "summary": "Wizz Air cheapest fare per day",
        "description": "The lowest Wizz Air fare of each day on a route between `date_from` and `date_to` (up to 92 days a call), with every departure time that day, the regular or Wizz Discount Club price, the original price and the cheapest day. Add `return=1` for the return direction too. Prices are in the departure airport's currency, for the passengers given. Routes Wizz Air does not fly answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wizzair-fares",
        "tags": [
          "Wizz Air"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Departure airport code (IATA).",
            "schema": {
              "type": "string"
            },
            "example": "LTN"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Arrival airport code (IATA).",
            "schema": {
              "type": "string"
            },
            "example": "BUD"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "description": "First day (YYYY-MM-DD). Default today.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days_ahead",
            "in": "query",
            "required": false,
            "description": "First day as days from today (0-365), when `date_from` is not given.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "description": "Last day (YYYY-MM-DD). Default 30 days after the first day.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return",
            "in": "query",
            "required": false,
            "description": "`1` to also return the fares of the way back.",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "price_type",
            "in": "query",
            "required": false,
            "description": "`regular` (default) or `wdc` (Wizz Discount Club prices).",
            "schema": {
              "type": "string",
              "enum": [
                "regular",
                "wdc"
              ]
            }
          },
          {
            "name": "adults",
            "in": "query",
            "required": false,
            "description": "Adults (1-25, default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "children",
            "in": "query",
            "required": false,
            "description": "Children (default 0).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "infants",
            "in": "query",
            "required": false,
            "description": "Infants (default 0).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "from": {
                    "code": "LTN",
                    "name": "London Luton",
                    "country": "United Kingdom",
                    "country_code": "GB"
                  },
                  "to": {
                    "code": "BUD",
                    "name": "Budapest",
                    "country": "Hungary",
                    "country_code": "HU"
                  },
                  "date_from": "2026-12-06",
                  "date_to": "2027-01-05",
                  "price_type": "regular",
                  "passengers": {
                    "adults": 1,
                    "children": 0,
                    "infants": 0
                  },
                  "count": 31,
                  "cheapest": {
                    "date": "2026-12-31",
                    "price": {
                      "amount": 30.99,
                      "currency": "GBP"
                    },
                    "original_price": {
                      "amount": 30.99,
                      "currency": "GBP"
                    },
                    "price_type": "price",
                    "departures": [
                      "2026-12-31T08:30:00",
                      "2026-12-31T11:00:00",
                      "… 2 more"
                    ],
                    "flights": 4,
                    "city_group_airport": true
                  },
                  "days": [
                    {
                      "date": "2026-12-06",
                      "price": {
                        "amount": 48.99,
                        "currency": "GBP"
                      },
                      "original_price": {
                        "amount": 48.99,
                        "currency": "GBP"
                      },
                      "price_type": "price",
                      "departures": [
                        "2026-12-06T08:30:00",
                        "2026-12-06T11:00:00",
                        "… 2 more"
                      ],
                      "flights": 4,
                      "city_group_airport": true
                    },
                    {
                      "date": "2026-12-07",
                      "price": {
                        "amount": 48.99,
                        "currency": "GBP"
                      },
                      "original_price": {
                        "amount": 48.99,
                        "currency": "GBP"
                      },
                      "price_type": "price",
                      "departures": [
                        "2026-12-07T08:30:00",
                        "2026-12-07T11:10:00",
                        "… 1 more"
                      ],
                      "flights": 3,
                      "city_group_airport": true
                    },
                    "… 29 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
