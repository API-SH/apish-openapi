    "/neimanmarcus/v1/search": {
      "get": {
        "operationId": "neimanmarcusSearch",
        "summary": "Neiman Marcus search",
        "description": "Products for a keyword search on Neiman Marcus: name, designer, price and original price (sale), price label, color, badge, promotions, pre-order, ids, link and images, 60 per page, plus the filter groups with counts and the sort options. Pass `next_page` back as `page`; it is null on the last page. Filter with `filter=Group:value` copied from `filters[].values[].filter`. When the site answers a keyword with a category page (e.g. a designer and product type), the response carries that page's first products and `redirected_to`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/neimanmarcus-search",
        "tags": [
          "Neiman Marcus"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keywords.",
            "schema": {
              "type": "string"
            },
            "example": "silk scarf"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default best_match).",
            "schema": {
              "type": "string",
              "enum": [
                "best_match",
                "price_desc",
                "price_asc",
                "newest",
                "best_sellers"
              ]
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "A filter value as `Group:value`, copied from `filters[].values[].filter` (for example `Designer:Etro`). Repeat for more filters (up to 15).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "silk scarf",
                  "page": 1,
                  "sort": "best_match",
                  "applied_filters": {},
                  "total": 550,
                  "total_pages": 10,
                  "count": 60,
                  "next_page": 2,
                  "sorts": [
                    {
                      "name": "Price: high to low",
                      "value": "price_desc",
                      "selected": false
                    },
                    {
