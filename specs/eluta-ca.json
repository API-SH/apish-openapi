{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Eluta.ca",
    "version": "1.0.0",
    "description": "The Eluta.ca API from API.SH: public Eluta.ca data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Eluta.ca",
      "description": "3 endpoints (jobs & b2b)",
      "x-slug": "eluta-ca",
      "x-domains": [
        "eluta.ca"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/eluta/v1/employer/jobs": {
      "get": {
        "operationId": "elutaEmployerJobs",
        "summary": "Eluta.ca employer jobs",
        "description": "Every job Eluta.ca lists for one employer, with the search filters (sort, remote, salary, job level, category, radius). Each job: `id`, `title`, `url`, `employer`, `employer_url`, `top_employer` (and its review link), `location`, `salary` with `salary_min`/`salary_max`/`salary_period` when the ad shows pay, `snippet`, `last_seen` (when the site last found the ad), `source` (the employer site the ad was read from) and `apply_url`. `total` is the employer's job count. Pass `next_page` back as `page`; null on the last page. Unknown employers answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/eluta-employer-jobs",
        "tags": [
          "Eluta.ca"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "employer",
            "in": "query",
            "required": true,
            "description": "The employer's eluta.ca/jobs-at-<employer> link (`employer_url` in search results) or the part after `jobs-at-`.",
            "schema": {
              "type": "string"
            },
            "example": "atkinsréalis"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Kilometres around `location` (the site's default is 50).",
            "schema": {
              "type": "integer",
              "enum": [
                "5",
                "10",
                "25",
                "50",
                "100",
                "200"
              ]
            }
          },
          {
            "name": "remote",
            "in": "query",
            "required": false,
            "description": "`only`: remote jobs; `onsite`: on-site jobs.",
            "schema": {
              "type": "string",
              "enum": [
                "only",
                "onsite"
              ]
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "required": false,
            "description": "Minimum yearly salary in CAD.",
            "schema": {
              "type": "integer",
              "enum": [
                "40000",
                "60000",
                "80000",
                "100000",
                "120000",
                "140000"
              ]
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "Job level or type.",
            "schema": {
              "type": "string",
              "enum": [
                "full_time",
                "part_time",
                "entry_level",
                "internship",
                "seasonal"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A category as listed in `refine.categories`, e.g. `Engineering - Civil`, `Computing - Software & Web Development`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default `relevance`).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "date",
                "popularity",
                "distance"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1-100 (10 jobs a page). Pass `next_page` back; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "employer": "AtkinsRéalis Canada",
                  "url": "https://www.eluta.ca/jobs-at-atkinsr%C3%A9alis",
                  "applied_filters": {},
                  "total": 727,
                  "total_is_estimate": false,
                  "page": 1,
                  "count": 10,
                  "next_page": 2,
                  "jobs": [
                    {
                      "id": "c94aa75919789b9502805720e808fb77",
                      "title": "New Graduate, Geotechnical Engineering",
                      "url": "https://www.eluta.ca/spl/new-graduate-geotechnical-engineering-c94aa75919789b9502805720e808fb77",
                      "employer": "AtkinsRéalis Canada Inc.",
                      "employer_url": null,
                      "top_employer": true,
                      "top_employer_url": "https://reviews.canadastop100.com/top-employer-atkinsréalis",
                      "location": "Toronto ON",
                      "salary": "$61,900 - $80,000",
                      "salary_min": 61900,
                      "salary_max": 80000,
                      "salary_period": "year",
                      "snippet": "Job Description Overview Kickstart your career with our Odyssey Program! Please note that this job posting is intended for you to express yo…",
                      "last_seen": "1 hour ago",
                      "source": "slihrms.wd3.myworkdayjobs.com",
                      "apply_url": "https://www.eluta.ca/direct/i?i=c94aa75919789b9502805720e808fb77"
                    },
                    {
                      "id": "7ddbb965993ac671ad8f3f76506b92be",
                      "title": "Manager, Alberta, Electrical",
                      "url": "https://www.eluta.ca/spl/manager-alberta-electrical-7ddbb965993ac671ad8f3f76506b92be",
                      "employer": "AtkinsRéalis Canada Inc.",
                      "employer_url": null,
                      "top_employer": true,
                      "top_employer_url": "https://reviews.canadastop100.com/top-employer-atkinsréalis",
                      "location": "Calgary AB",
                      "salary": null,
