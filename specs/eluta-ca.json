    "/eluta/v1/search": {
      "get": {
        "operationId": "elutaSearch",
        "summary": "Eluta.ca job search",
        "description": "Jobs on Eluta.ca, the Canadian job search engine that lists jobs from employers' own career sites, for a keyword and/or location, with every filter of the site: radius, remote or on-site, minimum salary, job level, Canada's Top Employers lists, category and sort. Each job: `id`, `title`, `url`, `employer`, `employer_url`, `top_employer` (and its review link), `location`, `salary` with `salary_min`/`salary_max`/`salary_period` when the ad shows pay, `snippet`, `last_seen` (when the site last found the ad), `source` (the employer site the ad was read from) and `apply_url`. `total` is the site's count (`total_is_estimate` when it shows 10000+); `refine` lists the categories, job levels (with counts) offered for this search. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/eluta-search",
        "tags": [
          "Eluta.ca"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `engineer`, `nurse`. Required unless `location` is given.",
            "schema": {
              "type": "string"
            },
            "example": "engineer"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City and province, e.g. `Toronto ON`, `Vancouver BC`.",
            "schema": {
              "type": "string"
            },
            "example": "Toronto ON"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Kilometres around `location` (the site's default is 50).",
            "schema": {
              "type": "integer",
              "enum": [
                "5",
                "10",
                "25",
                "50",
                "100",
                "200"
              ]
            }
          },
          {
            "name": "remote",
            "in": "query",
            "required": false,
            "description": "`only`: remote jobs; `onsite`: on-site jobs.",
            "schema": {
              "type": "string",
              "enum": [
                "only",
                "onsite"
              ]
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "required": false,
            "description": "Minimum yearly salary in CAD.",
            "schema": {
              "type": "integer",
              "enum": [
                "40000",
                "60000",
                "80000",
                "100000",
                "120000",
                "140000"
              ]
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "Job level or type.",
            "schema": {
              "type": "string",
              "enum": [
                "full_time",
                "part_time",
                "entry_level",
                "internship",
                "seasonal"
              ]
            }
          },
          {
            "name": "top_employer",
            "in": "query",
            "required": false,
            "description": "Only employers on one of the Canada's Top Employers lists.",
            "schema": {
              "type": "string",
              "enum": [
                "top100",
                "over40",
                "greenest",
                "family_friendly",
                "young_people",
                "small_medium",
                "diversity",
                "greater_toronto",
