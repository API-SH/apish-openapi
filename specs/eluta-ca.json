                      "salary_period": null,
                      "snippet": "Job Description Overview AtkinsRéalis is growing and our Western Canadian Engineering group is seeking a client-facing Electrical Engineerin…",
                      "last_seen": "1 hour ago",
                      "source": "slihrms.wd3.myworkdayjobs.com",
                      "apply_url": "https://www.eluta.ca/direct/i?i=7ddbb965993ac671ad8f3f76506b92be"
                    },
                    "… 8 more"
                  ],
                  "refine": {
                    "categories": [
                      "Trades/Technicians",
                      "Engineering - Civil",
                      "… 10 more"
                    ],
                    "job_levels": [
                      {
                        "filter": "etype",
                        "value": 1,
                        "name": "Full-time",
                        "count": 723
                      },
                      {
                        "filter": "etype",
                        "value": 2,
                        "name": "Part-time",
                        "count": 4
                      },
                      "… 2 more"
                    ],
                    "locations": []
                  },
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/eluta/v1/job": {
      "get": {
        "operationId": "elutaJob",
        "summary": "Eluta.ca job ad",
        "description": "One job ad on Eluta.ca: title, employer with its short description and jobs link, location, contract (full-time, part-time…), salary when shown, the full description (text and HTML), the employer's Canada's Top Employers awards and the apply link (it opens the ad on the employer's site). `latest=true` with search parameters returns the first matching ad. Removed ads answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/eluta-job",
        "tags": [
          "Eluta.ca"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job `id` from search (32 characters) or its eluta.ca/spl/... link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`true`: the first ad of a search with `q`/`location` instead of an `id`.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "With `latest=true`: keywords.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "With `latest=true`: city and province.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "e64c1ab6082211e10d72699c767214f7",
                  "title": "Engineering Manager, Reactor Engineering",
                  "url": "https://www.eluta.ca/spl/engineering-manager-reactor-engineering-e64c1ab6082211e10d72699c767214f7",
