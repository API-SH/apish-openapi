    "/foxnews/v1/headlines": {
      "get": {
        "operationId": "foxnewsHeadlines",
        "summary": "Fox News headlines by section",
        "description": "The latest stories of a Fox News section or topic tag (`tag`), newest first: headline, summary, link, publication and update times, type (article, video, slideshow), category, kicker, authors, breaking flag, video duration, id and image. Pass `next_page` back as `page`. Article bodies are not returned.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/foxnews-headlines",
        "tags": [
          "Fox News"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "Section: us (default), politics, world, opinion, entertainment, sports, lifestyle, health, science, tech, media, travel, food-drink, auto...",
            "schema": {
              "type": "string"
            },
            "example": "politics"
