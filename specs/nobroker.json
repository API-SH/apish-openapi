    "/nobroker/v1/locality": {
      "get": {
        "operationId": "nobrokerLocality",
        "summary": "NoBroker top localities",
        "description": "A city's most sought-after localities on NoBroker: name, id, how many times its homes were viewed and owners contacted recently, the contact rate and how many listings are active. Any of the names works as the location of /nobroker/v1/search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/nobroker-locality",
        "tags": [
          "NoBroker"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City (bangalore, mumbai, pune, chennai, hyderabad, delhi, gurgaon, noida, ghaziabad, faridabad, navi mumbai, thane).",
            "schema": {
              "type": "string"
            },
            "example": "bangalore"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
