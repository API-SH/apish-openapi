          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/nobroker/v1/search": {
      "get": {
        "operationId": "nobrokerSearch",
        "summary": "NoBroker homes around a place",
        "description": "Owner-listed homes to rent or buy, and commercial space, on NoBroker (India) around a city, a named place or a point, with rent or price range, BHK type, furnishing, building type, parking, tenant type and sort. Each result has id, link, title, type, rent or price, deposit, maintenance, size, bathrooms, balconies, floor, age, facing, furnishing, parking, lease type, availability date, society, builder, locality, coordinates, amenities, lifestyle and transit scores, dates, description and photos. Owners' names and contact details are not returned. 26 per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/nobroker-search",
        "tags": [
          "NoBroker"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City.",
            "schema": {
              "type": "string",
              "enum": [
                "bangalore",
                "mumbai",
                "pune",
                "chennai",
                "hyderabad",
                "delhi",
                "gurgaon",
                "noida",
                "ghaziabad",
                "faridabad",
                "navi mumbai",
                "thane"
              ]
            },
            "example": "bangalore"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "A neighbourhood or area to search around, like `Koramangala`, `Andheri West` or `Sector 62, Noida` (else the city centre). Without `city`, the covered city it is in is picked for you. Or give `lat` and `lon`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of the search centre.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Longitude of the search centre.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "description": "Search radius in km (default 2).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "kind",
            "in": "query",
            "required": false,
            "description": "Rent, buy, or commercial rent or buy.",
            "schema": {
              "type": "string",
              "enum": [
                "rent",
                "buy",
                "commercial_rent",
                "commercial_buy"
              ]
            },
            "example": "rent"
          },
          {
            "name": "bhk",
            "in": "query",
            "required": false,
            "description": "BHK types, comma-separated: 1, 2, 3, 4 (or RK1, BHK4PLUS).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum rent or price (INR).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum rent or price (INR).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "furnishing",
            "in": "query",
            "required": false,
            "description": "Furnishing, comma-separated: FULLY_FURNISHED, SEMI_FURNISHED, NOT_FURNISHED.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "building_type",
            "in": "query",
            "required": false,
            "description": "Building types, comma-separated: AP (apartment), IH (independent house), IF (independent floor), GC (gated community).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "parking",
            "in": "query",
            "required": false,
            "description": "Parking, comma-separated: TWO_WHEELER, FOUR_WHEELER, BOTH.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenant_type",
            "in": "query",
            "required": false,
            "description": "Preferred tenants, comma-separated: FAMILY, BACHELOR, COMPANY, ANYONE.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "price_asc",
                "price_desc"
              ]
            },
            "example": "relevance"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "total": 506,
                  "page": 1,
                  "count": 26,
                  "next_page": 2,
                  "place": {
                    "name": "bangalore",
                    "lat": 12.9716,
                    "lon": 77.5946
                  },
                  "applied_filters": {
                    "pageNo": "1",
                    "city": "bangalore",
                    "radius": "2"
                  },
                  "results": [
                    {
                      "id": "8aa9b8499ca4c64b019ca739be6651a5",
                      "url": "https://www.nobroker.in/property/1-bhk-apartment-for-rent-in-arekere-bangalore-for-rs-16000/8aa9b8499ca4c64b019ca739be6651a5/detail",
                      "short_url": "http://nobr.kr/sl/wVBjM",
                      "title": "1 BHK Flat In Raghu Nivas for Rent  In Arekere",
                      "kind": "RENT",
                      "type": "1 BHK",
                      "rent": 16000,
                      "price": null,
                      "deposit": 75000,
                      "negotiable": true,
                      "maintenance_included": false,
                      "maintenance": 1000,
                      "size_sqft": 450,
                      "bathrooms": 1,
                      "balconies": 0,
                      "floor": 1,
                      "total_floors": 4,
                      "age_years": 0,
                      "facing": "North",
