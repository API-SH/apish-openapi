    "/jameda/v1/reviews": {
      "get": {
        "operationId": "jamedaReviews",
        "summary": "Jameda doctor reviews",
        "description": "A doctor's reviews as Jameda shows them, newest first: id, rating, text, date, verification badges, practice address and service the review is about, and the doctor's reply when there is one. Reviewers are anonymous on the site. Filter to positive or negative reviews. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jameda-reviews",
        "tags": [
          "Jameda"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "A profile id (the `id` of /jameda/v1/profile).",
            "schema": {
              "type": "integer"
            },
            "example": "321586"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Or a jameda.de profile link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "positive or negative.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page, 1-30 (default 10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-based).",
            "schema": {
              "type": "integer"
            }
