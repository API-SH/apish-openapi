    "/jameda/v1/search": {
      "get": {
        "operationId": "jamedaSearch",
        "summary": "Jameda doctor search",
        "description": "Find doctors, therapists and facilities on Jameda by specialty and city, with the site's filters: insurance type (government, government_self_payer, private), online booking, gender, spoken languages, services, conditions treated, accessibility, kids friendly, result type and online-only consultations. Each result: id, name, profile link, type, photo, specialties, rating, review count, cities, premium and calendar flags, practice address id (for /jameda/v1/availability) and each address with street, city, coordinates, services and price. The response lists the filters the site offers for that search. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jameda-search",
        "tags": [
          "Jameda"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "specialty",
            "in": "query",
            "required": true,
            "description": "The site's specialty slug, e.g. zahnarzt, hausarzt, hautarzt-dermatologe, frauenarzt-gynaekologe (see /jameda/v1/specialties).",
            "schema": {
              "type": "string"
            },
            "example": "zahnarzt"
          },
          {
            "name": "city",
            "in": "query",
            "required": true,
            "description": "City slug, e.g. berlin, hamburg, muenchen, koeln.",
            "schema": {
              "type": "string"
            },
            "example": "berlin"
          },
          {
            "name": "insurance",
            "in": "query",
            "required": false,
            "description": "government, government_self_payer or private; comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "online_booking",
            "in": "query",
            "required": false,
            "description": "true: only those bookable online.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "gender",
            "in": "query",
            "required": false,
            "description": "female, male or other.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "A spoken language exactly as listed in filters_available.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "service",
            "in": "query",
            "required": false,
            "description": "A service id from filters_available.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "disease",
            "in": "query",
            "required": false,
            "description": "A condition id from filters_available.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "accessibility",
            "in": "query",
            "required": false,
            "description": "An accessibility id from filters_available (1 wheelchair, 2 visually impaired, 3 hearing impaired, 4 parents with prams).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kids_friendly",
            "in": "query",
            "required": false,
            "description": "true: only kids-friendly practices.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "entity_type",
            "in": "query",
            "required": false,
            "description": "doctor or facility.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "online_only",
            "in": "query",
            "required": false,
            "description": "true: online consultations only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-based).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
