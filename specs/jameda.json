    "/jameda/v1/profile": {
      "get": {
        "operationId": "jamedaProfile",
        "summary": "Jameda doctor profile",
        "description": "One doctor's or therapist's professional Jameda profile: id, name, photo, specialties, about, expertise, rating, review count, each practice address (practice phone, coordinates, payment methods, services with prices, insurance accepted), services, education, experience, languages, awards, publications, accepted insurances and the latest reviews as the site shows them (reviewers are anonymous on the site). Use `id` with /jameda/v1/reviews for all reviews.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jameda-profile",
        "tags": [
          "Jameda"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A jameda.de profile link, e.g. https://www.jameda.de/profil/sam-blum.",
            "schema": {
              "type": "string"
