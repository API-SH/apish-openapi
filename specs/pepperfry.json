    "/pepperfry/v1/search": {
      "get": {
        "operationId": "pepperfrySearch",
        "summary": "Pepperfry search",
        "description": "Pepperfry furniture and home search or category listing (India): product name, link, price, MRP, discount, coupon price, rating, brand, material, colour, shipping time and image, in the chosen sort and page size, plus the filter lists and the available sort orders.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/pepperfry-search",
        "tags": [
          "Pepperfry"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "table"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug, e.g. sofas, or a category path.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price-asc",
                "price-desc"
              ]
            },
            "example": "price-asc"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Products per page (default 20, max 40).",
            "schema": {
              "type": "integer"
            },
            "example": "20"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
