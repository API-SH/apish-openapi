    "/purplle/v1/search": {
      "get": {
        "operationId": "purplleSearch",
        "summary": "Purplle search",
        "description": "Purplle search, category or brand listing (India): id, name, link, brand, price, MRP, discount, stock, rating, offers, elite flag and image, with the total count, every sort and paging, plus the matched category.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/purplle-search",
        "tags": [
          "Purplle"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "lipstick"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug, e.g. makeup-lips-lipsticks.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand slug.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "discount",
                "rating"
              ]
            },
            "example": "price_asc"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "lipstick",
                  "category": null,
                  "brand": null,
                  "list_type": "search",
                  "title": "lipstick",
                  "page": 1,
                  "sort": "relevance",
                  "total": 643,
                  "next_page": 2,
                  "count": 24,
                  "available_sorts": [
                    "relevance",
                    "price_asc",
                    "… 3 more"
                  ],
                  "matched_category": {
                    "name": "lipstick",
                    "slug": "makeup-lips-lipsticks",
                    "path": "makeup/lips/lipsticks"
                  },
                  "products": [
