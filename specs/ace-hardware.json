    "/acehardware/v1/search": {
      "get": {
        "operationId": "acehardwareSearch",
        "summary": "Ace Hardware product search",
        "description": "Search Ace Hardware products: the first 30 results the shop shows for the query (by relevance), with the total match count and the facets (brand, price bands, store availability, special offers, rating) with counts. Each product: item number, name, link, brand, price, regular price when on sale, price range, image, online stock, fulfillment options (ship, pickup, delivery), purchasable flag, UPC, manufacturer part number, date added, summary and categories, plus `raw`. Later pages are not available (`next_page` is always null).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/acehardware-search",
        "tags": [
          "Ace Hardware"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keywords.",
            "schema": {
              "type": "string"
            },
            "example": "hammer"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
