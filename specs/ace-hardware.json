        "description": "The first 30 products of an Ace Hardware department page (the shop's default order) with the total and facet counts, in the same shape as search. Later pages are not available (`next_page` is always null).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/acehardware-category",
        "tags": [
          "Ace Hardware"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "description": "Department path after /departments/ (e.g. tools/power-tools/cordless-drills) or the department link.",
            "schema": {
              "type": "string"
            },
            "example": "tools/power-tools/cordless-drills"
