    "/doctoralia/v1/search": {
      "get": {
        "operationId": "doctoraliaSearch",
        "summary": "Doctoralia doctor search",
        "description": "Doctors and clinics listed on Doctoralia and its sister sites (Brazil, Spain, Mexico, Colombia, Chile, Peru, Argentina, Portugal, Italy, Poland, Turkey, Czechia) for a specialty in a city: id, name, profile link, type, photo, specialties, areas of expertise, rating, review count, cities, online-only, premium and verified flags, booking calendar flags, and each practice address (name, street, city, region, coordinates) with its services and first-visit price, plus `insurances`: the health plans this search can be narrowed to (name, slug for `insurance`, id). Filter by health plan with `insurance` and to teleconsultation with `online=true`. Professional listing data only. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/doctoralia-search",
        "tags": [
          "Doctoralia"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Site country (default br).",
            "schema": {
              "type": "string",
              "enum": [
                "br",
                "es",
                "mx",
                "co",
                "cl",
                "pe",
                "ar",
                "pt",
                "it",
                "pl",
                "tr",
                "cz"
              ]
            },
            "example": "br"
          },
          {
            "name": "specialty",
            "in": "query",
            "required": true,
            "description": "Specialty slug in the site's language, e.g. `dermatologista` (br), `dermatologo` (es, mx), `dermatolog` (pl), `ginecologo`, `psicologo`.",
            "schema": {
              "type": "string"
            },
            "example": "dermatologista"
          },
          {
            "name": "city",
            "in": "query",
            "required": true,
            "description": "City slug, e.g. `sao-paulo`, `rio-de-janeiro`, `madrid`, `ciudad-de-mexico`, `warszawa`.",
            "schema": {
              "type": "string"
            },
            "example": "sao-paulo"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "insurance",
            "in": "query",
            "required": false,
            "description": "Only doctors who accept this health plan: its slug from `insurances` in a search response (e.g. `amil`, `unimed`, `bradesco-saude` in Brazil). An unknown slug gives 404.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "online",
