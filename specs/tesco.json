    "/tesco/v1/product": {
      "get": {
        "operationId": "tescoProduct",
        "summary": "Tesco product",
        "description": "One Tesco product: everything in search plus the description, all images and videos, icons (vegetarian, Red Tractor...), pack size and net contents, ingredients, allergens, the nutrition table per 100 g/ml and per serving with reference intakes, guideline daily amounts with traffic-light ratings, storage, preparation, cooking and freezing instructions, warnings, recycling, origin, alcohol details, marketing text, specifications and dimensions (non-food), sellers with their prices, delivery and returns (Marketplace), bulk-buy limit, price-match flags, manufacturer and return addresses, the rating distribution and the 10 newest reviews.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/tesco-product",
        "tags": [
          "Tesco"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "The product number in a tesco.com/groceries/en-GB/products/<id> link (the `id` in search results), or that link.",
            "schema": {
              "type": "string"
            },
