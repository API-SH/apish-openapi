    "/tesco/v1/search": {
      "get": {
        "operationId": "tescoSearch",
        "summary": "Search Tesco products",
        "description": "Tesco (UK) product search across groceries, Tesco Marketplace and F&F, with every filter the shop offers: product id (tpnc), tpnb, barcode, name, brand, link, price, unit price and unit, Clubcard prices, multibuys and other offers (with dates), availability, new flag, rating and review count, low everyday price and price promise flags, sponsored flag, seller for marketplace items, department / aisle / shelf, and image. `facets` lists the super departments, departments, brands, dietary options, sources, offers and new counts for the query (use their ids as filter values). Sponsored products come on top of `limit` on the first page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/tesco-search",
        "tags": [
          "Tesco"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search keywords.",
            "schema": {
              "type": "string"
            },
            "example": "milk"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: relevance (default), price_asc, price_desc.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc"
              ]
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Only these brands (comma-separated, as in the brand facet, e.g. Cadbury,TESCO).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dietary",
            "in": "query",
            "required": false,
            "description": "Dietary and allergen filters (comma-separated, as in the dietary facet, e.g. Vegan,No gluten).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "super_department",
            "in": "query",
            "required": false,
            "description": "Super department name (e.g. Groceries & Essentials, Marketplace, Clothing & Accessories).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Department name (e.g. Fresh Food, Food Cupboard).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A category id from /tesco/v1/categories (b;...) to search within.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "tesco (Tesco's own range), marketplace (Marketplace sellers only) or all.",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "tesco",
                "marketplace"
              ]
            }
          },
          {
            "name": "offers",
            "in": "query",
            "required": false,
            "description": "true for products on offer only (Clubcard prices, multibuys, price cuts).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "new",
            "in": "query",
            "required": false,
            "description": "true for new products only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Products per page, 1-48 (default 24).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1 for the first. Pass back `next_page`.",
            "schema": {
              "type": "integer"
            }
          },
