    "/ulta/v1/product": {
      "get": {
        "operationId": "ultaProduct",
        "summary": "Ulta Beauty product",
        "description": "One Ulta Beauty product: id, SKU, brand, name, price, list and sale price, availability, selected shade, rating, review count, description, images, categories, every shade/size variant with its images and link, the latest reviews, the details text (features, benefits), how to use, the ingredient list and the product attributes (coverage, finish, form, skin type, SPF...). With `reviews_page`, also one page of the product's reviews (10 per page: title, text, rating, date, reviewer nickname and location, recommends flag, verified buyer, helpful votes, photos) with the total and `next_page`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ulta-product",
        "tags": [
          "Ulta Beauty"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "Ulta product link.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.ulta.com/p/infallible-up-32-hour-fresh-wear-foundation-pimprod2002481?sku=2538199"
          },
          {
            "name": "reviews_page",
            "in": "query",
            "required": false,
            "description": "Also return this page of reviews (1 = newest 10; up to 500). Pass `reviews.next_page` back here.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "reviews_sort",
            "in": "query",
            "required": false,
            "description": "Review order with `reviews_page` (default newest).",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest",
                "highest",
                "lowest",
                "most_helpful"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "product_id": "pimprod2002481",
                  "sku": "2538199",
                  "name": "Infallible Up to 32 Hour Fresh Wear Foundation",
                  "brand": "L'Oréal Paris",
