                  "rating": 4.3,
                  "reviews_count": 4549,
                  "description": "L'Oréal Infallible Fresh Wear 32HR Foundation is their most lightweight, breathable, longwear foundation. Defies transfer hour after hour.",
                  "images": [
                    "https://media.ulta.com/i/ulta/2538199?w=500&h=500",
                    "https://media.ulta.com/i/ulta/2538199_alt01?w=500&h=500",
                    "… 2 more"
                  ],
                  "categories": [
                    "Makeup",
                    "Face",
                    "… 1 more"
                  ],
                  "variants": [
                    {
                      "sku": "2558070",
                      "name": "395 Rose Pearl  Infallible Up to 32 Hour Fresh Wear Foundation",
                      "color": "395 Rose Pearl",
                      "size": null,
                      "url": "https://www.ulta.com/p/infallible-up-32-hour-fresh-wear-foundation-pimprod2002481?sku=2558070",
