    "/sainsburys/v1/search": {
      "get": {
        "operationId": "sainsburysSearch",
        "summary": "Search Sainsbury's products",
        "description": "Sainsbury's (UK) grocery search with every sort and filter the shop offers. Each product has its id, EANs, link, name, brand, price and unit price, availability, rating and review count, Nectar and other offers (with dates and was-price), labels (British, price match…), categories and image. `facets` lists brands, dietary, allergy, offers/new and other filters with counts; `categories` the top categories with counts (use an id as `category`). 30 products a page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/sainsburys-search",
        "tags": [
          "Sainsbury's"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search keywords.",
            "schema": {
              "type": "string"
            },
            "example": "milk"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: relevance (default), price_asc, price_desc, rating.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price_asc",
                "price_desc",
                "rating"
              ]
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Only these brands (comma-separated, as in the brand facet).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Only this top category (id from `categories`, e.g. 812511).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dietary",
            "in": "query",
            "required": false,
            "description": "Dietary options (comma-separated, e.g. vegetarian,vegan).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "allergy",
            "in": "query",
            "required": false,
            "description": "Allergy filters (comma-separated, e.g. no gluten).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offers",
            "in": "query",
            "required": false,
            "description": "true: only products on offer or with a Nectar price.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "new",
            "in": "query",
            "required": false,
            "description": "true: only new products.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Any other facet: facet_id:value[,value], several separated by ;.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1 = first).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "milk",
                  "applied_filters": {
                    "sort": "relevance"
                  },
                  "page": 1,
                  "limit": 30,
                  "total": 964,
                  "pages": 33,
                  "count": 30,
                  "next_page": 2,
                  "sort_options": [
                    "relevance",
                    "price_asc",
                    "… 2 more"
                  ],
                  "categories": [
                    {
                      "id": "812511",
                      "name": "Dairy & eggs",
                      "count": 371
                    },
                    {
                      "id": "812503",
                      "name": "Drinks",
                      "count": 337
                    },
                    "… 26 more"
                  ],
                  "facets": [
                    {
                      "id": "nav_Filter-Your-Results",
                      "name": "Most Popular",
                      "type": "MULTI_SELECT",
                      "values": [
                        {
                          "id": "new",
                          "name": "New In",
                          "count": 77,
                          "selected": false
                        },
                        {
                          "id": "Offers",
                          "name": "Offers & Nectar Prices",
                          "count": null,
                          "selected": false
                        }
                      ]
                    },
                    {
                      "id": "nav_Brand",
                      "name": "Brand",
                      "type": "MULTI_SELECT",
                      "values": [
                        {
                          "id": "sainsbury's",
                          "name": "Sainsbury's",
                          "count": 129,
                          "selected": false
