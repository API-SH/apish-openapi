    "/firmy/v1/search": {
      "get": {
        "operationId": "firmySearch",
        "summary": "Firmy.cz business search",
        "description": "Businesses on Firmy.cz (Czech Republic) for what you look for, optionally in a place: id, name, link, website, description, business phone, photo, street, city, postcode, country, coordinates, rating (0-5 and the site's percentage), review count and social profiles. 14 per page; pass `next_page` back as `page`; null on the last page. Or browse a category with `category` (and `region`): the answer then has `category`, `region` and the category's `total`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/firmy-search",
        "tags": [
          "Firmy.cz"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "What to look for, in Czech, e.g. `pizzerie`, `autoservis`, `zubař`, `kadeřnictví`, `instalatér`.",
            "schema": {
              "type": "string"
            },
            "example": "pizzerie"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City or district, e.g. `praha`, `brno`, `ostrava` (leave out for the whole country).",
            "schema": {
              "type": "string"
            },
            "example": "praha"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Instead of q: browse a Firmy.cz category, given as its path or link, e.g. `Restauracni-a-pohostinske-sluzby/Restaurace/Pizzerie` (the `categories[].url` of /firmy/v1/business). Either q or category is required.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "With category: a region slug such as `kraj-praha`, `kraj-jihomoravsky` or `kraj-moravskoslezsky` (the `kraj-` prefix may be left out).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "pizzerie",
                  "location": "praha",
                  "page": 1,
                  "per_page": 14,
                  "total": null,
                  "count": 14,
                  "businesses": [
                    {
                      "id": 12927955,
                      "name": "Pizza \"HNED\"",
                      "url": "https://www.firmy.cz/detail/12927955-pizza-hned-praha-nusle.html",
                      "website": "https://www.pizzahned.com",
                      "description": "Rozvoz pizzy i ostatních čerstvých jídel. Prodáváme alkoholické i nealkoholické nápoje. Možnost online objednávky. Kdykoli vás přepadne hlad…",
                      "phone": "+1 555 010 0000",
                      "image": "https://d48-a.sdn.cz/d_48/c_img_H_H/VFZGJx.png",
                      "street": "Svatoslavova 1680/51",
                      "city": "Praha, Nusle",
                      "postal_code": "14000",
                      "country": "CZ",
