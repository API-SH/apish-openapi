    "/firmy/v1/categories": {
      "get": {
        "operationId": "firmyCategories",
        "summary": "Firmy.cz category tree",
        "description": "The Firmy.cz business category tree. Without `category`: the top-level categories. With `category`: that category's name, its direct subcategories (name, path, link, image) and the regions it can be browsed by; pass a subcategory's path back to go deeper, or use it as `category` in /firmy/v1/search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/firmy-categories",
        "tags": [
          "Firmy.cz"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A category path such as Auto-moto or Auto-moto/Auto-moto-sluzby, or its firmy.cz link (leave out for the top level).",
            "schema": {
              "type": "string"
            },
            "example": "Auto-moto"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "category": "Auto-moto",
                  "name": "Auto-moto",
                  "url": "https://www.firmy.cz/Auto-moto",
                  "count": 3,
                  "subcategories": [
                    {
                      "name": "Auto-moto prodejci",
