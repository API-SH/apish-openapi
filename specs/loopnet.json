    "/loopnet/v1/search": {
      "get": {
        "operationId": "loopnetSearch",
        "summary": "LoopNet commercial property search",
        "description": "Search LoopNet's commercial real estate for lease or for sale by property type and place (city, state), with the total count. Each listing has its id, link, building name, address, city, state, ZIP, headline (size and use, or price), price or rent, key facts (star rating, year built, size range, cap rate and the like), transaction type, tier, summary, brokers (name and company), broker logos and photos. Pass a loopnet.com search link as `url` to keep any filters set on the site. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/loopnet-search",
        "tags": [
          "LoopNet"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City and state as in LoopNet links (austin-tx, new-york-ny, los-angeles-ca) or a state (tx).",
            "schema": {
              "type": "string"
            },
            "example": "austin-tx"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Property type (default commercial-real-estate: all types).",
            "schema": {
              "type": "string",
              "enum": [
                "commercial-real-estate",
                "office-space",
                "retail-space",
                "industrial-space",
                "flex-space",
                "coworking-space",
                "medical-office-space",
                "restaurants",
                "land",
                "multifamily",
                "hospitality",
                "office-buildings",
                "retail-buildings",
                "industrial-buildings",
                "warehouses",
                "shopping-centers",
                "health-care-facilities",
                "mixed-use",
                "special-purpose",
                "businesses"
              ]
            },
            "example": "office-space"
          },
          {
            "name": "deal",
            "in": "query",
            "required": false,
            "description": "For lease (default) or for sale.",
            "schema": {
              "type": "string",
              "enum": [
                "lease",
                "sale"
              ]
            },
            "example": "lease"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A loopnet.com/search/... link instead (keeps the site's filters).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "title": "750+ New York Office Spaces for Lease",
                  "total": 750,
                  "page": 1,
                  "total_pages": 30,
                  "count": 25,
                  "next_page": 2,
                  "search_url": "https://www.loopnet.com/search/office-space/new-york-ny/for-lease/",
                  "listings": [
                    {
                      "id": "20044350",
                      "url": "https://www.loopnet.com/Listing/667-Madison-Ave-New-York-NY/20044350/",
                      "name": null,
                      "address": "667 Madison Ave, New York, NY 10065",
                      "city": "New York",
                      "state": "NY",
                      "zip": "10065",
                      "headline": "38,630 SF Office Available",
                      "price": null,
                      "facts": [
                        "4 Star | Built in 1985",
                        "6,300 - 38,630 SF",
                        "… 1 more"
                      ],
