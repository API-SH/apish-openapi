    "/loopnet/v1/listing": {
      "get": {
        "operationId": "loopnetListing",
        "summary": "LoopNet commercial listing",
        "description": "One LoopNet listing: title, name, address, price or rental rate, description, property overview or executive summary, highlights, property facts (sale type, building class, year built, size, lot size, zoning, parking, occupancy and the other facts shown), available spaces with their size, rent, term, use and highlights, amenities, tenants with floor and industry, brokers and contacts with phone numbers and profile links, the brokerage, photos, plus `raw`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/loopnet-listing",
        "tags": [
          "LoopNet"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A loopnet.com/Listing/... link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The listing id instead (the number at the end of the link).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "true: open the first listing of a search with the /loopnet/v1/search params given alongside (type, location, deal). Then url is not needed.",
            "schema": {
              "type": "boolean"
            },
            "example": "true"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "With latest: the search's property type.",
            "schema": {
              "type": "string"
            },
            "example": "office-space"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "With latest: the search's location.",
            "schema": {
              "type": "string"
            },
            "example": "austin-tx"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
