    "/goodrx/v1/search": {
      "get": {
        "operationId": "goodrxSearch",
        "summary": "GoodRx drug search",
        "description": "The GoodRx search box: brand and generic drugs, conditions and drug classes matching a name or its start. Each result: type, title, name, slug (use it as `drug` on the other GoodRx endpoints), id, promotion text and the page link.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/goodrx-search",
        "tags": [
          "GoodRx"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Drug, condition or drug class name, or its start.",
            "schema": {
              "type": "string"
            },
            "example": "lipit"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results, 1-50 (default 10).",
            "schema": {
              "type": "integer"
            },
            "example": "10"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "lipit",
                  "count": 5,
                  "results": [
                    {
                      "type": "drug",
                      "title": "Lipitor (brand-name)",
                      "name": "Lipitor (brand-name)",
                      "slug": "lipitor",
                      "id": "2406",
                      "featured": false,
                      "promotion": null,
                      "url": "https://www.goodrx.com/lipitor"
                    },
                    {
                      "type": "drug",
                      "title": "Lipitor (generic)",
                      "name": "Lipitor (generic)",
                      "slug": "lipitor",
                      "id": "388",
                      "featured": false,
                      "promotion": null,
                      "url": "https://www.goodrx.com/lipitor"
                    },
                    "… 3 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
