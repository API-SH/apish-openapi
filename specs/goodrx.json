    "/goodrx/v1/lowest-prices": {
      "get": {
        "operationId": "goodrxLowestPrices",
        "summary": "GoodRx lowest prices for several drugs",
        "description": "The lowest GoodRx price of up to 25 drugs in one call. `found` is false for a name GoodRx has no price for.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/goodrx-lowest-prices",
        "tags": [
          "GoodRx"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "drugs",
            "in": "query",
            "required": true,
            "description": "Comma-separated drug names or slugs (up to 25).",
            "schema": {
              "type": "string"
            },
            "example": "lisinopril,atorvastatin,metformin"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "count": 3,
                  "state": null,
                  "prices": [
                    {
                      "drug": "lisinopril",
                      "lowest_price": 7.79,
                      "currency": "USD",
                      "url": "https://www.goodrx.com/lisinopril",
