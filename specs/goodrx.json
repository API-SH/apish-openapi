            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/goodrx/v1/pharmacies": {
      "get": {
        "operationId": "goodrxPharmacies",
        "summary": "GoodRx popular pharmacies near a ZIP code",
        "description": "The most popular pharmacy chains near a US ZIP code on GoodRx, ranked, with their ids and logos, and the place the ZIP code resolves to.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/goodrx-pharmacies",
        "tags": [
          "GoodRx"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "zip",
            "in": "query",
            "required": true,
            "description": "5-digit US ZIP code.",
            "schema": {
              "type": "string"
            },
            "example": "94103"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Pharmacies, 1-50 (default 20).",
            "schema": {
              "type": "integer"
            },
            "example": "20"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
