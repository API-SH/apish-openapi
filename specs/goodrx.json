    "/goodrx/v1/prices": {
      "get": {
        "operationId": "goodrxPrices",
        "summary": "GoodRx pharmacy prices near a ZIP code",
        "description": "Prescription prices at every pharmacy GoodRx lists near a US ZIP code for one drug version: the lowest price at each pharmacy, the coupon price, retail price, member price, delivery and every pricing option with its campaign, plus the average retail price and estimated cash price. Pick the version with `label`, `form`, `dosage` and `quantity` (values from /goodrx/v1/drug; the site's default version otherwise). Sorted by lowest price.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/goodrx-prices",
        "tags": [
          "GoodRx"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "drug",
            "in": "query",
            "required": true,
            "description": "Drug slug from search, or a goodrx.com drug link.",
            "schema": {
              "type": "string"
            },
            "example": "lisinopril"
          },
          {
            "name": "zip",
            "in": "query",
            "required": true,
            "description": "5-digit US ZIP code.",
            "schema": {
              "type": "string"
            },
            "example": "10001"
          },
          {
            "name": "label",
            "in": "query",
            "required": false,
            "description": "Brand or generic label slug, e.g. zestril or lisinopril.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "form",
            "in": "query",
            "required": false,
            "description": "Form slug, e.g. tablet.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dosage",
            "in": "query",
            "required": false,
            "description": "Strength slug, e.g. 20mg.",
            "schema": {
              "type": "string"
            },
            "example": "20mg"
          },
          {
            "name": "quantity",
            "in": "query",
            "required": false,
            "description": "Quantity (default: the version's default quantity).",
            "schema": {
              "type": "integer"
            },
            "example": "30"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "price (default).",
            "schema": {
              "type": "string",
              "enum": [
                "price"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "drug": "Lisinopril",
                  "drug_slug": "lisinopril",
                  "drug_id": "193",
