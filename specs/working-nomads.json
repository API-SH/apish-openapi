    "/workingnomads/v1/job": {
      "get": {
        "operationId": "workingnomadsJob",
        "summary": "Working Nomads job",
        "description": "One Working Nomads job by link, slug or numeric id (or the newest job with `latest=true`): title, company, category, position type, experience level, tags, locations, salary, how to apply, posted date, the full description (text and HTML) and similar jobs. Expired or unknown jobs answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/workingnomads-job",
        "tags": [
          "Working Nomads"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "job",
            "in": "query",
            "required": false,
            "description": "Job link (https://www.workingnomads.com/jobs/...), slug or numeric id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "true: the newest job on the site.",
            "schema": {
              "type": "boolean"
            },
            "example": "true"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
