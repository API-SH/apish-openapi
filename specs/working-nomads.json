            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category from /workingnomads/v1/filters, e.g. Development (comma separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "position_type",
            "in": "query",
            "required": false,
            "description": "full-time, part-time or contract (comma separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "experience",
            "in": "query",
            "required": false,
            "description": "entry-level, mid-level or senior (comma separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
