    "/workingnomads/v1/search": {
      "get": {
        "operationId": "workingnomadsSearch",
        "summary": "Working Nomads job search",
        "description": "Searches Working Nomads' remote jobs with the site's filters: keywords (any of several; `a AND b` inside one), title words, category, position type, experience level, location, date posted, annual salary range in USD and company, newest first or by relevance. 50 jobs per page (20 with `description=true`), each with `id`, `slug`, `title`, `url`, company, company slug and page, category, position type, experience level, tags, locations, salary text, annual salary in USD, applicant count when shown, how to apply (link, email, instructions), featured flag and posted date; `description=true` adds the full description. Pass `next_page` back as `page`; null on the last page (the first 10,000 results).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/workingnomads-search",
        "tags": [
          "Working Nomads"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, comma separated (any of them).",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "title",
            "in": "query",
            "required": false,
            "description": "Words in the job title, comma separated.",
            "schema": {
