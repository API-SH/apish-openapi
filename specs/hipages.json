    "/hipages/v1/locations": {
      "get": {
        "operationId": "hipagesLocations",
        "summary": "hipages suburb suggestions",
        "description": "Australian suburbs matching a name or postcode, with suburb, state and region keys for search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/hipages-locations",
        "tags": [
          "hipages"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Suburb name or postcode.",
            "schema": {
              "type": "string"
            },
            "example": "bondi"
