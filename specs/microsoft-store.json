    "/microsoft-store/v1/category": {
      "get": {
        "operationId": "microsoftStoreCategory",
        "summary": "Microsoft Store charts by category",
        "description": "A Microsoft Store chart for apps or games, overall or in one category: top free, top paid, best selling, best rated or deals. Each product has id, title, type, publisher, link, categories, rating and rating count, price, display price, list price, release date, game/PWA/Android flags, package family names, age rating, description, icon and poster. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/microsoft-store-category",
        "tags": [
          "Microsoft Store"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "apps or games. Default apps.",
            "schema": {
              "type": "string",
              "enum": [
                "apps",
                "games"
              ]
            },
            "example": "apps"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Store category name. Apps: Books & reference, Business, Developer tools, Education, Entertainment, Health & fitness, Lifestyle, Music, Navigation & maps, News & weather, Personal finance, Personalization, Photo & video, Productivity, Security, Shopping, Social, Sports, Travel, Utilities & tools and others. Games: Action & adventure, Card & board, Family & kids, Puzzle & trivia, Racing & flying, Role playing, Shooter, Simulation, Sports, Strategy and others. Default: all.",
            "schema": {
              "type": "string"
            },
            "example": "Productivity"
          },
          {
            "name": "list",
            "in": "query",
            "required": false,
            "description": "Which chart. Default top_free.",
            "schema": {
              "type": "string",
              "enum": [
                "top_free",
                "top_paid",
                "best_selling",
                "best_rated",
                "deals"
              ]
            },
            "example": "top_free"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, from 1.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Products per page, 1-60. Default 24.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "description": "Two-letter market (country) code. Default US.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Language, e.g. en-US, de-DE. Default en-<market>.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
