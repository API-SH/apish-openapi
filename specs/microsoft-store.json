          "Microsoft Store"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Product id (12 characters, in the apps.microsoft.com/detail link).",
            "schema": {
              "type": "string"
            },
            "example": "9NCBCSZSJRSB"
