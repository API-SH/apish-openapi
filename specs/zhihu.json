          "Zhihu"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Article number from a zhuanlan.zhihu.com/p/<id> link, e.g. `549805343`.",
