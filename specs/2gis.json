    "/2gis/v1/search": {
      "get": {
        "operationId": "2gisSearch",
        "summary": "2GIS place search",
        "description": "Search 2GIS, the city directory and map for Russia, Kazakhstan, Kyrgyzstan, Uzbekistan and more, for places and businesses in a city, with the total count. Each place has its id, link, name, type, address, building, postcode, coordinates, rating and review count, rubrics, organization and branch count, opening hours, summary, photo count, attributes and contacts when listed, plus `raw`. Sort by rating, newest or name, narrow by a rubric and by filters the site offers for the query (open now, delivery, takeaway and the like; each answer lists them in `available_filters` with the matching rubrics and districts). 12 places a page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 2 credits per successful call. Docs: https://api.sh/docs/2gis-search",
        "tags": [
          "2GIS"
        ],
        "x-credits": 2,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "What to look for: a kind of place (кафе, аптека, pharmacy) or a name. Optional with rubric_id.",
            "schema": {
              "type": "string"
            },
            "example": "кафе"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City alias as in 2gis.ru links (default moscow; spb, novosibirsk, ekaterinburg, kazan, almaty, astana, bishkek and more in /2gis/v1/cities).",
            "schema": {
              "type": "string"
            },
            "example": "moscow"
          },
          {
            "name": "rubric_id",
            "in": "query",
            "required": false,
            "description": "Only places in this rubric (from /2gis/v1/rubrics or `available_filters`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default relevance; opened_time: newest first).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "rating",
                "opened_time",
                "name"
              ]
            }
          },
          {
            "name": "open_now",
            "in": "query",
            "required": false,
            "description": "true: only places open now.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "Filter tags from `available_filters`, comma-separated (e.g. covid_homedelivery, food_service_details_food_takeaway).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
