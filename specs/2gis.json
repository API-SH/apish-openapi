    "/2gis/v1/rubrics": {
      "get": {
        "operationId": "2gisRubrics",
        "summary": "2GIS rubrics",
        "description": "2GIS's rubric catalog for a city: the top-level groups (food, car service, beauty, health and the rest), or with `parent_id` the rubrics inside a group, each with its id, name, place and organization counts, icon and a search link. Use a rubric id as `rubric_id` in /2gis/v1/search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/2gis-rubrics",
        "tags": [
          "2GIS"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City alias (default moscow).",
            "schema": {
              "type": "string"
            },
            "example": "moscow"
          },
          {
            "name": "parent_id",
            "in": "query",
            "required": false,
