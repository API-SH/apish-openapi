    "/centris/v1/search": {
      "get": {
        "operationId": "centrisSearch",
        "summary": "Centris property search",
        "description": "Search Quebec property listings on Centris for sale or rent, residential or commercial, with the site's filters: location (a place name or a location id), price range, property types (single-family homes, condos, lofts and studios, plexes, intergenerational, mobile homes, hobby farms, cottages, lots, multi-family, office, industrial, commercial, accommodation, agricultural, business), bedrooms, bathrooms, parking and garages, pool, private yard, elevator, adapted for reduced mobility, waterfront, water access, navigable water, resort, pets and smoking allowed, open house, foreclosure, option to buy, new or century homes, building style and type, plex type, furnished, living and land area, year built, and the sort order. Each listing: Centris number, category, price, address, city, bedrooms, bathrooms, photo count, image, coordinates and link. 20 per page; pass `next_page` back as `page` (keep the same `sort_seed`).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/centris-search",
        "tags": [
          "Centris"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "A place name (first match) or a location id from /centris/v1/locations, e.g. GSGS4621 (Montreal island).",
            "schema": {
              "type": "string"
            },
            "example": "GSGS4621"
          },
          {
            "name": "location_type",
            "in": "query",
            "required": false,
            "description": "The id's type from /centris/v1/locations (e.g. CityDistrict) when it is not a region id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "residential (default) or commercial.",
            "schema": {
              "type": "string",
              "enum": [
                "residential",
                "commercial"
              ]
            }
          },
          {
            "name": "transaction",
            "in": "query",
            "required": false,
            "description": "sale (default) or rent.",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (CAD).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price (CAD).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Comma-separated: single_family_home, condo, condo_rent, loft_studio, plex, intergenerational, mobile_home, hobby_farm, chalet, residential_lot, multi_family, office, industrial, industrial_rent, commercial, commercial_rent, accommodation, agricultural, commercial_lot, business.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bedrooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bathrooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum bathrooms (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "parking_min",
            "in": "query",
            "required": false,
            "description": "Minimum parking spaces (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "garages_min",
            "in": "query",
            "required": false,
            "description": "Minimum garages (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "pool",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "private_yard",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "elevator",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "mobility_adapted",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "waterfront",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "water_access",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "navigable_water",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "resort",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "pets_allowed",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "smoking_allowed",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "open_house",
            "in": "query",
