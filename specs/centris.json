            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "foreclosed",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "option_to_buy",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "new_construction",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "century_home",
            "in": "query",
            "required": false,
            "description": "true: only these.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "building_style",
            "in": "query",
            "required": false,
            "description": "Comma-separated: Bungalow, MoreThanOneStorey, SplitLevel.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "building_type",
            "in": "query",
            "required": false,
