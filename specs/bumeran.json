    "/bumeran/v1/job": {
      "get": {
        "operationId": "bumeranJob",
        "summary": "Bumeran job ad",
        "description": "One job ad on Bumeran: full description (text and HTML), company (name, logo, about, industry, size, location), location, area and sub-area, job type, work mode, seniority, contract type, vacancies, salary when public, requirements (age range, education, experience, residence, languages, skills), the ad's screening questions, posted, modified and closing dates, and similar jobs. `latest=true` with search parameters returns the first matching ad. Removed ads answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bumeran-job",
        "tags": [
          "Bumeran"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job id (`id` in search results) or its bumeran job link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Site: `ar` bumeran.com.ar (default), `mx` bumeran.com.mx, `pe` bumeran.com.pe, `ve` bumeran.com.ve.",
            "schema": {
              "type": "string",
              "enum": [
                "ar",
                "mx",
                "pe",
                "ve"
              ]
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`true`: the first ad of a search with the other parameters instead of an id (an example that never expires).",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "With `latest=true`: keywords.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
