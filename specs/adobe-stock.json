          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Partial keywords, e.g. `cat`.",
            "schema": {
              "type": "string"
            },
            "example": "cat"
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "A language tag, default `en-US` (e.g. `de-DE`, `fr-FR`).",
