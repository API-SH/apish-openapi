          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/gol/v1/flights": {
      "get": {
        "operationId": "golFlights",
        "summary": "GOL flight search",
        "description": "GOL's fares between two airports on a day, as the booking site lists them: every flight or connection with departure and arrival (local times), stops, duration, flight numbers, aircraft, and each fare family (Light, Classic, Flex and others) with total, fare and taxes in BRL per traveller (as the site shows them). Also returns the lowest fare on the nearby days (`nearby_dates`) and nearby destination airports the site suggests. A round trip (`return_date`) lists the outbound flights priced for the round trip. Filter by stops or fare family and sort by price, duration or departure. Airports outside the GOL network answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/gol-flights",
        "tags": [
          "GOL"
        ],
        "x-credits": 1,
