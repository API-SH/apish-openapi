          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/gol/v1/flight-delays": {
      "get": {
        "operationId": "golFlightDelays",
        "summary": "Flight delay and cancellation rates",
        "description": "The delay and cancellation rates per scheduled flight that GOL shows on its booking pages, for GOL and every other airline flying in Brazil: airline, flight number, route, the number of recent operations counted, the cancellation rate and the share of flights delayed more than 30 and 60 minutes (percent). Filter by airline, flight number, origin or destination. 100 rows per page; pass `next_page` back as `page` (null on the last page).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/gol-flight-delays",
        "tags": [
          "GOL"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "airline",
            "in": "query",
            "required": false,
            "description": "Three-letter ICAO airline code, e.g. GLO (GOL), AZU (Azul), TAM (LATAM Brasil), TAP.",
            "schema": {
              "type": "string"
            },
            "example": "GLO"
          },
          {
            "name": "flight_number",
            "in": "query",
            "required": false,
            "description": "Flight number digits, e.g. 1560.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "origin",
            "in": "query",
            "required": false,
            "description": "Departure airport code (IATA).",
            "schema": {
              "type": "string"
            },
            "example": "GRU"
          },
          {
            "name": "destination",
            "in": "query",
            "required": false,
            "description": "Arrival airport code (IATA).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "applied_filters": {
                    "airline": "GLO",
                    "origin": "GRU"
                  },
                  "total": 119,
                  "page": 1,
                  "count": 100,
                  "next_page": 2,
                  "flights": [
                    {
                      "airline_code": "GLO",
                      "airline": "GOL LINHAS AÉREAS S.A. (EX- VRG LINHAS AÉREAS S.A.)",
                      "flight_number": "1128",
                      "origin": "GRU",
                      "destination": "CAC",
                      "flights_counted": 30,
                      "cancel_rate_pct": 13.33,
                      "delay_over_30min_pct": 7.69,
                      "delay_over_60min_pct": 3.85
                    },
                    {
                      "airline_code": "GLO",
                      "airline": "GOL LINHAS AÉREAS S.A. (EX- VRG LINHAS AÉREAS S.A.)",
                      "flight_number": "1140",
                      "origin": "GRU",
                      "destination": "FLN",
