    "/meesho/v1/reviews": {
      "get": {
        "operationId": "meeshoReviews",
        "summary": "Meesho product reviews",
        "description": "Customer reviews of one meesho.com product, most helpful first: rating, text, helpful votes, date, review photos and videos and the reviewer's display name, with the product's average rating, rating and review counts and the 1-5 star breakdown. Pass `next_cursor` back as `cursor`; it is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/meesho-reviews",
        "tags": [
          "Meesho"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "product_id",
            "in": "query",
            "required": false,
            "description": "Product id (the numeric `id` from /meesho/v1/search, or the short code after /p/ in a product link). Either product_id or url is required.",
            "schema": {
              "type": "string"
            },
            "example": "537307277"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A meesho.com product link (/<name>/p/<code>).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "all (default) or media (only reviews with photos or videos).",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "media"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page, 1-50 (default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pass `next_cursor` from the previous response.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "product_id": "8vwcy5",
                  "url": "https://www.meesho.com/s/p/8vwcy5",
                  "type": "all",
                  "rating": 4.1,
                  "rating_scale": 5,
                  "ratings": 12136,
                  "review_count": 4248,
                  "rating_breakdown": {
                    "1": 1255,
