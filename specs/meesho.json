    "/meesho/v1/product": {
      "get": {
        "operationId": "meeshoProduct",
        "summary": "Meesho product",
        "description": "One Meesho product by link or id: name, price, MRP and discount, stock flag, sizes, description, highlights and the detail table, rating, rating and review counts, rating breakdown, the top review (text, rating, helpful votes, photos), delivery estimate, images, catalog, breadcrumbs, supplier (name, handle, link, rating, rating count, product count, products sold, image, mall flag, dispatch time) and mall tags. Also `variants` (each size with its id, price and stock flag), `shipping` (charges, free delivery, serviceable, express, estimated delivery date and timestamp, dispatch time, cash on delivery and its charge), `returns` (label and policy text, exchange-only flag), `special_offers` and `other_designs` (the catalog's other designs with code, name, price, stock, image and link).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/meesho-product",
        "tags": [
          "Meesho"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A meesho.com product link (/<name>/p/<code>).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.meesho.com/womens-kanjivaram-soft-banarasi-silk-saree-with-blouse-piece-wine/p/8vwcy5"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The product id (e.g. 537307277) or the code in the link (e.g. 8vwcy5), instead of `url`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
