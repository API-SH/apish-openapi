                    "Bathroom Installation & Remodel",
                    "General Plumbing",
                    "… 3 more"
                  ],
                  "awards": [
                    "Certificate of Excellence, 2020"
                  ],
                  "description": "SMA Plumbing is the core service that has an established reputation for quality, service, and customer satisfaction.\n\nSMA Emergency Plumbing…",
                  "logo": "https://user-data.bark.com/s/avatar_v2/By484/logo/66ffb3b2de8cc.jpg!d=Mw6FPX",
                  "reviews": [
                    {
                      "rating": 5,
                      "date": "2024-09-24",
                      "author": "Sarika Neha Joshi",
                      "text": "Mohammed at SMA plumbers came in 20 minutes to fix an urgent plumbing issue. The call out fee was reasonable, the problem fixed and overall …"
                    },
                    {
                      "rating": 5,
                      "date": "2023-11-27",
                      "author": "Nick Butt",
                      "text": "Just perfect, great people to work with."
                    },
                    "… 24 more"
                  ],
                  "url": "https://www.bark.com/en/gb/company/sma-plumbing-and-bathrooms-ltd/8myB6/",
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/bark/v1/categories": {
      "get": {
        "operationId": "barkCategories",
        "summary": "Services directory",
        "description": "Bark's services directory for a country: each listed service with its slug, name and page, and the city pages Bark lists for it. The slug works as `category` (and the place as `location`) in /bark/v1/search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bark-categories",
        "tags": [
          "Bark"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country site (gb, us, au, ca, ie, nz, za, sg, in, fr, de, es, it, nl; default gb).",
            "schema": {
              "type": "string"
            },
            "example": "gb"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "country": "gb",
                  "count": 51,
                  "services": [
                    {
                      "slug": "pet-grooming",
                      "name": "Dog & Pet Grooming",
                      "url": "https://www.bark.com/en/gb/pet-grooming/",
                      "locations": []
                    },
                    {
                      "slug": "dog-training",
                      "name": "Dog Training",
                      "url": "https://www.bark.com/en/gb/dog-training/",
                      "locations": []
                    },
                    "… 49 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/bark/v1/search": {
      "get": {
        "operationId": "barkSearch",
        "summary": "Bark professionals by service and place",
        "description": "A Bark service in a place: the service name, area, typical price range, average rating and review count, and the featured professionals (name, location, description, rating, id, profile link, their latest review and any Bark award shown on the card, e.g. Certificate of Excellence).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bark-search",
        "tags": [
          "Bark"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": true,
            "description": "The service as in Bark's addresses (e.g. plumbers, electricians, personal-trainers, web-design, dog-walking, wedding-photography).",
            "schema": {
              "type": "string"
            },
            "example": "plumbers"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City or town (e.g. london, manchester, new-york). Country-wide when empty.",
            "schema": {
              "type": "string"
            },
            "example": "london"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country (default gb).",
            "schema": {
              "type": "string",
              "enum": [
                "gb",
                "us",
                "au",
                "ca",
                "ie",
                "nz",
                "za",
                "sg",
                "in",
                "fr",
                "de",
                "es",
                "it",
                "nl"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
