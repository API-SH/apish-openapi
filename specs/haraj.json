    "/haraj/v1/comments": {
      "get": {
        "operationId": "harajComments",
        "summary": "Haraj ad comments",
        "description": "The public comments under a Haraj ad: id, author, author id and level, new-member flag, text, date, status, deletion reason, order, and whether it replies to another comment. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/haraj-comments",
        "tags": [
          "Haraj"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The ad id, or a haraj.com.sa/11<id>/... link.",
            "schema": {
              "type": "string"
            },
            "example": "191909227"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "An ad link instead of the id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "order",
            "in": "query",
            "required": false,
            "description": "oldest (default) or newest first.",
            "schema": {
              "type": "string",
              "enum": [
                "oldest",
                "newest"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "191909227",
                  "url": "https://haraj.com.sa/11191909227/",
                  "order": "oldest",
                  "page": 1,
                  "count": 1,
                  "next_page": null,
                  "comments": [
                    {
                      "id": 569656424,
                      "author": "عضو 77 31436",
