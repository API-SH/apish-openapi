    "/haraj/v1/search": {
      "get": {
        "operationId": "harajSearch",
        "summary": "Search Haraj ads",
        "description": "Haraj (Saudi Arabia) classified ads for an Arabic or English keyword, or a tag (category): title, text, price (SAR), city, district and neighbourhood, posting and update times, tags, attributes, car and real-estate details, photos and comment counts. The newest matching ads (about 20 a page); `has_more` tells whether the site has more, and `page` fetches the next ones. Filter by `city`, price range (`min_price` / `max_price`, keyword searches) and `sort=newest` (newest posted first); with any of these the response also echoes `page`, `city`, `min_price`, `max_price` and `sort`. Private sellers' names, phone numbers and email addresses are never returned (masked in ad text).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/haraj-search",
        "tags": [
          "Haraj"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords (Arabic or English).",
            "schema": {
              "type": "string"
            },
            "example": "ايفون"
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "A Haraj tag (category) instead of keywords, e.g. حراج السيارات.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Results page, 1-100 (about 20 ads a page). Pass page+1 while `has_more` is true.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "Only ads in this city, as Haraj names it (Arabic), e.g. الرياض, جده, الدمام.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Lowest price (SAR). Needs q.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Highest price (SAR). Needs q.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "default (the site's order) or newest (newest posted first).",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "newest"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
