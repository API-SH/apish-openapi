    "/haraj/v1/listing": {
      "get": {
        "operationId": "harajListing",
        "summary": "Haraj ad details",
        "description": "One Haraj ad: title, text, price, city and neighbourhood, dates, tags, attributes, car and real-estate details, photos and comment counts. Pass `id`, `url`, or `latest=1` with search params. Private sellers' names, phone numbers and email addresses are never returned (masked in ad text).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/haraj-listing",
        "tags": [
          "Haraj"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Haraj ad id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Haraj ad url.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`1`: open the first current result of a search made with this route's search params (q, location and filters) instead of an id. Ads expire, so this keeps a link working.",
            "schema": {
              "type": "string"
            },
            "example": "1"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search keywords (with latest=1).",
            "schema": {
              "type": "string"
            },
            "example": "ايفون"
          },
          {
            "name": "tag",
            "in": "query",
            "required": false,
            "description": "Tag (with latest=1).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "191949288",
                  "url": "https://haraj.com.sa/11191949288/ايفون_14_برو_للبيع/",
                  "title": "ايفون 14 برو للبيع",
                  "description": "السلام عليكم \nجوال ايفون 14. برو للبيع \nمافي اي تغير ولا وشي  \nبطريته 73\nوالقيقا 128\nالله يجزآكم خير",
                  "price": null,
