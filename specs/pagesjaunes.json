    "/pagesjaunes/v1/search": {
      "get": {
        "operationId": "pagesjaunesSearch",
        "summary": "PagesJaunes business search",
        "description": "Businesses on PagesJaunes (France) for an activity or name and a place: id, name, link, activity, address, distance, coverage area, rating and review count, Google rating and review count, opening status, service tags, description, badges, image, sponsored flag. `total` is the number of results. 20 per page: pass `next_page` back as `page`; null on the last page. Order with `sort` (the site's own orders); the response echoes `sort`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/pagesjaunes-search",
        "tags": [
          "PagesJaunes"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Activity or business name, e.g. `plombier`, `restaurant`, `boulangerie`.",
            "schema": {
              "type": "string"
            },
            "example": "plombier"
          },
          {
            "name": "location",
            "in": "query",
            "required": true,
            "description": "City, postcode or department, e.g. `Paris`, `69001`, `Gironde`.",
            "schema": {
              "type": "string"
            },
            "example": "Paris"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "`relevance` (default), `distance`, `rating` (best rated first) or `reviews` (most reviewed first).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "distance",
                "rating",
                "reviews"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "boulangerie",
                  "location": "Paris",
                  "sort": "relevance",
                  "page": 1,
                  "total": 1195,
                  "pages": 60,
                  "next_page": 2,
                  "count": 20,
                  "results": [
                    {
                      "id": "00287424",
