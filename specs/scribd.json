    "/scribd/v1/search": {
      "get": {
        "operationId": "scribdSearch",
        "summary": "Scribd document search",
        "description": "Documents uploaded to Scribd for keywords, with the site's filters (category, length, file type, upload date, language) and sort: id, title, description, link, page count, views, up and down votes, number of ratings, language, release date, cover image, search snippets and the uploader (id, name, profile link). Also the total, the number of pages, a corrected query and the filters the site offers for this search with their values (category and language ids). 40 per page. Pass `next_page` back as `page`; it is null on the last page. Document text is not included.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/scribd-search",
        "tags": [
          "Scribd"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "query",
            "in": "query",
            "required": true,
            "description": "Keywords, e.g. `python programming` or `business plan template`.",
            "schema": {
              "type": "string"
            },
            "example": "python programming"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "`most_relevant` (default), `top_rated` or `most_viewed`.",
            "schema": {
              "type": "string",
              "enum": [
                "most_relevant",
                "top_rated",
                "most_viewed"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "One or more category ids, comma separated (from the `filters` in a search response).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "pages",
            "in": "query",
            "required": false,
            "description": "Document length in pages.",
            "schema": {
              "type": "string",
              "enum": [
                "1-3",
                "4-100",
                "100+"
              ]
            }
          },
          {
            "name": "file_type",
            "in": "query",
            "required": false,
            "description": "One or more of pdf, word, epub, presentation, spreadsheet (comma separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "uploaded",
            "in": "query",
            "required": false,
            "description": "Uploaded within the last week, month, 3 months, 6 months or year.",
            "schema": {
              "type": "string",
              "enum": [
                "1week",
                "1month",
                "3month",
                "6month",
                "1year"
              ]
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "One or more language ids, comma separated (from the `filters` in a search response; 1 = English, 4 = Spanish).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "python programming",
                  "sort": "most_relevant",
                  "applied_filters": {},
                  "page": 1,
                  "total": 3526,
                  "total_pages": 89,
                  "next_page": 2,
