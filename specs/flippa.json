                  "monthly_profit": 51720,
                  "monthly_revenue": null,
                  "profit_margin": "32%",
                  "page_views": null,
                  "profit_multiple": "4.1x",
                  "revenue_multiple": "1.3x",
                  "comments": null,
                  "views": 11257,
                  "watchers": 349,
                  "flags": [
                    "Verified Listing",
                    "Editors Choice",
                    "… 4 more"
                  ],
                  "verified_items": [
                    "Revenue",
                    "Primary Expenses",
                    "… 2 more"
                  ],
                  "integrations": [],
                  "about": "The online dating platform, founded in 2014, is an established service focusing on relationship-based dating, primarily targeting Latin Amer…",
                  "broker": {
                    "role": "broker",
                    "name": "Nick Carlucci",
                    "location": "United States",
                    "bio": "Hi, I’m Nick Carlucci, an AM&AA Certified Broker based in Texas. I specialize in broker...",
                    "positive_feedback": "80.0%",
                    "transactions": "649 transactions totalling USD $288,211,788",
