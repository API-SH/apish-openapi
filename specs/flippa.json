          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/flippa/v1/search": {
      "get": {
        "operationId": "flippaSearch",
        "summary": "Flippa businesses for sale",
        "description": "Online businesses, websites, apps, domains and channels for sale on Flippa with the site's filters: category, industry, asking price, monthly revenue and profit, profit and revenue multiples, age, monthly uniques, page views and downloads, sale method, status, who manages the sale, keyword and sort. Each result has id, link, category, title, broker, flags, location, price type and asking price or bid, monthly revenue and profit, multiples, age, type, industry and connected data integrations. 50 per page; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/flippa-search",
        "tags": [
          "Flippa"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Categories, comma-separated: ai-apps-and-tools, amazon-fba, amazon-kdp, android-apps, content, crypto-and-blockchain, digital-agencies, domain, ecommerce, ios-apps, marketplaces, newsletters, other, plugins-and-extensions, projects-and-concepts, saas, services, social-media-accounts, youtube-channels.",
            "schema": {
              "type": "string"
            },
            "example": "saas"
          },
          {
            "name": "industry",
            "in": "query",
            "required": false,
            "description": "Industries, comma-separated: automotive, business, design-and-style, education, electronics, entertainment, food-and-drink, general-knowledge, health-and-beauty, hobbies-and-games, home-and-garden, internet, lifestyle, sports-and-outdoor, travel.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keyword.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price (USD).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price (USD).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "monthly_revenue_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly revenue.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "monthly_revenue_max",
            "in": "query",
            "required": false,
            "description": "Maximum monthly revenue.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "monthly_profit_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly profit.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "monthly_profit_max",
            "in": "query",
            "required": false,
            "description": "Maximum monthly profit.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "profit_multiple_min",
            "in": "query",
            "required": false,
            "description": "Minimum profit multiple.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "profit_multiple_max",
            "in": "query",
            "required": false,
            "description": "Maximum profit multiple.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "revenue_multiple_min",
            "in": "query",
            "required": false,
            "description": "Minimum revenue multiple.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "revenue_multiple_max",
            "in": "query",
            "required": false,
            "description": "Maximum revenue multiple.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "age_min",
            "in": "query",
            "required": false,
            "description": "Minimum age (years).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "age_max",
            "in": "query",
            "required": false,
            "description": "Maximum age (years).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "monthly_uniques_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly unique visitors.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "monthly_page_views_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly page views.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "monthly_downloads_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly downloads (apps).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sale_method",
            "in": "query",
            "required": false,
            "description": "auction or classified (comma-separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "open (default) or won (sold).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "managed_by",
            "in": "query",
            "required": false,
            "description": "flippa_broker, partner_broker or owner (comma-separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "lowest_price",
                "highest_price",
                "most_profitable",
                "most_active",
                "ending_soonest"
              ]
            },
            "example": "relevance"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
