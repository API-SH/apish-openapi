    "/ziprecruiter/v1/job": {
      "get": {
        "operationId": "ziprecruiterJob",
        "summary": "ZipRecruiter job posting",
        "description": "One ZipRecruiter job page: title, company, location, workplace, employment type, pay, posted dates, the full description (HTML and text), benefits, ZipRecruiter's extracted summary (responsibilities, qualifications) when present, and `education` (each education level the posting asks for, whether it is required or preferred, and whether ZipRecruiter inferred it). Use a job `url` from `/ziprecruiter/v1/search`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ziprecruiter-job",
        "tags": [
          "ZipRecruiter"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "Job page link from `/ziprecruiter/v1/search` (https://www.ziprecruiter.com/c/<Company>/Job/<Title>/-in-<City>?jid=<id>).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.ziprecruiter.com/c/Integra-Medical-Doctors/Job/Medical-Nurse-Practitioners/-in-Hoffman-Estates,IL?jid=f40aa699ef3c8111"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
