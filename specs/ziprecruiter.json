    "/ziprecruiter/v1/search": {
      "get": {
        "operationId": "ziprecruiterSearch",
        "summary": "ZipRecruiter job search",
        "description": "ZipRecruiter job search results, 20 per page: title, company (name, page, logo), location, workplace (on-site/remote/hybrid), employment type, pay (text, min/max, interval, annualised), posted dates, short description, job page and apply links. Filters: radius, days since posted, employment type, workplace (remote or on-site), yearly pay range and experience level. `total` is ZipRecruiter's match count; without an account ZipRecruiter shows 3 pages (60 jobs) per search, so `page` is 1 to 3 and `next_page` is null after page 3. `applied_filters` echoes what ZipRecruiter applied. Each job's `url` works with `/ziprecruiter/v1/job`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ziprecruiter-search",
        "tags": [
          "ZipRecruiter"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Job title or keywords (give `q`, `location` or both).",
            "schema": {
              "type": "string"
            },
            "example": "software engineer"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, state or ZIP code.",
            "schema": {
              "type": "string"
            },
            "example": "New York, NY"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Miles around `location` (ZipRecruiter default 25).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "days",
            "in": "query",
            "required": false,
            "description": "Only jobs posted within this many days, e.g. 1, 5, 10, 30.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "employment_type",
            "in": "query",
            "required": false,
            "description": "Employment type.",
            "schema": {
              "type": "string",
              "enum": [
                "full_time",
                "part_time",
                "contract",
                "temporary",
                "internship",
                "per_diem",
                "other"
              ]
            }
          },
          {
            "name": "workplace",
            "in": "query",
            "required": false,
            "description": "remote: remote jobs only; onsite: leaves out remote-only jobs.",
            "schema": {
              "type": "string",
              "enum": [
                "remote",
                "onsite"
              ]
            }
          },
          {
            "name": "min_salary",
            "in": "query",
            "required": false,
            "description": "Minimum yearly pay in US dollars (e.g. 80000 or 80k).",
            "schema": {
              "type": "integer"
            },
            "example": "80000"
          },
          {
            "name": "max_salary",
            "in": "query",
            "required": false,
            "description": "Maximum yearly pay in US dollars.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "experience",
            "in": "query",
            "required": false,
            "description": "Experience level.",
            "schema": {
              "type": "string",
              "enum": [
                "no_experience",
                "junior",
                "mid",
                "senior"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page 1 to 3. Pass `next_page` from the previous response.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
