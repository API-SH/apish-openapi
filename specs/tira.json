    "/tira/v1/search": {
      "get": {
        "operationId": "tiraSearch",
        "summary": "Tira search",
        "description": "Tira search, brand or category listing (India): uid, item code, name, link, brand, price, MRP, discount, rating, stock, sizes, tags and image, with brand, category, every sort and any listed filter, plus the filter lists with counts. Returns the first 12 results of a query, so there is no next page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/tira-search",
        "tags": [
          "Tira"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "lipstick"
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand slug, e.g. akind.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug, e.g. lipstick.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "latest",
                "discount_dsc",
                "price_asc",
                "price_dsc",
                "attributes.customaveragerating_desc"
              ]
            },
            "example": "price_asc"
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Other filters as key:value; separated by semicolons (keys from the filters list), e.g. primary-colour:Pink.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "lipstick",
                  "brand": null,
