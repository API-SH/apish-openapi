        "tags": [
          "Creator Tools"
        ],
        "x-credits": 6,
        "parameters": [
          {
            "name": "handle",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "mkbhd"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "websites",
            "in": "query",
            "required": false,
            "description": "false skips their website.",
            "schema": {
