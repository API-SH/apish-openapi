    "/creators/v1/find-social-profiles": {
      "get": {
        "operationId": "creatorsFindSocialProfiles",
        "summary": "Find a creator's other social profiles",
        "description": "Every response includes `credits_used`: the credits this call cost.\n\nChecks the handle on each platform and follows the links the profiles publish (bio links, link-in-bio pages). Confidence: high = linked from a profile, medium = same handle and name, low = same handle only.\n\nPrice: 3 credits per successful call. Docs: https://api.sh/docs/creators-find-social-profiles",
        "tags": [
          "Creator Tools"
        ],
        "x-credits": 3,
        "parameters": [
          {
            "name": "handle",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "example": "mkbhd"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Any profile URL instead of a handle.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "platforms",
            "in": "query",
            "required": false,
            "description": "Comma-separated subset: instagram,tiktok,youtube,twitter,threads,bluesky,twitch,kick,github,snapchat.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "input": "mkbhd",
                  "input_platform": null,
                  "count": 9,
                  "profiles": [
                    {
                      "platform": "twitter",
                      "username": "MKBHD",
                      "url": "https://x.com/MKBHD",
                      "name": "Marques Brownlee",
                      "followers": 6158117,
                      "verified": true,
                      "avatar": "https://pbs.twimg.com/profile_images/1990855181785759745/CP3H7WsL_400x400.jpg",
                      "confidence": "medium",
                      "evidence": [
                        "same_handle"
                      ],
                      "bio": "Web Video Producer | ⋈ | Pro Ultimate Frisbee Player | Host of @WVFRM @TheStudio",
                      "email": null,
                      "links": [
                        "http://MKBHD.com"
                      ],
                      "name_match": true
                    },
                    {
                      "platform": "instagram",
                      "username": "mkbhd",
                      "url": "https://www.instagram.com/mkbhd/",
                      "name": "Marques Brownlee",
                      "followers": 5304412,
                      "verified": true,
                      "avatar": "https://scontent-lhr6-1.cdninstagram.com/v/t51.82787-19/587817368_18545874469015447_3745195562993032801_n.jpg?stp=dst-jpg_s150x150_tt6&_nc_c…",
                      "confidence": "medium",
                      "evidence": [
                        "same_handle"
                      ],
                      "bio": "I promise I won't overdo the filters.",
                      "email": null,
                      "links": [
                        "https://mkbhd.com/"
                      ],
                      "name_match": true
                    },
                    "… 7 more"
                  ],
                  "other_links": [
                    "https://mkbhd.com/",
                    "http://MKBHD.com"
                  ],
                  "all_links": [
                    "https://mkbhd.com/",
                    "http://MKBHD.com"
                  ],
                  "bio_pages": [],
                  "platforms_checked": [
                    "instagram",
                    "tiktok",
                    "… 8 more"
                  ],
                  "platforms_skipped": [],
                  "linked_profiles_checked": [],
                  "by_confidence": {
                    "high": 0,
                    "medium": 6,
                    "low": 3
                  },
                  "cached": false,
                  "credits_used": 3
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Create keys at https://app.api.sh/keys. Authorization: Bearer <key> also works."
      }
    },
    "parameters": {
      "raw": {
        "name": "raw",
        "in": "query",
        "required": false,
        "description": "0 leaves out the bulky `raw` source blocks (often 10-30x smaller).",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Comma-separated fields to return, e.g. `posts.id,posts.title`. Call metadata is always included.",
        "schema": {
          "type": "string"
        }
      },
      "fresh": {
        "name": "fresh",
        "in": "query",
        "required": false,
        "description": "1 skips the 24-hour cache and fetches live.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "output": {
        "name": "output",
        "in": "query",
        "required": false,
        "description": "csv or ndjson returns the response's records (its main list, or the object as one row) as CSV or NDJSON instead of JSON.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "ndjson"
          ]
        }
      },
      "records": {
        "name": "records",
        "in": "query",
        "required": false,
        "description": "With output=csv|ndjson: the top-level list to turn into rows (e.g. `reviews`), or `.` for the whole object as one row.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "On a 503 for a paused endpoint: the status page, which lists open incidents."
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "responses": {
      "E400": {
        "description": "A parameter is missing or invalid. Not charged (unless the call ran and the source rejected the value; credits_used says).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E402": {
        "description": "Not enough credits, a spend limit you set was reached (`spend_limit`), or the key's monthly credit cap was reached (`key_cap`). Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
        "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E502": {
        "description": "The source site failed this time; retry. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E503": {
        "description": "Endpoint paused or temporarily unavailable; may include retry-after, and status_url (https://api.sh/status) for a paused endpoint. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "headers": {
      "x-request-id": {
        "description": "The call's id (logs, re-fetch with /v1/results/{id}).",
