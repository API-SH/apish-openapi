    "/purplebricks/v1/search": {
      "get": {
        "operationId": "purplebricksSearch",
        "summary": "Purplebricks property search",
        "description": "Homes for sale or to rent listed with Purplebricks around a UK place or postcode: address, postcode, distance, price (or monthly rent), bedrooms, bathrooms, receptions, property type and style ids, sold/under-offer flags, description, photo and count, and the Purplebricks local expert handling it. Filter by radius, price, bedrooms, property type, styles and sold/let; sort by price or newest. `property_styles` lists the styles in the area with their ids. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/purplebricks-search",
        "tags": [
          "Purplebricks"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "description": "UK town, area or postcode, e.g. Leeds, Didsbury, SW1A 1AA.",
            "schema": {
              "type": "string"
            },
            "example": "Leeds"
          },
          {
            "name": "channel",
            "in": "query",
            "required": false,
            "description": "For sale or to rent.",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent"
              ],
              "default": "sale"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Search radius in miles, 1-30.",
            "schema": {
              "type": "integer",
              "default": "20"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum price (monthly rent for channel=rent), GBP.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum price (monthly rent for channel=rent), GBP.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_beds",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_beds",
            "in": "query",
            "required": false,
            "description": "Maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Property type.",
            "schema": {
              "type": "string",
              "enum": [
                "house",
                "bungalow",
                "flat",
                "commercial",
                "other"
              ]
            }
          },
          {
            "name": "styles",
            "in": "query",
            "required": false,
            "description": "Comma-separated style ids from `property_styles` (e.g. 8 semi-detached house, 9 detached house, 12 flat).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sold",
            "in": "query",
            "required": false,
            "description": "true: only homes that are sold subject to contract or let agreed.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order of the results.",
            "schema": {
              "type": "string",
              "enum": [
                "price_desc",
                "price_asc",
                "newest"
              ],
              "default": "price_desc"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page, 1-50 (default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1 for the first. Pass back `next_page`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "applied_filters": {
                    "location": "Leeds",
                    "channel": "sale",
                    "radius": 20,
                    "sort": "price_desc"
                  },
                  "place": {
                    "name": "Leeds, West Yorkshire, England",
                    "latitude": 53.8007554,
                    "longitude": -1.5490774
                  },
                  "page": 1,
                  "limit": 20,
                  "total": 306,
