    "/spareroom/v1/search": {
      "get": {
        "operationId": "spareroomSearch",
        "summary": "SpareRoom room search",
        "description": "Rooms and flatshares offered on SpareRoom around any UK town, area, postcode or station, with every filter of the site's advanced search: rent and period, radius, room type, rooms for (females, males, couples), ages, beds, rooms in the property, terms, availability date, bills included, ensuite, furnished, shared living room, smoking, pets, parking, disabled access, no deposit, short lets, days available (e.g. Mon to Fri lets), household gender and ages, LGBT-friendly, vegetarian households, photos only, free to contact, advertiser type, keywords, and which ad kinds (rooms, 1-bed flats, whole properties). Each ad has title, rent and period, bills, room type, availability, neighbourhood and postcode, property type, rooms in the property, summary, flags, advertiser type and the name the ad shows, and photo. `total` is the site's count (it shows at most 1,000 per search). 10 a page; pass `next_cursor` back as `cursor` (null on the last page); `page` also works for a first call.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/spareroom-search",
        "tags": [
          "SpareRoom"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "description": "A UK town, area, postcode or station, e.g. `Manchester`, `E10`, `Brixton`.",
            "schema": {
              "type": "string"
            },
            "example": "Manchester"
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum rent.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum rent.",
            "schema": {
              "type": "integer"
            },
            "example": "700"
          },
          {
            "name": "per",
            "in": "query",
            "required": false,
            "description": "Period of price_min/price_max: pcm (default) or pw.",
            "schema": {
              "type": "string",
              "enum": [
                "pcm",
                "pw"
              ]
            }
          },
          {
            "name": "radius_miles",
            "in": "query",
            "required": false,
            "description": "Miles around the place: 0, 1, 2, 3, 4, 5, 10, 15, 20, 30, 40.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "room_type",
            "in": "query",
            "required": false,
            "description": "double or single.",
            "schema": {
              "type": "string",
              "enum": [
                "double",
                "single"
              ]
            }
          },
          {
            "name": "rooms_for",
            "in": "query",
            "required": false,
            "description": "females, males or couples.",
            "schema": {
              "type": "string",
              "enum": [
                "females",
                "males",
                "couples"
              ]
            }
          },
          {
            "name": "bills_included",
            "in": "query",
            "required": false,
            "description": "`true`: bills included.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "ensuite",
            "in": "query",
            "required": false,
            "description": "`true`: ensuite rooms.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "furnished",
            "in": "query",
            "required": false,
            "description": "`true` furnished, `false` unfurnished.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "parking",
            "in": "query",
            "required": false,
            "description": "`true`: parking.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "pets",
            "in": "query",
            "required": false,
            "description": "`true`: pets OK.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "smoking",
            "in": "query",
            "required": false,
            "description": "`true` smoking OK, `false` non-smoking.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "couples",
            "in": "query",
            "required": false,
            "description": "`true` couples considered, `false` no couples.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "no_deposit",
            "in": "query",
            "required": false,
            "description": "`true`: no deposit.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "short_lets",
            "in": "query",
            "required": false,
            "description": "`true`: short lets considered.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "disabled_access",
            "in": "query",
            "required": false,
            "description": "`true`: disabled access.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "photos_only",
            "in": "query",
            "required": false,
            "description": "`true`: ads with photos.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "min_term_months",
            "in": "query",
            "required": false,
            "description": "Minimum term (months, 0-15).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_term_months",
            "in": "query",
            "required": false,
            "description": "Maximum term (months, 0-15).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "available_from",
            "in": "query",
            "required": false,
            "description": "Available from (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days_available",
            "in": "query",
            "required": false,
            "description": "7 days a week, Mon to Fri only, or Weekends only.",
            "schema": {
              "type": "string",
              "enum": [
                "7 days a week",
                "Mon to Fri only",
                "Weekends only"
              ]
            }
          },
          {
            "name": "household_gender",
            "in": "query",
            "required": false,
            "description": "none, females, males or mixed.",
            "schema": {
              "type": "string",
              "enum": [
                "none",
                "females",
                "males",
                "mixed"
              ]
            }
          },
          {
            "name": "posted_by",
            "in": "query",
            "required": false,
            "description": "Advertiser type.",
            "schema": {
              "type": "string",
              "enum": [
                "private_landlords",
                "flatmates",
                "live_in",
                "live_out"
              ]
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "Keyword in the ad.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "default",
                "newest",
                "last_updated",
                "price_asc",
                "price_desc"
              ]
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "`next_cursor` from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "search_id": "1502711756",
                  "offset": 0,
                  "page": 1,
                  "total": 1000,
                  "total_is_lower_bound": true,
                  "count": 11,
                  "next_cursor": "1502711756:10",
                  "sort": "default",
                  "applied_filters": {
                    "location": "Manchester",
                    "per": "pcm",
                    "price_max": "700"
                  },
                  "listings": [
                    {
                      "id": "17966613",
                      "url": "https://www.spareroom.co.uk/flatshare/flatshare_detail.pl",
                      "title": "Luxury Room - Bills Included",
                      "type": "offered",
                      "featured": true,
                      "status": "new",
                      "rent": 650,
                      "rent_period": "pcm",
