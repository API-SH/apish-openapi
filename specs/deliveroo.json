    "/deliveroo/v1/restaurants": {
      "get": {
        "operationId": "deliverooRestaurants",
        "summary": "Deliveroo restaurants in an area, with dish search",
        "description": "Restaurants and shops Deliveroo lists for an area (UK, Ireland, France, Italy, Belgium, Netherlands, UAE, Kuwait, Qatar, Singapore, Hong Kong), optionally for a dish, cuisine or name search and a delivery point: id, name, menu link, rating, review count, distance, delivery time, offers, image and the card summary, plus the dishes the search matched (name, price and restaurant in the description, link, image). Pass a Deliveroo area link, or city and area as they appear in Deliveroo links; lat and lon narrow it to a delivery point.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/deliveroo-restaurants",
        "tags": [
          "Deliveroo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A Deliveroo area link (deliveroo.co.uk/restaurants/<city>/<area>, any Deliveroo country site). Or pass city and area.",
            "schema": {
              "type": "string"
            },
            "example": "https://deliveroo.co.uk/restaurants/london/soho"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Dish, cuisine or restaurant name to search for (optional).",
            "schema": {
              "type": "string"
            },
            "example": "burger"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Deliveroo country site when passing city and area (default uk).",
            "schema": {
              "type": "string",
              "enum": [
                "uk",
                "ie",
                "fr",
                "it",
                "be",
                "nl",
                "ae",
                "kw",
                "qa",
                "sg",
                "hk"
              ]
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City as in Deliveroo links, e.g. london, manchester, paris.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "area",
            "in": "query",
            "required": false,
            "description": "Area as in Deliveroo links, e.g. soho, leicester-square.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Delivery point latitude (with lon).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Delivery point longitude.",
            "schema": {
              "type": "number"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "country": "uk",
                  "city": "london",
                  "area": "soho",
                  "geohash": null,
                  "query": "burger",
                  "url": "https://deliveroo.co.uk/restaurants/london/soho?query=burger",
                  "subheader": "150 partners",
                  "count": 150,
                  "restaurants": [
