    "/vrbo/v1/search": {
      "get": {
        "operationId": "vrboSearch",
        "summary": "Vrbo vacation rental search",
        "description": "Vacation rentals Vrbo lists for a destination: property id, listing number, name, type and place, bedrooms, beds, bathrooms, highlights, free-cancellation deadline, guest rating with label and review count, nightly price (and the struck-through price), total for the stay, price notes, badges, photos and link. Filter with any value of the `filters` list each answer carries (guest rating, amenities, common spaces, house rules, property type, location, nearby activities, booking options, discounts, free cancellation, accessibility, beach access, premier host, ...), neighborhoods and a nightly or total price range. Give dates for prices and availability. 50 rentals per page: pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/vrbo-search",
        "tags": [
          "Vrbo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "destination",
            "in": "query",
            "required": true,
            "description": "Destination: city, region, area or landmark, e.g. `Lake Tahoe`, `Miami, Florida`, `Outer Banks`.",
            "schema": {
              "type": "string"
            },
            "example": "Lake Tahoe"
          },
          {
            "name": "check_in",
            "in": "query",
            "required": false,
            "description": "Check-in date (YYYY-MM-DD); with check_out, prices are for the stay.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "check_out",
            "in": "query",
            "required": false,
