{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Yupoo",
    "version": "1.0.0",
    "description": "The Yupoo API from API.SH: public Yupoo data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Yupoo",
      "description": "4 endpoints (e-commerce)",
      "x-slug": "yupoo",
      "x-domains": [
        "yupoo.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/yupoo/v1/album": {
      "get": {
        "operationId": "yupooAlbum",
        "summary": "Yupoo album with every photo",
        "description": "One Yupoo album: title, description, the links in its description (shop and marketplace links), photo count, cover, publish and update dates, and every photo (id, type, file name, width, height, original file, large and small versions, path; video formats for videos). Photo files are served only with the `image_referer` value as the `Referer` header. A password-protected album answers 403. Very large albums are split into pages: pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yupoo-album",
        "tags": [
          "Yupoo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "store",
            "in": "query",
            "required": false,
            "description": "Store name (e.g. `huali-1837`); not needed with `url`.",
            "schema": {
              "type": "string"
            },
            "example": "huali-1837"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Album id (the number in `/albums/<id>`).",
            "schema": {
              "type": "string"
            },
            "example": "258480569"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Album link instead of store and id, e.g. `https://huali-1837.x.yupoo.com/albums/258480569?uid=1`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page of a very large album (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": "258480569",
                  "store": "huali-1837",
                  "store_name": "华利",
                  "title": "中古欧美时尚黄铜特色项链Hl77B70",
                  "description": "中古欧美时尚黄铜特色项链Hl77B70",
                  "links": [],
                  "photo_count": 5,
                  "cover": "https://photo.yupoo.com/huali-1837_v/c241e846bb/medium.jpg",
                  "date_published": "2026-10-14",
                  "date_modified": "2026-10-14",
                  "url": "https://huali-1837.x.yupoo.com/albums/258480569?uid=1",
                  "image_referer": "https://huali-1837.x.yupoo.com/",
                  "page": 1,
                  "pages": 1,
                  "next_page": null,
                  "count": 5,
                  "photos": [
                    {
                      "id": "93016400",
                      "type": "photo",
                      "name": "wsxc1791964999254_4.jpg",
                      "width": 1263,
                      "height": 1263,
                      "original": "https://photo.yupoo.com/huali-1837_v/bd747b08a3/8fca23e8.jpg",
                      "large": "https://photo.yupoo.com/huali-1837_v/bd747b08a3/big.jpg",
                      "small": "https://photo.yupoo.com/huali-1837_v/bd747b08a3/small.jpg",
                      "path": "/huali-1837_v/bd747b08a3/8fca23e8.jpg",
                      "video_formats": null
                    },
                    {
                      "id": "93016399",
                      "type": "photo",
                      "name": "wsxc1791964999254_3.jpg",
                      "width": 1325,
                      "height": 1325,
                      "original": "https://photo.yupoo.com/huali-1837_v/be8ecd7eed/a040ebc8.jpg",
                      "large": "https://photo.yupoo.com/huali-1837_v/be8ecd7eed/big.jpg",
                      "small": "https://photo.yupoo.com/huali-1837_v/be8ecd7eed/small.jpg",
                      "path": "/huali-1837_v/be8ecd7eed/a040ebc8.jpg",
                      "video_formats": null
                    },
                    "… 3 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/yupoo/v1/albums": {
      "get": {
        "operationId": "yupooAlbums",
        "summary": "Yupoo store albums",
        "description": "A Yupoo store's albums, newest first, or one category's albums: album id, title, photo count, cover image and link (120 a page, as on the site). Pass `next_page` back as `page`; null on the last page. Photo files are served only with `Referer: https://<store>.x.yupoo.com/`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yupoo-albums",
        "tags": [
          "Yupoo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "store",
            "in": "query",
            "required": true,
            "description": "Store name (the subdomain of `<store>.x.yupoo.com`, e.g. `huali-1837`) or any link to the store.",
            "schema": {
              "type": "string"
            },
            "example": "huali-1837"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category id from `/yupoo/v1/store` (or a `/categories/<id>` link): that category's albums only.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back as `page`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
