    "/yupoo/v1/store": {
      "get": {
        "operationId": "yupooStore",
        "summary": "Yupoo store and its categories",
        "description": "A Yupoo store (a supplier's photo catalog at `<store>.x.yupoo.com`): store name, user id, the notice the store pins on its pages (often its contact channels), number of album pages, and its category tree (id, name, link, sub-categories). Use a category id with `/yupoo/v1/albums`. A store whose owner locked its pages with a password answers 403; a closed or unknown store answers 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yupoo-store",
        "tags": [
          "Yupoo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "store",
            "in": "query",
            "required": true,
            "description": "Store name (the subdomain of `<store>.x.yupoo.com`, e.g. `huali-1837`) or any link to the store.",
            "schema": {
              "type": "string"
            },
            "example": "huali-1837"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
