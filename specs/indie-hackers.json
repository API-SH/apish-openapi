    "/indiehackers/v1/product": {
      "get": {
        "operationId": "indiehackersProduct",
        "summary": "Indie Hackers product page",
        "description": "One Indie Hackers product: name, tagline, logo, website, X and Facebook links, monthly revenue (and whether Stripe verified), post count and its posts (title, link, date, excerpt).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/indiehackers-product",
        "tags": [
          "Indie Hackers"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "slug",
