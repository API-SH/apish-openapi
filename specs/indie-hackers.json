    "/indiehackers/v1/posts": {
      "get": {
        "operationId": "indiehackersPosts",
        "summary": "Indie Hackers posts",
        "description": "Indie Hackers forum posts: the newest, or the top posts of a week or a month. Each post has its title, link, author, upvotes, comment count and posting time. Ten pages of 20 per feed; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/indiehackers-posts",
        "tags": [
          "Indie Hackers"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "feed",
            "in": "query",
            "required": false,
            "description": "Feed (default newest).",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "top-week",
                "top-month"
              ]
            },
            "example": "newest"
          },
          {
            "name": "week",
            "in": "query",
            "required": false,
            "description": "With feed=top-week: any day of the week (YYYY-MM-DD; default this week).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "With feed=top-month: the month (YYYY-MM; default this month).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page (1-10, default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
