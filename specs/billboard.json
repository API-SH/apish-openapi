          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/billboard/v1/charts": {
      "get": {
        "operationId": "billboardCharts",
        "summary": "Billboard charts list",
        "description": "The main weekly Billboard charts with their slugs, names, kind (songs, albums or artists) and links, to use with /billboard/v1/chart.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/billboard-charts",
