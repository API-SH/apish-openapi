    "/billboard/v1/news": {
      "get": {
        "operationId": "billboardNews",
        "summary": "Billboard news articles",
        "description": "Billboard's articles, newest first, optionally matching a search term or about one artist: title, summary, link, published and modified times, section, authors, keywords and the lead image.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/billboard-news",
        "tags": [
          "Billboard"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search term.",
            "schema": {
              "type": "string"
            },
            "example": "grammy"
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "description": "Only articles tagged with this artist (the billboard.com/artist/<name>/ link, its <name> part or the name).",
            "schema": {
              "type": "string"
            },
            "example": "taylor-swift"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page (1-100).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Articles a page (1-50, default 20).",
            "schema": {
              "type": "integer"
            },
            "example": "20"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
