                      "title": "Rockin' Around The Christmas Tree",
                      "artist": "Brenda Lee",
                      "is_new": false,
                      "is_reentry": false,
                      "last_week": 2,
                      "change": 1,
                      "peak_position": 1,
                      "weeks_on_chart": 58,
                      "weeks_at_no1": 3,
                      "debut_position": 64,
                      "debut_date": "1960-12-12",
                      "peak_date": "2023-12-09",
                      "awards": [
