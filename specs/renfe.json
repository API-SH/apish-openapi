{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Renfe",
    "version": "1.0.0",
    "description": "The Renfe API from API.SH: public Renfe data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Renfe",
      "description": "4 endpoints (travel & events)",
      "x-slug": "renfe",
      "x-domains": [
        "renfe.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/renfe/v1/price-calendar": {
      "get": {
        "operationId": "renfePriceCalendar",
        "summary": "Renfe lowest fare per day",
        "description": "The lowest Renfe fare of each day between two stations (up to 92 days a call), as the search form's calendar shows it, and the cheapest day. Days without trains or fares on sale have no price.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/renfe-price-calendar",
        "tags": [
          "Renfe"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Departure station code or name (see /renfe/v1/stations).",
            "schema": {
              "type": "string"
            },
            "example": "MADRI"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Arrival station code or name.",
            "schema": {
              "type": "string"
            },
            "example": "BARCE"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "description": "First day (YYYY-MM-DD). Default today.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days_ahead",
            "in": "query",
            "required": false,
            "description": "First day as days from today, when `date_from` is not given.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "description": "Last day (YYYY-MM-DD). Default 30 days after the first day.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "from": {
                    "code": "MADRI",
                    "name": "MADRID (TODAS)"
                  },
                  "to": {
                    "code": "BARCE",
                    "name": "BARCELONA (TODAS)"
                  },
                  "date_from": "2026-11-19",
                  "date_to": "2026-12-19",
                  "currency": "EUR",
                  "cheapest": {
                    "date": "2026-11-25",
                    "price": 30,
                    "currency": "EUR",
                    "available": true
                  },
                  "count": 31,
                  "days": [
                    {
                      "date": "2026-11-19",
                      "price": 32,
                      "currency": "EUR",
                      "available": true
                    },
                    {
                      "date": "2026-11-20",
                      "price": 32,
                      "currency": "EUR",
                      "available": true
                    },
                    "… 29 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/renfe/v1/stations": {
      "get": {
        "operationId": "renfeStations",
        "summary": "Renfe stations",
        "description": "Every station Renfe sells tickets for, with its code, name, UIC code and whether it is an all-stations group of a city (e.g. MADRI for all Madrid stations). Filter by name.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/renfe-stations",
        "tags": [
          "Renfe"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Text to match in the station name or code, e.g. `sevilla`.",
            "schema": {
              "type": "string"
            },
            "example": "sevilla"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results (default 50 with `q`, all without).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "sevilla",
                  "total": 1,
                  "count": 1,
                  "stations": [
                    {
                      "code": "51003",
                      "name": "SEVILLA-SANTA JUSTA",
                      "uic": "51003",
                      "all_stations": false,
                      "key": "0071,51003,51003"
                    }
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/renfe/v1/train": {
      "get": {
        "operationId": "renfeTrain",
        "summary": "Renfe train calling points",
        "description": "Every stop of a Renfe train on a day: station code and name, arrival and departure times, boarding and alighting, and the train type and line. With `days_ahead` the next day the train runs (up to 7 days later) is returned. Covers days in Renfe's new sales calendar.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/renfe-train",
        "tags": [
          "Renfe"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "number",
            "in": "query",
            "required": true,
            "description": "Train number, e.g. 02070.",
            "schema": {
              "type": "string"
            },
            "example": "02070"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Day, YYYY-MM-DD. Give this or `days_ahead`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days_ahead",
            "in": "query",
            "required": false,
            "description": "Day as days from today (0-365), when `date` is not given.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "number": "02070",
                  "date": "2027-03-05",
                  "train_type": "AVE",
                  "type_code": "AV1",
                  "line": "AVE MADRID PTA.AT-SEVILLA S.J.",
                  "operator": "AV",
                  "first_departure": "2027-03-05T06:00:00Z",
                  "stops": [
                    {
                      "code": "60000",
                      "name": "MADRID-PUERTA DE ATOCHA-ALMUDENA GRANDES",
                      "arrival": null,
                      "departure": "2027-03-05T06:00:00Z",
                      "distance_km": 0,
                      "active": true,
                      "skipped": false,
                      "boarding": true,
                      "alighting": true
                    },
                    {
                      "code": "37200",
                      "name": "CIUDAD REAL",
                      "arrival": "2027-03-05T06:53:00Z",
                      "departure": "2027-03-05T06:55:00Z",
                      "distance_km": 0.2,
                      "active": true,
                      "skipped": false,
                      "boarding": true,
                      "alighting": true
                    },
                    "… 3 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/renfe/v1/trains": {
      "get": {
        "operationId": "renfeTrains",
        "summary": "Renfe train search",
        "description": "Renfe trains between two stations on a day, as the booking site lists them: departure and arrival times, duration, direct or with changes, train types (AVE, Avlo, Alvia, Euromed, Intercity and others) and numbers, the lowest price, every fare (Básico, Elige, Elige Confort, Prémium and others) with its price, class and conditions, sold-out flag, wheelchair, pet and bike space, and each leg with its notices. Filter by direct trains, wheelchair space, pets and bikes. For days in Renfe's new sales calendar the timetable is returned with fares once they are on sale.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/renfe-trains",
        "tags": [
          "Renfe"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Departure station code or name (see /renfe/v1/stations).",
            "schema": {
              "type": "string"
            },
            "example": "60000"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Arrival station code or name.",
            "schema": {
              "type": "string"
            },
            "example": "71801"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Departure day, YYYY-MM-DD. Give this or `days_ahead`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days_ahead",
            "in": "query",
            "required": false,
            "description": "Departure day as days from today (0-365), when `date` is not given.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "adults",
            "in": "query",
            "required": false,
            "description": "Adults (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "children",
            "in": "query",
            "required": false,
            "description": "Children (default 0).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "infants",
            "in": "query",
            "required": false,
            "description": "Infants (default 0).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "direct",
            "in": "query",
            "required": false,
            "description": "`1` for trains without changes only.",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "wheelchair",
            "in": "query",
            "required": false,
            "description": "`1` for trains with wheelchair space.",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "pet",
            "in": "query",
            "required": false,
            "description": "`1` for trains with space for a dog of 10-40 kg.",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "name": "bike",
            "in": "query",
            "required": false,
            "description": "`1` for trains with space for an unfolded bike.",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "1"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
