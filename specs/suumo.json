    "/suumo/v1/rentals": {
      "get": {
        "operationId": "suumoRentals",
        "summary": "SUUMO rental search",
        "description": "Rentals on SUUMO (suumo.jp) in a prefecture or cities: `buildings` with `name`, `type`, `address`, `access` (station and walk), `age`, `floors`, `image` and `rooms` (`id`, `floor`, `rent`, `management_fee`, `deposit`, `key_money` in yen, `layout`, `area_sqm`, `tags`, `url`, `photos`). `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/suumo-rentals",
        "tags": [
          "SUUMO"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "prefecture",
            "in": "query",
            "required": true,
            "description": "Prefecture code 1-47 (13 = Tokyo, 27 = Osaka, 14 = Kanagawa).",
            "schema": {
              "type": "integer"
            },
            "example": "13"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "5-digit municipality codes, comma-separated (e.g. `13101` = Chiyoda).",
            "schema": {
              "type": "string"
            },
            "example": "13101"
          },
          {
            "name": "rent_min",
            "in": "query",
            "required": false,
            "description": "Lowest monthly rent (yen).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "rent_max",
            "in": "query",
            "required": false,
            "description": "Highest monthly rent (yen).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "layout",
            "in": "query",
            "required": false,
            "description": "Comma-separated: `1R`, `1K`, `1DK`, `1LDK`, `2K`, `2DK`, `2LDK`, `3K`, `3DK`, `3LDK`, `4K`, `4DK`, `4LDK`, `5K+`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
