{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: SUUMO",
    "version": "1.0.0",
    "description": "The SUUMO API from API.SH: public SUUMO data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "SUUMO",
      "description": "4 endpoints (real estate)",
      "x-slug": "suumo",
      "x-domains": [
        "suumo.jp"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/suumo/v1/for-sale": {
      "get": {
        "operationId": "suumoForSale",
        "summary": "SUUMO homes for sale",
        "description": "Homes and land for sale on SUUMO (suumo.jp): used condos, used houses, new houses and land in a prefecture and its cities, with price, floor, building and land area, layout (rooms), walk to station, building age and keyword filters and the site's sorts. Each item: `id`, link, title, property name, `price` in yen (and `price_max` for a range), price text, address, station access, layout, area, land area, balcony, built date, building coverage, tags (photos on file, open house...), the listing agency with its phone, the agent and comment, photos and every detail row the card shows (`details`). `total` is the site's match count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/suumo-for-sale",
        "tags": [
          "SUUMO"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "used_condo (default), used_house, new_house or land.",
            "schema": {
              "type": "string",
              "enum": [
                "used_condo",
                "used_house",
                "new_house",
                "land"
              ]
            },
            "example": "used_condo"
          },
          {
            "name": "prefecture",
            "in": "query",
            "required": true,
            "description": "JIS prefecture code 1-47 (13 = Tokyo, 27 = Osaka, 14 = Kanagawa).",
            "schema": {
              "type": "string"
            },
            "example": "13"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "Comma-separated 5-digit municipality codes in the prefecture, e.g. 13113 (Shibuya).",
            "schema": {
              "type": "string"
            },
            "example": "13113"
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price in yen.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price in yen.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "area_min",
            "in": "query",
            "required": false,
            "description": "Minimum floor area in m² (building area for houses, land area for land).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "area_max",
            "in": "query",
            "required": false,
            "description": "Maximum floor area in m².",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "land_area_min",
            "in": "query",
            "required": false,
            "description": "Houses and land: minimum land area in m².",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "land_area_max",
            "in": "query",
            "required": false,
            "description": "Houses and land: maximum land area in m².",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "layout",
            "in": "query",
            "required": false,
            "description": "Comma-separated room counts: 1R (one room), 1, 2, 3, 4, 5+.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "walk_max",
            "in": "query",
            "required": false,
            "description": "Maximum minutes on foot to the station (1, 3, 5, 7, 10, 15, 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "age_max",
            "in": "query",
            "required": false,
            "description": "Maximum building age in years.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "keyword",
            "in": "query",
            "required": false,
            "description": "Free-text keyword.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "recommended, newest, address_asc, address_desc, price_asc, price_desc, area_desc, area_asc, rooms_desc, rooms_asc, built_newest, built_oldest.",
            "schema": {
              "type": "string",
              "enum": [
                "recommended",
                "newest",
                "address_asc",
                "address_desc",
                "price_asc",
                "price_desc",
                "area_desc",
                "area_asc",
                "rooms_desc",
                "rooms_asc",
                "built_newest",
                "built_oldest"
              ]
            }
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Listings per page: 10, 20, 30 (default) or 50.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/suumo/v1/for-sale-listing": {
      "get": {
        "operationId": "suumoForSaleListing",
        "summary": "SUUMO home for sale",
        "description": "One home or plot for sale on SUUMO, from its outline page: title, `price` in yen (and `price_max`), management fee, repair reserve, layout, floor and land area, balcony, built date, floor, facing, structure, total units, handover, renovation, land rights, zoning, parking, address, access, building coverage, the listing agency with its phone and company details (licence, address), publication and next-update dates, and every outline row the page shows (`outline`). Pass a listing link from `/suumo/v1/for-sale` (`items[].url`), or `latest=true` with its search parameters to open the first current match.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/suumo-for-sale-listing",
        "tags": [
          "SUUMO"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A suumo.jp for-sale listing link (`items[].url`). Required unless latest=true.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`true`: the first listing of a `/suumo/v1/for-sale` search with the other parameters.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "With latest=true: used_condo, used_house, new_house or land.",
            "schema": {
              "type": "string",
              "enum": [
                "used_condo",
                "used_house",
                "new_house",
                "land"
              ]
            }
          },
          {
            "name": "prefecture",
            "in": "query",
            "required": false,
            "description": "With latest=true: JIS prefecture code.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "With latest=true: municipality code.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/suumo/v1/rental": {
      "get": {
        "operationId": "suumoRental",
        "summary": "SUUMO rental listing",
        "description": "One rental on SUUMO: `name`, `agency`, `rent`, `management_fee`, `deposit`, `key_money`, `layout`, `layout_detail`, `area_sqm`, `facing`, `building_type`, `age`, `built`, `structure`, `floor`, `address`, `access`, `parking`, `move_in`, `conditions`, `total_units`, `contract`, `brokerage_fee`, `guarantor`, `updated`, `features`, `nearby`, `photos` and `raw`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/suumo-rental",
        "tags": [
          "SUUMO"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "12-digit room id (`rooms[].id` in `/suumo/v1/rentals`) or its suumo.jp/chintai/bc_<id>/ link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "prefecture",
            "in": "query",
            "required": false,
            "description": "Instead of `id`: the first room of a `/suumo/v1/rentals` search with these params (prefecture, city and filters).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "With `prefecture`: municipality codes.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
