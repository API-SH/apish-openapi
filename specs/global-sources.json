    "/globalsources/v1/search": {
      "get": {
        "operationId": "globalsourcesSearch",
        "summary": "Global Sources product search",
        "description": "Search wholesale products from verified suppliers: name, link, image, price or price range with unit, minimum order, lead time, FOB port, model number, verification flags, trade show, and the supplier (id, name, location, rank, years on the site, business types, highlight). Includes the category tree and every filter with its options and counts; pass an option's `value` to the filter named in `param`. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/globalsources-search",
        "tags": [
          "Global Sources"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Product, e.g. `bluetooth speaker`.",
            "schema": {
              "type": "string"
            },
            "example": "bluetooth speaker"
          },
          {
            "name": "business_type",
            "in": "query",
            "required": false,
            "description": "Verified business type, e.g. `Manufacturer` (comma-separated for several).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Supplier location, e.g. `China` or `China-Guangdong`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "product_cert",
            "in": "query",
            "required": false,
            "description": "Product certificate, e.g. `CE`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "company_cert",
            "in": "query",
            "required": false,
            "description": "Company certificate, e.g. `ISO 9001:2015`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "years_in_business",
            "in": "query",
            "required": false,
            "description": "Years in business: `30`, `25-30`, `15-25`, `5-15` or `0-5`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "supplier_rank",
            "in": "query",
            "required": false,
            "description": "Supplier ranking, `0`-`6`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_order",
            "in": "query",
            "required": false,
            "description": "Maximum minimum order quantity you accept.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "lead_time",
            "in": "query",
            "required": false,
            "description": "Maximum lead time in days.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "oem",
            "in": "query",
            "required": false,
            "description": "Suppliers offering OEM services only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "trade_show",
            "in": "query",
            "required": false,
            "description": "Suppliers at trade shows only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "fob_port",
            "in": "query",
            "required": false,
            "description": "FOB port, e.g. `Shenzhen`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "seller_type",
            "in": "query",
            "required": false,
            "description": "Business type, e.g. `Wholesaler`, `Online Seller`, `Trading Company`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category_id",
            "in": "query",
            "required": false,
            "description": "Category id (from `categories`).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "feature",
            "in": "query",
            "required": false,
            "description": "Feature filter value from `filters`, e.g. `Feature_attr_Waterproof`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "usage",
            "in": "query",
            "required": false,
            "description": "Usage filter value from `filters`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "function",
            "in": "query",
            "required": false,
            "description": "Multi-function filter value from `filters`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1-500 (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page, 1-80 (default 40).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
