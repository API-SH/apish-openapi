    "/globalsources/v1/product": {
      "get": {
        "operationId": "globalsourcesProduct",
        "summary": "Global Sources product",
        "description": "One product: name, brand, model, aliases, price tiers by order quantity (USD), minimum order, lead time, payment method, samples, export markets, country of origin, shipping details, attributes, description, images, video and PDF links, categories, rating summary, and the supplier (company, homepage, highlights, country, business type, employees, annual sales, year established, verification flags, response rate, registered name and number, address), its product categories and related products.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/globalsources-product",
        "tags": [
          "Global Sources"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Product id or product page URL, e.g. `1235814321`.",
            "schema": {
              "type": "string"
