    "/tradeindia/v1/search": {
      "get": {
        "operationId": "tradeindiaSearch",
        "summary": "TradeIndia product search",
        "description": "Search TradeIndia's Indian B2B catalogue: product name and long title, price text with amount and currency, minimum order quantity, image, description, specifications, stock flag, and the supplier (name, profile link, city, state, business types, member years, trust stamp, seller tiers, response rate, online shop). Filter by city and by business type, trust stamp, buyer feedback, listed price and online shop; the city list in `cities` gives values for `city`. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/tradeindia-search",
        "tags": [
          "TradeIndia"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Product or service, e.g. `steel pipes`.",
            "schema": {
              "type": "string"
            },
            "example": "steel pipes"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "City filter, e.g. `pune` (values in `cities`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "manufacturer",
            "in": "query",
            "required": false,
            "description": "Manufacturers only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "supplier",
            "in": "query",
            "required": false,
            "description": "Suppliers only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "exporter",
            "in": "query",
            "required": false,
            "description": "Exporters only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "trader",
            "in": "query",
            "required": false,
            "description": "Traders only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "wholesaler",
            "in": "query",
            "required": false,
            "description": "Wholesalers and distributors only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "trust_stamp",
            "in": "query",
            "required": false,
            "description": "Trust-stamp members only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "buyer_feedback",
            "in": "query",
            "required": false,
            "description": "Suppliers with buyer feedback only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "with_price",
            "in": "query",
            "required": false,
            "description": "Listings with a price only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "shop_online",
            "in": "query",
            "required": false,
            "description": "Listings that can be bought online only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1-500 (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page, 11-50 (default 30).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
