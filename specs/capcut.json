    "/capcut/v1/templates": {
      "get": {
        "operationId": "capcutTemplates",
        "summary": "CapCut template gallery",
        "description": "CapCut's template gallery: the shelves the templates page shows (editor's pick, social, holiday, calendar, anniversary, recap, effects, industry, business, insights, others), each with its templates (title, uses, likes, duration, clips, cover, preview video, upload date).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/capcut-templates",
        "tags": [
          "CapCut"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "One shelf, or all (default).",
            "schema": {
              "type": "string",
              "enum": [
                "all",
                "editors-pick",
                "social",
                "holiday",
                "calendar",
                "anniversary",
                "record",
                "effects",
                "industry",
                "business",
                "insights",
                "others"
              ]
            },
            "example": "editors-pick"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
