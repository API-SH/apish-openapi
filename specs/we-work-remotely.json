    "/weworkremotely/v1/jobs": {
      "get": {
        "operationId": "weworkremotelyJobs",
        "summary": "We Work Remotely latest jobs",
        "description": "The newest remote jobs on We Work Remotely, all or for one category, as the site publishes them in its feeds: title, company, url, region, country, state, skills, category, job type, posted and expiry dates, company logo and the full description (HTML and text). No paging: the feed holds the latest jobs.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/weworkremotely-jobs",
        "tags": [
          "We Work Remotely"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category.",
            "schema": {
              "type": "string",
              "enum": [
                "programming",
                "full-stack-programming",
                "front-end-programming",
                "back-end-programming",
                "design",
                "product-design",
                "ux-ui-design",
                "customer-support",
                "devops-sysadmin",
                "management-and-finance",
                "product",
                "sales-and-marketing",
                "other"
              ]
            },
            "example": "back-end-programming"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "At most this many jobs (default 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
