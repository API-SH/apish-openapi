    "/weworkremotely/v1/job": {
      "get": {
        "operationId": "weworkremotelyJob",
        "summary": "We Work Remotely job details",
        "description": "One We Work Remotely job: title, company (slug, page, website, headquarters, jobs posted), posted and apply-before dates, employment type, category, regions, skills, applicant countries, salary when given, the apply link and the full description (HTML and text). Removed jobs answer 404. Give id/url, or q to open the first current result of a search.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/weworkremotely-job",
        "tags": [
          "We Work Remotely"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Job URL (weworkremotely.com/remote-jobs/…) or its slug (`id` is accepted too).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Instead of url: keywords; opens the first current result of that search (all /weworkremotely/v1/search filters apply).",
            "schema": {
              "type": "string"
            },
            "example": "developer"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
