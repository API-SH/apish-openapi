    "/weworkremotely/v1/search": {
      "get": {
        "operationId": "weworkremotelySearch",
        "summary": "We Work Remotely job search",
        "description": "We Work Remotely's advanced search: keyword plus categories, applicant countries, salary ranges, skills and date posted. Each job: `id`, `title`, `url`, `company`, `company_slug`, `company_url`, `company_logo`, `headquarters`, `posted`, `job_types`, `regions`, `salary`, `category_id` and boosted, featured, Top 100 and hot flags. `skill_options` lists the skill ids the `skills` filter takes. Every match is on one page (no paging).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/weworkremotely-search",
        "tags": [
          "We Work Remotely"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
