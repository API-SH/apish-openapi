    "/justdial/v1/search": {
      "get": {
        "operationId": "justdialSearch",
        "summary": "Justdial business search",
        "description": "Local businesses on Justdial (India) for a category or keyword in a city, optionally in one area, sorted by relevance, distance, rating or popularity: docid, name, link, category, address, area, city, coordinates, rating, review count, verified flag, phone, open status and today's hours, price info (e.g. price for two), highlight (e.g. years in business), thumbnail, video and sponsored flags, plus the matched category id, the site's sort options and the search centre. 10 businesses per page; `total_at_least` grows as you page (the site does not give a final count). Pass `next_page` back as `page`; null on the last page. A brand name the site files under its own page answers `redirect_url` with no results: search the brand's category instead, or use /justdial/v1/autocomplete to find its outlets.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/justdial-search",
        "tags": [
          "Justdial"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": true,
            "description": "An Indian city, e.g. `Mumbai`, `Delhi`, `Bangalore`, `Pune`, `Hyderabad`, `Chennai`.",
            "schema": {
              "type": "string"
            },
            "example": "Mumbai"
          },
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Category or keyword, e.g. `Restaurants`, `Dentists`, `Gyms`, `Packers and Movers`.",
            "schema": {
              "type": "string"
            },
            "example": "Restaurants"
          },
          {
            "name": "area",
            "in": "query",
            "required": false,
            "description": "Area within the city, as Justdial names it (e.g. `Andheri West`); /justdial/v1/autocomplete with `type=where` lists them.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default `relevance`).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "distance",
                "rating",
                "popular"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, 1-50 (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
