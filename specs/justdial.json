    "/justdial/v1/reviews": {
      "get": {
        "operationId": "justdialReviews",
        "summary": "Justdial business reviews",
        "description": "Reviews of one business on Justdial, sorted as the site offers (most relevant, latest, highest rated first): review id, reviewer name and avatar, rating, text, date, the reviewer's review count, likes, comments, link, the tags the reviewer picked, photos and the owner's reply, plus the business's overall rating and rating count and the total number of written reviews. 10 reviews per page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/justdial-reviews",
        "tags": [
          "Justdial"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "docid",
