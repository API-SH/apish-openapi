    "/cnn/v1/headlines": {
      "get": {
        "operationId": "cnnHeadlines",
        "summary": "CNN headlines of the last two days",
        "description": "Everything CNN published in the last two days (usually 200+ stories), newest first: headline, link, publication and update times, section, type (article, video, live updates, gallery, interactive), keywords and image, with section, type, keyword and time filters. `sections_available` lists the sections present now. With `month` (and `section`), the stories of that section in that month instead, from CNN's monthly archive going back years: link, publication date (from the link), last update, lead image with `image_caption`, and a title read from the link (the archive carries no headline or keywords). Article bodies are not returned.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/cnn-headlines",
        "tags": [
          "CNN"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "Section as in CNN's addresses: politics, world, us, business, economy, markets, health, entertainment, sport, style, travel, climate, weather, science, media, tech... Required with month.",
            "schema": {
              "type": "string"
            },
            "example": "politics"
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Story type.",
            "schema": {
              "type": "string",
              "enum": [
                "article",
                "video",
                "live",
                "gallery",
                "interactive"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Only stories whose headline or keywords (with month: title or image caption) contain all these words.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Only stories published at or after this date or ISO time.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "month",
            "in": "query",
            "required": false,
            "description": "YYYY-MM: that month's stories of `section` from CNN's archive instead of the last two days.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum stories (default 50, max 300).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
