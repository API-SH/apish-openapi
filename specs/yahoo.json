    "/yahoo/v1/videos": {
      "get": {
        "operationId": "yahooVideos",
        "summary": "Yahoo Videos",
        "description": "Yahoo video results: 60 per page with video URL, embed URL, title, duration, publisher, views, description and thumbnail. Pass `next_page` back as `page`. Filter by duration, age, source site, HD and SafeSearch; `search_parameters` echoes the filters applied. Every response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yahoo-videos",
        "tags": [
          "Yahoo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query.",
            "schema": {
              "type": "string"
            },
            "example": "red panda"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Two-letter country of the Yahoo edition (US default).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1 = first).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "description": "Video length.",
            "schema": {
              "type": "string",
              "enum": [
                "short",
                "medium",
                "long"
              ]
            }
          },
          {
            "name": "time",
            "in": "query",
            "required": false,
            "description": "Only videos from the past day, week, month or year.",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "description": "Only videos from this site.",
            "schema": {
              "type": "string",
              "enum": [
                "youtube",
                "dailymotion",
                "vimeo",
                "mtv",
                "cbsnews",
                "foxnews",
                "cnn",
                "msn"
              ]
            }
          },
          {
            "name": "resolution",
            "in": "query",
            "required": false,
            "description": "hd for high-definition videos only.",
            "schema": {
              "type": "string",
              "enum": [
                "hd"
              ]
            }
          },
          {
            "name": "safe",
            "in": "query",
            "required": false,
            "description": "SafeSearch level.",
            "schema": {
              "type": "string",
              "enum": [
                "strict",
                "moderate",
                "off"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
