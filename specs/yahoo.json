    "/yahoo/v1/search": {
      "get": {
        "operationId": "yahooSearch",
        "summary": "Yahoo Search",
        "description": "Yahoo web results: 10 per page with position, title, real destination URL, displayed URL, snippet, date and sitelinks, plus related searches, the knowledge panel and the local pack when Yahoo shows them. Pass `next_page` back as `page`; it is null on the last page. `site` limits results to one domain and `safe` sets SafeSearch; `search_parameters` echoes both. Every response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yahoo-search",
        "tags": [
          "Yahoo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query.",
            "schema": {
              "type": "string"
            },
            "example": "coffee machine"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Two-letter country of the Yahoo edition (US default; GB, DE, FR, CA, AU, IN, BR, TW, ...).",
            "schema": {
              "type": "string"
            },
            "example": "US"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1 = first).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "time",
            "in": "query",
            "required": false,
            "description": "Only results from the past day, week or month.",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month"
              ]
            }
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "description": "Only results from this domain, e.g. wikipedia.org.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "safe",
            "in": "query",
            "required": false,
            "description": "SafeSearch level.",
            "schema": {
              "type": "string",
              "enum": [
                "strict",
                "moderate",
                "off"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "search_parameters": {
                    "engine": "yahoo",
                    "q": "Eiffel Tower",
                    "country": "US",
                    "page": 1,
                    "time": null
                  },
                  "query": "Eiffel Tower",
                  "page": 1,
                  "count": 10,
                  "results": [
                    {
                      "position": 1,
