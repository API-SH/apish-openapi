    "/zalando/v1/search": {
      "get": {
        "operationId": "zalandoSearch",
        "summary": "Zalando search",
        "description": "Fashion products for a search or a category on Zalando (17 European shops): name, brand, price, original price, discount, currency, flags (deal, top rated...), target group, image and the full product card in `raw`, 48 per page, plus the total, the category tree and every filter facet with its option keys. Filter with `brand`, `color`, `size` or `filter=facet:option1|option2` using keys from `facets`, plus `min_price`, `max_price`, `sale` and `toggle`. Pass `next_cursor` back as `cursor`; it is null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/zalando-search",
        "tags": [
          "Zalando"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search text. Required unless `category` is given.",
            "schema": {
              "type": "string"
            },
            "example": "dress"
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "description": "Which Zalando shop (default uk). de_en is the German shop in English.",
            "schema": {
              "type": "string",
              "enum": [
                "uk",
                "ie",
                "de",
                "de_en",
                "fr",
                "it",
                "es",
                "nl",
                "be",
                "at",
                "ch",
                "pl",
                "se",
                "dk",
                "fi",
                "no",
                "cz"
              ]
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "A category slug such as women, men, kids or streetwear-mens-shoes-sneakers (see `categories[].id`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "popularity",
                "newest",
                "price_asc",
                "price_desc",
                "sale"
              ]
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Brand keys from the brands facet, comma-separated (e.g. NI1 for Nike Sportswear).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "color",
            "in": "query",
            "required": false,
            "description": "Colour keys from the colors facet, comma-separated (e.g. BLACK).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Size keys from the sizes facet, comma-separated (e.g. M).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Any discrete facet as key:option1|option2 (e.g. upper_materials:leather); repeat or separate with ;.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "sale",
            "in": "query",
            "required": false,
            "description": "true: discounted items only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "toggle",
            "in": "query",
            "required": false,
            "description": "Toggle facet keys, comma-separated (e.g. shipped_by_zalando).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pass `next_cursor` from the previous response; `next_cursor` is null on the last page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
