    "/boohoo/v1/product": {
      "get": {
        "operationId": "boohooProduct",
        "summary": "boohoo product details",
        "description": "One boohoo product: id, name, brand, description, category, style, gender, department, collection, attributes (neckline, sleeve length, length, occasion, design), badges, breadcrumbs, dates, and every colour with its sizes (SKU, EAN, price, was price, discounts, in stock, units in stock), swatch and images, plus `raw`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/boohoo-product",
        "tags": [
          "boohoo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Product code (e.g. HZZ61671), product slug or a boohoo product link.",
            "schema": {
              "type": "string"
            },
            "example": "HZZ61671"
          },
