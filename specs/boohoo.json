    "/boohoo/v1/search": {
      "get": {
        "operationId": "boohooSearch",
        "summary": "boohoo product search",
        "description": "Search boohoo (US, UK, Australia and Ireland sites) by keywords with every facet and sort the site offers. Each product: id, name, brand, colour, price, was price, saving, rating and review count, every colour with stock flag, SKU and image, images and link, plus `raw`. Also returns `facets` (keys, values, counts) and `sort_options`. 40 per page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/boohoo-search",
        "tags": [
          "boohoo"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keywords.",
            "schema": {
              "type": "string"
            },
            "example": "dress"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Site: US (default), GB, AU, IE.",
            "schema": {
              "type": "string",
              "enum": [
                "US",
                "GB",
                "AU",
                "IE"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default), best-sellers, newness, price-asc, price-desc.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "best-sellers",
                "newness",
                "price-asc",
                "price-desc"
              ]
            }
          },
          {
