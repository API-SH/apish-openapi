{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Mamaearth",
    "version": "1.0.0",
    "description": "The Mamaearth API from API.SH: public Mamaearth data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Mamaearth",
      "description": "2 endpoints (e-commerce)",
      "x-slug": "mamaearth",
      "x-domains": [
        "mamaearth.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/mamaearth/v1/product": {
      "get": {
        "operationId": "mamaearthProduct",
        "summary": "Mamaearth product",
        "description": "One Mamaearth product: price, MRP, discount, availability, variants with their own price and stock, options, tags, images and description.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/mamaearth-product",
        "tags": [
          "Mamaearth"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "handle",
            "in": "query",
            "required": false,
            "description": "Product handle, e.g. onion-shampoo.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Mamaearth product link, https://mamaearth.in/products/<handle>. Use instead of handle.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words. Resolved to the first matching product.",
            "schema": {
              "type": "string"
            },
            "example": "shampoo"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": 8255400575023,
                  "title": "Tea Tree Shampoo for Dandruff Free Hair - 250ml",
                  "handle": "tea-tree-shampoo-for-dandruff-free-hair-250ml",
                  "vendor": "Mamaearth",
                  "product_type": "Shampoo",
                  "url": "https://mamaearth.in/products/tea-tree-shampoo-for-dandruff-free-hair-250ml",
                  "price": 349,
                  "mrp": 349,
                  "discount_percent": null,
                  "available": true,
                  "description": "Hurry! Only 15 Units Left In Stock Stimulate and renew your hair with an outlandish mix of Tea Tree and Ginger Oil that helps in reducing it…",
                  "tags": [
                    "B1G1-Include",
                    "B2G2_BAU",
                    "… 5 more"
                  ],
                  "options": [
                    {
                      "name": "Title",
                      "values": [
                        "Default Title"
                      ]
                    }
                  ],
                  "variants": [
                    {
                      "id": 45297258496047,
                      "title": "Default Title",
                      "sku": "8906087771845",
                      "barcode": "8906087771845",
                      "price": 349,
                      "mrp": 349,
                      "discount_percent": null,
                      "available": true,
                      "options": [
                        "Default Title"
                      ],
                      "image": null
                    }
                  ],
                  "featured_image": "https://cdn.shopify.com/s/files/1/0721/7558/3279/files/tea_tree_shampoo_1.jpg?v=1777968949",
                  "images": [
                    "https://cdn.shopify.com/s/files/1/0721/7558/3279/files/tea_tree_shampoo_1.jpg?v=1777968949",
                    "https://cdn.shopify.com/s/files/1/0721/7558/3279/files/tea_tree_shampoo_2.jpg?v=1777968949",
                    "… 5 more"
                  ],
                  "published_at": "2026-05-05T13:45:44+05:30",
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/mamaearth/v1/search": {
      "get": {
        "operationId": "mamaearthSearch",
        "summary": "Mamaearth search",
        "description": "Mamaearth product search or collection listing (India): title, handle, link, price, compare-at price, discount, vendor, type, tags, availability and images. Search by words (up to 10 hits, no paging) or list a collection with paging.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/mamaearth-search",
        "tags": [
          "Mamaearth"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (up to 10 hits).",
            "schema": {
              "type": "string"
            },
            "example": "shampoo"
          },
          {
            "name": "collection",
            "in": "query",
            "required": false,
            "description": "Collection handle, e.g. hair-care. Takes the place of q and is paged.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results to return (search: up to 10, default 10; collection: up to 100, default 30).",
            "schema": {
              "type": "integer"
            },
            "example": "10"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number for a collection listing (default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "shampoo",
                  "page": 1,
                  "count": 10,
                  "next_page": null,
                  "products": [
                    {
                      "id": 8255400575023,
                      "title": "Tea Tree Shampoo for Dandruff Free Hair - 250ml",
                      "handle": "tea-tree-shampoo-for-dandruff-free-hair-250ml",
                      "vendor": "Mamaearth",
                      "product_type": "Shampoo",
                      "url": "https://mamaearth.in/products/tea-tree-shampoo-for-dandruff-free-hair-250ml",
                      "price": 349,
                      "mrp": 349,
                      "discount_percent": null,
                      "available": true,
                      "tags": [
                        "B1G1-Include",
                        "B2G2_BAU",
                        "… 5 more"
                      ],
                      "image": "https://cdn.shopify.com/s/files/1/0721/7558/3279/files/tea_tree_shampoo_1.jpg?v=1777968949",
                      "description": "Hurry! Only 15 Units Left In Stock Stimulate and renew your hair with an outlandish mix of Tea Tree and Ginger Oil that helps in reducing it…"
                    },
                    {
                      "id": 8255413256239,
                      "title": "Onion Shampoo for Hair Growth and Hair Fall Control with Onion and Plant Keratin - 1 Litre",
                      "handle": "onion-shampoo-for-hair-growth-hair-fall-control-with-onion-plant-keratin-1-litre",
                      "vendor": "Mamaearth",
                      "product_type": "Shampoo",
                      "url": "https://mamaearth.in/products/onion-shampoo-for-hair-growth-hair-fall-control-with-onion-plant-keratin-1-litre",
                      "price": 1549,
                      "mrp": 1549,
                      "discount_percent": null,
                      "available": true,
                      "tags": [
                        "B1G1-Include",
                        "B2G2_BAU",
                        "… 10 more"
                      ],
                      "image": "https://cdn.shopify.com/s/files/1/0721/7558/3279/files/onion_shampoo_1l.jpg?v=1777970532",
                      "description": "Introducing new & improved Mamaearth Onion Shampoo for even stronger, smoother, and cleaner hair. The new formula improves deep cleansing ac…"
                    },
                    "… 8 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Create keys at https://app.api.sh/keys. Authorization: Bearer <key> also works."
      }
    },
    "parameters": {
      "raw": {
        "name": "raw",
        "in": "query",
        "required": false,
        "description": "0 leaves out the bulky `raw` source blocks (often 10-30x smaller).",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Comma-separated fields to return, e.g. `posts.id,posts.title`. Call metadata is always included.",
        "schema": {
          "type": "string"
        }
      },
      "fresh": {
        "name": "fresh",
        "in": "query",
        "required": false,
        "description": "1 skips the 24-hour cache and fetches live.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "output": {
        "name": "output",
        "in": "query",
        "required": false,
        "description": "csv or ndjson returns the response's records (its main list, or the object as one row) as CSV or NDJSON instead of JSON.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "ndjson"
          ]
        }
      },
      "records": {
        "name": "records",
        "in": "query",
        "required": false,
        "description": "With output=csv|ndjson: the top-level list to turn into rows (e.g. `reviews`), or `.` for the whole object as one row.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "On a 503 for a paused endpoint: the status page, which lists open incidents."
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "responses": {
      "E400": {
        "description": "A parameter is missing or invalid. Not charged (unless the call ran and the source rejected the value; credits_used says).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E402": {
        "description": "Not enough credits, a spend limit you set was reached (`spend_limit`), or the key's monthly credit cap was reached (`key_cap`). Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
        "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E502": {
        "description": "The source site failed this time; retry. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E503": {
        "description": "Endpoint paused or temporarily unavailable; may include retry-after, and status_url (https://api.sh/status) for a paused endpoint. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "headers": {
      "x-request-id": {
        "description": "The call's id (logs, re-fetch with /v1/results/{id}).",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "x-credits-used": {
        "description": "Credits charged for this call.",
        "schema": {
          "type": "integer"
        }
      },
      "x-credits-remaining": {
        "description": "Balance after the call.",
        "schema": {
          "type": "integer"
        }
      }
    }
  },
  "externalDocs": {
    "url": "https://api.sh/docs"
  }
}
