    "/bayt/v1/search": {
      "get": {
        "operationId": "baytSearch",
        "summary": "Bayt job search",
        "description": "Jobs on Bayt.com (Middle East and North Africa) for keywords, country and city: id, title, link, company and its Bayt page, locations, summary, posted time, Easy Apply and external flags, logo. Pass `next_page` back as `page`; null on the last page.\n\nSort by date, limit to recent posts, and filter by industry, career level, employment type, company, company type, gender, nationality-only jobs, remote or Easy Apply. `total` is the number of matching jobs; `filters` lists the site's filter groups with their options (`value`, `count`) and the param (`param`) that takes them; `applied_filters` echoes what is in effect.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bayt-search",
        "tags": [
          "Bayt"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `engineer`.",
            "schema": {
              "type": "string"
            },
            "example": "engineer"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "uae (default), saudi-arabia, qatar, kuwait, bahrain, oman, egypt, jordan, lebanon, morocco, iraq, algeria, tunisia, pakistan, india, international.",
            "schema": {
              "type": "string"
            },
            "example": "uae"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, e.g. `dubai`, `riyadh`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default) or date (newest first).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "date"
              ]
            }
          },
          {
            "name": "posted_within",
            "in": "query",
            "required": false,
            "description": "Only jobs posted in the last 24 hours, 7 days or 30 days.",
            "schema": {
              "type": "string",
              "enum": [
                "24h",
                "7d",
                "30d"
              ]
            }
          },
          {
            "name": "industry",
            "in": "query",
            "required": false,
            "description": "Industry id(s) from `filters` (key jb_industry_id_original), comma-separated, e.g. 12 (Construction & Building).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "career_level",
            "in": "query",
            "required": false,
            "description": "fresh_graduate, entry_level, mid_career, management, or a value from `filters` (key jb_career_level_id_original); comma-separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
