    "/dice/v1/search": {
      "get": {
        "operationId": "diceSearch",
        "summary": "Dice job search",
        "description": "Tech jobs on Dice (US) for a keyword and/or location, with the site's filters: radius, posted date, employment type, employer type, workplace (remote, on-site, hybrid), easy apply, visa sponsorship and company. `total` is Dice's count; 30 jobs per page. `facets` gives the counts per filter value. Each job: `id`, `legacy_id`, `title`, `url`, `company`, `company_profile_id`, `logo`, `location`, `city`, `state`, `country`, `employment_type`, `employer_type`, `workplace_types`, `remote`, `salary` (as listed), `summary`, `easy_apply`, `willing_to_sponsor`, `posted_at`, `updated_at` and `raw`. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/dice-search",
        "tags": [
          "Dice"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `python`, `java developer`. Required unless `location` is given.",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, state or ZIP, e.g. `Austin, TX`.",
            "schema": {
              "type": "string"
            },
            "example": "New York, NY"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Radius around the location.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "radius_unit",
            "in": "query",
            "required": false,
            "description": "Unit of `radius` (default mi).",
            "schema": {
              "type": "string",
              "enum": [
                "mi",
                "km"
              ]
            }
          },
          {
            "name": "posted",
            "in": "query",
            "required": false,
            "description": "Posted within this many days.",
            "schema": {
              "type": "integer",
              "enum": [
                "1",
                "3",
                "7"
              ]
            }
          },
          {
            "name": "employment_type",
            "in": "query",
            "required": false,
            "description": "Comma-separated: `full_time`, `part_time`, `contract`, `third_party`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employer_type",
            "in": "query",
            "required": false,
            "description": "Comma-separated: `direct_hire`, `recruiter`, `other`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workplace",
            "in": "query",
            "required": false,
            "description": "Comma-separated: `remote`, `on_site`, `hybrid`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "easy_apply",
            "in": "query",
            "required": false,
            "description": "Only jobs with Dice Easy Apply.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "willing_to_sponsor",
            "in": "query",
            "required": false,
            "description": "Only employers willing to sponsor a visa.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "company",
            "in": "query",
            "required": false,
            "description": "Only jobs from this company, by its name as Dice shows it (the job's `company`), e.g. `Capital One`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "python",
                  "location": "New York, NY, USA",
                  "url": "https://www.dice.com/jobs?q=python&location=New+York%2C+NY",
