                  "salary": {
                    "currency": "USD",
                    "min": 96100,
                    "max": 123200,
                    "value": null,
                    "unit": null
                  },
                  "posted_at": "2026-08-19T22:02:02.000Z",
                  "valid_through": "2026-12-04T23:01:43.000Z",
                  "skills": [
                    "Research",
                    "System Integration",
                    "… 69 more"
                  ],
                  "apply_type": "External",
                  "featured": true,
                  "description_html": "<b>Overview</b> <br /> <br /> <strong>Navy Federal Credit Union currently does not provide sponsorship for this role. Applicants must be aut…",
                  "description": "Overview\n\nNavy Federal Credit Union currently does not provide sponsorship for this role. Applicants must be authorized to work in the Unite…",
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
