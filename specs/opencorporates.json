  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Create keys at https://app.api.sh/keys. Authorization: Bearer <key> also works."
      }
    },
    "parameters": {
      "raw": {
        "name": "raw",
        "in": "query",
        "required": false,
        "description": "0 leaves out the bulky `raw` source blocks (often 10-30x smaller).",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Comma-separated fields to return, e.g. `posts.id,posts.title`. Call metadata is always included.",
        "schema": {
          "type": "string"
        }
      },
      "fresh": {
        "name": "fresh",
        "in": "query",
        "required": false,
        "description": "1 skips the 24-hour cache and fetches live.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "output": {
        "name": "output",
        "in": "query",
        "required": false,
        "description": "csv or ndjson returns the response's records (its main list, or the object as one row) as CSV or NDJSON instead of JSON.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "ndjson"
          ]
        }
      },
      "records": {
        "name": "records",
        "in": "query",
        "required": false,
        "description": "With output=csv|ndjson: the top-level list to turn into rows (e.g. `reviews`), or `.` for the whole object as one row.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "On a 503 for a paused endpoint: the status page, which lists open incidents."
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "responses": {
      "E400": {
        "description": "A parameter is missing or invalid. Not charged (unless the call ran and the source rejected the value; credits_used says).",
