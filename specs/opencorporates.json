{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: OpenCorporates",
    "version": "1.0.0",
    "description": "The OpenCorporates API from API.SH: public OpenCorporates data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "OpenCorporates",
      "description": "5 endpoints (jobs & b2b)",
      "x-slug": "opencorporates",
      "x-domains": [
        "opencorporates.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/opencorporates/v1/company": {
      "get": {
        "operationId": "opencorporatesCompany",
        "summary": "OpenCorporates company",
        "description": "One company record: name, company number, status, company type, jurisdiction, registered address, registered agent, industry codes, previous and alternative names, other identifiers (SEC CIK, EIN, LEI and others) with links, latest accounts and annual return dates, counts of current and inactive officers, addresses, websites, telephone and tax numbers and register entries the record lists, and recent filings. Fields the site shows only to signed-in users (incorporation date, officer names, source) are null and named in `signed_in_only`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/opencorporates-company",
        "tags": [
          "OpenCorporates"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "jurisdiction",
            "in": "query",
            "required": true,
            "description": "Jurisdiction code, e.g. `gb`.",
            "schema": {
              "type": "string"
            },
            "example": "gb"
          },
          {
            "name": "number",
            "in": "query",
            "required": true,
            "description": "Company number in that register, e.g. `00445790`.",
            "schema": {
              "type": "string"
            },
            "example": "00445790"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Instead of jurisdiction and number: the company's opencorporates.com/companies/... link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "jurisdiction": "gb",
                  "number": "00445790",
                  "name": "TESCO PLC",
                  "url": "https://opencorporates.com/companies/gb/00445790",
                  "status": "Active",
                  "company_type": "Public Limited Company",
                  "jurisdiction_name": "United Kingdom",
                  "incorporation_date": null,
                  "dissolution_date": null,
                  "registered_address": {
                    "lines": [
                      "Tesco House, Shire Park Kestrel Way",
                      "Welwyn Garden City",
                      "… 2 more"
                    ],
                    "text": "Tesco House, Shire Park Kestrel Way, Welwyn Garden City, AL7 1GA, United Kingdom"
                  },
                  "agent_name": null,
                  "agent_address": null,
                  "industry_codes": [
                    "47.11: Retail sale in non-specialised stores with food, beverages or tobacco predominating (UK SIC Classification 2007)",
                    "47.11: Retail sale in non-specialised stores with food, beverages or tobacco predominating (European Community NACE Rev 2)",
                    "… 1 more"
                  ],
                  "previous_names": [
                    "TESCO STORES (HOLDINGS) PUBLIC LIMITED COMPANY",
                    "TESCO STORES (HOLDINGS) LIMITED"
                  ],
                  "alternative_names": [],
                  "other_identifiers": [
                    {
                      "type": "SEC CIK number",
                      "value": "885834",
                      "url": "https://opencorporates.com/identifiers/cik/885834"
                    }
                  ],
                  "previous_company_numbers": null,
                  "branch": null,
                  "latest_accounts_date": "2026-02-28",
                  "annual_return_last_made_up_date": "2016-06-07",
                  "officers_count": 11,
                  "inactive_officers_count": 62,
                  "addresses": [
                    "TESCO HOUSE - DELAMARE RD, CHESHUNT, HERTFORDSHIRE EN8 9SL UK X0",
                    "TESCO HOUSE, DELAMARE ROAD, CHESHUNT, HERTFORDSHIRE, EN8 9SL, United Kingdom"
                  ],
                  "websites": [],
