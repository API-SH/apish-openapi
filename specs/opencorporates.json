    "/opencorporates/v1/search": {
      "get": {
        "operationId": "opencorporatesSearch",
        "summary": "OpenCorporates company search",
        "description": "Search company register records from more than 140 jurisdictions by company name: jurisdiction code, company number, name, match score and link. Narrow to one jurisdiction with `jurisdiction` (e.g. `gb`, `us_de`, `de`). Up to 250 matches per name. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/opencorporates-search",
        "tags": [
          "OpenCorporates"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Company name, e.g. `tesla`.",
            "schema": {
              "type": "string"
            },
            "example": "tesla"
          },
          {
            "name": "jurisdiction",
            "in": "query",
            "required": false,
            "description": "Jurisdiction code, e.g. `gb`, `us_de`, `de`, `fr`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page, 1-100 (default 25).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1); at most 250 matches in all.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "tesla",
                  "jurisdiction": null,
                  "page": 1,
                  "limit": 25,
                  "count": 25,
                  "next_page": 2,
                  "results": [
                    {
