    "/openrent/v1/search": {
      "get": {
        "operationId": "openrentSearch",
        "summary": "OpenRent rental search",
        "description": "UK homes to rent directly from landlords on OpenRent, around any town, area or postcode, with every filter the site's search has: rent, bedrooms, bathrooms, property type (house, flat, room), studio, furnished or unfurnished, bills included, pets, students, families, benefits (DSS), garden, parking, fireplace, video viewings, available by a date, maximum minimum-tenancy, radius in km, and let-agreed homes. Each property has title, summary, rent per month and per week, type, bedrooms, bathrooms, flags, minimum tenancy, availability date, first-listed date, coordinates, distance and photo, plus `raw`. `total_in_area` counts every home the site found for the place; `total` the ones matching the filters. 20 a page; pass `next_page` back as `page` (null on the last page).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/openrent-search",
        "tags": [
          "OpenRent"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": true,
            "description": "A UK town, area or postcode, e.g. `Manchester`, `SW11`, `Leeds LS6`.",
            "schema": {
              "type": "string"
            },
            "example": "Manchester"
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum rent per month (GBP).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum rent per month (GBP).",
            "schema": {
              "type": "number"
            },
            "example": "1200"
          },
          {
            "name": "bedrooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bedrooms_max",
            "in": "query",
            "required": false,
            "description": "Maximum bedrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bathrooms_min",
            "in": "query",
            "required": false,
            "description": "Minimum bathrooms.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "house, flat or room (comma separated).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "studio",
            "in": "query",
            "required": false,
            "description": "`true`: only studios; `false`: no studios.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "furnished",
            "in": "query",
            "required": false,
            "description": "`true`: furnished only; `false`: unfurnished only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "bills_included",
            "in": "query",
            "required": false,
            "description": "`true`: bills included.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "pets_allowed",
            "in": "query",
            "required": false,
            "description": "`true`: pets allowed.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "students_allowed",
            "in": "query",
            "required": false,
            "description": "`true`: students welcome.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "families_allowed",
            "in": "query",
            "required": false,
            "description": "`true`: families welcome.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "dss_accepted",
            "in": "query",
            "required": false,
            "description": "`true`: housing benefit accepted.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "garden",
            "in": "query",
            "required": false,
            "description": "`true`: with a garden.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "parking",
            "in": "query",
            "required": false,
            "description": "`true`: with parking.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "fireplace",
            "in": "query",
            "required": false,
            "description": "`true`: with a fireplace.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "video_viewings",
            "in": "query",
            "required": false,
            "description": "`true`: video viewings accepted.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "available_by",
            "in": "query",
            "required": false,
            "description": "Available on or before this date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_tenancy_max",
            "in": "query",
            "required": false,
            "description": "Minimum tenancy of at most this many months.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "description": "Within this distance of the place (km).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "include_let_agreed",
            "in": "query",
            "required": false,
            "description": "`true`: also homes already let agreed.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order (default distance).",
            "schema": {
              "type": "string",
              "enum": [
                "distance",
                "price_asc",
                "price_desc",
                "newest"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "location": "Manchester",
                  "latitude": 53.48021,
                  "longitude": -2.244461,
                  "total_in_area": 640,
                  "total": 307,
                  "page": 1,
                  "total_pages": 16,
