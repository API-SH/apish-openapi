    "/eventbrite/v1/search": {
      "get": {
        "operationId": "eventbriteSearch",
        "summary": "Eventbrite event search",
        "description": "Eventbrite events in a place (or online) by keywords, or by category, event format, date window (or a custom start_date/end_date range, which also works with keywords) and free events, 20 a page: id, name, summary, link, start and end, timezone, online and cancelled flags, series, category, subcategory, format, tags, free flag, price range, sold-out flag, urgency signals, venue (address, coordinates), organizer (followers) and image; plus promoted events. Pass `next_page` back as `page`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/eventbrite-search",
        "tags": [
          "Eventbrite"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "The site's place slug: `ny--new-york`, `ca--san-francisco`, `united-kingdom--london`, `germany--berlin`, or `online` (default).",
            "schema": {
              "type": "string"
            },
            "example": "ny--new-york"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords (alone: not combined with category, format, date or free; start_date/end_date may be added).",
            "schema": {
              "type": "string"
            },
            "example": "jazz"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Event category (with a `date` window or start_date/end_date).",
            "schema": {
              "type": "string",
              "enum": [
                "business",
                "food-and-drink",
                "health",
                "music",
                "auto-boat-and-air",
                "charity-and-causes",
                "community",
                "family-and-education",
                "fashion",
                "film-and-media",
                "hobbies",
                "home-and-lifestyle",
                "arts",
                "government",
                "spirituality",
                "school-activities",
                "science-and-tech",
                "holiday",
                "sports-and-fitness",
                "travel-and-outdoor",
                "other"
              ]
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Date window.",
            "schema": {
              "type": "string",
              "enum": [
                "today",
                "tomorrow",
