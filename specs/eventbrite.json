    "/eventbrite/v1/venue": {
      "get": {
        "operationId": "eventbriteVenue",
        "summary": "Events at a venue",
        "description": "The events held at an Eventbrite venue (live by default, or started, ended or all): id, name, summary and description, link, start and end (UTC and local) with time zone, status, free flag, currency, online flag, series, capacity, organizer, category ids, image and dates. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/eventbrite-venue",
        "tags": [
          "Eventbrite"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "A venue id (from an event's venue).",
            "schema": {
              "type": "string"
            },
            "example": "299217359"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
