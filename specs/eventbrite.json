    "/eventbrite/v1/organizer": {
      "get": {
        "operationId": "eventbriteOrganizer",
        "summary": "Eventbrite organizer",
        "description": "An Eventbrite organizer: name, link, description, followers, past and future event counts, logo, website and social links, and their events (live, ended or all; 50 a page) with dates, price range, venue and image. Pass `next_page` back as `page`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/eventbrite-organizer",
        "tags": [
          "Eventbrite"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The number at the end of an eventbrite.com/o/... link.",
            "schema": {
              "type": "string"
            },
            "example": "13954839845"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Or the eventbrite.com/o/... link.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Which events (default live).",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "ended",
                "all"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). Pass `next_page` back; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
