    "/herold/v1/search": {
      "get": {
        "operationId": "heroldSearch",
        "summary": "Search Austrian businesses",
        "description": "HEROLD, Austria's yellow pages: businesses by trade or keyword, optionally in a place, with name, id, description, street, postal code, region, phone, email, website, rating, review count, verified flag, logo and page link, 30 per page, and the total. Pass `next_page` back as `page`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/herold-search",
        "tags": [
          "Herold"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Trade or keyword (e.g. restaurant, installateur, zahnarzt, rechtsanwalt).",
            "schema": {
              "type": "string"
            },
            "example": "restaurant"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Place as in HEROLD's addresses: a state (wien, niederoesterreich, oberoesterreich, steiermark, tirol, kaernten, salzburg, vorarlberg, burgenland) or a town slug the site uses. All of Austria when empty.",
            "schema": {
              "type": "string"
            },
            "example": "wien"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "restaurant",
                  "location": "wien",
                  "total": 1051,
                  "page": 1,
                  "pages": 36,
                  "count": 30,
                  "items": [
                    {
                      "name": "EF16 Restaurant Weinbar",
                      "id": "sm4rW",
                      "herold_id": "708152",
                      "description": "Authentische Wiener Küche, mediterrane Aromen und exzellente Weine – serviert im stimmungsvollen Innenhof Wiens.",
                      "street": "Fleischmarkt 16",
                      "postal_code": "1010",
                      "city": null,
                      "region": "Wien",
                      "country": "AT",
                      "address": null,
                      "phone": "+1 555 010 0000",
                      "email": "name@example.com",
                      "website": "https://www.ef16.at",
                      "rating": 4.9,
                      "reviews": 7,
                      "verified": true,
                      "logo": "https://a.mktgcdn.com/p/V-up-hsdHvIwV54L0aLBbeFZKXmVP1kRbl-Jm7_VB_A/600x600.png",
                      "url": "https://www.herold.at/gelbe-seiten/wien/sm4rW/ef16-restaurant-weinbar/"
                    },
                    {
