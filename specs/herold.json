    "/herold/v1/reviews": {
      "get": {
        "operationId": "heroldReviews",
        "summary": "Business reviews",
        "description": "Every review of a HEROLD business: title, text, author, date, owner reply, the per-category ratings (quality, price, advice...) and their average, plus the category averages over all reviews. 20 a page; pass `next_page` back as `page`, null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/herold-reviews",
        "tags": [
          "Herold"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": true,
            "description": "A herold.at business link (or the code in `id`).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.herold.at/gelbe-seiten/wien/MK8c9/in-rothen-haarstudio-und-kaffeebar/"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Business code, e.g. MK8c9.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest",
                "highest",
                "lowest"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
