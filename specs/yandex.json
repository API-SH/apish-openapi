    "/yandex/v1/suggest": {
      "get": {
        "operationId": "yandexSuggest",
        "summary": "Yandex suggestions",
        "description": "Yandex's search-box suggestions for the start of a query, in the order Yandex shows them.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yandex-suggest",
        "tags": [
          "Yandex"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Start of a search.",
            "schema": {
              "type": "string"
            },
            "example": "moscow"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Yandex site and interface language (default en).",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ru",
                "tr",
                "kk",
                "be",
                "uz"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
