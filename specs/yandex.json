    "/yandex/v1/search": {
      "get": {
        "operationId": "yandexSearch",
        "summary": "Yandex Search",
        "description": "Yandex web results: 10 per page with position, title, URL, displayed URL, snippet and favicon, and the result count Yandex reports. Pass `next_page` back as `page`. Optional `site` restricts results to one domain and `time` to pages dated within the last day, week, month or year.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/yandex-search",
        "tags": [
          "Yandex"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search query.",
            "schema": {
              "type": "string"
            },
            "example": "coffee machine"
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Yandex edition: en (yandex.com, default), ru, tr, kk, be, uz.",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "ru",
                "tr",
                "kk",
                "be",
                "uz"
              ]
            }
          },
          {
            "name": "region",
            "in": "query",
            "required": false,
            "description": "Yandex region id (lr), e.g. 213 Moscow, 2 Saint Petersburg, 84 USA, 11508 Istanbul.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1 = first).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "site",
            "in": "query",
            "required": false,
            "description": "Only results from this domain (e.g. wikipedia.org).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "time",
            "in": "query",
            "required": false,
            "description": "Only pages dated within this recent window.",
            "schema": {
              "type": "string",
              "enum": [
                "day",
                "week",
                "month",
                "year"
              ]
            }
          },
          {
            "name": "lr",
            "in": "query",
            "required": false,
            "description": "Alias of region (Yandex region id).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "search_parameters": {
                    "engine": "yandex",
                    "q": "Moscow Kremlin",
                    "lang": "en",
                    "region": null,
                    "page": 1
                  },
                  "query": "Moscow Kremlin",
