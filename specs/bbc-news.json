    "/bbc/v1/headlines": {
      "get": {
        "operationId": "bbcHeadlines",
        "summary": "BBC headlines by section",
        "description": "The latest stories of a BBC News or BBC Sport section: headline, summary, link, publication time, type (article, video, live, audio), id and image. Filter by keywords and since a time. Article bodies are not returned.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bbc-headlines",
        "tags": [
          "BBC News"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "section",
            "in": "query",
            "required": false,
            "description": "top (default), world, uk, business, politics, health, education, science_and_environment, technology, entertainment_and_arts, world/africa, world/asia, world/europe, world/latin_america, world/middle_east, world/us_and_canada, england, scotland, wales, northern_ireland, sport, sport/football, sport/cricket, sport/tennis, sport/formula1...",
            "schema": {
              "type": "string"
            },
            "example": "world"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Only stories whose headline or summary contains all these words.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "Only stories published at or after this date or ISO time.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Maximum stories (default 50, max 100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
