    "/bandsintown/v1/event": {
      "get": {
        "operationId": "bandsintownEvent",
        "summary": "Event details",
        "description": "One concert on Bandsintown: name, artist, start and end time with timezone, status, attendance mode, description, RSVP count, venue (address, city, region, postal code, country, coordinates, phone, website), the lineup with follower counts, ticket sellers with links (and prices when listed), and similar events. Pass the event `id` or `url`, or an `artist` id for that artist's next concert.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bandsintown-event",
        "tags": [
          "Bandsintown"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "A Bandsintown event id, e.g. 1038209449 (as in bandsintown.com/e/1038209449-...).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Instead of id: the event page url.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "artist",
            "in": "query",
            "required": false,
            "description": "Instead of id: an artist id (e.g. 128); answers that artist's next upcoming concert.",
            "schema": {
              "type": "string"
            },
            "example": "128"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
