    "/bandsintown/v1/nearby": {
      "get": {
        "operationId": "bandsintownNearby",
        "summary": "Concerts near a point",
        "description": "Upcoming concerts around a point on Bandsintown, soonest first (36 a page): artist and id, start time with timezone, venue, city, event url, RSVP count and image, optionally narrowed to a genre. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/bandsintown-nearby",
        "tags": [
          "Bandsintown"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "description": "Latitude.",
            "schema": {
              "type": "string"
            },
            "example": "40.7128"
          },
          {
            "name": "lng",
            "in": "query",
            "required": true,
            "description": "Longitude.",
            "schema": {
              "type": "string"
            },
            "example": "-74.006"
          },
          {
            "name": "genre",
            "in": "query",
            "required": false,
            "description": "A genre slug, e.g. rock, hip-hop, country, electronic, jazz, pop.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-100).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
