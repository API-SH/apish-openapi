{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Eurostar",
    "version": "1.0.0",
    "description": "The Eurostar API from API.SH: public Eurostar data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Eurostar",
      "description": "4 endpoints (travel & events)",
      "x-slug": "eurostar",
      "x-domains": [
        "eurostar.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/eurostar/v1/calendar": {
      "get": {
        "operationId": "eurostarCalendar",
        "summary": "Eurostar cheapest fare per day",
        "description": "The lowest Eurostar fare of each day on a route between `date_from` and `date_to` (up to 184 days a call), and the cheapest day of the range. `passengers` gives the total for that many people.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/eurostar-calendar",
        "tags": [
          "Eurostar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Origin station: UIC code or name/city.",
            "schema": {
              "type": "string"
            },
            "example": "London"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Destination station: UIC code or name/city.",
            "schema": {
              "type": "string"
            },
            "example": "Paris"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "description": "First day (YYYY-MM-DD). Default today.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "description": "Last day (YYYY-MM-DD). Default 60 days after date_from.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "passengers",
            "in": "query",
            "required": false,
            "description": "Passengers (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "direction",
            "in": "query",
            "required": false,
            "description": "Default `outbound`.",
            "schema": {
              "type": "string",
              "enum": [
                "outbound",
                "inbound"
              ]
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Default `GBP`.",
            "schema": {
              "type": "string",
              "enum": [
                "GBP",
                "EUR",
                "USD"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "from": {
                    "uic": "7015400",
                    "name": "London St Pancras Int'l",
                    "city": "London",
                    "country": "United Kingdom",
                    "country_code": "GBR",
                    "eurostar_direct": true,
                    "eurostar_red_direct": false
                  },
                  "to": {
                    "uic": "8727100",
                    "name": "Paris Gare du Nord",
                    "city": "Paris",
                    "country": "France",
                    "country_code": "FRA",
                    "eurostar_direct": true,
                    "eurostar_red_direct": true
                  },
                  "currency": "GBP",
                  "passengers": 1,
                  "direction": "outbound",
                  "date_from": "2026-11-06",
                  "date_to": "2027-01-05",
                  "count": 60,
                  "cheapest": {
                    "date": "2026-12-02",
                    "price": 39
                  },
                  "days": [
                    {
                      "date": "2026-11-06",
                      "price": 228
                    },
                    {
                      "date": "2026-11-07",
                      "price": 204
                    },
                    "… 58 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/eurostar/v1/fare-conditions": {
      "get": {
        "operationId": "eurostarFareConditions",
        "summary": "Eurostar fare conditions",
        "description": "The exchange and refund conditions of Eurostar fares by tariff code (from `fares[].tariff_codes` in /eurostar/v1/search).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/eurostar-fare-conditions",
        "tags": [
          "Eurostar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "tariff_codes",
            "in": "query",
            "required": true,
            "description": "Tariff codes, comma separated (up to 20).",
            "schema": {
              "type": "string"
            },
            "example": "B05PSXARBGN"
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Default `en`.",
            "schema": {
              "type": "string",
              "enum": [
                "en",
                "fr",
                "nl",
                "de"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "language": "en",
                  "count": 1,
                  "conditions": [
                    {
                      "tariff_code": "B05PSXARBGN",
                      "conditions": "Tickets are exchangeable up to 1 hour before your original departure time without a fee. If your new ticket is more expensive, you’ll pay th…"
                    }
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/eurostar/v1/search": {
      "get": {
        "operationId": "eurostarSearch",
        "summary": "Eurostar train search with fares",
        "description": "Eurostar trains between two stations on a day (and an optional return day): departure and arrival times, duration, train numbers and changes, and every class (Standard, Plus, Premier) with price per passenger and total, seats left, flexibility, fare names and tariff codes (for /eurostar/v1/fare-conditions), plus the lowest price of each train.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/eurostar-search",
        "tags": [
          "Eurostar"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "from",
            "in": "query",
            "required": true,
            "description": "Origin station: UIC code (e.g. `7015400`) or name/city.",
            "schema": {
              "type": "string"
            },
            "example": "London"
          },
          {
            "name": "to",
            "in": "query",
            "required": true,
            "description": "Destination station: UIC code or name/city.",
            "schema": {
              "type": "string"
            },
            "example": "Paris"
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Outbound date (YYYY-MM-DD). Default: `days_ahead` days from today.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "days_ahead",
            "in": "query",
            "required": false,
            "description": "Days from today when no `date` is given (default 30).",
            "schema": {
              "type": "integer"
            },
            "example": "30"
          },
          {
            "name": "return_date",
            "in": "query",
            "required": false,
            "description": "Return date (YYYY-MM-DD) for a return search.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "return_days_ahead",
            "in": "query",
            "required": false,
            "description": "Return date as days from today.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "adults",
            "in": "query",
            "required": false,
            "description": "Adults (default 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "youths",
            "in": "query",
            "required": false,
            "description": "Youths 12-25.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "children",
            "in": "query",
            "required": false,
            "description": "Children 4-11.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "infants",
            "in": "query",
            "required": false,
            "description": "Infants under 4.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "seniors",
            "in": "query",
            "required": false,
            "description": "Seniors 60+.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "child_ages",
            "in": "query",
            "required": false,
            "description": "Ages of the children, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "youth_ages",
            "in": "query",
            "required": false,
            "description": "Ages of the youths, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "senior_ages",
            "in": "query",
            "required": false,
            "description": "Ages of the seniors, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Price currency. Default `GBP`.",
            "schema": {
              "type": "string",
              "enum": [
                "GBP",
                "EUR",
                "USD"
              ]
            }
          },
          {
            "name": "class",
            "in": "query",
            "required": false,
            "description": "Only these classes, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_changes",
            "in": "query",
            "required": false,
            "description": "At most this many changes.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "from": {
                    "uic": "7015400",
                    "name": "London St Pancras Int'l",
                    "city": "London",
                    "country": "United Kingdom",
                    "country_code": "GBR",
                    "eurostar_direct": true,
                    "eurostar_red_direct": false
                  },
                  "to": {
                    "uic": "8727100",
                    "name": "Paris Gare du Nord",
                    "city": "Paris",
                    "country": "France",
                    "country_code": "FRA",
                    "eurostar_direct": true,
                    "eurostar_red_direct": true
                  },
                  "date": "2026-12-06",
                  "return_date": null,
                  "currency": "GBP",
                  "passengers": {
                    "adults": 1,
                    "youths": 0,
                    "children": 0,
                    "infants": 0,
                    "seniors": 0
                  },
                  "applied_filters": {
                    "class": null,
                    "max_changes": null
                  },
                  "outbound": {
                    "from": {
                      "uic": "7015400",
                      "name": "London St Pancras Int'l",
                      "city": "London"
                    },
                    "to": {
                      "uic": "8727100",
                      "name": "Paris Gare du Nord",
                      "city": "Paris"
                    },
                    "classes_of_service": [
                      {
                        "code": "STANDARD",
                        "name": "Eurostar Standard"
                      },
                      {
                        "code": "PLUS",
                        "name": "Eurostar Plus"
                      },
                      "… 4 more"
                    ],
                    "count": 10,
                    "journeys": [
                      {
                        "date": "2026-12-06",
                        "departure_time": "08:01",
                        "arrival_time": "11:29",
                        "duration": 148,
                        "changes": 0,
                        "trains": [
                          {
                            "…": "13 fields"
                          }
                        ],
                        "currency": "GBP",
                        "lowest_price": 156,
                        "lowest_class": "STANDARD",
                        "sold_out": false,
                        "fares": [
                          {
                            "…": "18 fields"
                          },
                          {
                            "…": "18 fields"
                          },
                          "… 1 more"
                        ]
                      },
                      {
                        "date": "2026-12-06",
                        "departure_time": "09:31",
                        "arrival_time": "12:59",
                        "duration": 148,
                        "changes": 0,
                        "trains": [
                          {
                            "…": "13 fields"
                          }
                        ],
