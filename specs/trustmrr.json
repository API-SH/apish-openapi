    "/trustmrr/v1/startups": {
      "get": {
        "operationId": "trustmrrStartups",
        "summary": "TrustMRR startup directory",
        "description": "Every startup listed on TrustMRR with revenue verified through its payment provider, in alphabetical order, 100 a page: slug, name, profile link, description, logo, for-sale flag, last-30-days revenue, MRR and total revenue (USD). `total` is the number of startups. Pass `next_page` back as `page` (null on the last page).\n\nAny of `sort`, `limit`, `min_mrr`/`max_mrr`, `min_revenue`/`max_revenue`, `min_growth`/`max_growth`, `category`, `audience` or `on_sale` switches to the filtered directory: sorted by total revenue, MRR or 30-day growth, up to 100 a page, and each startup also carries its id, category, 30-day growth, asking price when for sale, merchant-of-record and stealth flags and founder X handle. `q` instead searches startups by name and description (up to 20 matches) and also returns matching founders (public X handle, name, startup count, total revenue) and categories; it combines only with `on_sale`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/trustmrr-startups",
        "tags": [
          "TrustMRR"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1 by default).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search startups by name or description. Combines only with on_sale.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order of the filtered directory, highest first: total revenue (default), MRR or 30-day growth.",
            "schema": {
              "type": "string",
              "enum": [
                "revenue",
                "mrr",
                "growth"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Startups per page in the filtered directory, 1 to 100 (default 30).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "min_mrr",
            "in": "query",
            "required": false,
            "description": "Minimum MRR in USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_mrr",
            "in": "query",
            "required": false,
            "description": "Maximum MRR in USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_revenue",
            "in": "query",
            "required": false,
            "description": "Minimum total verified revenue in USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_revenue",
            "in": "query",
            "required": false,
            "description": "Maximum total verified revenue in USD.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "min_growth",
            "in": "query",
            "required": false,
            "description": "Minimum 30-day revenue growth in percent (may be negative).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_growth",
            "in": "query",
            "required": false,
            "description": "Maximum 30-day revenue growth in percent (may be negative).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "One or more category slugs, comma-separated (the same slugs as /trustmrr/v1/category, for example saas,ai).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "audience",
            "in": "query",
            "required": false,
            "description": "Only startups selling to businesses (b2b) or consumers (b2c).",
            "schema": {
              "type": "string",
              "enum": [
                "b2b",
                "b2c"
              ]
            }
          },
          {
            "name": "on_sale",
            "in": "query",
            "required": false,
