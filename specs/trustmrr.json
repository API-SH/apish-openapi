    "/trustmrr/v1/startup": {
      "get": {
        "operationId": "trustmrrStartup",
        "summary": "TrustMRR startup profile",
        "description": "One TrustMRR startup: verified total revenue, last-30-days revenue, MRR, active subscriptions, revenue rank, website, category, country, founding date, payment provider, merchant-of-record flag, for-sale terms (asking price, multiple), founder's public name and X handle with follower count, connected analytics, domain rating, keywords and related startups.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/trustmrr-startup",
        "tags": [
          "TrustMRR"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "required": true,
            "description": "Startup slug as in trustmrr.com/startup/<slug> (or the full URL).",
            "schema": {
              "type": "string"
            },
            "example": "gumroad"
          },
          {
