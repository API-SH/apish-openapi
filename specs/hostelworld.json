    "/hostelworld/v1/reviews": {
      "get": {
        "operationId": "hostelworldReviews",
        "summary": "Hostelworld reviews",
        "description": "Reviews of a property, newest first: date, rating out of 10 and per-category scores, text, language, owner reply and the traveller's group type, age band, trip types and nationality, with positive and negative counts and the share of solo, couple and group travellers. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/hostelworld-reviews",
        "tags": [
          "Hostelworld"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Hostelworld property id.",
            "schema": {
              "type": "string"
            },
            "example": "72963"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Reviews per page, 1-50.",
            "schema": {
              "type": "integer"
            },
            "example": "20"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
