    "/hostelworld/v1/search": {
      "get": {
        "operationId": "hostelworldSearch",
        "summary": "Hostelworld city search",
        "description": "Hostels and budget stays of a city for given dates: id, name, type, rating out of 10 with count and category scores, address, district, distance to the centre, lowest price per night (dorm and private, with the pre-discount price), free cancellation deadline, flags, overview, images and facilities, plus the city's price range. Find a city id from a hostelworld.com city page or pass its URL as `city`. Pass `next_page` back as `page`; null on the last page.\n\n`sort` and `property_type` are applied by the site across all pages. `min_rating`, `max_price`, `free_cancellation`, `district` and `facilities` filter the properties of the page read; with any of them set, `page_size` gives the page's size before filtering. `filters` echoes every choice.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/hostelworld-search",
        "tags": [
          "Hostelworld"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city_id",
            "in": "query",
            "required": true,
            "description": "Hostelworld city id (14 = Paris, 26 = Berlin, 3 = London). Or give `city` with a hostelworld.com city page URL such as https://www.hostelworld.com/hostels/europe/germany/berlin/.",
            "schema": {
              "type": "string"
            },
            "example": "14"
          },
          {
            "name": "checkin",
            "in": "query",
            "required": false,
            "description": "Check-in date (YYYY-MM-DD). Default 14 days from today.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nights",
            "in": "query",
            "required": false,
            "description": "Nights, 1-30.",
            "schema": {
              "type": "integer"
            },
            "example": "2"
          },
          {
            "name": "guests",
            "in": "query",
            "required": false,
            "description": "Guests, 1-20.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Price currency (EUR, USD, GBP...).",
            "schema": {
              "type": "string"
            },
            "example": "EUR"
          },
          {
            "name": "per_page",
            "in": "query",
            "required": false,
            "description": "Properties per page, 1-50.",
            "schema": {
              "type": "integer"
            },
            "example": "30"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; it is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: `popularity` (default), `price` (cheapest first), `price_desc`, `rating` (best first), `distance` (closest to the centre first).",
            "schema": {
              "type": "string",
              "enum": [
                "popularity",
                "price",
                "price_desc",
                "rating",
                "distance"
              ]
            }
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Only this property type.",
            "schema": {
              "type": "string",
              "enum": [
                "hostel",
                "hotel",
                "guesthouse",
                "apartment",
                "campsite"
              ]
            }
          },
          {
            "name": "min_rating",
            "in": "query",
            "required": false,
            "description": "Keep only properties rated at least this (0-10), e.g. `8.5`.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Keep only properties whose lowest price per night is at most this (in `currency`).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "free_cancellation",
            "in": "query",
            "required": false,
            "description": "Set to `1` to keep only properties offering free cancellation.",
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "0"
              ]
            }
          },
          {
            "name": "district",
            "in": "query",
            "required": false,
            "description": "Keep only properties whose district name contains this text, e.g. `Montmartre`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "facilities",
            "in": "query",
            "required": false,
            "description": "Keep only properties listing every one of these facilities (comma list, matched as text), e.g. `wifi,breakfast`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
