    "/irishjobs/v1/job": {
      "get": {
        "operationId": "irishjobsJob",
        "summary": "IrishJobs job ad",
        "description": "One job ad on IrishJobs: full description (text, HTML and its sections), company with logo and profile, location and address, contract and work type, salary, posted and valid-through dates, benefits and direct-apply flag. `latest=true` with search parameters returns the first matching ad. Removed ads answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/irishjobs-job",
        "tags": [
          "IrishJobs"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The job's irishjobs.ie/job/<title>/<company>-job<id> link (`url` in search results).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "`true`: the first ad of a search with the other parameters instead of an id (an example that never expires).",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "With `latest=true`: keywords.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "With `latest=true`: location.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
