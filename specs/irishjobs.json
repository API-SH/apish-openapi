    "/irishjobs/v1/search": {
      "get": {
        "operationId": "irishjobsSearch",
        "summary": "IrishJobs job search (Ireland)",
        "description": "Jobs on IrishJobs (irishjobs.ie, Ireland) for a keyword and/or location, with every filter of the site: radius, job type (permanent, contract, temporary, part time, full time, work from home), posting age, agency or direct employer, minimum annual, daily or hourly salary, and sort by relevance, date, salary or distance. `facets` lists the filter values with the parameter to send. Each job: `id`, `title`, `url`, `company`, `company_id`, `company_url`, `logo`, `location`, `salary`, `snippet`, `posted_at`, `labels` and `raw`. 25 jobs a page; `total` is the site's count. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/irishjobs-search",
        "tags": [
          "IrishJobs"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `software engineer`, `nurse`.",
            "schema": {
              "type": "string"
            },
            "example": "software engineer"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Town or county, e.g. `dublin`, `cork`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Distance from the location in km, e.g. `10`.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "Job type.",
            "schema": {
              "type": "string",
              "enum": [
                "permanent",
                "contract",
                "temporary",
                "part-time",
                "full-time",
                "work-from-home"
              ]
            }
          },
          {
            "name": "posted_within",
            "in": "query",
            "required": false,
            "description": "Only jobs posted within this many days.",
            "schema": {
              "type": "string",
              "enum": [
                "1",
                "3",
                "7",
                "14"
              ]
            }
          },
          {
            "name": "company_type",
            "in": "query",
            "required": false,
            "description": "Recruitment agency or direct employer.",
            "schema": {
              "type": "string",
              "enum": [
                "agency",
                "direct_employer"
              ]
            }
