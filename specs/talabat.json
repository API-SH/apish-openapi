    "/talabat/v1/restaurants": {
      "get": {
        "operationId": "talabatRestaurants",
        "summary": "talabat restaurants delivering to an area",
        "description": "Restaurants and shops talabat lists for a delivery area, 15 per page in the site's order or sorted: id, branch id, name, branch, slugs, link, cuisines, rating, ratings and reviews count, delivery fee, minimum order, delivery time, status, pre-order, promotion and discount texts, new, sponsored, grocery and catering flags, talabat-delivery flag, payment options, coordinates, image and logo, with the area, city, total and the area's cuisines (names and slugs). Filter by the site's listing filters (top rated, free delivery, fast delivery, offers, new, pickup, exceptional, veg only) and by cuisine; the filters used are echoed and `available_filters` lists them. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/talabat-restaurants",
        "tags": [
          "talabat"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The area's talabat.com/<country>/restaurants/<area id>/<area slug> link.",
            "schema": {
              "type": "string"
            },
            "example": "https://www.talabat.com/uae/restaurants/1308/jumeirah-lakes-towers-jlt"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "uae (default), kuwait, qatar, bahrain, oman, jordan, egypt or iraq (with area_id and area_slug).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "area_id",
            "in": "query",
            "required": false,
            "description": "Area id (with area_slug) instead of url.",
            "schema": {
              "type": "integer"
            },
            "example": "1308"
          },
          {
            "name": "area_slug",
            "in": "query",
            "required": false,
            "description": "Area slug (with area_id).",
            "schema": {
              "type": "string"
            },
            "example": "jumeirah-lakes-towers-jlt"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "rating, delivery_fee, delivery_time, min_order or a_z (default: the site's order).",
            "schema": {
              "type": "string"
            },
            "example": "rating"
          },
          {
            "name": "filters",
            "in": "query",
            "required": false,
            "description": "Comma-separated: top_rated (rating 4.0+), free_delivery, fast_delivery (under 30 minutes), offers, new, pickup, exceptional, veg_only.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cuisine",
            "in": "query",
            "required": false,
            "description": "Cuisine slug(s), comma-separated, as in `cuisine_slugs_in_area` (e.g. lebanese,indian).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
