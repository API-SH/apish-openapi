    "/talabat/v1/menu": {
      "get": {
        "operationId": "talabatMenu",
        "summary": "talabat restaurant menu",
        "description": "One talabat restaurant branch with its menu: id, branch id, name, branch, link, cuisines, rating and ratings count, delivery fee, minimum order, delivery time, payment methods, coordinates, image and logo, area and currency, VAT-inclusive and tracking flags, promotions and every menu section with its items: id, name, description, price, old price, discount flag, has-choices flag, top-rated flag and image. Pass `area_id` for the fees and availability in an area.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/talabat-menu",
        "tags": [
          "talabat"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The branch's talabat.com/<country>/restaurant/<branch id>/<slug> link (from /talabat/v1/restaurants).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.talabat.com/uae/restaurant/676187/dunkin-dubai-marina"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Country (with branch_id) instead of url.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "branch_id",
            "in": "query",
            "required": false,
            "description": "Branch id instead of url.",
            "schema": {
              "type": "integer"
            },
            "example": "676187"
          },
          {
            "name": "area_id",
            "in": "query",
            "required": false,
            "description": "Delivery area id, for fees and availability there.",
            "schema": {
              "type": "integer"
            },
            "example": "1308"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
