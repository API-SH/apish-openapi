          }
        }
      }
    },
    "/tatacliq/v1/search": {
      "get": {
        "operationId": "tatacliqSearch",
        "summary": "Tata CLiQ search",
        "description": "Tata CLiQ search (India): id, name, brand, link, price, MRP, discount, rating, stock, colour and image, with brand, category, price, colour and any listed filter, every sort and paging, plus the filter lists with counts.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/tatacliq-search",
        "tags": [
          "Tata CLiQ"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "shoes"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Sort order.",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "price-asc",
                "price-desc",
                "isProductNew",
                "isDiscountedPrice"
              ]
            },
            "example": "price-asc"
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "description": "Filters as facetkey:value;facetkey:value, using keys and values from the filters in a response, e.g. brand:MBH13F00005.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1). `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
