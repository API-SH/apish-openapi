                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "nike shoes",
                  "page": 1,
                  "sort": "relevance",
                  "total": 878,
                  "total_pages": 22,
                  "next_page": 2,
