          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/remotive/v1/job": {
      "get": {
        "operationId": "remotiveJob",
        "summary": "Remotive job ad",
        "description": "One remote job on Remotive: title, company and website, category, employment type, countries applicants must be in, salary when given, posting and closing dates, apply link and the full description. Give `url`, or `category` (or seniority, job_type, occupation, or latest=1) to open the newest job of that page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/remotive-job",
        "tags": [
          "Remotive"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Job URL on remotive.com.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category slug: software-development, customer-service, design, marketing, sales, product, project-management, data, devops, finance, human-resources, qa, writing, legal, medical, education, artificial-intelligence, all-others, and the site's other category pages.",
            "schema": {
              "type": "string"
            },
            "example": "software-development"
          },
          {
            "name": "seniority",
            "in": "query",
            "required": false,
            "description": "Seniority page instead of a category: senior, mid-level, lead.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "job_type",
            "in": "query",
            "required": false,
            "description": "Employment type page: full-time, contract.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "occupation",
            "in": "query",
            "required": false,
            "description": "Occupation page (e.g. android-developer, net-developer).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "1 = open the newest job of the whole board.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
