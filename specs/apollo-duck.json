    "/apolloduck/v1/search": {
      "get": {
        "operationId": "apolloduckSearch",
        "summary": "Apollo Duck keyword search",
        "description": "Keyword search across Apollo Duck UK adverts (boat names, makes, models, gear): the same advert fields as the listings route, 100 per page, with the total number of matches. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/apolloduck-search",
        "tags": [
          "Apollo Duck"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keywords, up to 50 characters.",
            "schema": {
              "type": "string"
            },
            "example": "fairline"
          },
          {
            "name": "exact",
            "in": "query",
            "required": false,
            "description": "false: match any word instead of the exact phrase.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Currency for prices (default GBP).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
