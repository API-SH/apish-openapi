    "/apolloduck/v1/dealer": {
      "get": {
        "operationId": "apolloduckDealer",
        "summary": "Apollo Duck dealer and stock",
        "description": "A boat dealer or broker on Apollo Duck: name, address, contact, website, total and UK listing counts, and its adverts (same fields as the listings route), filterable by category and sortable. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/apolloduck-dealer",
        "tags": [
          "Apollo Duck"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Dealer id (bid= in a dealer link).",
            "schema": {
              "type": "string"
            },
            "example": "350"
          },
          {
            "name": "office_id",
            "in": "query",
            "required": false,
            "description": "Office id (oid= in a dealer link), for dealers with several offices.",
            "schema": {
              "type": "string"
            },
            "example": "416"
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category key or id, as in /apolloduck/v1/listings.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "uk_only",
            "in": "query",
            "required": false,
            "description": "true: only the dealer's UK adverts.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "latest (default), price_asc, price_desc, length_asc, length_desc, year_asc, year_desc or price_reduced.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number, starting at 1. Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "10, 20 (default) or 50 per page.",
