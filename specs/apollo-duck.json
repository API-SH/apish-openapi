    "/apolloduck/v1/listings": {
      "get": {
        "operationId": "apolloduckListings",
        "summary": "Apollo Duck boats for sale",
        "description": "Boats and marine adverts on Apollo Duck UK by category: title, price and currency, year, length, location, status, seller type (trade or private), dealer, description, photo count, image and link. Filter by category, price (in any currency; prices are converted), year, length in metres and ad type, and sort by date, price, length, year or price reduction. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/apolloduck-listings",
        "tags": [
          "Apollo Duck"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "category",
            "in": "query",
            "required": false,
            "description": "Category key: sailing_yachts, motor_boats, narrow_boats, sport_boats, fishing_boats, house_boats, barges, classic_boats, commercial_vessels, sailing_dinghies, inflatable_boats, canoes_and_kayaks, personal_watercraft, superyachts, engines, boat_trailers, marinas_and_moorings, chandlery and more (or the numeric id).",
            "schema": {
              "type": "string"
            },
            "example": "sailing_yachts"
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum price.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
            "description": "Maximum price.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "currency",
            "in": "query",
            "required": false,
            "description": "Currency for prices and price filters (default GBP), e.g. EUR, USD.",
            "schema": {
              "type": "string"
            },
            "example": "GBP"
          },
          {
            "name": "min_year",
            "in": "query",
            "required": false,
            "description": "Built in or after.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_year",
            "in": "query",
            "required": false,
            "description": "Built in or before.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_length",
            "in": "query",
            "required": false,
            "description": "Minimum length in metres.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "max_length",
            "in": "query",
            "required": false,
            "description": "Maximum length in metres.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "for_sale, new, wanted, auction, charter, for_rent, service or promotion.",
            "schema": {
              "type": "string",
              "enum": [
                "for_sale",
                "new",
                "wanted",
                "auction",
                "charter",
                "for_rent",
                "service",
                "promotion"
              ]
            }
          },
          {
            "name": "sort",
            "in": "query",
