    "/workable/v1/jobs": {
      "get": {
        "operationId": "workableJobs",
        "summary": "Workable job board",
        "description": "Open jobs on a company's Workable careers page (apply.workable.com/<company>) with the company's name, website and logo. Pass `next_cursor` back as `cursor`; null on the last page. Each job: `id`, `title`, `department`, `team`, `location`, `locations`, `workplace_type`, `remote`, `employment_type`, `compensation` (summary, min, max, currency, interval) when the company publishes it, `posted_at`, `updated_at`, `description_html` and `description` (plain text) when included, `apply_url`, `url` and `raw` (the board's own record). The same shape on every job board endpoint. Filter by `employment_type`, `country` (two-letter code) and `location` text.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/workable-jobs",
        "tags": [
          "Workable"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "company",
            "in": "query",
            "required": true,
            "description": "The company's Workable board name (the part after the host in its job board URL), or that URL.",
            "schema": {
              "type": "string"
            },
            "example": "huggingface"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search words (title and description).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "department",
            "in": "query",
            "required": false,
            "description": "Workable department id(s), comma-separated; or a department name to filter the returned jobs by.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "workplace",
            "in": "query",
            "required": false,
            "description": "Workplace type(s), comma-separated. One of `on_site`, `hybrid`, `remote`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "Pass `next_cursor` from the previous response.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employment_type",
            "in": "query",
            "required": false,
            "description": "Job type, comma-separated for several: `full`, `part`, `contract`, `temporary`, `internship`, `volunteer`, `other` (`full_time` / `part_time` work too).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Two-letter country code (comma-separated for several), e.g. `US` or `FR,DE`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City, region or country text; keeps the jobs on the returned page whose location contains it.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "company": "huggingface",
                  "name": "Hugging Face",
                  "website": "https://huggingface.co/",
                  "logo": "https://workablehr.s3.amazonaws.com/uploads/account/logo/514327/logo",
                  "board_url": "https://apply.workable.com/huggingface/",
                  "total": 6,
                  "count": 6,
                  "next_cursor": null,
                  "applied_filters": {},
                  "jobs": [
                    {
