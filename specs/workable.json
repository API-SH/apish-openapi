                        "France"
                      ],
                      "workplace_type": "remote",
                      "remote": true,
                      "employment_type": "full",
                      "compensation": null,
                      "posted_at": "2026-09-21T00:00:00.000Z",
                      "updated_at": null,
                      "description_html": null,
                      "description": null,
                      "apply_url": "https://apply.workable.com/huggingface/j/DB4D7C0EC8/apply/",
                      "url": "https://apply.workable.com/huggingface/j/DB4D7C0EC8/"
                    },
                    {
                      "id": "F88446C814",
                      "title": "Senior Open-Source Python Engineer, ML Developer Tools - US Remote",
                      "department": "Product",
                      "team": null,
                      "location": "United States",
