    "/rentcom/v1/search": {
      "get": {
        "operationId": "rentcomSearch",
        "summary": "Rent.com rental search",
        "description": "Apartments, houses, condos and townhomes for rent in a US city on Rent.com, with the site's filters (bedrooms or a bedroom range, minimum bathrooms, rent range, pets allowed, amenities, cheap, luxury, new, specials) and sorts. Each result has id, link, name, property type, address, city, state, ZIP, coordinates, rent and range, bed/bath/size texts, units available, availability, price drops, deals, amenities, highlights, verified flag, rating, views, demand, update date, photos, 3D tours and videos, the managing company (or listing broker), the leasing office phone, website and hours, and every floor plan with its rent range, size, availability, photos and units. Private landlords' phone numbers are left out. 30 per page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/rentcom-search",
        "tags": [
          "Rent.com"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "city",
            "in": "query",
            "required": true,
            "description": "US city with its state: \"Austin, TX\", \"austin, texas\" or \"texas/austin\".",
            "schema": {
              "type": "string"
            },
            "example": "Austin, TX"
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "Property type.",
            "schema": {
              "type": "string",
              "enum": [
                "apartments",
                "houses",
                "condos",
                "townhomes"
              ]
            },
            "example": "apartments"
          },
          {
            "name": "beds",
            "in": "query",
