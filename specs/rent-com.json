    "/rentcom/v1/listing": {
      "get": {
        "operationId": "rentcomListing",
        "summary": "Rent.com property",
        "description": "One Rent.com property: everything in a search result plus the description, total units, fees (application, admin, deposit, utilities, insurance), parking, pet policies (rent, deposit, weight limits), amenities by category, leasing and special terms, internet services, walk/transit/bike scores, schools, nearby places, rental estimates and similar properties. Private landlords' phone numbers are left out. Pass `url` or `latest=true` with search params.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/rentcom-listing",
        "tags": [
          "Rent.com"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A rent.com property link (https://www.rent.com/apartment/...).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "true: return the newest current listing of a search with the search params given alongside (keeps examples valid). Then id/url are not needed.",
            "schema": {
              "type": "boolean"
            },
            "example": "true"
          },
          {
            "name": "city",
            "in": "query",
            "required": false,
            "description": "With latest=true: city for the search.",
            "schema": {
              "type": "string"
            },
            "example": "Denver, CO"
          },
          {
            "name": "property_type",
            "in": "query",
            "required": false,
            "description": "With latest=true: property type.",
            "schema": {
              "type": "string",
              "enum": [
                "apartments",
                "houses",
                "condos",
                "townhomes"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
