    "/getyourguide/v1/reviews": {
      "get": {
        "operationId": "getyourguideReviews",
        "summary": "Activity reviews",
        "description": "An activity's reviews on GetYourGuide with the site's sorts and filters: rating, title, text, author first name and country, date, language, traveler type, the booked option, sub-ratings (guide, value, accuracy...), photos and the original language for translated reviews. Also the total review count and average rating. Pass `next_offset` back as `offset`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/getyourguide-reviews",
        "tags": [
          "GetYourGuide"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "A GetYourGuide activity id, e.g. 508441.",
            "schema": {
              "type": "string"
            },
            "example": "508441"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Instead of id: the activity page url.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order.",
            "schema": {
              "type": "string",
              "enum": [
                "recommended",
                "date_desc",
                "date_asc",
                "rating_desc",
                "rating_asc"
              ]
            }
          },
          {
            "name": "ratings",
            "in": "query",
            "required": false,
            "description": "Comma-separated star ratings to include, e.g. 1,2.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "traveler_types",
            "in": "query",
            "required": false,
            "description": "Comma-separated: couple, friends, solo, family.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page (1-50, default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "Reviews to skip.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
