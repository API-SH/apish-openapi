    "/getyourguide/v1/search": {
      "get": {
        "operationId": "getyourguideSearch",
        "summary": "Search activities",
        "description": "GetYourGuide's activity search, 24 a page, with the site's filters and sorts: id, title, abstract, url, category, rating and review count, from-price (with base price, discount and per-person or per-group label), duration, free cancellation, features (small group, skip the line, wheelchair accessible...), highlights, availability message and next available time, and image. Also the result count, the applied filters and every filter option the site offers for the query (interest, place and departure-city ids to pass back). Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/getyourguide-search",
        "tags": [
          "GetYourGuide"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "A city, attraction or activity, e.g. paris, eiffel tower, rome food tour.",
            "schema": {
              "type": "string"
            },
            "example": "paris"
          },
          {
            "name": "date_from",
            "in": "query",
            "required": false,
            "description": "Start date (YYYY-MM-DD): prices and results for those dates.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date_to",
            "in": "query",
            "required": false,
            "description": "End date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "interests",
            "in": "query",
            "required": false,
            "description": "Comma-separated interest ids from `available_filters`, e.g. tc-3 (walking tours).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "places",
            "in": "query",
            "required": false,
            "description": "Comma-separated place ids from `available_filters`, e.g. 2600 (Eiffel Tower).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "departs_from",
            "in": "query",
            "required": false,
            "description": "Comma-separated departure city ids from `available_filters`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "languages",
            "in": "query",
            "required": false,
            "description": "Comma-separated two-letter language codes, e.g. en,fr.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "duration",
            "in": "query",
            "required": false,
            "description": "Comma-separated: 0-3h, 3-5h, 5-7h, full_day, 2_days, 3_days, 4_days, 5_days_plus.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "features",
            "in": "query",
            "required": false,
            "description": "Comma-separated: private, wheelchair, small_group, skip_the_line, hotel_pickup, originals.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "start_time",
            "in": "query",
            "required": false,
            "description": "Comma-separated: morning, afternoon, evening.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_rating",
            "in": "query",
            "required": false,
            "description": "Minimum rating.",
            "schema": {
              "type": "string",
              "enum": [
                "3.0",
                "3.5",
                "4.0",
                "4.5"
              ]
            }
          },
          {
            "name": "min_price",
            "in": "query",
            "required": false,
            "description": "Minimum price.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "max_price",
            "in": "query",
            "required": false,
