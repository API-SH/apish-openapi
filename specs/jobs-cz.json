{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Jobs.cz",
    "version": "1.0.0",
    "description": "The Jobs.cz API from API.SH: public Jobs.cz data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Jobs.cz",
      "description": "2 endpoints (jobs & b2b)",
      "x-slug": "jobs-cz",
      "x-domains": [
        "jobs.cz"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/jobs-cz/v1/job": {
      "get": {
        "operationId": "jobsCzJob",
        "summary": "Jobs.cz job ad",
        "description": "One job ad on Jobs.cz: title, company, introduction, place, salary, required education and languages, employment and contract type, benefits, every item of the position summary, the contact the ad shows, and the full description. Give `id` or `url`, or `q` (plus any search filter) to open the first matching current ad. Ads shown on an employer's branded page answer 404.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jobs-cz-job",
        "tags": [
          "Jobs.cz"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job id (the number in jobs.cz/rpd/<id>/).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Job URL on jobs.cz.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords (job title, skill or company).",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City or region as in the site's URLs (praha, brno, ostrava, plzen, jihomoravsky-kraj).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Distance around location in km.",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "10",
                "20",
                "30",
                "40",
                "50"
              ]
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly salary in CZK.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employer_type",
            "in": "query",
            "required": false,
            "description": "Direct employers or recruitment agencies only.",
            "schema": {
              "type": "string",
              "enum": [
                "employer",
                "agency"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/jobs-cz/v1/search": {
      "get": {
        "operationId": "jobsCzSearch",
        "summary": "Search Jobs.cz jobs",
        "description": "Job ads on Jobs.cz (the Czech Republic's largest job board) for keywords and a city or region, with radius, minimum salary and employer type. Each result has the title, company, place, salary when shown, tags (response time, home office and the like) and status. 30 per page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/jobs-cz-search",
        "tags": [
          "Jobs.cz"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords (job title, skill or company).",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City or region as in the site's URLs (praha, brno, ostrava, plzen, jihomoravsky-kraj).",
            "schema": {
              "type": "string"
            },
            "example": "praha"
          },
          {
            "name": "radius",
            "in": "query",
            "required": false,
            "description": "Distance around location in km.",
            "schema": {
              "type": "string",
              "enum": [
                "0",
                "10",
                "20",
                "30",
                "40",
                "50"
              ]
            }
          },
          {
            "name": "salary_min",
            "in": "query",
            "required": false,
            "description": "Minimum monthly salary in CZK.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employer_type",
            "in": "query",
            "required": false,
            "description": "Direct employers or recruitment agencies only.",
            "schema": {
              "type": "string",
              "enum": [
                "employer",
                "agency"
              ]
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Results page (1-based). Pass next_page back; it is null on the last page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "python",
                  "location": "praha",
                  "url": "https://www.jobs.cz/prace/praha/?q%5B%5D=python",
                  "applied_filters": {
                    "location": "praha"
                  },
                  "total": 183,
                  "count": 30,
                  "page": 1,
                  "next_page": 2,
                  "jobs": [
                    {
                      "id": "2001367610",
                      "title": "Python Developer – AI aplikace pro mediální dům (Denik.cz)",
                      "url": "https://www.jobs.cz/rpd/2001367610/",
                      "company": "VLTAVA LABE MEDIA a.s.",
                      "location": "Praha – Jinonice",
                      "salary": null,
                      "tags": [
                        "Odpověď do 2 týdnů",
                        "Možnost občasné práce z domova"
                      ],
                      "status": "19. října",
                      "status_type": "default",
                      "external": false
                    },
                    {
                      "id": "2001512199",
                      "title": "Programátor Seznam Asistenta - Python, ML, LLM",
                      "url": "https://www.jobs.cz/rpd/2001512199/",
                      "company": "Seznam.cz, a.s.",
                      "location": "Praha – Smíchov + 1 další lokalita",
                      "salary": null,
                      "tags": [
                        "Odpověď do 2 týdnů"
                      ],
                      "status": "2. listopadu",
                      "status_type": "default",
                      "external": false
                    },
                    "… 28 more"
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Create keys at https://app.api.sh/keys. Authorization: Bearer <key> also works."
      }
    },
    "parameters": {
      "raw": {
        "name": "raw",
        "in": "query",
        "required": false,
        "description": "0 leaves out the bulky `raw` source blocks (often 10-30x smaller).",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Comma-separated fields to return, e.g. `posts.id,posts.title`. Call metadata is always included.",
        "schema": {
          "type": "string"
        }
      },
      "fresh": {
        "name": "fresh",
        "in": "query",
        "required": false,
        "description": "1 skips the 24-hour cache and fetches live.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "output": {
        "name": "output",
        "in": "query",
        "required": false,
        "description": "csv or ndjson returns the response's records (its main list, or the object as one row) as CSV or NDJSON instead of JSON.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "ndjson"
          ]
        }
      },
      "records": {
        "name": "records",
        "in": "query",
        "required": false,
        "description": "With output=csv|ndjson: the top-level list to turn into rows (e.g. `reviews`), or `.` for the whole object as one row.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "On a 503 for a paused endpoint: the status page, which lists open incidents."
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "responses": {
      "E400": {
        "description": "A parameter is missing or invalid. Not charged (unless the call ran and the source rejected the value; credits_used says).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E402": {
        "description": "Not enough credits, a spend limit you set was reached (`spend_limit`), or the key's monthly credit cap was reached (`key_cap`). Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
        "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E502": {
        "description": "The source site failed this time; retry. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E503": {
        "description": "Endpoint paused or temporarily unavailable; may include retry-after, and status_url (https://api.sh/status) for a paused endpoint. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "headers": {
      "x-request-id": {
        "description": "The call's id (logs, re-fetch with /v1/results/{id}).",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "x-credits-used": {
        "description": "Credits charged for this call.",
        "schema": {
          "type": "integer"
        }
      },
      "x-credits-remaining": {
        "description": "Balance after the call.",
        "schema": {
          "type": "integer"
        }
      }
    }
  },
  "externalDocs": {
    "url": "https://api.sh/docs"
  }
}
