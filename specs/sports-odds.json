    "/odds/v1/sports": {
      "get": {
        "operationId": "oddsSports",
        "summary": "Sports, leagues and books",
        "description": "The books, the sports and the league keys `/odds/v1/events` accepts, with the books that list each league. With `sport`, also every league Pinnacle lists for that sport right now (id, name, region group, number of events); any of those ids works as `league` in `/odds/v1/events`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/odds-sports",
        "tags": [
          "Sports Odds"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "sport",
            "in": "query",
            "required": false,
