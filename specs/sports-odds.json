    "/odds/v1/events": {
      "get": {
        "operationId": "oddsEvents",
        "summary": "Odds comparison for a league (Pinnacle, Unibet, BetRivers, FanDuel)",
        "description": "Upcoming and live events of a league with each bookmaker's main lines side by side: moneyline / 1X2 (home, away, draw), spread or handicap (line and price for each side) and total (line, over, under), every price in decimal and American odds (Unibet and BetRivers also fractional). Events are matched across books by team and start time; `best_moneyline` gives the best price per outcome and the book offering it. Each book block carries its own `event_id` (use it with `/odds/v1/event`), start time, live flag and number of markets. Books: Pinnacle, Unibet, BetRivers (every listed league) and FanDuel (US leagues). A book that fails is listed in `book_errors` and the others are still returned. Odds change by the minute (cached 60 seconds; pass fresh=1 for a new read).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/odds-events",
        "tags": [
          "Sports Odds"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "league",
            "in": "query",
            "required": true,
            "description": "League key: nfl, ncaaf, nba, ncaab, wnba, euroleague, nhl, ahl, mlb, ufc, boxing, epl, championship, laliga, bundesliga, seriea, ligue1, eredivisie, primeira, scotland, turkey, brazil, mls, ligamx, ucl, uel, uecl. Or any Pinnacle league id from `/odds/v1/sports?sport=` (Pinnacle prices only).",
            "schema": {
              "type": "string"
            },
            "example": "nfl"
          },
          {
            "name": "books",
            "in": "query",
            "required": false,
            "description": "Comma-separated books to include: pinnacle, unibet, betrivers, fanduel. Default: all that list the league.",
            "schema": {
              "type": "string"
            },
            "example": "pinnacle,fanduel"
          },
          {
            "name": "team",
            "in": "query",
            "required": false,
            "description": "Only events whose team names contain this text (e.g. cowboys).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "date",
            "in": "query",
            "required": false,
            "description": "Only events starting on this UTC date (YYYY-MM-DD).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
