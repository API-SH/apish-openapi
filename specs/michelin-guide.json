    "/michelin/v1/restaurants": {
      "get": {
        "operationId": "michelinRestaurants",
        "summary": "MICHELIN Guide restaurants in a city or country",
        "description": "Restaurants of the MICHELIN Guide for a country, region or city, optionally only some distinctions (three, two or one star, Bib Gourmand, selected, Green Star), 48 per page: id, name, link, stars, distinction, Green Star flag, location, city, region, country, price band, cuisine, coordinates, hotel, online-booking flag and image, with the total. Also filter by cuisine, price band and restaurants new in this year's Guide; the answer echoes them as `applied_filters`. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/michelin-restaurants",
        "tags": [
          "MICHELIN Guide"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "Country/region/city path as in the Guide's links: `fr`, `fr/ile-de-france/paris`, `gb/greater-london/london`, `us/new-york-state/new-york`, `jp/tokyo-region/tokyo`, `it`, `es/comunidad-de-madrid/madrid`...",
            "schema": {
              "type": "string"
            },
            "example": "fr/ile-de-france/paris"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A guide.michelin.com/<lang>/<location>/restaurants link instead of location.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "distinction",
            "in": "query",
            "required": false,
            "description": "Comma-separated: 3-stars, 2-stars, 1-star, bib-gourmand, selected, green-star.",
            "schema": {
              "type": "string"
            },
            "example": "3-stars,2-stars"
          },
          {
            "name": "cuisine",
            "in": "query",
            "required": false,
            "description": "The Guide's cuisine slugs, comma separated (up to 5): modern-cuisine, creative, classic-cuisine, japanese, italian, seafood-1096, vegetarian... An unknown slug answers 400.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price",
            "in": "query",
            "required": false,
            "description": "Price bands, comma separated: affordable, mid-range, premium, luxury (or 1-4).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "new",
            "in": "query",
            "required": false,
            "description": "true: only restaurants new in this year's Guide.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "language",
            "in": "query",
            "required": false,
            "description": "Language of the texts: en (default), fr, de, es, it, ja, zh...",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "location": "fr/ile-de-france/paris",
                  "distinction": [
                    "3-stars",
