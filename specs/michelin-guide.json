                      "price_note": "Contact customer service for availability",
                      "photos": [
                        "https://static.prod.r53.tablethotels.com/media/hotels/slideshow_images_staged/large/1290658.jpg",
                        "https://static.prod.r53.tablethotels.com/media/hotels/slideshow_images_staged/large/1692450.jpg",
                        "… 8 more"
