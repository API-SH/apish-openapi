                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "location": "paris",
                  "title": "Paris and surroundings : 1-48 of 154 hotels",
                  "page": 1,
                  "total": 154,
                  "count": 52,
                  "next_page": 2,
