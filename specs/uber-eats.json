            "required": false,
            "description": "Only stores with offers (true/false).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "under_30_min",
            "in": "query",
            "required": false,
            "description": "Only stores delivering in under 30 minutes.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "top_rated",
            "in": "query",
