    "/ubereats/v1/stores": {
      "get": {
        "operationId": "ubereatsStores",
        "summary": "Uber Eats restaurants and stores near an address",
        "description": "Restaurants and stores that deliver to an address or point, as the site lists them, or the results of a dish/cuisine search (`q`). Each store: id, name, link, rating, rating score and count, delivery fee, ETA range, accepting-orders flag, offers, badges, coordinates, image and, for searches, matching dishes. Filters: offers, delivery-fee tier, under 30 minutes, top rated, minimum rating, price range, SNAP and benefits-eligible, open now, pickup instead of delivery; sorts: recommended, rating, delivery time. The response also lists the area's available filters with their local labels. Pass `next_offset` back as `offset`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ubereats-stores",
        "tags": [
          "Uber Eats"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "address",
            "in": "query",
            "required": false,
            "description": "Delivery address in any form (e.g. `350 5th Ave, New York`); resolved by the site. Or pass lat and lon.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of the delivery point (with lon).",
            "schema": {
              "type": "number"
            },
            "example": "40.758"
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Longitude of the delivery point (with lat).",
            "schema": {
              "type": "number"
            },
            "example": "-73.9855"
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Search for a dish, cuisine or store name (e.g. `sushi`, `burger`, `Starbucks`); omit for the full feed.",
            "schema": {
              "type": "string"
            },
            "example": "pizza"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "recommended (default), rating or delivery_time.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "min_rating",
            "in": "query",
            "required": false,
            "description": "Minimum rating: 3, 3.5, 4, 4.5 or 5.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "max_delivery_fee",
            "in": "query",
            "required": false,
            "description": "Delivery-fee tier 1-4, as the site's filter (US: up to $2, $3, $4, any; UK: up to £1, £2, £3, any).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price",
            "in": "query",
            "required": false,
            "description": "Price range: 1-4 or $-$$$$, comma-separated (e.g. `1,2`).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "offers",
