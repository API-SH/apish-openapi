    "/ubereats/v1/store": {
      "get": {
        "operationId": "ubereatsStore",
        "summary": "Uber Eats store with its full menu",
        "description": "One Uber Eats store: id, name, link, phone, full address with coordinates and neighbourhood, rating, rating score and count, price bucket, cuisines, labels and tags, currency, open and orderable flags, working-hours line, delivery fee, service fee, ETA, distance, dining modes, opening hours per day range, badges, parent chain, images, the menus with their hours and every menu category with its items (id, name, description, price, sold-out and availability flags, has-options flag, endorsement badges, dietary labels, image, section ids for /ubereats/v1/item) and featured reviews. Fees and ETA are for the delivery point when lat/lon or address is given. Each menu item also has the share of customers who liked it and on how many reviews (`liked_percent`, `liked_reviews`), calories where the menu shows them, and its tags (e.g. `#1 most liked`).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ubereats-store",
        "tags": [
          "Uber Eats"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The store's ubereats.com/store/<name>/<id> link (from /ubereats/v1/stores).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.ubereats.com/store/joes-pizza-times-square-1435-broadway/F9A-B2bKRg-ikAd0B8uzgg"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The store's UUID instead of url.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of the delivery point, for fees and ETA (with lon).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Longitude of the delivery point (with lat).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "address",
            "in": "query",
            "required": false,
            "description": "Delivery address instead of lat/lon.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dining_mode",
            "in": "query",
            "required": false,
            "description": "delivery (default) or pickup.",
            "schema": {
              "type": "string"
            }
          },
          {
