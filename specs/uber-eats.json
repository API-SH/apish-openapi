        "operationId": "ubereatsReviews",
        "summary": "Uber Eats store reviews",
        "description": "Customer reviews of an Uber Eats store as the store page shows them: review id, author's first name and initial, text, date and age, with the store's rating and rating count and, on page 1, the featured reviews. `limit` sets the page size; pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ubereats-reviews",
        "tags": [
          "Uber Eats"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The store's ubereats.com/store/<name>/<id> link (from /ubereats/v1/stores).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.ubereats.com/store/joes-pizza-times-square-1435-broadway/F9A-B2bKRg-ikAd0B8uzgg"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The store's UUID instead of url.",
            "schema": {
              "type": "string"
            },
            "example": "F9A-B2bKRg-ikAd0B8uzgg"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page, 1-100 (default 50).",
            "schema": {
              "type": "integer"
            },
            "example": "50"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (default 1).",
            "schema": {
              "type": "integer"
            },
            "example": "1"
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Language and market of the texts, e.g. `en-US`, `en-GB`, `fr-FR`, `es-MX` (default en-US).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
