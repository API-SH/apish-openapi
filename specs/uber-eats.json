{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: Uber Eats",
    "version": "1.0.0",
    "description": "The Uber Eats API from API.SH: public Uber Eats data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "Uber Eats",
      "description": "5 endpoints (food & delivery)",
      "x-slug": "uber-eats",
      "x-domains": [
        "ubereats.com"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/ubereats/v1/autocomplete": {
      "get": {
        "operationId": "ubereatsAutocomplete",
        "summary": "Uber Eats search suggestions",
        "description": "The Uber Eats search box suggestions for a place: matching stores (id, name, link, cuisines, image, orderable flag) and suggested search terms (dishes and cuisines) for the start of a query.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ubereats-autocomplete",
        "tags": [
          "Uber Eats"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "The start of a dish, cuisine or store name.",
            "schema": {
              "type": "string"
            },
            "example": "piz"
          },
          {
            "name": "address",
            "in": "query",
            "required": false,
            "description": "Delivery address in any form (e.g. 350 5th Ave, New York); resolved by the site. Or pass lat and lon.",
            "schema": {
              "type": "string"
            },
            "example": "Times Square, New York"
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude of the delivery point (with lon).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": false,
            "description": "Longitude of the delivery point (with lat).",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Language and market, like en-US (default), fr-FR, es-MX.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "piz",
                  "location": {
                    "latitude": 40.7579747,
                    "longitude": -73.9855426,
                    "address": "Times Square, New York, NY 10036, USA"
                  },
                  "suggestions": [
                    "pizza",
                    "pizza slice",
                    "… 5 more"
                  ],
                  "stores": [
                    {
                      "id": "fbc2d151-c71e-5f00-b48e-1e10837d98e1",
                      "name": "Pizza Hut",
                      "slug": "pizza-hut-932-8th-ave",
                      "cuisines": [
                        "Pizza",
                        "Italian"
                      ],
                      "image": "https://tb-static.uber.com/prod/image-proc/processed_images/73e7ba59a9708b3967a35e08d90befd4/d69908760640e6133b4375321dd259b9.jpeg",
                      "orderable": true,
                      "url": "https://www.ubereats.com/store/pizza-hut-932-8th-ave/fbc2d151-c71e-5f00-b48e-1e10837d98e1"
                    },
                    {
                      "id": "17d03e07-66ca-460f-a290-077407cbb382",
                      "name": "Joe's Pizza",
                      "slug": "joes-pizza-times-square-1435-broadway",
                      "cuisines": [
                        "Pizza",
                        "American"
                      ],
                      "image": "https://tb-static.uber.com/prod/image-proc/processed_images/6f67fd8dc603a197abf91eba0288129f/9b3aae4cf90f897799a5ed357d60e09d.jpeg",
                      "orderable": true,
                      "url": "https://www.ubereats.com/store/joes-pizza-times-square-1435-broadway/17d03e07-66ca-460f-a290-077407cbb382"
                    }
                  ],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/ubereats/v1/item": {
      "get": {
        "operationId": "ubereatsItem",
        "summary": "Uber Eats menu item with its options",
        "description": "One menu item of an Uber Eats store: name, description, price, sold-out and suspension details, images, dietary labels, endorsements, nutrition facts and every option group (name, min and max choices, required flag) with each option's name, extra price, default quantity, sold-out flag and nested sub-groups. Identify the item by the ids from /ubereats/v1/store, or by the store (url, id or store_id) plus `name`, which opens the first menu item whose name contains it.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/ubereats-item",
        "tags": [
          "Uber Eats"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The store's link (with name).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.ubereats.com/store/joes-pizza-times-square-1435-broadway/F9A-B2bKRg-ikAd0B8uzgg"
          },
          {
            "name": "name",
            "in": "query",
            "required": false,
            "description": "Part of the item's name (with url, id or store_id).",
            "schema": {
              "type": "string"
            },
            "example": "cheese pie"
          },
          {
            "name": "store_id",
            "in": "query",
            "required": false,
            "description": "The store UUID.",
            "schema": {
              "type": "string"
            },
            "example": "F9A-B2bKRg-ikAd0B8uzgg"
          },
          {
            "name": "item_id",
            "in": "query",
            "required": false,
            "description": "The item's id (from /ubereats/v1/store).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "section_id",
            "in": "query",
            "required": false,
            "description": "The item's section_id (from /ubereats/v1/store).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subsection_id",
            "in": "query",
            "required": false,
            "description": "The item's subsection_id (from /ubereats/v1/store).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "required": false,
            "description": "Language and market of the texts, e.g. `en-US`, `en-GB`, `fr-FR`, `es-MX` (default en-US).",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/ubereats/v1/reviews": {
