    "/copart/v1/search": {
      "get": {
        "operationId": "copartSearch",
        "summary": "Copart lot search",
        "description": "Vehicle lots on Copart (US auctions) for keywords and/or filters, as a logged-out visitor sees them. Each lot: lot number, title, year, make, model, trim, masked VIN, body, colour, engine, fuel, transmission, drive, keys, odometer, damage, condition, title type and state, estimated retail value, current bid, buy-now price, sale status and date, yard and location, highlights, link, thumbnail and `raw`. Filter by damage, title type, vehicle type, fuel, drive, body style, transmission, seller source, Buy It Now, newly added lots and sale dates. `facets` lists the site's filter groups with counts for the current search (values for fuel, drive, body_style and transmission are matched as written there). Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/copart-search",
        "tags": [
          "Copart"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keywords, e.g. `toyota camry`. Optional when a filter is given.",
            "schema": {
              "type": "string"
            },
            "example": "toyota camry"
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "description": "Make, e.g. `TOYOTA`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Model, e.g. `CAMRY`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year_min",
            "in": "query",
            "required": false,
            "description": "Oldest model year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_max",
            "in": "query",
            "required": false,
            "description": "Newest model year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "odometer_min",
            "in": "query",
            "required": false,
            "description": "Lowest odometer reading.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "odometer_max",
            "in": "query",
            "required": false,
            "description": "Highest odometer reading.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "yard",
            "in": "query",
            "required": false,
            "description": "Yard name as shown on lots, e.g. `CA - SACRAMENTO`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "damage",
            "in": "query",
            "required": false,
            "description": "Primary damage, one or more comma-separated (either matches): all_over, biohazard_chemical, burn, burn_engine, burn_interior, damage_history, frame_damage, front_end, hail, mechanical, minor_dent_scratches, missing_altered_vin, normal_wear, partial_repair, rear_end, rejected_repair, replaced_vin, rollover, side, stripped, top_roof, undercarriage, unknown, vandalism, water_flood.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "title_type",
            "in": "query",
            "required": false,
            "description": "Title group, one or more comma-separated: clean, salvage, non_repairable.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "vehicle_type",
            "in": "query",
            "required": false,
            "description": "Vehicle type, one or more comma-separated: automobiles, pickup_trucks, suvs, motorcycle, atvs, dirt_bikes, snowmobile, jet_skis, boats, rvs, trailers, bus, medium_duty_box_trucks, heavy_duty_trucks, construction_equipment, industrial_equipment, agriculture_farm_equipment.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "source",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fuel",
            "in": "query",
            "required": false,
            "description": "Fuel type as Copart writes it, one or more comma-separated, e.g. `GAS`, `DIESEL`, `ELECTRIC`, `ELECTRIC AND GAS HYBRID`, `FLEXIBLE`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "drive",
            "in": "query",
            "required": false,
            "description": "Drive train as Copart writes it, one or more comma-separated, e.g. `ALL WHEEL DRIVE`, `FRONT WHEEL DRIVE`, `REAR WHEEL DRIVE`, `4X4 W/REAR WHEEL DRV`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "body_style",
            "in": "query",
            "required": false,
            "description": "Body style as Copart writes it, one or more comma-separated, e.g. `SEDAN 4D`, `4DR SPORT UTILITY`, `PICKUP`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transmission",
            "in": "query",
            "required": false,
            "description": "Transmission, e.g. `AUTOMATIC` or `MANUAL`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "buy_now",
            "in": "query",
            "required": false,
            "description": "true: only lots with a Buy It Now price.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "newly_added",
            "in": "query",
            "required": false,
            "description": "Only lots added in the last 24 hours or 7 days.",
            "schema": {
              "type": "string",
              "enum": [
                "24h",
                "7d"
              ]
            }
          },
          {
            "name": "sale_date_from",
            "in": "query",
            "required": false,
            "description": "Earliest sale date (YYYY-MM-DD, UTC).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sale_date_to",
            "in": "query",
            "required": false,
            "description": "Latest sale date, inclusive (YYYY-MM-DD, UTC). Same as sale_date_from for one day's auctions.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "auction_date (default), newest_year, oldest_year, odometer_low, odometer_high.",
            "schema": {
              "type": "string",
              "enum": [
                "auction_date",
                "newest_year",
                "oldest_year",
                "odometer_low",
                "odometer_high"
              ]
            }
          },
          {
            "name": "size",
            "in": "query",
            "required": false,
            "description": "Lots per page, 1-100 (default 20).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "toyota camry",
                  "sort": "auction_date",
                  "page": 1,
                  "size": 20,
                  "total": 49895,
                  "count": 20,
                  "next_page": 2,
                  "facets": [
