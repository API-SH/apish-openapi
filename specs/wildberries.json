    "/wildberries/v1/search": {
      "get": {
        "operationId": "wildberriesSearch",
        "summary": "Wildberries product search",
        "description": "Search Wildberries, Russia's largest marketplace, with the site's sorts and filters, as shown for delivery in Moscow. Each product has its id, link, name, brand, seller and seller rating, price and price before discount in rubles, discount, rating and review count, colors, sizes with their prices, stock and delivery time, photo count and first photo, plus `raw`. Each answer also lists the filters the site offers for the query (`available_filters`: categories, brands, sellers, colors, sizes, price range and product properties with their ids), which go back in as `brand_ids`, `subject_ids`, `seller_ids`, `color_ids`, `size_ids` or `filters`. 100 products a page. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wildberries-search",
        "tags": [
          "Wildberries"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "What to search for (Russian or English).",
            "schema": {
              "type": "string"
            },
            "example": "iphone"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order: popular (default), rate (rating), priceup, pricedown, newly (newest), benefit (best deal).",
            "schema": {
              "type": "string",
              "enum": [
                "popular",
                "rate",
                "priceup",
                "pricedown",
                "newly",
                "benefit"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in rubles.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Highest price in rubles.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "brand_ids",
