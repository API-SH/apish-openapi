      "get": {
        "operationId": "wildberriesCategory",
        "summary": "Wildberries category products",
        "description": "Products of one Wildberries category (a leaf from /wildberries/v1/categories, or a wildberries.ru/catalog/... link), 100 a page, with the same fields, sorts and filters as search and the category's own `available_filters`. Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wildberries-category",
        "tags": [
          "Wildberries"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "A category id with products (has_products in /wildberries/v1/categories).",
            "schema": {
              "type": "string"
            },
            "example": "9463"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A wildberries.ru/catalog/... category link instead.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default popular).",
            "schema": {
              "type": "string",
              "enum": [
                "popular",
                "rate",
                "priceup",
                "pricedown",
                "newly",
                "benefit"
              ]
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Lowest price in rubles.",
