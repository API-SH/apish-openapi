    "/wildberries/v1/reviews": {
      "get": {
        "operationId": "wildberriesReviews",
        "summary": "Wildberries reviews",
        "description": "Reviews of a Wildberries product (all its color and size variants, as on the site): rating, text, pros, cons, date, author name and country, color, size, size fit, likes and dislikes, photo count, the seller's answer, plus the product's rating, review counts and rating distribution. Sort by date, rating or helpfulness and narrow to one rating, reviews with photos or this variant only. Pass `next_offset` back as `offset`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wildberries-reviews",
        "tags": [
          "Wildberries"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The product number.",
            "schema": {
              "type": "string"
            },
            "example": "169684889"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A product link instead.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "root_id",
            "in": "query",
            "required": false,
            "description": "The product's root id (root_id in /wildberries/v1/product) instead of id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default newest).",
            "schema": {
              "type": "string",
              "enum": [
                "newest",
                "oldest",
                "rating_desc",
                "rating_asc",
                "helpful"
              ]
            }
          },
          {
            "name": "rating",
            "in": "query",
            "required": false,
            "description": "Only reviews with this rating (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "with_photos",
            "in": "query",
            "required": false,
            "description": "true: only reviews with photos.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "this_variant_only",
            "in": "query",
            "required": false,
            "description": "true: only reviews of this exact product id, not its other variants.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Reviews per page (1-100, default 30).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "description": "`next_offset` from the previous page (default 0).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
