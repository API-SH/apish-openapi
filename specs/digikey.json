    "/digikey/v1/product": {
      "get": {
        "operationId": "digikeyProduct",
        "summary": "One DigiKey product",
        "description": "One DigiKey product by its link, or by manufacturer part number (`mpn`, optionally narrowed by `manufacturer`) or DigiKey part number (`dkpn`): name, part numbers, manufacturer, description, categories, price and price breaks, stock, availability, lead time, lifecycle, RoHS/REACH/MSL status, datasheet, images, specifications and environmental data. Also returns `substitutes` (part number, manufacturer, stock, DigiKey part number, price and substitute type, with `substitutes_total`), `alternate_packaging`, `also_evaluated`, `associated_products` (for-use-with parts such as evaluation boards) and `packaging_variants` (each DigiKey part number's packaging, minimum order and price breaks). A part-number lookup returns `lookup` with the matching candidates and costs more than a link.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/digikey-product",
        "tags": [
          "DigiKey"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "The product's digikey.com/<lang>/products/detail/... link (or give mpn or dkpn).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.digikey.com/en/products/detail/stackpole-electronics-inc/RMCF0805JT10K0/1757763"
          },
          {
            "name": "mpn",
            "in": "query",
            "required": false,
            "description": "Manufacturer part number, e.g. LM358DR (instead of url). When several manufacturers use it, the first match is returned unless `manufacturer` picks one.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "dkpn",
            "in": "query",
            "required": false,
            "description": "DigiKey part number, e.g. 296-LM358DRCT-ND (instead of url).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "manufacturer",
            "in": "query",
            "required": false,
            "description": "With mpn: part of the manufacturer's name, e.g. Texas Instruments.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "name": "RMCF0805JT16K0",
                  "url": "https://www.digikey.com/en/products/detail/stackpole-electronics-inc/RMCF0805JT10K0/1757763",
                  "digikey_part_number": "738-RMCF0805JT16K0TR-ND",
                  "manufacturer_part_number": "RMCF0805JT16K0",
                  "manufacturer": "Stackpole Electronics Inc",
                  "description": "16 kOhms ±5% 0.125W, 1/8W Chip Resistor 0805 (2012 Metric) Automotive AEC-Q200 Thick Film",
                  "category": "Chip Resistor - Surface Mount",
                  "categories": [
                    "Resistors",
                    "Chip Resistor - Surface Mount"
                  ],
                  "price": 0.00291,
                  "currency": "USD",
                  "price_breaks": [
                    {
                      "quantity": 50000,
                      "unit_price": 0.00291
                    },
                    {
                      "quantity": 35000,
                      "unit_price": 0.00306
                    },
                    "… 20 more"
                  ],
                  "stock_quantity": 5929,
                  "availability": "In-Stock: 5,929",
                  "lead_time": "21 Weeks",
                  "min_order_qty": 1,
                  "lifecycle_status": "Active",
                  "rohs_status": "ROHS3 Compliant",
                  "reach_status": "REACH Unaffected",
                  "msl_rating": "1  (Unlimited)",
                  "datasheet_url": "https://www.seielect.com/catalog/SEI-RMCF_RMCP.pdf",
                  "image": "https://mm.digikey.com/Volume0/opasdata/d220001/medias/images/639/0805-RMCF-Series.jpg?hidebanner=true",
                  "specifications": {
                    "Mfr": "Stackpole Electronics Inc",
                    "Series": "RMCF",
                    "Packaging": "Tape & Reel (TR), Cut Tape (CT), Digi-Reel®",
                    "Part Status": "Active",
                    "Resistance": "16 kOhms",
                    "Tolerance": "±5%",
