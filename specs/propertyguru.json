{
  "openapi": "3.1.0",
  "info": {
    "title": "API.SH: PropertyGuru",
    "version": "1.0.0",
    "description": "The PropertyGuru API from API.SH: public PropertyGuru data as clean JSON. Every endpoint is a GET with query parameters and your key in the x-api-key header. Calls that run cost the credits shown (x-credits): successes, and lookups that found nothing (404). Refused calls and errors on our side are free. Docs: https://api.sh/docs · Every platform: https://api.sh/openapi.json",
    "contact": {
      "name": "API.SH support",
      "email": "support@api.sh",
      "url": "https://api.sh/contact"
    },
    "termsOfService": "https://api.sh/legal/terms"
  },
  "servers": [
    {
      "url": "https://api.api.sh"
    }
  ],
  "security": [
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Account",
      "description": "Your balance, usage, logs and past responses. Free."
    },
    {
      "name": "PropertyGuru",
      "description": "3 endpoints (real estate)",
      "x-slug": "propertyguru",
      "x-domains": [
        "propertyguru.com.sg"
      ]
    }
  ],
  "paths": {
    "/v1/account": {
      "get": {
        "operationId": "getAccount",
        "tags": [
          "Account"
        ],
        "summary": "Balance, plan, spend and spend limits",
        "description": "Credits by bucket (free monthly, plan, pay-as-you-go), the plan, credits spent today and this month (UTC), your spend limits and the key used. Free: costs no credits.",
        "responses": {
          "200": {
            "description": "Account",
            "content": {
              "application/json": {
                "example": {
                  "success": true,
                  "account": {
                    "id": "8f0c…",
                    "status": "active",
                    "unlimited": false
                  },
                  "credits": {
                    "total": 41250,
                    "free": 100,
                    "plan": 0,
                    "payg": 41150,
                    "free_resets_at": "2026-11-01T00:00:00Z"
                  },
                  "plan": null,
                  "spend": {
                    "today": 120,
                    "this_month": 3400,
                    "daily_limit": 5000,
                    "monthly_limit": null,
                    "period": "UTC"
                  },
                  "key": {
                    "id": "…",
                    "name": "production",
                    "prefix": "ash_li",
                    "created_at": "2026-10-01T00:00:00Z"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/usage": {
      "get": {
        "operationId": "getAccountUsage",
        "tags": [
          "Account"
        ],
        "summary": "Usage per day and per endpoint",
        "description": "Calls, errors and credits per UTC day, and the top endpoints by credits. Free. Add output=csv for the daily rows as CSV.",
        "parameters": [
          {
            "name": "days",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 90,
              "default": 30
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Usage",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/account/logs": {
      "get": {
        "operationId": "listAccountLogs",
        "tags": [
          "Account"
        ],
        "summary": "Your calls of the last 30 days",
        "description": "Newest first. Filter by status, route prefix, key or time; page with `before` (the `next` value). Add output=csv|ndjson to download (up to 5,000 rows per request; the next cursor is in the x-next-cursor header). Free.",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 500,
              "default": 50
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "ok, error, or an HTTP status like 502.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "route",
            "in": "query",
            "required": false,
            "description": "Route prefix, e.g. /tiktok/v1",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key",
            "in": "query",
            "required": false,
            "description": "Only calls made with this key id.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "description": "ISO time.",
            "schema": {
              "type": "string",
              "format": "date-time"
            }
          },
          {
            "name": "before",
            "in": "query",
            "required": false,
            "description": "Cursor from `next`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          }
        ],
        "responses": {
          "200": {
            "description": "Calls",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/results/{request_id}": {
      "get": {
        "operationId": "getResult",
        "tags": [
          "Account"
        ],
        "summary": "Fetch a past response again, free",
        "description": "The exact response a call returned, for 30 days after the call, at no cost. Use the call's x-request-id. Supports output=csv|ndjson.",
        "parameters": [
          {
            "name": "request_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The stored response (headers: x-refetch: 1, x-original-time, x-original-route).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          },
          "404": {
            "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "410": {
            "description": "Older than 30 days.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/propertyguru/v1/agent": {
      "get": {
        "operationId": "propertyguruAgent",
        "summary": "PropertyGuru agent profile",
        "description": "A property agent's public profile on PropertyGuru (Singapore or Malaysia): name, job title, licence (CEA registration or REN), agency with its licence and logo, photo, verification, years on the site, transactions in the last 3 years, languages, description, rating with the star breakdown and the per-category scores, client reviews (rating, date, comment, reviewer name, replies), specialities, past transactions by type and property type with locations and by client type, regions and HDB estates served, active listing counts for sale and rent with their search links, posts and social and website links. Phone numbers are not shown on the profile without a contact request and are not returned. Pass the profile link, or `id` in Singapore.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/propertyguru-agent",
        "tags": [
          "PropertyGuru"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "An agent profile link (propertyguru.com.sg/agent/<name>-<id> or propertyguru.com.my/property-agents/<name>-<id>).",
            "schema": {
              "type": "string"
            },
            "example": "https://www.propertyguru.com.sg/agent/don-lim-313587"
          },
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The agent id (Singapore only; Malaysia needs the link).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "description": "sg (default) or my; taken from the link when one is given.",
            "schema": {
              "type": "string",
              "enum": [
                "sg",
                "my"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/propertyguru/v1/listing": {
      "get": {
        "operationId": "propertyguruListing",
        "summary": "PropertyGuru listing details",
        "description": "One listing: title, type and status, price and price type, price per floor and land area, bedrooms, bathrooms, floor and land area, property type, project name and id, developer, tenure, address, postcode, district, the details list (furnishing, completion, lease, listed date, units), description, amenities, common facilities, photos, floor plans, videos and virtual tours, agent (name, phone, licence, profile, agency, verification, tenure), project details, price insight and FAQ, plus `raw`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/propertyguru-listing",
        "tags": [
          "PropertyGuru"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": true,
            "description": "Listing id or a PropertyGuru listing link.",
            "schema": {
              "type": "string"
            },
            "example": "500251822"
          },
          {
            "name": "market",
            "in": "query",
            "required": false,
            "description": "sg or my (detected from a link; default sg).",
            "schema": {
              "type": "string",
              "enum": [
                "sg",
                "my"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/propertyguru/v1/search": {
      "get": {
        "operationId": "propertyguruSearch",
        "summary": "PropertyGuru property search",
        "description": "Property listings on PropertyGuru Singapore (market sg) or Malaysia (market my), for sale or rent, residential or commercial, with the site's filters: property type group and types, keyword or place, district, HDB estate, MRT station and distance, price, price per area, bedrooms, bathrooms, floor and land size, tenure, furnishing, floor level, completion year, listed within, unit and project features, rental conditions, new projects, verified listings, floor plans, video, and sort. Each listing has price and type, price per area, bedrooms, bathrooms, size, property type, address and area, MRT, posting date, badges, agent (name, licence, profile) and agency, and photos, plus `raw`. 20 a page; pass `next_page` back as `page` (null on the last page).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/propertyguru-search",
        "tags": [
          "PropertyGuru"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "market",
            "in": "query",
            "required": false,
            "description": "sg (Singapore, default) or my (Malaysia).",
            "schema": {
              "type": "string",
              "enum": [
                "sg",
                "my"
              ]
            }
          },
          {
            "name": "listing_type",
            "in": "query",
            "required": false,
            "description": "sale or rent (default sale).",
            "schema": {
              "type": "string",
              "enum": [
                "sale",
                "rent"
              ]
            },
            "example": "sale"
          },
          {
            "name": "commercial",
            "in": "query",
            "required": false,
            "description": "true: commercial property.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "property_type_group",
            "in": "query",
            "required": false,
            "description": "Singapore: N condo, L landed, H HDB (Malaysia uses its own codes).",
            "schema": {
              "type": "string"
            },
            "example": "N"
          },
          {
            "name": "property_type_code",
            "in": "query",
            "required": false,
            "description": "Property type codes, comma separated (e.g. CONDO, APT, EXCON, TERRA, SEMI, DETAC, 4A, 5I).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Keyword or place (e.g. Tampines, a project name).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "district_code",
            "in": "query",
            "required": false,
            "description": "District codes, comma separated (e.g. D09, D10).",
            "schema": {
              "type": "string"
            },
            "example": "D09"
          },
          {
            "name": "hdb_estate",
            "in": "query",
            "required": false,
            "description": "HDB estate codes, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "mrt_station",
            "in": "query",
            "required": false,
            "description": "MRT station codes, comma separated (e.g. NS1, EW12).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "distance_to_mrt_km",
            "in": "query",
            "required": false,
            "description": "Within this distance of an MRT station (0.25 to 1.5).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "price_min",
            "in": "query",
            "required": false,
            "description": "Minimum price.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "price_max",
            "in": "query",
            "required": false,
            "description": "Maximum price.",
            "schema": {
              "type": "integer"
            },
            "example": "2000000"
          },
          {
            "name": "psf_min",
            "in": "query",
            "required": false,
            "description": "Minimum price per square foot.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "psf_max",
            "in": "query",
            "required": false,
            "description": "Maximum price per square foot.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "bedrooms",
            "in": "query",
            "required": false,
            "description": "Bedroom counts, comma separated (0 for studio).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "bathrooms",
            "in": "query",
            "required": false,
            "description": "Bathroom counts, comma separated.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "size_min",
            "in": "query",
            "required": false,
            "description": "Minimum floor size (sqft).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "size_max",
            "in": "query",
            "required": false,
            "description": "Maximum floor size (sqft).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "land_size_min",
            "in": "query",
            "required": false,
            "description": "Minimum land size (sqft).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "land_size_max",
            "in": "query",
            "required": false,
            "description": "Maximum land size (sqft).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "tenure",
            "in": "query",
            "required": false,
            "description": "Tenure codes, comma separated: F (freehold), L99, L103, L110, L999, L9999.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "furnishing",
            "in": "query",
            "required": false,
            "description": "Comma separated: UNFUR, PART, FULL.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "floor_level",
            "in": "query",
            "required": false,
            "description": "Comma separated: GND, LOW, MID, HIGH, PENT.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "completion_year_min",
            "in": "query",
            "required": false,
            "description": "Completed (TOP) in or after.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "completion_year_max",
            "in": "query",
            "required": false,
            "description": "Completed (TOP) in or before.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "listed_within_days",
            "in": "query",
            "required": false,
            "description": "Listed within 3, 7, 14 or 31 days.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "unit_features",
            "in": "query",
            "required": false,
            "description": "Comma separated: ARCON, BALC, BTRM, CORN, HLRM, PRPL, RENO, TERR.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "project_features",
            "in": "query",
            "required": false,
            "description": "Comma separated: GYM, PARK, SWIM, TEN.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "tenancy_conditions",
            "in": "query",
            "required": false,
            "description": "Rentals, comma separated: hasAircon, ownerStays, allowPets, hasUtilities, allowVisitors, hasWifi.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "room_type",
            "in": "query",
            "required": false,
            "description": "Room rentals: master, common or shared.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "entire_unit_or_room",
            "in": "query",
            "required": false,
            "description": "Rentals: ent (entire unit) or room.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "lease_term",
            "in": "query",
            "required": false,
            "description": "Rentals: 1YR, 2YR, 3YR, ST (short term), FL (flexible).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "new_project",
            "in": "query",
            "required": false,
            "description": "true: new launches only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "verified",
            "in": "query",
            "required": false,
            "description": "true: verified listings only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "with_floor_plans",
            "in": "query",
            "required": false,
            "description": "true: with floor plans.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "with_video",
            "in": "query",
            "required": false,
            "description": "true: with video.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order (default relevance).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "newest",
                "oldest",
                "price_low",
                "price_high",
                "size_small",
                "size_large",
                "psf_low",
                "psf_high"
              ]
            },
            "example": "price_low"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page (20 a page).",
            "schema": {
              "type": "integer",
              "default": "1"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Create keys at https://app.api.sh/keys. Authorization: Bearer <key> also works."
      }
    },
    "parameters": {
      "raw": {
        "name": "raw",
        "in": "query",
        "required": false,
        "description": "0 leaves out the bulky `raw` source blocks (often 10-30x smaller).",
        "schema": {
          "type": "string",
          "enum": [
            "0",
            "1"
          ]
        }
      },
      "fields": {
        "name": "fields",
        "in": "query",
        "required": false,
        "description": "Comma-separated fields to return, e.g. `posts.id,posts.title`. Call metadata is always included.",
        "schema": {
          "type": "string"
        }
      },
      "fresh": {
        "name": "fresh",
        "in": "query",
        "required": false,
        "description": "1 skips the 24-hour cache and fetches live.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "output": {
        "name": "output",
        "in": "query",
        "required": false,
        "description": "csv or ndjson returns the response's records (its main list, or the object as one row) as CSV or NDJSON instead of JSON.",
        "schema": {
          "type": "string",
          "enum": [
            "json",
            "csv",
            "ndjson"
          ]
        }
      },
      "records": {
        "name": "records",
        "in": "query",
        "required": false,
        "description": "With output=csv|ndjson: the top-level list to turn into rows (e.g. `reviews`), or `.` for the whole object as one row.",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "status_url": {
            "type": "string",
            "format": "uri",
            "description": "On a 503 for a paused endpoint: the status page, which lists open incidents."
          }
        },
        "required": [
          "success",
          "error"
        ]
      }
    },
    "responses": {
      "E400": {
        "description": "A parameter is missing or invalid. Not charged (unless the call ran and the source rejected the value; credits_used says).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E401": {
        "description": "Missing, invalid, revoked or expired API key. Not charged. See https://api.sh/docs/errors#401",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E402": {
        "description": "Not enough credits, a spend limit you set was reached (`spend_limit`), or the key's monthly credit cap was reached (`key_cap`). Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E404": {
        "description": "Not found, or not public. A lookup that ran costs the endpoint's price (credits_used says); an unknown route is free.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E502": {
        "description": "The source site failed this time; retry. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "E503": {
        "description": "Endpoint paused or temporarily unavailable; may include retry-after, and status_url (https://api.sh/status) for a paused endpoint. Not charged.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "headers": {
      "x-request-id": {
        "description": "The call's id (logs, re-fetch with /v1/results/{id}).",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "x-credits-used": {
        "description": "Credits charged for this call.",
        "schema": {
          "type": "integer"
        }
      },
      "x-credits-remaining": {
        "description": "Balance after the call.",
        "schema": {
          "type": "integer"
        }
      }
    }
  },
  "externalDocs": {
    "url": "https://api.sh/docs"
  }
}
