    "/freshersworld/v1/job": {
      "get": {
        "operationId": "freshersworldJob",
        "summary": "Freshersworld job details",
        "description": "One Freshersworld job posting in full: title, company, posted and closing dates, employment type, remote flag, locations, experience in months, every eligible qualification, salary range with period and currency, the full description (text and HTML) and the site's original posting data in `raw`. Expired jobs, which the site keeps online, come back from their page with `expired: true` (title, company, locations, experience, salary, qualifications, posted date and description). Pass an id or the job link; `latest=true` returns the newest job on the site.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/freshersworld-job",
        "tags": [
          "Freshersworld"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "Job id (the number at the end of the job link).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Job link, e.g. https://www.freshersworld.com/jobs/...-2953242",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "latest",
            "in": "query",
            "required": false,
            "description": "true: the newest job on the site.",
            "schema": {
              "type": "string",
              "enum": [
                "true"
              ]
            },
            "example": "true"
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "id": 2954521,
                  "url": "https://www.freshersworld.com/jobs/software-tester-jobs-opening-in-web-axis-at-btm-bangalore-mangalore-bengaluru-rural-2954521",
                  "title": "Software Tester",
