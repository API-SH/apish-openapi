    "/freshersworld/v1/search": {
      "get": {
        "operationId": "freshersworldSearch",
        "summary": "Freshersworld job search",
        "description": "Searches Freshersworld's jobs for freshers and early-career candidates by keywords and city, with the site's filters: course (qualification), experience and job type; or lists a job category (IT/Software, Govt Jobs, MBA, Internship, Walk-in, BPO, Bank, Teaching, ...) optionally in one city. 20 jobs per page, each with `id`, `title`, `url`, company, company logo, locations (with their city pages), experience, salary text with min/max and period, eligible qualifications, a short snippet, posted age and the Hot/Premium label. `total` is the number of matching jobs. Pass `next_page` back as `page`; null on the last page (the first 2,000 results).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/freshersworld-search",
        "tags": [
          "Freshersworld"
        ],
        "x-credits": 1,
