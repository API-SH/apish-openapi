          "Wer liefert was"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "slug",
            "in": "query",
            "required": true,
            "description": "The supplier's slug from a search result (or its wlw.de/de/firma/... link as `url`).",
