    "/wlw/v1/search": {
      "get": {
        "operationId": "wlwSearch",
        "summary": "Search German, Austrian and Swiss suppliers (wlw)",
        "description": "Suppliers, manufacturers, wholesalers and service providers on Wer liefert was by product, service or name, with country, supplier type, company size, verified-only and distance filters and paging. Each supplier has id, slug, name, description, website, phone, street, postcode, city, country, coordinates, logo, supplier types, employee band, founding year, distribution area, verified flag, certificates count, response rate and time, product counts, a match snippet, featured products and pictures. `facets` lists countries, supplier types, company sizes and verified counts. The directory serves the first 3,300 results of a search (`last_reachable_page`). Pass `next_page` back as `page`; null on the last page.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wlw-search",
        "tags": [
          "Wer liefert was"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Product, service or company name (German or English), e.g. schrauben.",
            "schema": {
              "type": "string"
            },
            "example": "schrauben"
          },
          {
            "name": "country",
            "in": "query",
            "required": false,
            "description": "Supplier countries, comma separated ISO codes, e.g. DE,AT,CH.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "supplier_type",
            "in": "query",
            "required": false,
            "description": "Comma list: production, customer_specific_manufacturing, distribution, service, wholesaler.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "employees",
            "in": "query",
            "required": false,
            "description": "Comma list of bands: 1-4, 5-9, 10-19, 20-49, 50-99, 100-199, 200-499, 500-999, 1000+.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "verified",
            "in": "query",
            "required": false,
            "description": "true: verified suppliers only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "lat",
            "in": "query",
            "required": false,
            "description": "Latitude for a distance search.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lng",
            "in": "query",
            "required": false,
            "description": "Longitude for a distance search.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "radius_km",
            "in": "query",
            "required": false,
            "description": "Radius around lat/lng in km (default 50).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "relevance (default) or distance (needs lat and lng).",
            "schema": {
              "type": "string",
              "enum": [
                "relevance",
                "distance"
              ]
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "de (default) or en.",
            "schema": {
              "type": "string",
              "enum": [
                "de",
                "en"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page, 1-30 (default 30).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "page",
