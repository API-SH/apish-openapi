    "/wellfound/v1/search": {
      "get": {
        "operationId": "wellfoundSearch",
        "summary": "Wellfound job search",
        "description": "Startups hiring for a role and/or in a location, 20 companies per page with their open jobs, from Wellfound's public job pages: `role` alone (/role/<role>), `role` + `location` (/role/l/<role>/<location>), `role` + `remote=true` (/role/r/<role>) or `location` alone (/location/<location>). Give at least one of `role`, `location` or `url`. `total_companies`, `total_jobs` and `total_pages` come from Wellfound. Pass `next_page` back as `page`; `next_page` is null on the last page. Each job's `url` works with `/wellfound/v1/job`.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/wellfound-search",
        "tags": [
          "Wellfound"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "role",
            "in": "query",
            "required": false,
            "description": "Role name or Wellfound slug, e.g. `software-engineer`, `Product Manager`, `data-scientist`.",
            "schema": {
              "type": "string"
            },
            "example": "software-engineer"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City or Wellfound location slug, e.g. `new-york`, `San Francisco`, `london`. `remote` is the same as `remote=true`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "remote",
            "in": "query",
            "required": false,
            "description": "With `role`: remote jobs only (Wellfound has no remote + location page).",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "Instead of the above: a wellfound.com /role/... or /location/... page URL, path, or a role slug.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number. Pass `next_page` from the previous response; `next_page` is null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "page": 1,
                  "next_page": 2,
