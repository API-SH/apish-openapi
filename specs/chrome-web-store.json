    "/chrome-web-store/v1/search": {
      "get": {
        "operationId": "chromeWebStoreSearch",
        "summary": "Chrome Web Store search",
        "description": "Pass `next_cursor` back as `cursor` for the next page; null on the last page. The store's own filters narrow the results: `type` (extensions or themes), `min_rating` (the store compares its rounded rating, so 3.9 counts as 4) `featured` and `established` (items from established publishers; one of featured/established at a time); a filtered search returns the store's first page (`next_cursor` null) and echoes the applied `filters`. `category` keeps only results in that store category (a group such as `productivity` or a category such as `productivity/developer`); on unfiltered searches up to 6 store pages are read to fill a page (`scanned` says how many results were checked; a page can come back empty with a `next_cursor` when none of the scanned results matched).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/chrome-web-store-search",
        "tags": [
          "Chrome Web Store"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search words.",
            "schema": {
              "type": "string"
            },
            "example": "ad blocker"
          },
          {
            "name": "hl",
            "in": "query",
            "required": false,
            "description": "Language (default en).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "description": "Results per page (1-100, default 10).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "description": "`next_cursor` from the previous page.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "type",
            "in": "query",
            "required": false,
            "description": "Only extensions or only themes.",
            "schema": {
              "type": "string",
              "enum": [
                "extension",
                "theme"
              ]
            }
          },
          {
            "name": "min_rating",
            "in": "query",
            "required": false,
            "description": "Minimum store rating (1-5).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "featured",
            "in": "query",
            "required": false,
            "description": "true: only items with the store's Featured badge.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "established",
            "in": "query",
            "required": false,
            "description": "true: only items from the store's established publishers.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "category",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
