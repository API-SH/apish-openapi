    "/sncf-connect/v1/places": {
      "get": {
        "operationId": "sncfConnectPlaces",
        "summary": "SNCF Connect place search",
        "description": "Stations, cities, addresses and points of interest as the SNCF Connect search box suggests them: id, name, region, type, UIC codes, booking code, transit id and the train, tram and bus lines that serve a station.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/sncf-connect-places",
        "tags": [
          "SNCF Connect"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Place name (2+ characters).",
            "schema": {
              "type": "string"
            },
            "example": "bordeaux"
          },
          {
            "name": "stations_only",
            "in": "query",
            "required": false,
            "description": "`true`: only stations.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "q": "bordeaux",
                  "stations_only": false,
                  "count": 26,
                  "places": [
                    {
