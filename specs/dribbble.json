    "/dribbble/v1/profile": {
      "get": {
        "operationId": "dribbbleProfile",
        "summary": "Dribbble designer or team profile",
        "description": "A designer's or team's public Dribbble profile: name, headline, bio, location, avatar, links, followers, following, likes, Pro badge, and their latest shots (cards as in search). Also `available_for_work`. `include=about` adds the About page (one more page read): bio, location, member since, skills, top specialties, work history, what they are seeking, teams with their members and outside links.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/dribbble-profile",
        "tags": [
          "Dribbble"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "username",
            "in": "query",
            "required": false,
            "description": "Dribbble username (or pass `url`).",
            "schema": {
              "type": "string"
            },
            "example": "Larkef"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A dribbble.com profile link, instead of `username`.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "description": "`about` to add the profile's About page (one more page read).",
            "schema": {
              "type": "string",
              "enum": [
                "about"
              ]
            }
          },
          {
            "$ref": "#/components/parameters/raw"
