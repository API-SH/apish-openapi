    "/kroger/v1/product": {
      "get": {
        "operationId": "krogerProduct",
        "summary": "One Kroger product",
        "description": "One product by UPC with the store's price (regular, promo, unit price), stock level and fulfillment options, aisle locations, description, nutrition facts, ingredients and allergens, dietary tags, dimensions, rating distribution, images and URL.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kroger-product",
        "tags": [
          "Kroger"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "id",
            "in": "query",
            "required": false,
            "description": "The 13-digit UPC at the end of a Kroger product URL.",
            "schema": {
              "type": "string"
            },
            "example": "0001111041700"
          },
          {
            "name": "url",
            "in": "query",
            "required": false,
            "description": "A Kroger (or sister banner) product URL, instead of id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "zip",
            "in": "query",
            "required": false,
            "description": "5-digit US ZIP: price and stock of the nearest store.",
            "schema": {
              "type": "string"
            },
            "example": "45202"
          },
          {
            "name": "store_id",
            "in": "query",
            "required": false,
            "description": "8-digit store location id.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "banner",
            "in": "query",
            "required": false,
            "description": "Store banner (default kroger); see /kroger/v1/search.",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/kroger/v1/search": {
      "get": {
        "operationId": "krogerSearch",
        "summary": "Kroger product search",
        "description": "Product search on Kroger or a sister banner (Ralphs, Fred Meyer, King Soopers, Smith's, Fry's, QFC, Harris Teeter, Dillons, Mariano's, Pick 'n Save…), 24 products per page with UPC, title, brand, size, price, regular and promo price, promo text, unit price, stock level, fulfillment options, aisle, rating, images and URL. Prices and stock are for the store given by store_id or zip (otherwise Kroger's default store, returned in `store`). Pass `next_page` back as `page`; null on the last page. `facets` lists the result's filter groups with counts (brands, departments, nutrition, flavor, special benefits, savings, availability, price buckets, price range, ways to shop); `brand`, `nutrition` and `on_sale` narrow the search with them.\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/kroger-search",
        "tags": [
          "Kroger"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Search keywords.",
            "schema": {
              "type": "string"
            },
            "example": "milk"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "zip",
            "in": "query",
            "required": false,
            "description": "5-digit US ZIP: prices and stock of the nearest store of the banner.",
            "schema": {
              "type": "string"
            },
            "example": "45202"
          },
          {
            "name": "store_id",
            "in": "query",
            "required": false,
            "description": "8-digit store location id (`store.store_id` in a response), e.g. 01400513.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "brand",
            "in": "query",
            "required": false,
            "description": "Only these brands: comma-separated brand names as listed in `facets.brands[].name`, e.g. Kroger,Simple Truth (max 10).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "nutrition",
            "in": "query",
            "required": false,
            "description": "Only products with these nutrition attributes: comma-separated names as listed in `facets.nutrition[].name`, e.g. Gluten Free (max 10).",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "on_sale",
            "in": "query",
            "required": false,
            "description": "true for products on sale only.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "banner",
            "in": "query",
            "required": false,
            "description": "Store banner (default kroger).",
            "schema": {
              "type": "string",
              "enum": [
                "kroger",
                "ralphs",
                "fredmeyer",
                "kingsoopers",
                "smiths",
                "frys",
                "qfc",
                "harristeeter",
                "dillons",
                "marianos",
                "picknsave",
                "metromarket",
                "citymarket",
                "bakers",
                "gerbes",
                "jaycfoods",
                "payless",
