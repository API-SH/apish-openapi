    "/carsandbids/v1/auctions": {
      "get": {
        "operationId": "carsandbidsAuctions",
        "summary": "Cars & Bids auctions",
        "description": "Live Cars & Bids auctions or past results with the site's filters: words, make and model, transmission, body style, year range and no-reserve, plus the site's sorts and paging (50 per page). Each auction has id, link, title, subtitle, status, current bid, sale amount, end time, no-reserve and inspection flags, location, transmission, mileage, highlights and image. Pass `next_page` back as `page`; null on the last page. Each auction also has `year` (the model year from its title).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/carsandbids-auctions",
        "tags": [
          "Cars & Bids"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Live auctions or past results.",
            "schema": {
              "type": "string",
              "enum": [
                "live",
                "closed"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "description": "Words to search for.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "make",
            "in": "query",
            "required": false,
            "description": "Make (porsche, bmw...).",
            "schema": {
              "type": "string"
            },
            "example": "porsche"
          },
          {
            "name": "model",
            "in": "query",
            "required": false,
            "description": "Model (911...). Needs make.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "transmission",
            "in": "query",
            "required": false,
            "description": "Transmission.",
            "schema": {
              "type": "string",
              "enum": [
                "automatic",
                "manual"
              ]
            }
          },
          {
            "name": "body_style",
            "in": "query",
            "required": false,
            "description": "Body style.",
            "schema": {
              "type": "string",
              "enum": [
                "coupe",
                "convertible",
                "hatchback",
                "sedan",
                "suv",
                "truck",
                "van",
                "wagon"
              ]
            }
          },
          {
            "name": "year_min",
            "in": "query",
            "required": false,
            "description": "Earliest year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "year_max",
            "in": "query",
            "required": false,
            "description": "Latest year.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "no_reserve",
            "in": "query",
            "required": false,
            "description": "true: live no-reserve auctions first.",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "description": "Order. Live: ending_soon, newly_listed, no_reserve, lowest_mileage, newest_cars, oldest_cars. Closed: recently_ended, lowest_mileage, highest_mileage, lowest_price, highest_price.",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (1-based). Pass `next_page` back as `page`; null on the last page.",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "status": "live",
