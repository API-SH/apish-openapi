                  ],
                  "reporting_location": "Delhi",
                  "experience": "0 to 4 Yrs",
                  "salary": {
                    "text": "[Salary Hidden]",
                    "min": 200000,
                    "max": 500000,
                    "currency": "INR",
                    "period": "year"
                  },
                  "industry": "IT Services & Consulting",
                  "functional_areas": [
                    "General / Other Software"
                  ],
                  "skills": [
                    "Java",
                    "Software Development",
                    "… 4 more"
                  ],
                  "tags": [
                    "software development",
                    "back end developer",
                    "… 2 more"
                  ],
                  "employment_type": "FULL_TIME",
                  "work_mode": 0,
                  "vacancies": null,
                  "applicants": 0,
                  "instant_apply": false,
                  "posted_at": "2026-10-07T18:35:38",
                  "expires_at": "2026-12-06T18:35:36",
                  "valid_through": "2026-12-06T18:35:36+05:30",
                  "description_html": "Develop and maintain Java-based applications. Write clean, efficient, and reusable code. Debug issues and perform software testing. Work wit…",
                  "description": "Develop and maintain Java-based applications. Write clean, efficient, and reusable code. Debug issues and perform software testing. Work wit…",
                  "apply_url": "https://www.shine.com/jobs/java-developer/trois-infotech/19733219",
                  "similar_jobs": [],
                  "cached": false,
                  "credits_used": 1
                }
              },
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              },
              "application/x-ndjson": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/E400"
          },
          "401": {
            "$ref": "#/components/responses/E401"
          },
          "402": {
            "$ref": "#/components/responses/E402"
          },
          "404": {
            "$ref": "#/components/responses/E404"
          },
          "502": {
            "$ref": "#/components/responses/E502"
          },
          "503": {
            "$ref": "#/components/responses/E503"
          }
        }
      }
    },
    "/shine/v1/search": {
      "get": {
        "operationId": "shineSearch",
        "summary": "Search Shine.com jobs",
        "description": "Job ads on Shine.com (India) for keywords and a city. Each result has the title, employer, locations, experience band, salary text, skills, badges and the posting date; recruiter names, phones and e-mails are left out. `facets` gives counts by location, experience, salary, department, industry and employment type. 20 per page; pass `next_page` back as `page` (null on the last page).\n\nEvery response includes `credits_used`: the credits this call cost.\n\nPrice: 1 credit per successful call. Docs: https://api.sh/docs/shine-search",
        "tags": [
          "Shine"
        ],
        "x-credits": 1,
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": true,
            "description": "Keywords (title or skill).",
            "schema": {
              "type": "string"
            },
            "example": "python"
          },
          {
            "name": "location",
            "in": "query",
            "required": false,
            "description": "City (e.g. Bangalore, Mumbai, Delhi, Pune).",
            "schema": {
              "type": "string"
            },
            "example": "Pune"
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "description": "Page number (from 1).",
            "schema": {
              "type": "integer"
            }
          },
          {
            "$ref": "#/components/parameters/raw"
          },
          {
            "$ref": "#/components/parameters/fields"
          },
          {
            "$ref": "#/components/parameters/fresh"
          },
          {
            "$ref": "#/components/parameters/output"
          },
          {
            "$ref": "#/components/parameters/records"
          }
        ],
        "responses": {
          "200": {
            "description": "The data as JSON (or CSV / NDJSON with `output`).",
            "headers": {
              "x-request-id": {
                "$ref": "#/components/headers/x-request-id"
              },
              "x-credits-used": {
                "$ref": "#/components/headers/x-credits-used"
              },
              "x-credits-remaining": {
                "$ref": "#/components/headers/x-credits-remaining"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                },
                "example": {
                  "query": "python",
                  "location": "Pune",
                  "url": "https://www.shine.com/job-search/python-jobs?q=python&loc=Pune",
                  "applied_filters": {
                    "location": "Pune"
                  },
                  "total": 887,
                  "pages": 45,
                  "count": 20,
                  "page": 1,
                  "next_page": 2,
                  "facets": {},
                  "jobs": [
                    {
                      "id": "19985359",
