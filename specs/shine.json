                      "url": "https://www.shine.com/jobs/python-developer/white-horse-manpower-consultancy-p-ltd/19985359",
                      "company": "WHITE HORSE MANPOWER CONSULTANCY (P) LTD",
                      "company_id": "699568",
                      "logo": null,
